\u53f0\u4f3a\u670d\u5668\u914d\u4ef6\u7684\u5faa\u74b0\u518d\u5229\u7528\u3002\\n\u963f\u91cc\u96f2\u5236\u5b9a\u5371\u96aa\u5ee2\u7269\u7ba1\u7406\u5236\u5ea6\uff0c\u78ba\u4fdd\u5c07\u81ea\u5efa\u6578\u64da\u4e2d\u5fc3\u7684\u5371\u96aa\u5ee2\u68c4\u7269100% \u4ea4\u7531\u7b2c\u4e09\u65b9\u5177\u5099\u8cc7\u8cea\u7684\u5c08\u696d\u516c\u53f8\u9032\u884c\u8655\u7f6e\u3002\u540c\u6642\uff0c\u963f\u91cc\u96f2\u6703\u8ffd\u8e64\u8655\u7406\u65b9\u5f0f\u4e26\u8a18\u9304\u8655\u7406\u7d50\u679c\uff0c\u4ee5\u4fdd\u8b49\u5176\u5408\u898f\u6027\u3002","packagingDescription":"\u5305\u88dd\u662f\u6d88\u8cbb\u8005\u9ad4\u9a57\u88cf\u7684\u91cd\u8981\u4e00\u74b0\u30022025 \u8ca1\u5e74\uff0c\u6211\u5011\u7684\u5305\u88dd\u8db3\u8de1\u4e3b\u8981\u5728\u65bc\u83dc\u9ce5\u7684\u7269\u6d41\u696d\u52d9\u3002\u96d6\u7136\u9762\u81e8\u4e0d\u540c\u7684\u7d93\u71df\u74b0\u5883\u5f71\u97ff\uff0c\u8b6c\u5982\u5546\u54c1\u54c1\u985e\u3001\u5929\u6c23\u72c0\u6cc1\u3001\u904b\u8f38\u914d\u9001\u65b9\u5f0f\u7b49\uff0c\u4f46\u6211\u5011\u5c0d\u65bc\u6d88\u8cbb\u8005\u7684\u627f\u8afe\u90fd\u662f\u76f8\u540c\u7684\uff0c\u8981\u70ba\u4ed6\u5011\u63d0\u4f9b\u5b89\u5168\u7121\u5bb3\u3001\u4e7e\u6de8\u653e\u5fc3\u548c\u65b9\u4fbf\u4f7f\u7528\u7684\u5305\u88dd\u9ad4\u9a57\u3002\u56e0\u6b64\uff0c\u9700\u7d9c\u5408\u8003\u616e\u9019\u4e9b\u56e0\u7d20\u4f86\u61c9\u7528\u6709\u6548\u7684\u6280\u8853\uff0c\u63d0\u4f9b\u5408\u9069\u7684\u5305\u88dd\u89e3\u6c7a\u65b9\u6848\u4f86\u5be6\u73fe\u53ef\u6301\u7e8c\u767c\u5c55\u76ee\u6a19\u3002","techEfficiency":"\u6280\u8853\u63d0\u6548","resourceUsage":"\u8f49\u8b8a\u8cc7\u6e90\u4f7f\u7528\u65b9\u5f0f","valueChainReduction":"\u5354\u540c\u50f9\u503c\u93c8\u6e1b\u6392","liquidCooling":"\u6db2\u51b7\u670d\u52d9\u5668\u6280\u8853","temperatureControl":"\u667a\u80fd\u6eab\u63a7\u7cfb\u7d71","energyManagement":"\u9ad8\u6548\u80fd\u6e90\u7ba1\u7406","panamaPower":"\u5df4\u62ff\u99ac\u96fb\u6e90","renewableEnergy":"\u53ef\u518d\u751f\u80fd\u6e90\u4f7f\u7528","fullValueRecovery":"\u5168\u50f9\u503c\u56de\u6536","greenSupplyChain":"\u7da0\u8272\u4f9b\u61c9\u93c8","carbonEmissionMonitoring":"\u78b3\u6392\u653e\u76e3\u6e2c","greenComputing":"\u7da0\u8272\u8a08\u7b97","sustainabilityKnowledgeTitle":"\u53ef\u6301\u7e8c\u8a8d\u77e5","waterEfficiencyDescription":"WUE(Water Usage Effectiveness)\u662f\u8861\u91cf\u6578\u64da\u4e2d\u5fc3\u4e2d\u6c34\u4f7f\u7528\u6548\u7387\u7684\u6307\u6a19\uff0c\u5b83\u8207 PUE \u7684\u8a08\u7b97\u95dc\u4fc2\u4e00\u81f4\uff0c\u90fd\u662f\u4e00\u500b\u6bd4\u503c\u3002WUE \u548c PUE \u7684\u8a08\u7b97\uff0c\u53cd\u6620\u53ef\u7528\u65bc\u6578\u64da\u4e2d\u5fc3\u8a2d\u8a08\u6642\u7d9c\u5408\u8003\u616e\u6c34\u8cc7\u6e90\u7684\u7ba1\u7406\u548c\u80fd\u6e90\u6548\u7387\u7684\u7ba1\u7406\u65b9\u6848\u3002\\n\u6211\u5011\u5728\u6578\u64da\u4e2d\u5fc3\u8a2d\u8a08\u4e2d\u4f7f\u7528\u5168\u90e8\u8b8a\u983b\u6c34\u6cf5\uff0c\u5c07\u5168\u5e74\u88fd\u51b7\u7cfb\u7d71\u7684\u8017\u6c34\u91cf\u964d\u4f4e30%\uff08\u76f8\u6bd4\u65bc\u5e38\u898f\u7cfb\u7d71\u964d\u4f4e\uff09\u3002\u6211\u5011\u5728\u90e8\u7f72\u968e\u6bb5\u7684 PUE \u662f\u4f4e\uff0c\u63a1\u7528\u6c34\u51b7\u6a21\u5f0f\uff0cWUE \u9060\u9060\u4f4e\u65bc\u884c\u696d\uff0c2025 \u8ca1\u5e74\uff0c\u963f\u91cc\u96f2\u81ea\u5efa\u6578\u64da\u4e2d\u5fc3\u5e73\u5747 WUE \u70ba 1.144\uff0c\u5176\u4e2d\uff0c\u4e3b\u8981\u63a1\u7528\u6c34\u51b7\u6a21\u5f0f\u7684\u6578\u64da\u4e2d\u5fc3\u5e74\u5747 WUE \u70ba 1.600\uff0c\u4e3b\u8981\u63a1\u7528\u98a8\u51b7\u6a21\u5f0f\u7684\u6578\u64da\u4e2d\u5fc3\u5e74\u5747 WUE \u70ba 0.325\u3002","waterResourceManagement":"\u53ef\u6301\u7e8c\u7528\u6c34\u5be6\u8e10","waterResourceDescription":"\u53ef\u6301\u7e8c\u7528\u6c34\u662f\u963f\u91cc\u5df4\u5df4\u6578\u64da\u4e2d\u5fc3\u7684\u91cd\u8981\u5be6\u8e10\u4e4b\u4e00\u3002\u6211\u5011\u901a\u904e\u667a\u80fd\u6c34\u8cc7\u6e90\u7ba1\u7406\u7cfb\u7d71\u3001\u7bc0\u6c34\u6280\u8853\u548c\u6c34\u8cc7\u6e90\u5faa\u74b0\u5229\u7528\uff0c\u63d0\u9ad8\u6c34\u8cc7\u6e90\u5229\u7528\u6548\u7387\uff0c\u6e1b\u5c11\u5c0d\u81ea\u7136\u6c34\u8cc7\u6e90\u7684\u4f9d\u8cf4\u3002","waterConservation":"\u53ef\u6301\u7e8c\u7528\u6c34","waterRecycling":"\u6c34\u8cc7\u6e90\u5faa\u74b0","waterMonitoring":"\u667a\u80fd\u6c34\u8cc7\u6e90\u76e3\u63a7","waterMonitoringDesc":"\u6211\u5011\u63a1\u7528\u5148\u9032\u7684\u667a\u80fd\u6c34\u8cc7\u6e90\u76e3\u63a7\u7cfb\u7d71\uff0c\u5be6\u6642\u76e3\u6e2c\u6578\u64da\u4e2d\u5fc3\u7684\u7528\u6c34\u60c5\u6cc1\uff0c\u7cbe\u78ba\u63a7\u5236\u6c34\u8cc7\u6e90\u7684\u4f7f\u7528\uff0c\u53ca\u6642\u767c\u73fe\u4e26\u8655\u7406\u6c34\u8cc7\u6e90\u6d6a\u8cbb\u554f\u984c\uff0c\u63d0\u9ad8\u6c34\u8cc7\u6e90\u5229\u7528\u6548\u7387\u3002","waterSaving":"\u7bc0\u6c34\u6280\u8853","waterSavingDesc":"\u901a\u904e\u63a1\u7528\u8b8a\u983b\u6c34\u6cf5\u3001\u9ad8\u6548\u51b7\u537b\u5854\u7b49\u7bc0\u6c34\u6280\u8853\uff0c\u6211\u5011\u7684\u6578\u64da\u4e2d\u5fc3\u80fd\u5920\u5728\u4fdd\u8b49\u8a2d\u5099\u6b63\u5e38\u904b\u884c\u7684\u540c\u6642\uff0c\u986f\u8457\u964d\u4f4e\u6c34\u8cc7\u6e90\u6d88\u8017\uff0c\u6bcf\u5e74\u53ef\u7bc0\u7d04\u5927\u91cf\u6c34\u8cc7\u6e90\u3002","waterTreatment":"\u6c34\u8655\u7406\u6280\u8853","waterTreatmentDesc":"\u6211\u5011\u7684\u6578\u64da\u4e2d\u5fc3\u63a1\u7528\u5148\u9032\u7684\u6c34\u8655\u7406\u6280\u8853\uff0c\u5c0d\u4f7f\u7528\u904e\u7684\u51b7\u537b\u6c34\u9032\u884c\u6de8\u5316\u8655\u7406\uff0c\u53bb\u9664\u96dc\u8cea\u548c\u6c61\u67d3\u7269\uff0c\u4f7f\u6c34\u8cea\u9054\u5230\u53ef\u518d\u5229\u7528\u7684\u6a19\u6e96\uff0c\u6e1b\u5c11\u5c0d\u65b0\u9bae\u6c34\u8cc7\u6e90\u7684\u4f9d\u8cf4\u3002","waterReuse":"\u6c34\u8cc7\u6e90\u518d\u5229\u7528","waterReuseDesc":"\u901a\u904e\u6c34\u8cc7\u6e90\u5faa\u74b0\u7cfb\u7d71\uff0c\u6211\u5011\u5c07\u8655\u7406\u5f8c\u7684\u6c34\u91cd\u65b0\u7528\u65bc\u51b7\u537b\u7cfb\u7d71\u3001\u7da0\u5316\u704c\u6e89\u7b49\u975e\u98f2\u7528\u7528\u9014\uff0c\u5be6\u73fe\u6c34\u8cc7\u6e90\u7684\u591a\u7d1a\u5229\u7528\uff0c\u5927\u5e45\u63d0\u9ad8\u6c34\u8cc7\u6e90\u7684\u4f7f\u7528\u6548\u7387\u3002","rainwaterCollection":"\u96e8\u6c34\u6536\u96c6","rainwaterCollectionDesc":"\u6211\u5011\u7684\u6578\u64da\u4e2d\u5fc3\u8a2d\u8a08\u4e86\u5b8c\u5584\u7684\u96e8\u6c34\u6536\u96c6\u7cfb\u7d71\uff0c\u5c07\u5c4b\u9802\u548c\u5730\u9762\u7684\u96e8\u6c34\u6536\u96c6\u8d77\u4f86\uff0c\u7d93\u904e\u7c21\u55ae\u8655\u7406\u5f8c\u7528\u65bc\u5712\u5340\u7da0\u5316\u548c\u6c96\u6d17\uff0c\u6e1b\u5c11\u5c0d\u5e02\u653f\u4f9b\u6c34\u7684\u4f9d\u8cf4\uff0c\u5be6\u73fe\u6c34\u8cc7\u6e90\u7684\u53ef\u6301\u7e8c\u5229\u7528\u3002","wasteManagementTitle":"\u8209\u63aa","wasteManagementDescription":"\u963f\u91cc\u5df4\u5df4\u5728\u6578\u64da\u4e2d\u5fc3\u7684\u5efa\u8a2d\u8207\u904b\u71df\u904e\u7a0b\u4e2d\uff0c\u81f4\u529b\u65bc\u63a8\u52d5\u7da0\u8272\u5faa\u74b0\u7d93\u6fdf\uff0c\u6211\u5011\u901a\u904e\u512a\u5316\u5305\u88dd\u8a2d\u8a08\uff0c\u63a1\u7528\u53ef\u56de\u6536\u6750\u6599\uff0c\u5efa\u7acb\u5b8c\u5584\u7684\u56de\u6536\u9ad4\u7cfb\uff0c\u6e1b\u5c11\u8cc7\u6e90\u6d6a\u8cbb\uff0c\u5be6\u73fe\u7269\u8cc7\u7684\u5faa\u74b0\u5229\u7528\u3002\u6211\u5011\u9f13\u52f5\u7528\u6236\u9078\u64c7\u7da0\u8272\u5305\u88dd\uff0c\u5171\u540c\u70ba\u74b0\u5883\u4fdd\u8b77\u505a\u51fa\u8ca2\u737b\u3002","wasteSubscribe":"\u8a02\u55ae","wastePackage":"\u5305\u88dd","wastePaper":"\u7d19\u7b52","wasteBox":"\u5009\u5132","wasteRecycle":"\u56de\u6536","multiCombineTitle":"\u591a\u7dad\u5408\u62fc","multiCombineDesc":"\u5728\u5546\u5bb6\u6709\u5f88\u591a\u5546\u54c1\u9700\u8981\u767c\u5f80\u540c\u4e00\u5730\u9ede\u6642\uff0c\u4e0b\u8f09\u5546\u54c1\u5c3a\u5bf8\u5728\u96f2\u7aef\uff0c\u6e1b\u5c11\u4eba\u5de5\u6e2c\u91cf\uff0c\u7cfb\u7d71\u81ea\u52d5\u5b8c\u6210\u591a\u4ef6\u5546\u54c1\u5c3a\u5bf8\u548c\u91cd\u91cf\u7684\u81ea\u52d5\u8a08\u7b97\uff0c\u4e26\u70ba\u591a\u7d44\u5408\u4ef6\u63a8\u85a6\u66f4\u5c0f\u5c3a\u5bf8\u7684\u5305\u88dd\u65b9\u6848\uff0c\u6e1b\u5c11\u7d19\u7bb1\u5c3a\u5bf8\u9054\u5230\u8cc7\u6e90\u512a\u5316","packageMaterialTitle":"\u6e1b\u5c11\u5305\u88dd\u6750\u6599\u4f7f\u7528","packageMaterialDesc":"\u9577\u6c5f\u908a\u6578\u64da\u4e2d\u5fc3\u63a1\u7528\u53ef\u56de\u6536\u74b0\u4fdd\u6750\u6599\u66ff\u4ee3\u6ce1\u6cab\u586b\u5145\u6599\u7b49\u975e\u74b0\u4fdd\u6750\u8cea\u4f7f\u7528\uff0c\u4fdd\u8b49\u8ca8\u7269\u5728\u904b\u8f38\u4e2d\u4e0d\u53d7\u640d\u50b7\u7684\u60c5\u6cc1\u4e0b\uff0c\u4f7f\u7528\u53ef\u964d\u89e3\u74b0\u4fdd\u6750\u8cea\uff0c\u5168\u5e74\u53ef\u7bc0\u7701\u6ce1\u6cab\u6750\u65991200\u842c\u65b9\uff0c\u5176\u904b\u8f38\u640d\u58de\u7387\u4e5f\u5728\u964d\u4f4e\u81f30.002%\u4ee5\u4e0b\uff0c\u9060\u9060\u4f4e\u65bc\u5e02\u5834\u6a19\u6e96\u3002","packageRecycleTitle":"\u5305\u88dd\u5faa\u74b0\u5229\u7528\u65b0\u7bc7","packageRecycleDesc":"\u9ed1\u9f8d\u6c5f\u54c8\u723e\u6ff1\u5e02\u958b\u59cb\u521d\u6b65\u5efa\u7bc9\u74b0\u4fdd\u6750\u6599\u5eab\uff0c\u63a8\u9032\u4f7f\u7528\u7da0\u8272\u65bd\u5de5\u5efa\u7bc9\u6750\u6599\uff0c\u622a\u6b62\u5df2\u7d93\u5165\u5eab75\u5bb6\uff0c\u6e1b\u5c11\u5e02\u5834\u591a\u7a2e\u5305\u88dd\u4e0d\u8db3\u4e8b\u9805\uff0c\u7372\u5f97\u5728\u5efa\u7bc9\u5de5\u7a0b\u7684\u78b3\u62ab\u9732\u5360\u6bd4\u9054\u5230\u5168\u570b\u4e4b3.2%\u8f032023\u5e7410\u670831\u65e5\uff0c\u4e26\u9084\u5728\u53ef\u80fd\u63d0\u9ad8\u4e2d\u3002\u8b93\u53c3\u8207\u4f01\u696d\u9054\u523014.7\u842c\u500b\u3002","packageMaterialOptimizeTitle":"\u5305\u88dd\u6750\u6599\u5347\u7d1a\u512a\u5316","packageMaterialOptimizeDesc":"\u5305\u88dd\u6750\u6599\u7814\u767c\u53ef\u964d\u89e3\u6750\u6599\u7d44\u7e54\u5275\u5efa\u5de5\u4f5c\u8eca\u9593\uff0c\u8207\u88fd\u9020\u5be6\u8e10\u6d3b\u8e8d\u4e92\u52d5\u3002\u8207\u591a\u5bb6\u77e5\u540d\u88fd\u9020\u5546\u53c3\u8207\uff0c\u64f4\u5c55\u672c\u54c1\u985e\u7814\u767c\u6df1\u5ea6\uff0c\u6b64\u5916\u6750\u6599\u88ab\u8ce6\u4e88\u7279\u6027\u5316\uff0c\u4ee5\u6c42\u76ee\u6a19\u5e02\u5834\u7279\u6027\u6709\u6240\u4e0d\u540c\u3002\u8207\u793e\u5340\u5de5\u4f5c\u5ba4\u958b\u5c55\u5de5\u4f5c\u5171\uff0c\u4e5f\u5728\u5176\u4ed6\u57ce\u5e02\u958b\u5c55\u591a\u7d44\u793e\u5340\u5e02\u5834\u6d3b\u52d5\u3002","paperCombineTitle":"\u591a\u7dad\u5408\u62fc","paperCombineDesc":"\u5728\u5546\u5bb6\u6709\u5f88\u591a\u5546\u54c1\u9700\u8981\u767c\u5f80\u540c\u4e00\u5730\u9ede\u6642\uff0c\u4e0b\u8f09\u5546\u54c1\u5c3a\u5bf8\u5728\u96f2\u7aef\uff0c\u6e1b\u5c11\u4eba\u5de5\u6e2c\u91cf\uff0c\u7cfb\u7d71\u81ea\u52d5\u5b8c\u6210\u591a\u4ef6\u5546\u54c1\u5c3a\u5bf8\u548c\u91cd\u91cf\u7684\u81ea\u52d5\u8a08\u7b97\uff0c\u4e26\u70ba\u591a\u7d44\u5408\u4ef6\u63a8\u85a6\u66f4\u5c0f\u5c3a\u5bf8\u7684\u5305\u88dd\u65b9\u6848\uff0c\u6e1b\u5c11\u7d19\u7bb1\u5c3a\u5bf8\u9054\u5230\u8cc7\u6e90\u512a\u5316","boxStorageTitle":"\u5009\u5132","boxStorageDesc":"\u5728\u5009\u5132\u74b0\u7bc0\uff0c\u6211\u5011\u63a1\u7528\u667a\u80fd\u5316\u7ba1\u7406\u7cfb\u7d71\uff0c\u512a\u5316\u5009\u5132\u5e03\u5c40\uff0c\u63d0\u9ad8\u7a7a\u9593\u5229\u7528\u7387\uff0c\u6e1b\u5c11\u4e0d\u5fc5\u8981\u7684\u80fd\u6e90\u6d88\u8017\u3002","recycleSystemTitle":"\u56de\u6536","recycleSystemDesc":"\u6211\u5011\u5efa\u7acb\u4e86\u5b8c\u5584\u7684\u56de\u6536\u9ad4\u7cfb\uff0c\u5c0d\u4f7f\u7528\u904e\u7684\u5305\u88dd\u6750\u6599\u9032\u884c\u5206\u985e\u56de\u6536\uff0c\u518d\u6b21\u5229\u7528\uff0c\u6e1b\u5c11\u8cc7\u6e90\u6d6a\u8cbb\u3002","protectingEcosystems":"\u4fdd\u8b77\u81ea\u7136","temperatureControlDesc":"\u901a\u904eAI\u7b97\u6cd5\u548c\u50b3\u611f\u5668\u7db2\u7d61\uff0c\u5be6\u6642\u76e3\u63a7\u548c\u8abf\u7bc0\u6578\u64da\u4e2d\u5fc3\u6eab\u5ea6\uff0c\u512a\u5316\u51b7\u537b\u6548\u7387\uff0c\u6e1b\u5c11\u4e0d\u5fc5\u8981\u7684\u80fd\u6e90\u6d88\u8017\u3002","energyManagementDesc":"\u90e8\u7f72\u667a\u80fd\u80fd\u6e90\u7ba1\u7406\u7cfb\u7d71\uff0c\u5be6\u6642\u76e3\u63a7\u548c\u512a\u5316\u96fb\u529b\u4f7f\u7528\uff0c\u901a\u904e\u8ca0\u8f09\u5747\u8861\u548c\u5cf0\u8c37\u8abf\u7bc0\uff0c\u6700\u5927\u5316\u80fd\u6e90\u5229\u7528\u6548\u7387\u3002","renewableEnergyDesc":"\u5927\u529b\u63a8\u5ee3\u592a\u967d\u80fd\u3001\u98a8\u80fd\u7b49\u