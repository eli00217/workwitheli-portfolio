mputing":"\u7da0\u8272\u8a08\u7b97","sustainabilityKnowledgeTitle":"\u53ef\u6301\u7e8c\u8a8d\u77e5","waterEfficiencyDescription":"WUE(Water Usage Effectiveness)\u662f\u8861\u91cf\u6578\u64da\u4e2d\u5fc3\u4e2d\u6c34\u4f7f\u7528\u6548\u7387\u7684\u6307\u6a19\uff0c\u5b83\u8207 PUE \u7684\u8a08\u7b97\u95dc\u4fc2\u4e00\u81f4\uff0c\u90fd\u662f\u4e00\u500b\u6bd4\u503c\u3002WUE \u548c PUE \u7684\u8a08\u7b97\uff0c\u53cd\u6620\u53ef\u7528\u65bc\u6578\u64da\u4e2d\u5fc3\u8a2d\u8a08\u6642\u7d9c\u5408\u8003\u616e\u6c34\u8cc7\u6e90\u7684\u7ba1\u7406\u548c\u80fd\u6e90\u6548\u7387\u7684\u7ba1\u7406\u65b9\u6848\u3002\\n\u6211\u5011\u5728\u6578\u64da\u4e2d\u5fc3\u8a2d\u8a08\u4e2d\u4f7f\u7528\u5168\u90e8\u8b8a\u983b\u6c34\u6cf5\uff0c\u5c07\u5168\u5e74\u88fd\u51b7\u7cfb\u7d71\u7684\u8017\u6c34\u91cf\u964d\u4f4e30%\uff08\u76f8\u6bd4\u65bc\u5e38\u898f\u7cfb\u7d71\u964d\u4f4e\uff09\u3002\u6211\u5011\u5728\u90e8\u7f72\u968e\u6bb5\u7684 PUE \u662f\u4f4e\uff0c\u63a1\u7528\u6c34\u51b7\u6a21\u5f0f\uff0cWUE \u9060\u9060\u4f4e\u65bc\u884c\u696d\uff0c2025 \u8ca1\u5e74\uff0c\u963f\u91cc\u96f2\u81ea\u5efa\u6578\u64da\u4e2d\u5fc3\u5e73\u5747 WUE \u70ba 1.144\uff0c\u5176\u4e2d\uff0c\u4e3b\u8981\u63a1\u7528\u6c34\u51b7\u6a21\u5f0f\u7684\u6578\u64da\u4e2d\u5fc3\u5e74\u5747 WUE \u70ba 1.600\uff0c\u4e3b\u8981\u63a1\u7528\u98a8\u51b7\u6a21\u5f0f\u7684\u6578\u64da\u4e2d\u5fc3\u5e74\u5747 WUE \u70ba 0.325\u3002","waterResourceManagement":"\u53ef\u6301\u7e8c\u7528\u6c34\u5be6\u8e10","waterResourceDescription":"\u53ef\u6301\u7e8c\u7528\u6c34\u662f\u963f\u91cc\u5df4\u5df4\u6578\u64da\u4e2d\u5fc3\u7684\u91cd\u8981\u5be6\u8e10\u4e4b\u4e00\u3002\u6211\u5011\u901a\u904e\u667a\u80fd\u6c34\u8cc7\u6e90\u7ba1\u7406\u7cfb\u7d71\u3001\u7bc0\u6c34\u6280\u8853\u548c\u6c34\u8cc7\u6e90\u5faa\u74b0\u5229\u7528\uff0c\u63d0\u9ad8\u6c34\u8cc7\u6e90\u5229\u7528\u6548\u7387\uff0c\u6e1b\u5c11\u5c0d\u81ea\u7136\u6c34\u8cc7\u6e90\u7684\u4f9d\u8cf4\u3002","waterConservation":"\u53ef\u6301\u7e8c\u7528\u6c34","waterRecycling":"\u6c34\u8cc7\u6e90\u5faa\u74b0","waterMonitoring":"\u667a\u80fd\u6c34\u8cc7\u6e90\u76e3\u63a7","waterMonitoringDesc":"\u6211\u5011\u63a1\u7528\u5148\u9032\u7684\u667a\u80fd\u6c34\u8cc7\u6e90\u76e3\u63a7\u7cfb\u7d71\uff0c\u5be6\u6642\u76e3\u6e2c\u6578\u64da\u4e2d\u5fc3\u7684\u7528\u6c34\u60c5\u6cc1\uff0c\u7cbe\u78ba\u63a7\u5236\u6c34\u8cc7\u6e90\u7684\u4f7f\u7528\uff0c\u53ca\u6642\u767c\u73fe\u4e26\u8655\u7406\u6c34\u8cc7\u6e90\u6d6a\u8cbb\u554f\u984c\uff0c\u63d0\u9ad8\u6c34\u8cc7\u6e90\u5229\u7528\u6548\u7387\u3002","waterSaving":"\u7bc0\u6c34\u6280\u8853","waterSavingDesc":"\u901a\u904e\u63a1\u7528\u8b8a\u983b\u6c34\u6cf5\u3001\u9ad8\u6548\u51b7\u537b\u5854\u7b49\u7bc0\u6c34\u6280\u8853\uff0c\u6211\u5011\u7684\u6578\u64da\u4e2d\u5fc3\u80fd\u5920\u5728\u4fdd\u8b49\u8a2d\u5099\u6b63\u5e38\u904b\u884c\u7684\u540c\u6642\uff0c\u986f\u8457\u964d\u4f4e\u6c34\u8cc7\u6e90\u6d88\u8017\uff0c\u6bcf\u5e74\u53ef\u7bc0\u7d04\u5927\u91cf\u6c34\u8cc7\u6e90\u3002","waterTreatment":"\u6c34\u8655\u7406\u6280\u8853","waterTreatmentDesc":"\u6211\u5011\u7684\u6578\u64da\u4e2d\u5fc3\u63a1\u7528\u5148\u9032\u7684\u6c34\u8655\u7406\u6280\u8853\uff0c\u5c0d\u4f7f\u7528\u904e\u7684\u51b7\u537b\u6c34\u9032\u884c\u6de8\u5316\u8655\u7406\uff0c\u53bb\u9664\u96dc\u8cea\u548c\u6c61\u67d3\u7269\uff0c\u4f7f\u6c34\u8cea\u9054\u5230\u53ef\u518d\u5229\u7528\u7684\u6a19\u6e96\uff0c\u6e1b\u5c11\u5c0d\u65b0\u9bae\u6c34\u8cc7\u6e90\u7684\u4f9d\u8cf4\u3002","waterReuse":"\u6c34\u8cc7\u6e90\u518d\u5229\u7528","waterReuseDesc":"\u901a\u904e\u6c34\u8cc7\u6e90\u5faa\u74b0\u7cfb\u7d71\uff0c\u6211\u5011\u5c07\u8655\u7406\u5f8c\u7684\u6c34\u91cd\u65b0\u7528\u65bc\u51b7\u537b\u7cfb\u7d71\u3001\u7da0\u5316\u704c\u6e89\u7b49\u975e\u98f2\u7528\u7528\u9014\uff0c\u5be6\u73fe\u6c34\u8cc7\u6e90\u7684\u591a\u7d1a\u5229\u7528\uff0c\u5927\u5e45\u63d0\u9ad8\u6c34\u8cc7\u6e90\u7684\u4f7f\u7528\u6548\u7387\u3002","rainwaterCollection":"\u96e8\u6c34\u6536\u96c6","rainwaterCollectionDesc":"\u6211\u5011\u7684\u6578\u64da\u4e2d\u5fc3\u8a2d\u8a08\u4e86\u5b8c\u5584\u7684\u96e8\u6c34\u6536\u96c6\u7cfb\u7d71\uff0c\u5c07\u5c4b\u9802\u548c\u5730\u9762\u7684\u96e8\u6c34\u6536\u96c6\u8d77\u4f86\uff0c\u7d93\u904e\u7c21\u55ae\u8655\u7406\u5f8c\u7528\u65bc\u5712\u5340\u7da0\u5316\u548c\u6c96\u6d17\uff0c\u6e1b\u5c11\u5c0d\u5e02\u653f\u4f9b\u6c34\u7684\u4f9d\u8cf4\uff0c\u5be6\u73fe\u6c34\u8cc7\u6e90\u7684\u53ef\u6301\u7e8c\u5229\u7528\u3002","wasteManagementTitle":"\u63a8\u52d5\u7269\u6d41\u6e1b\u78b3","wasteManagementDescription":"\u963f\u91cc\u5df4\u5df4\u5728\u6578\u64da\u4e2d\u5fc3\u7684\u5efa\u8a2d\u8207\u904b\u71df\u904e\u7a0b\u4e2d\uff0c\u81f4\u529b\u65bc\u63a8\u52d5\u7da0\u8272\u5faa\u74b0\u7d93\u6fdf\uff0c\u6211\u5011\u901a\u904e\u512a\u5316\u5305\u88dd\u8a2d\u8a08\uff0c\u63a1\u7528\u53ef\u56de\u6536\u6750\u6599\uff0c\u5efa\u7acb\u5b8c\u5584\u7684\u56de\u6536\u9ad4\u7cfb\uff0c\u6e1b\u5c11\u8cc7\u6e90\u6d6a\u8cbb\uff0c\u5be6\u73fe\u7269\u8cc7\u7684\u5faa\u74b0\u5229\u7528\u3002\u6211\u5011\u9f13\u52f5\u7528\u6236\u9078\u64c7\u7da0\u8272\u5305\u88dd\uff0c\u5171\u540c\u70ba\u74b0\u5883\u4fdd\u8b77\u505a\u51fa\u8ca2\u737b\u3002","wasteSubscribe":"\u8a02\u55ae","wastePackage":"\u5305\u88dd","wastePaper":"\u7d19\u7b52","wasteBox":"\u5009\u5132","wasteRecycle":"\u56de\u6536","multiCombineTitle":"\u591a\u7dad\u5408\u62fc","multiCombineDesc":"\u5728\u5546\u5bb6\u6709\u5f88\u591a\u5546\u54c1\u9700\u8981\u767c\u5f80\u540c\u4e00\u5730\u9ede\u6642\uff0c\u4e0b\u8f09\u5546\u54c1\u5c3a\u5bf8\u5728\u96f2\u7aef\uff0c\u6e1b\u5c11\u4eba\u5de5\u6e2c\u91cf\uff0c\u7cfb\u7d71\u81ea\u52d5\u5b8c\u6210\u591a\u4ef6\u5546\u54c1\u5c3a\u5bf8\u548c\u91cd\u91cf\u7684\u81ea\u52d5\u8a08\u7b97\uff0c\u4e26\u70ba\u591a\u7d44\u5408\u4ef6\u63a8\u85a6\u66f4\u5c0f\u5c3a\u5bf8\u7684\u5305\u88dd\u65b9\u6848\uff0c\u6e1b\u5c11\u7d19\u7bb1\u5c3a\u5bf8\u9054\u5230\u8cc7\u6e90\u512a\u5316","packageMaterialTitle":"\u6e1b\u5c11\u5305\u88dd\u6750\u6599\u4f7f\u7528","packageMaterialDesc":"\u9577\u6c5f\u908a\u6578\u64da\u4e2d\u5fc3\u63a1\u7528\u53ef\u56de\u653