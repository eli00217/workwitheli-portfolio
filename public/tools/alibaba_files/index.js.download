'{"esgReports":"ESG\u62a5\u544a","actionResults":"\u884c\u52a8\u7ed3\u679c","actionResultsTitle":"\u884c\u52a8\u7ed3\u679c","strategyPath":"\u7b56\u7565\u4e0e\u8def\u5f84","strategyPathTitle":"\u7b56\u7565\u4e0e\u8def\u5f84","consumerExperienceTitle":"\u521b\u9020\u826f\u597d\u7684\u6d88\u8d39\u4f53\u9a8c","digitalLifeTitle":"\u8425\u9020\u5305\u5bb9\u5065\u5eb7\u7684\u6570\u5b57\u751f\u6d3b","diversityEquityInclusion":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d","talentAttractionRetention":"\u4eba\u624d\u7684\u5438\u5f15\u548c\u4fdd\u7559","talentDevelopmentOpportunities":"\u4e30\u5bcc\u7684\u4eba\u624d\u53d1\u5c55\u673a\u4f1a","employeeHealthVitality":"\u5458\u5de5\u5065\u5eb7\u4e0e\u6d3b\u529b","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"\u5458\u5de5\u4e3a\u5973\u6027","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"\u798f\u5e03\u65af\u5168\u7403\u6700\u4f73\u96c7\u4e3b","familyCareLeaveTitle":"\u8d856\u4e07","familyCareLeaveDesc":"\u5173\u7231\u5bb6\u4eba\uff0c\u5458\u5de5\u5229\u7528\u966a\u4f34\u5047\u4eab\u53d7\u4e0e\u5bb6\u4eba\u7684\u5b9d\u8d35\u65f6\u5149","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"\u963f\u91cc\u5df4\u5df4\u7684\u591a\u4e2a\u56ed\u533a\u3001\u6570\u636e\u4e2d\u5fc3\u548c\u7269\u6d41\u573a\u6240\u83b7\u5f97\u4e86\u8ba4\u8bc1","firstAidTrainingTitle":"\u8d8514000\u540d","firstAidTrainingDesc":"\u963f\u91cc\u5df4\u5df4\u7d2f\u8ba1\u57f9\u8bad\u6025\u6551\u4fa0","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"\u963f\u91cc\u5df4\u5df4\u529e\u516c\u73af\u5883\u6ee1\u610f\u5ea693.1%"}')},68003:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u5831\u544a","actionResults":"\u884c\u52d5\u7d50\u679c","actionResultsTitle":"\u884c\u52d5\u7d50\u679c","strategyPath":"\u7b56\u7565\u8207\u8def\u5f91","strategyPathTitle":"\u7b56\u7565\u8207\u8def\u5f91","consumerExperienceTitle":"\u5275\u9020\u826f\u597d\u7684\u6d88\u8cbb\u9ad4\u9a57","digitalLifeTitle":"\u71df\u9020\u5305\u5bb9\u5065\u5eb7\u7684\u6578\u5b57\u751f\u6d3b","diversityEquityInclusion":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d","talentAttractionRetention":"\u4eba\u624d\u7684\u5438\u5f15\u548c\u4fdd\u7559","talentDevelopmentOpportunities":"\u8c50\u5bcc\u7684\u4eba\u624d\u767c\u5c55\u6a5f\u6703","employeeHealthVitality":"\u54e1\u5de5\u5065\u5eb7\u8207\u6d3b\u529b","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"\u54e1\u5de5\u70ba\u5973\u6027","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"\u798f\u5e03\u65af\u5168\u7403\u6700\u4f73\u50f1\u4e3b","familyCareLeaveTitle":"\u8d856\u842c","familyCareLeaveDesc":"\u95dc\u611b\u5bb6\u4eba\uff0c\u54e1\u5de5\u5229\u7528\u966a\u4f34\u5047\u4eab\u53d7\u8207\u5bb6\u4eba\u7684\u5bf6\u8cb4\u6642\u5149","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"\u963f\u91cc\u5df4\u5df4\u7684\u591a\u500b\u5712\u5340\u3001\u6578\u64da\u4e2d\u5fc3\u548c\u7269\u6d41\u5834\u6240\u7372\u5f97\u4e86\u8a8d\u8b49","firstAidTrainingTitle":"\u8d8514000\u540d","firstAidTrainingDesc":"\u963f\u91cc\u5df4\u5df4\u7d2f\u8a08\u57f9\u8a13\u6025\u6551\u4fe0","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"\u963f\u91cc\u5df4\u5df4\u8fa6\u516c\u74b0\u5883\u6eff\u610f\u5ea693.1%"}')},13398:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","otherReports":"Reports","esgNewsViews":"ESG News and Views","esgRatingsAwards":"ESG Ratings and Awards","esgPolicies":"ESG Policies","bannerSlogan":"Responsible tech for a sustainable future","letterTitle":"A Letter from our CEO","letterContent":"In FY2025, we advanced our AI capabilities and stayed deeply committed to the principle of technology for good. Alibaba ranked third globally for its contributions to major AI models. Our Qwen model family has generated over 100,000 derivatives on Hugging Face. DAMO Academy\'s AI-powered multi-cancer screening technology has been piloted in multiple counties across China. The year 2025 marks the 10th anniversary of Alibaba\'s \\"Three Hours for a Better World\\" initiative. We have sent 34 commissioners to 29 counties to support rural revitalization efforts. Amap\'s \\"Wheelchair Navigation\\" feature provided over 100 million accessible route plans and navigation services for the visually impaired in FY2025. Taobao Instant Commerce\'s \\"Silent Rider\\" program has provided job opportunities to over 4,200 individuals with hearing impairments in FY2025. A decade of action has reinforced our belief \u2013 employees who care deeply about real-world problems are the ones who build products with heart \u2013 and that\'s what defines a truly responsible company.","letterContent2":"We also hope that more and more peers will explore the future of sustainable development together, create value beyond business, and jointly build a healthy, comprehensive, and mutually prosperous sustainable ecosystem.","leader":"EDDIE WU","ceo":"Eddie Wu, Chief Executive Officer of Alibaba Group","alibaba":"Cloud Intelligence Group Chairman and CEO","LatestESGReport":"Latest ESG Report","letterContentFirst":"ESG is a vital benchmark for measuring and refining the quality of Alibaba\'s growth. ","strategySummary":"In FY2022, Alibaba officially established ESG as a cornerstone strategy, which drives sustainability along three pathways: tech-driven efficiency, resource transition, and ecosystem coordination.","strategicPositionOfESG":"Strategic position of ESG","ESGGovernanceTitle":"ESG governance","keyIssuesAndPerformanceMetrics":"Progress","keyIssuesAndPerformanceMetricsTitle":"Progress of FY2026","ESGNews":"News","governance":"Governance","environment":"Environment","social":"Social","downloadReport":"Download the latest ESG report","ESG":"ESG","carbonNeutrality":"Carbon Neutrality","lowCarbonCloud":"Low Carbon Cloud","buildGreenCloud":"Building a Green and Low-Carbon Cloud","saveWaterCirculation":"Water Conservation","reduceWasteReuse":"Waste Reduction and Recycling","goalTitle":"Goal","greenEnergyDesc":"Clean electricity provided for cloud computing from 2030 onwards","carbonNeutralTitle":"Carbon Neutrality","carbonNeutralDesc":"Aliyun commits to achieving carbon neutrality for scope 1, 2, and 3 by 2030","pueDesc":"Aliyun\'s self-built data center average PUE does not exceed","actionResultTitle":"Actions","cleanEnergyPercent":"33.8","cleanEnergyDesc":"Clean energy accounts for 64% of Alibaba Cloud\'s self-built data centers, an increase of 8 percentage points compared to the same period in 2024","pueValueResult":"1.190","pueValueDesc":"The annual average PUE of Alibaba Cloud\'s self-built data centers further decreased from 1.200 to 1.190","carbonReduction":"57.5","carbonReductionUnit":"million tons","carbonReductionDesc":"In FY2025, carbon emissions from Alibaba Cloud\'s self-built data centers","energySaving":"11.19 million tons","energySavingDesc":"In FY2025, Alibaba Cloud helped invest in low-carbon technology innovation, further reducing energy resource consumption, with core business carbon intensity of 11.19 million tons","carbonReductionPractice":"Carbon Reduction Practices in Our Campus","packagingDescription":"Packaging is a crucial part of the consumer experience. In FY2025, our packaging footprint was primarily in Cainiao\'s logistics business. Despite facing different operational environment impacts, such as product categories, weather conditions, and transportation methods, our commitment to consumers remains the same: to provide packaging that is safe, clean, and convenient to use. Therefore, we need to consider these factors comprehensively to apply effective technologies and provide appropriate packaging solutions to achieve sustainable development goals.","techEfficiency":"Technical Efficiency","resourceUsage":"Transforming Resource Usage","valueChainReduction":"Value Chain Collaboration","liquidCooling":"Liquid Cooling Technology","temperatureControl":"Smart Temperature Control","energyManagement":"Efficient Energy Management","panamaPower":"Panama Power","renewableEnergy":"Renewable Energy Usage","fullValueRecovery":"Full Value Recovery","greenSupplyChain":"Green Supply Chain","carbonEmissionMonitoring":"Carbon Emission Monitoring","greenComputing":"Green Computing","sustainabilityKnowledgeTitle":"Sustainability Knowledge","waterEfficiencyDescription":"WUE (Water Usage Effectiveness) is a metric for measuring water usage efficiency in data centers. It has a consistent calculation relationship with PUE, both being ratios. The calculation of WUE and PUE reflects the comprehensive consideration of water resource management and energy efficiency management solutions available for data center design.\\nWe use all variable frequency water pumps in our data center design, reducing the cooling system\'s water consumption by 30% year-round (compared to conventional systems). Our PUE at the deployment stage is low, using water cooling mode, and our WUE is far below the industry average. In FY2025, Alibaba Cloud\'s self-built data centers had an average WUE of 1.144, with water-cooled data centers averaging a WUE of 1.600 and air-cooled data centers averaging a WUE of 0.325.","waterResourceManagement":"Sustainable Water Practices","waterResourceDescription":"Sustainable water usage is one of the important practices in Alibaba\'s data centers. We improve water resource utilization efficiency and reduce dependence on natural water resources through intelligent water resource management systems, water-saving technologies, and water resource recycling.","waterConservation":"Sustainable Water Usage","waterRecycling":"Water Resource Recycling","waterMonitoring":"Smart Water Resource Monitoring","waterMonitoringDesc":"We employ advanced smart water resource monitoring systems to track water usage in our data centers in real-time, precisely control water resource usage, promptly identify and address water waste issues, and improve water resource utilization efficiency.","waterSaving":"Water-saving Technology","waterSavingDesc":"By adopting variable frequency water pumps, efficient cooling towers, and other water-saving technologies, our data centers can significantly reduce water consumption while ensuring normal equipment operation, saving a substantial amount of water resources annually.","waterTreatment":"Water Treatment Technology","waterTreatmentDesc":"Our data centers use advanced water treatment technology to purify used cooling water, removing impurities and contaminants to meet reusable standards, reducing dependence on fresh water resources.","waterReuse":"Water Resource Reuse","waterReuseDesc":"Through our water resource recycling system, we reuse treated water for cooling systems, landscape irrigation, and other non-potable purposes, achieving multi-level utilization of water resources and significantly improving water use efficiency.","rainwaterCollection":"Rainwater Collection","rainwaterCollectionDesc":"Our data centers feature comprehensive rainwater collection systems that gather rainwater from roofs and grounds, which is then simply treated for campus landscaping and cleaning, reducing dependence on municipal water supplies and achieving sustainable water resource utilization.","wasteManagementTitle":"Promoting Logistics Carbon Reduction","wasteManagementDescription":"In the construction and operation of data centers, Alibaba is committed to promoting a green circular economy. We optimize packaging design, use recyclable materials, establish a comprehensive recycling system, reduce resource waste, and achieve circular utilization of materials. We encourage users to choose green packaging and contribute to environmental protection together.","wasteSubscribe":"Subscribe","wastePackage":"Package","wastePaper":"Paper","wasteBox":"Storage","wasteRecycle":"Recycle","multiCombineTitle":"Multi-dimensional Combination","multiCombineDesc":"When merchants have many products to be sent to the same location, the product dimensions are downloaded to the cloud, reducing manual measurement. The system automatically completes the automatic calculation of the dimensions and weights of multiple products, and recommends smaller packaging solutions for multiple combinations, reducing the size of cartons to achieve resource optimization","packageMaterialTitle":"Reduce Packaging Material Usage","packageMaterialDesc":"The Yangtze River data center uses recyclable environmentally friendly materials to replace foam fillers and other non-environmentally friendly materials. While ensuring that goods are not damaged during transportation, degradable environmentally friendly materials are used. The foam material can be saved by 12 million cubic meters per year, and the transportation damage rate has also been reduced to below 0.002%, far below market standards.","packageRecycleTitle":"New Chapter in Packaging Recycling","packageRecycleDesc":"Harbin City, Heilongjiang Province, has started to initially build an environmentally friendly material library, promoting the use of green construction materials. As of now, 75 companies have been included in the library, reducing various packaging shortages in the market. The carbon disclosure ratio in construction projects has reached 3.2% of the national total as of October 31, 2023, and is still improving. The number of participating companies has reached 147,000.","packageMaterialOptimizeTitle":"Packaging Material Upgrade and Optimization","packageMaterialOptimizeDesc":"Packaging material R&D degradable material organization creates workshops and actively interacts with manufacturing practices. Participating with multiple well-known manufacturers, expanding the R&D depth of this category. In addition, materials are given characteristics to seek different target market characteristics. Working with community studios, and also carrying out multiple community market activities in other cities.","paperCombineTitle":"Multi-dimensional Combination","paperCombineDesc":"When merchants have many products to be sent to the same location, the product dimensions are downloaded to the cloud, reducing manual measurement. The system automatically completes the automatic calculation of the dimensions and weights of multiple products, and recommends smaller packaging solutions for multiple combinations, reducing the size of cartons to achieve resource optimization","boxStorageTitle":"Storage","boxStorageDesc":"In the storage link, we use intelligent management systems to optimize storage layout, improve space utilization, and reduce unnecessary energy consumption.","recycleSystemTitle":"Recycling","recycleSystemDesc":"We have established a comprehensive recycling system to classify and recycle used packaging materials for reuse, reducing resource waste.","protectingEcosystems":"Protecting ecosystems","buildingSustainableCampus":"Building Sustainable Campus","sustainableCampusDescription":"The environment is a consideration, we focused on topics such as carbon\u3001packaging\u3001water resources\u3001waste and biodiversity, based on the 4R circular economy model to take the appropriate actions.We aims to maintain a clean and green environment","SustainableCampusActionResultTitle":"Actions","CampusActionResultTitle1":"Carbon-Neutral Campus","CampusActionResultTitle1Desc":"Alibaba\'s Guangzhou, Shenzhen, Hangzhou Xixi Area A, and Shanghai Xuhui Riverside Campus Area D have been certified as carbon neutral.","CampusActionResultTitle2":"52.1","CampusActionResultTitle2Unit":"10,000 square meters","CampusActionResultTitle2Desc":"As of March 31, 2025, 521,000 square meters of building area have achieved LEED Gold certification, a year-on-year increase of 119%.","CampusActionResultTitle3":"36.7","CampusActionResultTitle3Unit":"%","CampusActionResultTitle3Desc":"Through energy efficiency improvements, clean power applications, and the deployment of smart management systems, we have achieved a 36.7% year-on-year reduction in emissions per unit area at our self-owned office campuses.","CampusActionResultTitle4":"110,248","CampusActionResultTitle4Unit":"Employee","CampusActionResultTitle4Desc":"In fiscal year 2025, 110,248 employees completed 2,676,047 green and low-carbon friendly behaviors through \\"Youxin\\" participation.","CarbonNeutralPark":"Carbon Neutral Park","CarbonNeutralParkDesc":"\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848","liquidCoolingDesc":"Adopting advanced liquid cooling technology, through direct contact cooling, significantly improving server heat dissipation efficiency, reducing energy consumption, and achieving higher computing density and lower operating costs.","temperatureControlDesc":"Through AI algorithms and sensor networks, real-time monitoring and adjustment of data center temperature, optimizing cooling efficiency, and reducing unnecessary energy consumption.","energyManagementDesc":"Deploying intelligent energy management systems, real-time monitoring and optimization of power usage, maximizing energy utilization efficiency through load balancing and peak-valley regulation.","panamaPowerDesc":"Adopting efficient Panama power technology, improving power conversion efficiency, reducing power loss, and providing more stable and energy-efficient power supply for data centers.","renewableEnergyDesc":"Vigorously promoting the use of renewable energy such as solar and wind power, reducing dependence on traditional fossil fuels, and achieving clean energy power supply.","fullValueRecoveryDesc":"Establishing a complete resource recovery system, conducting full lifecycle management of waste equipment and materials, achieving maximum utilization and circular use of resources.","greenSupplyChainDesc":"Cooperating with suppliers to establish a green supply chain system, prioritizing environmentally friendly materials and low-carbon transportation methods, promoting sustainable development of the entire value chain.","carbonEmissionMonitoringDesc":"Deploying comprehensive carbon emission monitoring systems, real-time tracking and analysis of carbon footprints, providing precise data support for emission reduction decisions.","greenComputingDesc":"Promoting green computing technology, optimizing algorithm efficiency, reducing computing resource consumption, and achieving more environmentally friendly computing services through technological innovation.","CarbonNeutralParkContentTitle":"Carbon Neutral Sample Campus","CarbonNeutralParkContent":"\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587","CarbonNeutralParkPracticeTitle":"Carbon Neutral Park Practice","CleanEnergy":"Clean Energy Usage","EnergyEfficiency":"Energy Efficiency Improvement","EmployeePractice":"Employee Low-Carbon Behavior Incentive","CleanEnergyTitle":"Solar Power System","CleanEnergyDescription":"Promoting the use of renewable energy such as solar and wind power, reducing dependence on traditional fossil fuels, and achieving clean energy power supply.","EnergyEfficiencyTitle":"Wind Power Facility","EnergyEfficiencyDescription":"Optimizing building envelope structures, reducing air conditioning energy consumption, and improving building overall energy efficiency.","EmployeePracticeTitle":"Employee Low-Carbon Behavior Incentive","EmployeePracticeDescription":"Promoting employee low-carbon behavior, improving employee environmental awareness, promoting office energy-saving tips, forming a low-carbon culture of full participation.","smartLightingSystem":"Smart Lighting System","smartLightingDesc":"Deploy intelligent LED lighting systems that automatically adjust brightness based on natural light and personnel activity, achieving over 60% energy savings compared to traditional lighting.","buildingInsulationOptimization":"Building Insulation Optimization","buildingInsulationDesc":"Adopt high-performance insulation materials and energy-efficient glass, optimize building envelope structure, reduce air conditioning energy consumption, and improve overall building energy efficiency.","smartAirConditioningSystem":"Smart Air Conditioning System","smartAirConditioningDesc":"Deploy AI-driven smart air conditioning systems that automatically adjust based on indoor and outdoor temperature, personnel density and other factors, achieving precise temperature control and energy saving.","lowCarbonTravelIncentive":"Low-Carbon Travel Incentive","lowCarbonTravelDesc":["Through digital travel services, reduce carbon emissions,","Encourage users to choose environmentally friendly travel methods,","Expected to achieve emission reduction of 500,000 tons by 2025."],"energySavingBehaviorTraining":"Energy-Saving Behavior Training","energySavingBehaviorDesc":"Regularly conduct energy-saving and environmental protection training, improve employee environmental awareness, promote office energy-saving tips, and form a low-carbon culture with full participation.","buildingDigitalCircularLogistics":"Building Digital Circular Logistics","digitalCircularLogisticsDescription":"The transportation industry is a major source of global greenhouse gas emissions, with significant decarbonization challenges. Cainiao is one of Alibaba\'s main logistics emission businesses. In FY2025, Cainiao continued to assess carbon emissions and energy consumption data from itself and suppliers, taking green and low-carbon actions across all stages from orders, warehousing, packaging to transportation, achieving a total emission reduction of 284,000 tons in its own operations and value chain. Meanwhile, in the recycling stage, Cainiao Post continues to drive consumer participation in emission reduction.","wasteOrderTab":"Orders","wastePackageTab":"Packaging","wasteTransportTab":"Transportation","wasteStorageTab":"Warehousing","wasteRecycleTab":"Recycling","multiOrderMerging":"Multi-Order Consolidation","smartAlgorithmOptimizeTransport":"Smart Algorithm for Transport Route Optimization","greenLowCarbonTransportMethod":"Using Greener and Low-Carbon Transportation Methods","distributedPhotovoltaic":"Distributed Photovoltaic","cleanElectricityTrading":"Clean Electricity Trading","recyclingSystem":"Recycling System","pendingContentPlaceholder":"Content to be provided. Content to be provided. Content to be provided. Content to be provided. Content to be provided. Content to be provided.","digitalCircularActionResultTitle1":"Clean electricity usage ratio under the control of Cainiao in FY2025","digitalCircularActionResultTitle2":"The proportion of trips delivered by Cainiao\'s own fleet in urban delivery","digitalCircularActionDescription3":"Cainiao has reduced packaging materials by 284,000 tons through reducing packaging material usage, packaging recycling, and reuse, achieving a total reduction of 284,000 tons.","sustainableCognitionLogistics":"Sustainable Cognition of Logistics","carbonReductionDescription":"We comprehensively promote carbon reduction work in our through technological innovation, resource optimization, and value chain collaboration, achieving sustainable development goals.","ecosystemReductionTitle":"Driving and Enabling Platform Ecosystem Emission Reduction","ecosystemReductionDescription":"Through digital technology innovation, we can provide assistance to society and play a limiting role in the process. We can achieve solutions through information utilization. Appropriately, Alibaba established in 2021 based on its own operations and value chain experience,","ecosystemReductionKeyword":"Scope 3+","ecosystemReductionStats":"leadership system goals. By 2025, Scope 3+ will achieve emission reductions of 59.208 million tons, a year-on-year increase of 77.6%.","viewMoreText":"View More","drivingReductionTitle":"Driving Emission Reduction","enablingReductionTitle":"Enabling Emission Reduction","lowCarbonProducts":"Low-Carbon Products","lowCarbonTravel":"Low-Carbon Travel","lowCarbonDining":"Low-Carbon Dining","consumerRecycling":"Consumer Product Recycling","lowCarbonLogistics":"Low-Carbon Logistics","lowCarbonOffice":"Low-Carbon Office","lowCarbonProduction":"Low-Carbon Production","fourPrinciplesTitle":"Four Principles","scientificMeasurement":"Scientific Measurement","professionalCertification":"Professional Certification","ecosystemSharing":"Ecosystem Sharing","principlesVideoText":"By 2025, our construction achievements will be more prominent, and we can try to enable users to clearly verify and display achievements through testing.","lowCarbonProductsDesc":["By 2025, Tmall\'s selection in key areas will reach 290,000 tons,","Meeting relevant selection criteria in environmental protection technology methods and capabilities","1688.com annual results of 32,000 tons, similarly achievable through technical installation methods","Auxiliary: 12.713 million tons"],"lowCarbonDiningDesc":["Promote green dining concepts,","Reduce food waste and optimize supply chains,","Expected to reduce emissions by 300,000 tons by 2025."],"consumerRecyclingDesc":["Establish a comprehensive recycling system,","Promote resource recycling and utilization,","Expected to reduce emissions by 800,000 tons by 2025."],"lowCarbonCloudDesc":["Optimize resource allocation through cloud computing technology,","Improve server efficiency and reduce energy consumption,","Expected to achieve emission reduction of 2 million tons by 2025."],"lowCarbonLogisticsDesc":["Smart logistics systems optimize delivery routes,","Use new energy vehicles,","Expected to reduce emissions by 1.2 million tons by 2025."],"lowCarbonOfficeDesc":["Digital office systems reduce paper usage,","Smart buildings reduce energy consumption,","Expected to reduce emissions by 400,000 tons by 2025."],"lowCarbonProductionDesc":["Green manufacturing processes, clean energy utilization,","Industrial digital transformation,","Expected to reduce emissions by 3 million tons by 2025."],"governanceStructure":"Governance structure","managementSystem":"Management system","governanceDescription":"We advance our ESG initiatives through a three-tier governance structure comprising the Board of Directors, the management, and working groups. This approach incorporates a PDCA (Plan-Do-Check-Act) cycle to continuously refine our ESG management system.","ESGSuggestions":"Share your ESG feedback","contactESG":"Contact us at ESG@alibaba-inc.com","viewMore":"View More","nav_esg_home":"Home","nav_environment":"Environmental","nav_climate_change":"Climate action","nav_carbon_neutrality":"Carbon neutrality","nav_green_mountains":"Nature protection","nav_social":"Social","nav_employee_development":"Our people","nav_product_responsibility":"Responsible consumption","nav_smart_platform":"Enterprise empowerment","nav_social_community":"Community giving","nav_honest_business":"Business integrity","nav_governance":"Governance","nav_resource":"Resources","ratingRange":"Rating Range","ratingScore":"Rating Score","learnMore":"Learn More","homeTip":"Unless otherwise specified, all ESG disclosures reflect our performance and progress during FY2026."}')},79521:function(e){"use strict";e.exports=JSON.parse('{"esgReport