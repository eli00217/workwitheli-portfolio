u5b9c\u964d\u4f4e\u7528\u6c34\u6d88\u8017\u3001\u63d0\u5347\u6c34\u8d44\u6e90\u5229\u7528\u6548\u7387\u3002","waterCard2Title":"\u529e\u516c\u56ed\u533a","waterCard2Description":"\u6211\u4eec\u5728\u56ed\u533a\u7684\u8bbe\u8ba1\u548c\u8fd0\u8425\u9636\u6bb5\u5747\u8003\u8651\u6c34\u8d44\u6e90\u7684\u53ef\u6301\u7eed\u7ba1\u7406\uff0c\u901a\u8fc7\u6d77\u7ef5\u57ce\u5e02\u8bbe\u8ba1\u7406\u5ff5\u548c\u667a\u80fd\u5316\u6c34\u8d44\u6e90\u7ba1\u7406\u7cfb\u7edf\u7b49\u884c\u52a8\u5c3d\u53ef\u80fd\u63d0\u5347\u6c34\u8d44\u6e90\u5229\u7528\u7387\u3002","waterCard3Title":"\u96f6\u552e\u573a\u6240","waterCard3Description":"\u6d77\u9c9c\u4fdd\u9c9c\u7528\u6c34\u662f\u76d2\u9a6c\u6700\u5927\u7684\u6c34\u8db3\u8ff9\u6765\u6e90\u3002\u5728\u4fdd\u969c\u54c1\u8d28\u4e0e\u6d88\u8d39\u4f53\u9a8c\u7684\u524d\u63d0\u4e0b\uff0c\u6211\u4eec\u6301\u7eed\u63a2\u7d22\u9ad8\u6548\u8282\u6c34\u65b9\u6848\u3002","wasteDescription":"\u4eba\u7c7b\u6bcf\u5e74\u4ea7\u751f\u7ea6 21-23 \u4ebf\u5428\u57ce\u5e02\u56fa\u4f53\u5e9f\u7269\uff0c\u5176\u4e2d\u53ea\u670961%-62% \u5728\u53d7\u63a7\u8bbe\u65bd\u4e2d\u5f97\u5230\u5904\u7406\u3002\u6211\u4eec\u575a\u6301\\"\u51cf\u91cf\u5316\\"\u548c\\"\u8d44\u6e90\u5316\\"\u5904\u7406\uff0c\u52aa\u529b\u63a8\u52a8\u5e9f\u5f03\u7269\u5408\u89c4\u9ad8\u6548\u7ba1\u7406\u3002","wasteDataCenterTitle":"\u6570\u636e\u4e2d\u5fc3","wasteDataCenterContent":"\u6211\u4eec\u7684\u81ea\u5efa\u6570\u636e\u4e2d\u5fc3\u6240\u6709\u5371\u9669\u5e9f\u5f03\u7269100%\u4ea4\u7531\u6301\u8bc1\u4e13\u4e1a\u673a\u6784\u5904\u7406\uff0c\u5e76\u6784\u5efa\u4e86IT\u8bbe\u5907\u56de\u6536\u4f53\u7cfb\uff0c\u63a8\u52a8\u8d44\u6e90\u5faa\u73af\u518d\u751f\u3002","wasteOfficeParkTitle":"\u529e\u516c\u56ed\u533a","wasteOfficeParkContent":"\u6211\u4eec\u5728\u529e\u516c\u56ed\u533a\u575a\u6301\u201c100%\u5408\u89c4\u5904\u7406\u5e9f\u5f03\u7269\u201d\u539f\u5219\uff0c\u63a8\u884c\u5e9f\u5f03\u7269\u6570\u5b57\u5316\u7ba1\u7406\uff0c\u5e76\u8bd5\u70b9\u5c06\u53a8\u4f59\u5783\u573e\u8f6c\u53