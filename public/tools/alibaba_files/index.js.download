"lowCarbonProducts":"\u4f4e\u78b3\u5546\u54c1","lowCarbonProductsDescTitle":"\u4f4e\u78b3\u5546\u54c1","lowCarbonProductsDesc":"\u900f\u904e\u96fb\u5546\u5e73\u53f0\u64f4\u5927\u7da0\u8272\u6d88\u8cbb\u9078\u64c7\uff0c\u4fc3\u9032\u4f4e\u78b3\u5546\u54c1\u92b7\u552e\uff0c\u5f9e\u800c\u6e1b\u5c11\u6d88\u8cbb\u7aef\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","lowCarbonTravel":"\u51fa\u884c\u670d\u52d9","lowCarbonTravelDescTitle":"\u51fa\u884c\u670d\u52d9","lowCarbonTravelDesc":"\u900f\u904e\u5728\u5730\u5716\u7684\u51fa\u884c\u9801\u9762\u63a8\u85a6\u4e26\u5f15\u5c0e\u7528\u6236\u9078\u64c7\u7da0\u8272\u51fa\u884c\u65b9\u5f0f\uff08\u5982\u6b65\u884c\u3001\u9a0e\u884c\u3001\u516c\u4ea4\u3001\u5730\u9435\u7b49\uff09\u66ff\u4ee3\u79c1\u5bb6\u8eca\u51fa\u884c\uff0c\u5f9e\u800c\u6e1b\u5c11\u4ea4\u901a\u51fa\u884c\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","lowCarbonDining":"\u9910\u98f2\u670d\u52d9","lowCarbonDiningDescTitle":"\u9910\u98f2\u670d\u52d9","lowCarbonDiningDesc":"\u5373\u6642\u96f6\u552e\u5e73\u53f0\u5f15\u5c0e\u9910\u98f2\u5916\u8ce3\u7528\u6236\u505a\u51fa\u4f4e\u78b3\u7684\u9910\u98f2\u6d88\u8cbb\u9078\u64c7\uff08\u5982\u6e1b\u5c11\u4e00\u6b21\u6027\u5851\u6599\u88fd\u54c1\u6d88\u8017\u3001\u6e1b\u5c11\u98df\u7269\u6d6a\u8cbb\u7b49\uff09\uff0c\u5f9e\u800c\u6e1b\u5c11\u76f8\u95dc\u8017\u6750\u4f7f\u7528\u53ca\u5783\u573e\u5ee2\u68c4\u8655\u7406\u968e\u6bb5\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","consumerRecycling":"\u9592\u7f6e\u7269\u54c1\u56de\u6536\u5229\u7528","consumerRecyclingDescTitle":"\u9592\u7f6e\u7269\u54c1\u56de\u6536\u5229\u7528","consumerRecyclingDesc":"\u900f\u904e\u5e73\u53f0\u4fc3\u9032\u9592\u7f6e\u7269\u54c1\u5728\u7528\u6236\u4e4b\u9593\u6d41\u8f49\u6216\u9032\u5165\u898f\u7bc4\u56de\u6536\u93c8\u8def\u4ee5\u5ef6\u9577\u5176\u4f7f\u7528\u58fd\u547d\uff0c\u5f9e\u800c\u6e1b\u5c11\u56e0\u751f\u7522\u5168\u65b0\u66ff\u4ee3\u54c1\u800c\u7522\u751f\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","lowCarbonCloud":"\u96f2\u8a08\u7b97","lowCarbonCloudDescTitle":"\u96f2\u8a08\u7b97","lowCarbonCloudDesc":"\u7528\u6236\u63a1\u7528\u96f2\u670d\u52d9\u66ff\u4ee3\u81ea\u5efa\u6578\u64da\u4e2d\u5fc3\uff0c\u501f\u52a9\u96c6\u7d04\u5316\u57fa\u790e\u8a2d\u65bd\u3001\u80fd\u6548\u512a\u5316\u3001\u9ad8\u80fd\u6548\u786c\u4ef6\u3001\u6f54\u6de8\u80fd\u6e90\u4f7f\u7528\u8207\u96f2\u539f\u751f\u8abf\u5ea6\u7b49\u80fd\u529b\uff0c\u964d\u4f4e\u540c\u7b49 IT \u8ca0\u8f09\u4e0b\u7522\u751f\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","lowCarbonLogistics":"\u51fa\u884c\u670d\u52d9","lowCarbonLogisticsDescTitle":"\u51fa\u884c\u670d\u52d9","lowCarbonLogisticsDesc":"\u900f\u904e\u63d0\u4f9b\u9ad8\u7cbe\u5ea6\u7684\u5c0e\u822a\u8def\u7dda\u512a\u5316\u670d\u52d9\uff0c\u964d\u4f4e\u8eca\u8f1b\u56e0\u64c1\u5835\u6216\u7e5e\u884c\u7522\u751f\u7684\u6020\u901f\u8207\u884c\u99db\u91cc\u7a0b\uff0c\u5f9e\u800c\u6e1b\u5c11\u7528\u6236\u51fa\u884c\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","lowCarbonOffice":"\u6578\u5b57\u8fa6\u516c","lowCarbonOfficeDescTitle":"\u6578\u5b57\u8fa6\u516c","lowCarbonOfficeDesc":"\u4f9d\u6258\u7dda\u4e0a\u5354\u540c\u8fa6\u516c\u8edf\u4ef6\u7684\u7dda\u4e0a\u6703\u8b70\u8207\u7121\u7d19\u5316\u8fa6\u516c\u7522\u54c1\uff0c\u6e1b\u5c11\u7528\u6236\u8fa6\u516c\u76f8\u95dc\u7684\u4ea4\u901a\u51fa\u884c\u983b\u7387\u8207\u8fa6\u516c\u8017\u6750\u6d88\u8017\u7522\u751f\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","lowCarbonProduction":"\u5de5\u696d\u751f\u7522","lowCarbonProductionDescTitle":"\u5de5\u696d\u751f\u7522","lowCarbonProductionDesc":"\u900f\u904e\u667a\u80fd\u5316\u7ba1\u7406\u7cfb\u7d71\u512a\u5316\u5de5\u696d\u751f\u7522\u6d41\u7a0b\uff0c\u964d\u4f4e\u5de5\u5ee0\u55ae\u4f4d\u7522\u54c1\u7684\u80fd\u8017\u8207\u7269\u8017\uff0c\u5f9e\u800c\u6e1b\u5c11\u7522\u54c1\u751f\u7522\u88fd\u9020\u968e\u6bb5\u7684\u6eab\u5ba4\u6c23\u9ad4\u6392\u653e\u3002","methodologyTitle":"\u95dc\u9375\u80fd\u529b","scientificMeasurement":"\u79d1\u5b78\u6838\u7b97","scientificMeasurementDesc":"\u900f\u904e\u65b9\u6cd5\u5b78\u9ad4\u7cfb\u3001\u95dc\u9375\u8981\u7d20\u5b9a\u7fa9\uff08\u7cfb\u7d71\u908a\u754c\u3001\u529f\u80fd\u55ae\u4f4d\u3001\u57fa\u6e96\u60c5\u666f\u7b49\uff09\u8207\u6a19\u6e96\u5316\u6d41\u7a0b\uff0c\u78ba\u4fdd\u8a08\u7b97\u4e00\u81f4\u3001\u53ef\u8907\u73fe\u3001\u53ef\u6bd4\u8f03\u3002","digitalManagement":"\u6578\u5b57\u5316\u7ba1\u7406","digitalManagementDesc":"\u900f\u904e\u6578\u5b57\u5316\u5e73\u53f0\u5be6\u73fe\u6578\u64da\u63a1\u96c6\u3001\u7248\u672c\u63a7\u5236\u3001\u6d41\u7a0b\u7559\u75d5\u8207\u8a08\u7b97\u53ef\u8907\u73fe\uff0c\u63d0\u5347\u9451\u8b49\u5c31\u7dd2\u5ea6\u4e26\u964d\u4f4e\u898f\u6a21\u5316\u7ba1\u7406\u6210\u672c\u3002","professionalVerification":"\u7b2c\u4e09\u65b9\u9451\u8b49","professionalVerificationDesc":"\u900f\u904e\u7368\u7acb\u7684\u7b2c\u4e09\u65b9\u6a5f\u69cb\u9a57\u8b49\u65b9\u6cd5\u5b78\u3001\u6578\u64da\u8207\u7d50\u679c\u7684\u5408\u7406\u6027\u8207\u771f\u5be6\u6027\uff0c\u589e\u5f37\u5c0d\u5916\u6e9d\u901a\u7684\u53ef\u4fe1\u5ea6\u8207\u98a8\u96aa\u9632\u7bc4\u3002","ecosystemPartnership":"\u751f\u614b\u5171\u5efa","ecosystemPartnershipDesc":"\u900f\u904e\u8207\u884c\u696d\u5925\u4f34\u3001\u7814\u7a76\u6a5f\u69cb\u3001\u9451\u8b49\u6a5f\u69cb\u3001\u6a19\u6e96\u7d44\u7e54\u7b49\u5354\u4f5c\uff0c\u63a8\u52d5\u65b9\u6cd5\u5b78\u5171\u8b58\u3001\u6578\u64da\u53ef\u5f97\u6027\u8207\u5be6\u8e10\u64f4\u6563\u3002"}')},86846:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","otherReports":"Reports","esgNewsViews":"ESG News and Views","esgRatingsAwards":"ESG Ratings and Awards","esgPolicies":"ESG Policies","bannerSlogan":"Responsible tech for a sustainable future","letterTitle":"A Letter from our CEO","letterContent":"In FY2025, we advanced our AI capabilities and stayed deeply committed to the principle of technology for good. Alibaba ranked third globally for its contributions to major AI models. Our Qwen model family has generated over 100,000 derivatives on Hugging Face. DAMO Academy\'s AI-powered multi-cancer screening technology has been piloted in multiple counties across China. The year 2025 marks the 10th anniversary of Alibaba\'s \\"Three Hours for a Better World\\" initiative. We have sent 34 commissioners to 29 counties to support rural revitalization efforts. Amap\'s \\"Wheelchair Navigation\\" feature provided over 100 million accessible route plans and navigation services for the visually impaired in FY2025. Taobao Instant Commerce\'s \\"Silent Rider\\" program has provided job opportunities to over 4,200 individuals with hearing impairments in FY2025. A decade of action has reinforced our belief \u2013 employees who care deeply about real-world problems are the ones who build products with heart \u2013 and that\'s what defines a truly responsible company.","letterContent2":"We also hope that more and more peers will explore the future of sustainable development together, create value beyond business, and jointly build a healthy, comprehensive, and mutually prosperous sustainable ecosystem.","leader":"EDDIE WU","ceo":"Eddie Wu, Chief Executive Officer of Alibaba Group","alibaba":"Cloud Intelligence Group Chairman and CEO","LatestESGReport":"Latest ESG Report","letterContentFirst":"ESG is a vital benchmark for measuring and refining the quality of Alibaba\'s growth. ","strategySummary":"In FY2022, we officially established ESG as one of Alibaba\'s cornerstone strategies and identified three key pathways to drive sustainable development, which include integrating ESG into business growth, leveraging technological innovations, and building a stakeholder ecosystem. Through this strategic framework, we strive to address the core expectations of various stakeholders by creating systematic, scalable solutions that align with the public interest. That gives us the opportunity to thrive across economic cycles and create greater value, both commercial and beyond.","strategicPositionOfESG":"Strategic position of ESG","ESGGovernanceTitle":"ESG governance","keyIssuesAndPerformanceMetrics":"Core issues and our performance","ESGNews":"News","governance":"Governance","environment":"Environment","social":"Social","downloadReport":"Download the report","ESG":"ESG","carbonNeutrality":"Environment","lowCarbonCloud":"Green cloud computing","cloudSustainabilityTitle":"Green cloud computing","cloudSustainabilityDesc":"We are committed to building efficient, resilient, and sustainable data centers that minimize our own and our customers\' environmental footprints without compromising service quality.","buildGreenCloud":"Decarbonization","saveWaterCirculation":"Water conservation","saveWaterCirculationTab":"Water conservation","reduceWasteReuse":"Waste management","goalTitle":"Goals","greenEnergyGoalDesc":"Starting from 2030, Alibaba Cloud will be 100% powered by clean electricity.","pueGoalDesc":"The annual average PUE across Alibaba Cloud\'s self-built data centers will not exceed 1.3.","carbonNeutralGoalDesc":"Alibaba Cloud pledges to achieve carbon neutrality in Scopes 1, 2, and 3 by 2030.","greenEnergyDesc":"Clean electricity provided for cloud computing from 2030 onwards","carbonNeutralTitle":"Carbon neutrality","carbonNeutralDesc":"Aliyun commits to achieving carbon neutrality for scope 1, 2, and 3 by 2030","pueDesc":"Aliyun\'s self-built data center average PUE does not exceed","actionResultTitle":"Progress","cleanEnergyCardDesc":"Clean electricity comprised 64.0% of total power consumption at Alibaba Cloud\u2019s self-built data centers.","pueCardDesc":"The annual average PUE value of Alibaba Cloud\'s self-built data centers dropped to 1.190.","carbonReductionCardDesc":"Alibaba Cloud achieved 575,000 tons of emissions reduction across its leased data centers.","energySavingCardDesc":"Alibaba Cloud enabled enterprise customers to reduce emissions by 11.19 million tons.","cleanEnergyPercent":"33.8","cleanEnergyDesc":"Clean energy accounts for 64% of Alibaba Cloud\'s self-built data centers, an increase of 8 percentage points compared to the same period in 2024","pueValueResult":"1.190","pueValueDesc":"The annual average PUE of Alibaba Cloud\'s self-built data centers further decreased from 1.200 to 1.190","carbonReduction":"575,000","carbonReductionUnit":"tons","carbonReductionDesc":"In FY2025, carbon emissions from Alibaba Cloud\'s self-built data centers","energySaving":"11.19","energySavingUnit":"million tons","energySavingDesc":"In FY2025, Alibaba Cloud helped invest in low-carbon technology innovation, further reducing energy resource consumption, with core business carbon intensity of 11.19 million tons","carbonReductionPractice":"Carbon Reduction Practices in Our Campus","cloudCarbonReductionTitle":"Practices","valueChainEfficiency":"Ecosystem coordination","liquidCoolingTitle":"Liquid cooling for servers","liquidCoolingDesc":"We utilize advanced direct-contact liquid cooling to boost heat dissipation efficiency for servers and lower energy consumption.","panamaPowerTitle":"Upgraded power supply architectures","panamaPowerDesc":"Leveraging technical validation data and operational experience from the Panama power supply, Alibaba Cloud is scaling up the deployment of HVDC architectures to simplify step-downs and conversions, reducing heat generation and energy loss. Our latest data centers support these architectures up to 800V.","wasteHeatRecoveryTitle":"Waste heat recovery","wasteHeatRecoveryDesc":"Alibaba Cloud partners with municipal authorities to recover waste heat from data centers using advanced heat exchange technologies and repurpose it for district heating. This practice improves energy efficiency and contributes to urban energy conservation, delivering both economic and ecological benefits.","cleanElectricityTitle":"Clean electricity","cleanElectricityDesc":"Alibaba Cloud systematically drives its clean energy transition along three pathways: distributed PV deployment, market-based clean electricity trading, and long-term power purchase agreements.","greenFireSystemTitle":"Eco-friendly fire suppression systems","greenFireSystemDesc":"Alibaba Cloud is phasing out traditional heptafluoropropane fire extinguishers with a GWP of 3,350 in favor of IG541-based alternatives with a GWP close to 0 across its self-built data centers.","sourceGridLoadStorageTitle":"Source-grid-load-storage","sourceGridLoadStorageDesc":"In Baoding City, Hebei Province, we have participated in a \\"source-grid-load-storage\\" project with an installed capacity of 500 MW. Once completed and connected to the power grid, the project will generate nearly 1 billion kWh of green electricity annually. In Zhangjiakou City, Hebei Province, we have participated in a \\"source-grid-load-storage\\" project invested in and built by Mingyang Wind Power Group. The project has an installed capacity of 200 MW. Once completed and connected to the power grid, it will secure a stable supply of green electricity for our data center, approximately 600 million kWh annually.","leasedDcCleanEnergyTitle":"Measuring Scope 3 emissions","leasedDcCleanEnergyDesc":"Without accurate measurement, emissions reduction is futile. Alibaba Cloud has deployed a monitoring system that tracks energy consumption and emissions across its leased data centers to facilitate carbon inventories and verification.","leasedDcPueTitle":"ESG assessments and requirements for suppliers","leasedDcPueDesc":"Alibaba Cloud has established a green assessment mechanism to track suppliers\' PUE performance and drive joint efforts for emissions reduction. It is progressively incorporating requirements for the share of clean electricity into new and renewed supplier contracts.","supportSupplierCarbonReduction":"Supporting suppliers in emissions reduction","supportSupplierCarbonReductionDesc":"Alibaba Cloud shares its in-house algorithmic O&M strategy and PUE analysis tool with suppliers. It partners with suppliers in Guangdong and Shanghai to secure electricity energy via market-based trading, while also phasing in IG541 green fire suppression systems across leased data centers.","wueCard1Unit":"L/kWh","wueCard1Desc":"The annual average WUE of Alibaba Cloud\'s self-built data centers was 1.144 L/kWh.","wueCard2Unit":"cubic meters","wueCard2Desc":"We reclaimed  40,625 cubic meters of water.","waterIdeasTitle":"Water efficiency","waterIdeasContent":"Data centers generate massive amounts of heat during their operations. Without effective cooling, equipment may overheat and fail. To address this issue, we can adopt air cooling or evaporative cooling. Air cooling generally requires more energy, whereas evaporative cooling consumes more water. Data centers are confronted with this trade-off between water and electricity.\\nWater usage effectiveness (WUE) is a crucial metric for measuring the efficiency and sustainability of data centers, where a lower value indicates better performance. Since FY2024, we have disclosed the average WUE of our self-built data centers worldwide.","waterPracticeTitle":"Practices","waterRecyclingTitle":"Site selection","waterRecyclingDesc":"WUE depends on numerous variables, among which data center location is particularly significant. In cold regions, a cool ambient environment reduces freshwater consumption for cooling, resulting in a naturally low WUE. When designing a data center, we evaluate the local climate and water availability to select the right cooling solution, considering various metrics such as PUE and WUE.","waterOptimizationTitle":"WUE management","waterOptimizationDesc":"Alibaba Cloud has established a WUE monitoring system covering all its self-built data centers. Alibaba Cloud has formulated WUE management guidelines that leverage accurate water footprint measurements to specify criteria for meter selection, measurement methods, and operational requirements. Furthermore, it has built a knowledge base of WUE optimization strategies, providing data centers with replicable best practices.","waterRecyclingTitle2":"Water reclamation","waterRecyclingDesc2":"Alibaba Cloud minimizes water consumption where possible and uses alternative solutions such as water reclamation and rainwater harvesting.","wasteCard1Desc":"Warranty extensions were achieved for servers with a combined capacity of 25.72 million cores.","wasteCard1Number":"25.72","wasteCard1Unit":"million cores","wasteCard2Desc":"Parts from 21,768 servers were reused.","wasteCard2Unit":"units","wasteIdeasTitle":"Approches","wasteIdeasContent":"The world generates an estimated 2.1-2.3 gigatons of municipal solid waste annually, of which only 61% to 62% is treated in controlled facilities. We manage our waste impact through a rigorous process where we track, measure, and audit our waste footprint. To drive the circular economy, we adopt a two-pronged approach that centers on \\"reduction\\" to minimize waste generation and \\"waste-to-resource conversion\\" to treat and recycle waste.","wastePracticeTitle":"Practices","wastePracticeContent":"Alibaba Cloud minimizes its environmental impact by recycling end-of-life equipment from data centers. Our Circular Reuse Center extends server lifecycles via refurbishment and repair, thereby cutting e-waste. In FY2026, we extended warranties for servers totaling 28.51 million cores and recycled parts from 15,593 servers. Additionally, 100% of hazardous waste is handled by qualified vendors, with full tracking and documentation to ensure compliance.","packagingDescription":"Packaging is a crucial part of the consumer experience. In FY2025, our packaging footprint was primarily in Cainiao\'s logistics business. Despite facing different operational environment impacts, such as product categories, weather conditions, and transportation methods, our commitment to consumers remains the same: to provide packaging that is safe, clean, and convenient to use. Therefore, we need to consider these factors comprehensively to apply effective technologies and provide appropriate packaging solutions to achieve sustainable development goals.","techEfficiency":"Tech-driven efficiency","resourceUsage":"Resource transition","valueChainReduction":"Coordinating along the value chain","liquidCooling":"Liquid Cooling Technology","temperatureControl":"Smart Temperature Control","energyManagement":"Efficient Energy Management","panamaPower":"Panama Power","renewableEnergy":"Renewable Energy Usage","fullValueRecovery":"Full Value Recovery","greenSupplyChain":"Green Supply Chain","carbonEmissionMonitoring":"Carbon Emission Monitoring","greenComputing":"Green Computing","sustainabilityKnowledgeTitle":"Sustainability Knowledge","waterEfficiencyDescription":"WUE (Water Usage Effectiveness) is a metric for measuring water usage efficiency in data centers. It has a consistent calculation relationship with PUE, both being ratios. The calculation of WUE and PUE reflects the comprehensive consideration of water resource management and energy efficiency management solutions available for data center design.\\nWe use all variable frequency water pumps in our data center design, reducing the cooling system\'s water consumption by 30% year-round (compared to conventional systems). Our PUE at the deployment stage is low, using water cooling mode, and our WUE is far below the industry average. In FY2025, Alibaba Cloud\'s self-built data centers had an average WUE of 1.144, with water-cooled data centers averaging a WUE of 1.600 and air-cooled data centers averaging a WUE of 0.325.","waterResourceManagement":"Sustainable Water Practices","waterResourceDescription":"Sustainable water usage is one of the important practices in Alibaba\'s data centers. We improve water resource utilization efficiency and reduce dependence on natural water resources through intelligent water resource management systems, water-saving technologies, and water resource recycling.","waterConservation":"Sustainable Water Usage","waterRecycling":"Water Resource Recycling","waterMonitoring":"Smart Water Resource Monitoring","waterMonitoringDesc":"We employ advanced smart water resource monitoring systems to track water usage in our data centers in real-time, precisely control water resource usage, promptly identify and address water waste issues, and improve water resource utilization efficiency.","waterSaving":"Water-saving Technology","waterSavingDesc":"By adopting variable frequency water pumps, efficient cooling towers, and other water-saving technologies, our data centers can significantly reduce water consumption while ensuring normal equipment operation, saving a substantial amount of water resources annually.","waterTreatment":"Water Treatment Technology","waterTreatmentDesc":"Our data centers use advanced water treatment technology to purify used cooling water, removing impurities and contaminants to meet reusable standards, reducing dependence on fresh water resources.","waterReuse":"Water Resource Reuse","waterReuseDesc":"Through our water resource recycling system, we reuse treated water for cooling systems, landscape irrigation, and other non-potable purposes, achieving multi-level utilization of water resources and significantly improving water use efficiency.","rainwaterCollection":"Rainwater Collection","rainwaterCollectionDesc":"Our data centers feature comprehensive rainwater collection systems that gather rainwater from roofs and grounds, which is then simply treated for campus landscaping and cleaning, reducing dependence on municipal water supplies and achieving sustainable water resource utilization.","wasteManagementTitle":"Practices","wasteManagementDescription":"In the construction and operation of data centers, Alibaba is committed to promoting a green circular economy. We optimize packaging design, use recyclable materials, establish a comprehensive recycling system, reduce resource waste, and achieve circular utilization of materials. We encourage users to choose green packaging and contribute to environmental protection together.","wasteSubscribe":"Subscribe","wastePackage":"Package","wastePaper":"Paper","wasteBox":"Storage","wasteRecycle":"Recycle","multiCombineTitle":"Multi-dimensional Combination","multiCombineDesc":"When merchants have many products to be sent to the same location, the product dimensions are downloaded to the cloud, reducing manual measurement. The system automatically completes the automatic calculation of the dimensions and weights of multiple products, and recommends smaller packaging solutions for multiple combinations, reducing the size of cartons to achieve resource optimization","packageMaterialTitle":"Reduce Packaging Material Usage","packageMaterialDesc":"The Yangtze River data center uses recyclable environmentally friendly materials to replace foam fillers and other non-environmentally friendly materials. While ensuring that goods are not damaged during transportation, degradable environmentally friendly materials are used. The foam material can be saved by 12 million cubic meters per year, and the transportation damage rate has also been reduced to below 0.002%, far below market standards.","packageRecycleTitle":"New Chapter in Packaging Recycling","packageRecycleDesc":"Harbin City, Heilongjiang Province, has started to initially build an environmentally friendly material library, promoting the use of green construction materials. As of now, 75 companies have been included in the library, reducing various packaging shortages in the market. The carbon disclosure ratio in construction projects has reached 3.2% of the national total as of October 31, 2023, and is still improving. The number of participating companies has reached 147,000.","packageMaterialOptimizeTitle":"Packaging Material Upgrade and Optimization","packageMaterialOptimizeDesc":"Packaging material R&D degradable material organization creates workshops and actively interacts with manufacturing practices. Participating with multiple well-known manufacturers, expanding the R&D depth of this category. In addition, materials are given characteristics to seek different target market characteristics. Working with community studios, and also carrying out multiple community market activities in other cities.","paperCombineTitle":"Multi-dimensional Combination","paperCombineDesc":"When merchants have many products to be sent to the same location, the product dimensions are downloaded to the cloud, reducing manual measurement. The system automatically completes the automatic calculation of the dimensions and weights of multiple products, and recommends smaller packaging solutions for multiple combinations, reducing the size of cartons to achieve resource optimization","boxStorageTitle":"Storage","boxStorageDesc":"In the storage link, we use intelligent management systems to optimize storage layout, improve space utilization, and reduce unnecessary energy consumption.","recycleSystemTitle":"Recycling","recycleSystemDesc":"We have established a comprehensive recycling system to classify and recycle used packaging materials for reuse, reducing resource waste.","protectingEcosystems":" Nature protection","temperatureControlDesc":"Through AI algorithms and sensor networks, real-time monitoring and adjustment of data center temperature, optimizing cooling efficiency, and reducing unnecessary energy consumption.","energyManagementDesc":"Deploying intelligent energy management systems, real-time monitoring and optimization of power usage, maximizing energy utilization efficiency through load balancing and peak-valley regulation.","renewableEnergyDesc":"Vigorously promoting the use of renewable energy such as solar and wind power, reducing dependence on traditional fossil fuels, and achieving clean energy power supply.","fullValueRecoveryDesc":"Establishing a complete resource recovery system, conducting full lifecycle management of waste equipment and materials, achieving maximum utilization and circular use of resources.","greenSupplyChainDesc":"Cooperating with suppliers to establish a green supply chain system, prioritizing environmentally friendly materials and low-carbon transportation methods, promoting sustainable development of the entire value chain.","carbonEmissionMonitoringDesc":"Deploying comprehensive carbon emission monitoring systems, real-time tracking and analysis of carbon footprints, providing precise data support for emission reduction decisions.","greenComputingDesc":"Promoting green computing technology, optimizing algorithm efficiency, reducing computing resource consumption, and achieving more environmentally friendly computing services through technological innovation.","CarbonNeutralParkContentTitle":"Carbon Neutral Sample Campus","CarbonNeutralParkContent":"\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587\u6848\u5f85\u786e\u8ba4\u6587","CleanEnergy":"Clean Energy Usage","EnergyEfficiency":"Energy Efficiency Improvement","EmployeePractice":"Employee Low-Carbon Behavior Incentive","CleanEnergyTitle":"Solar Power System","CleanEnergyDescription":"Promoting the use of renewable energy such as solar and wind power, reducing dependence on traditional fossil fuels, and achieving clean energy power supply.","EnergyEfficiencyTitle":"Wind Power Facility","EnergyEfficiencyDescription":"Optimizing building envelope structures, reducing air conditioning energy consumption, and improving building overall energy efficiency.","EmployeePracticeTitle":"Employee Low-Carbon Behavior Incentive","EmployeePracticeDescription":"Promoting employee low-carbon behavior, improving employee environmental awareness, promoting office energy-saving tips, forming a low-carbon culture of full participation.","smartLightingSystem":"Smart Lighting System","smartLightingDesc":"Deploy intelligent LED lighting systems that automatically adjust brightness based on natural light and personnel activity, achieving over 60% energy savings compared to traditional lighting.","buildingInsulationOptimization":"Building Insulation Optimization","buildingInsulationDesc":"Adopt high-performance insulation materials and energy-efficient glass, optimize building envelope structure, reduce air conditioning energy consumption, and improve overall building energy efficiency.","smartAirConditioningSystem":"Smart Air Conditioning System","smartAirConditioningDesc":"Deploy AI-driven smart air conditioning systems that automatically adjust based on indoor and outdoor temperature, personnel density and other factors, achieving precise temperature control and energy saving.","lowCarbonTravelIncentive":"Low-Carbon Travel Incentive","lowCarbonTravelDesc":["Through digital travel services, reduce carbon emissions,","Encourage users to choose environmentally friendly travel methods,","Expected to achieve emission reduction of 500,000 tons by 2025."],"energySavingBehaviorTraining":"Energy-Saving Behavior Training","energySavingBehaviorDesc":"Regularly conduct energy-saving and environmental protection training, improve employee environmental awareness, promote office energy-saving tips, and form a low-carbon culture with full participation.","buildingDigitalCircularLogistics":"Smart circular logistics","digitalCircularLogisticsDescription":"To deliver on our low-carbon commitment, we drive operational efficiency across order processing, warehousing, packaging, and transportation.","logisticsCard1Desc":"The share of clean electricity within Cainiao\'s operational control reached 33.8%.","logisticsCard2Title":"1,140.3","logisticsCard2Unit":"tons","logisticsCard2Desc":"Cainiao\'s intelligent route planning algorithm helped reduce 1,140.3 tons of emissions.","logisticsCard3Number":"169,000","logisticsCard3Unit":"tons","logisticsCard3Desc":"Cainiao saved around 169,000 tons of packaging materials by minimizing usage at the source and increasing reuse.","logisticsIdeasTitle":"Approches","logisticsIdeasContent":"To better serve consumers worldwide, we leverage a diverse logistics network. However, the varying maturity of emission reduction technologies across operational stages in different logistics models hinders deployment at scale. Our strategy is to prioritize the implementation of solutions deployable on a massive scale across five key stages: order processing, packaging, transportation, warehousing, and recycling. We make continuous investments to explore and deploy innovative technologies, aiming to build a future-ready, low-carbon logistics system.","wasteOrderTab":"Order processing","wastePackageTab":"Packaging","wasteTransportTab":"Transportation","wasteStorageTab":"Warehousing","wasteRecycleTab":"Recycling","multiOrderMerging":"Multi-order consolidation","multiOrderMergingDesc":"Our direct retail operations consolidate orders destined for the same address and placed around the same time. This reduces the shipping volume, thereby cutting emissions from packaging and transportation.","reducePackagingMaterialsTitle":"Reducing packaging","reducePackagingMaterialsDesc":"Cainiao has independently developed a smart packing algorithm that optimizes cardboard box selection, packing sequence, and item arrangement during the warehousing and packing phases to maximize space utilization.","packageRecyclingTitle":"Reusing and recyling","packageRecyclingDesc":"In FY2026, Cainiao reused over 24 million cardboard boxes. The business promotes reusable crates for logistics delivery. As of March 31, 2026, it had recorded over 1.4 million instances of use across a pool of 143,000 reusable crates in merchant warehouses.","packageMaterialUpgradeTitle":"Upgrading packaging materials","packageMaterialUpgradeDesc":"We procure a lot of packaging materials. For logistics and delivery in businesses such as Tmall Supermarket, we are phasing in plastic bags made from recycled materials to replace those manufactured entirely from virgin plastics.","smartAlgorithmOptimizeTransport":"Route planning algorithm","smartAlgorithmOptimizeTransportDesc":"This algorithm optimizes route planning for both Cainiao\'s self-operated fleet and third-party fleets to reduce mileage and lower empty load rates.","greenTransportMethodTitle":"Autonomous delivery vehicles","greenTransportMethodDesc":"Cainiao makes continuous efforts to scale the deployment of autonomous delivery vehicles across an expanding range of use cases.","multimodalTransportTitle":"Multimodal transportation","multimodalTransportDesc":"AliExpress balances transportation efficiency and environmental impact via a sea-land-air-rail multimodal network. It also optimizes vehicle configurations for land transportation. These efforts help decarbonize cross-border logistics.","intelligentOperationTitle":"Smart operations","intelligentOperationDesc":"In warehousing operations, Cainiao has deployed smart monitoring terminals to enable granular energy management, with a focus on its clean energy transition.","adoptCleanElectricityTitle":"Clean electricity","adoptCleanElectricityDesc":"As of March 31, 2026, the total installed capacity of grid-connected solar PV systems across our warehouses was 161.1 MW, triple the previous fiscal year\'s figure and enough to power 68,000 average households in China.","postBoxRecyclingTitle":"Circularity at Cainiao Posts","postBoxRecyclingDesc":"We encourage consumers to leave cardboard boxes at Cainiao Posts after picking up packages so that they can be reused for future shipments. When customers send packages, we offer a \\"Ship with Used Box\\" option to promote participation in the circular economy.","greenLowCarbonTransportMethod":"Using Greener and Low-Carbon Transportation Methods","distributedPhotovoltaic":"Distributed Photovoltaic","cleanElectricityTrading":"Clean Electricity Trading","recyclingSystem":"Recycling System","pendingContentPlaceholder":"Content to be provided. Content to be provided. Content to be provided. Content to be provided. Content to be provided. Content to be provided.","digitalCircularActionResultTitle1":"Clean electricity usage ratio under the control of Cainiao in FY2025","digitalCircularActionResultTitle2":"The proportion of trips delivered by Cainiao\'s own fleet in urban delivery","digitalCircularActionDescription3":"Cainiao has reduced packaging materials by 284,000 tons through reducing packaging material usage, packaging recycling, and reuse, achieving a total reduction of 284,000 tons.","sustainableCognitionLogistics":"Sustainable Cognition of Logistics","carbonReductionDescription":"We comprehensively promote carbon reduction work in our through technological innovation, resource optimization, and value chain collaboration, achieving sustainable development goals.","ecosystemReductionTitle":"Driving and Enabling Platform Ecosystem Emission Reduction","ecosystemReductionDescription":"Through digital technology innovation, we can provide assistance to society and play a limiting role in the process. We can achieve solutions through information utilization. Appropriately, Alibaba established in 2021 based on its own operations and value chain experience,","ecosystemReductionKeyword":"Scope 3+","ecosystemReductionStats":"leadership system goals. By 2025, Scope 3+ will achieve emission reductions of 59.208 million tons, a year-on-year increase of 77.6%.","viewMoreText":"View More","drivingReductionTitle":"Driving Emission Reduction","enablingReductionTitle":"Enabling Emission Reduction","lowCarbonProducts":"Low-Carbon Products","lowCarbonTravel":"Low-Carbon Travel","lowCarbonDining":"Low-Carbon Dining","consumerRecycling":"Consumer Product Recycling","lowCarbonLogistics":"Low-Carbon Logistics","lowCarbonOffice":"Low-Carbon Office","lowCarbonProduction":"Low-Carbon Production","fourPrinciplesTitle":"Four Principles","scientificMeasurement":"Scientific Measurement","professionalCertification":"Professional Certification","ecosystemSharing":"Ecosystem Sharing","principlesVideoText":"By 2025, our construction achievements will be more prominent, and we can try to enable users to clearly verify and display achievements through testing.","lowCarbonProductsDesc":["By 2025, Tmall\'s selection in key areas will reach 290,000 tons,","Meeting relevant selection criteria in environmental protection technology methods and capabilities","1688.com annual results of 32,000 tons, similarly achievable through technical installation methods","Auxiliary: 12.713 million tons"],"lowCarbonDiningDesc":["Promote green dining concepts,","Reduce food waste and optimize supply chains,","Expected to reduce emissions by 300,000 tons by 2025."],"consumerRecyclingDesc":["Establish a comprehensive recycling system,","Promote resource recycling and utilization,","Expected to reduce emissions by 800,000 tons by 2025."],"lowCarbonCloudDesc":["Optimize resource allocation through cloud computing technology,","Improve server efficiency and reduce energy consumption,","Expected to achieve emission reduction of 2 million tons by 2025."],"lowCarbonLogisticsDesc":["Smart logistics systems optimize delivery routes,","Use new energy vehicles,","Expected to reduce emissions by 1.2 million tons by 2025."],"lowCarbonOfficeDesc":["Digital office systems reduce paper usage,","Smart buildings reduce energy consumption,","Expected to reduce emissions by 400,000 tons by 2025."],"lowCarbonProductionDesc":["Green manufacturing processes, clean energy utilization,","Industrial digital transformation,","Expected to reduce emissions by 3 million tons by 2025."],"buildingSustainableCampus":"Sustainable campuses","sustainableCampusDescription":"Early in the design phase, we align with world-class standards to integrate ESG principles into planning and construction. During the operational phase, we prioritize smart energy management, clean energy transition, and resource circularity to reduce our carbon footprint and build a sustainable future together with our employees.","SustainableCampusActionResultTitle":"Progress","CampusActionResultTitle1":"Carbon neutrality","CampusActionResultTitle1Unit":"","CampusActionResultTitle1Desc":"Four campuses have been certified as carbon-neutral.","CampusActionResultTitle2":"521,000","CampusActionResultTitle2Unit":"square meters","CampusActionResultTitle2Desc":" Around 521,000 square meters of floor area has received the LEED Gold certification.","CampusActionResultTitle3":"36.7","CampusActionResultTitle3Unit":"%","CampusActionResultTitle3Desc":"Emissions per unit of area on our self-used office campuses fell by 36.7% year on year.","CampusActionResultTitle4prefix":"","CampusActionResultTitle4":"110,248","CampusActionResultTitle4Unit":"","CampusActionResultTitle4Desc":"110,248 employees engaged in low-carbon-friendly practices through the Youxin platform.","campusReduceWasteReuseTab":"Waste management","CarbonNeutralPark":"Carbon neutrality","CarbonNeutralParkDesc":"We embed low-carbon practices throughout the full lifecycle of campus management.  Our Xixi Campus Park A in Hangzhou, a LEED Platinum benchmark, integrates natural ecology with digital governance. From the planning stage, we maximize the preservation of natural elements, maintaining the wetland ecosystem\'s integrity via ecological engineering. To support our carbon neutrality pledge, we leverage our proprietary \\"Equipment Brain\\" for smart energy management, regulating usage with precise algorithms. Furthermore, photovoltaic panels now power all streetlights on our campuses.","CarbonNeutralParkPracticeTitle":"Methodology","campusTechEfficiencyTab":"Tech-driven efficiency","campusResourceTransformTab":"Resource transition","campusEmployeePracticeTab":"Low-carbon practices","campusSmartEquipmentTitle":"Smart operations","campusSmartEquipmentDesc":"We embed AI into campus operations to drive decarbonization. In FY2026, our AI-powered energy management system, the Equipment Brain, helped reduce emissions by 7,121.4 tons.","campusCleanElectricityTitle":"Clean electricity substitution","campusCleanElectricityDesc":"The deployment of distributed PV on suitable campuses and our participation in clean electricity trading brought the share of clean electricity across self-used office campuses and leased-out properties to 69.30% in FY2026.","campusElectrificationTitle":"Electrification","campusElectrificationDesc":"We have transitioned our campus shuttle fleet to electric vehicles and expanded our charging infrastructure.","campusVirtualPowerPlantTitle":"Virtual power plants","campusVirtualPowerPlantDesc":"We have established multi-energy complementary microgrids by integrating self-built distributed PV with energy storage. Leveraging intelligent dispatching and coordinated management of distributed energy resources, these systems maximize our clean electricity consumption while unlocking the potential of demand-side response to mitigate supply-demand imbalances on the power grid. In FY2026, source-grid-load-storage virtual power plants on our campus responded to demand from local power grids 16 times.","campusOfficeEmissionsTitle":"Workplace","campusOfficeEmissionsDesc":"Our Youxin platform incentivizes sustainable office habits, from turning off lights in unoccupied areas to printing documents on both sides. This helps foster energy conservation awareness among our employees. In FY2026, 107,682 employees engaged in green, low-carbon practices 2,876,540 times through the Youxin platform.","campusTravelEmissionsTitle":"Mobility","campusTravelEmissionsDesc":"Our Huanxing platform motivates employees to reduce emissions during their daily mobility, promoting energy-saving behavior such as carpooling. In FY2026, 60,258 employees engaged in low-carbon mobility 1,134,200 times through the Huanxing platform, contributing nearly 6,989.3 tons of emissions reduction.","campusSpongeCityTitle":"Sponge City philosophy","campusSpongeCityDesc":"Water conservation is integrated into campus design from the very beginning. For newly built campuses, we adopt the sponge city philosophy. It empowers cities to act like sponges with the capacity to absorb, store, infiltrate, and purify water. This allows for an effective response to water shortages, flooding, and water pollution.\\nOur Xixi Campus Park C in Hangzhou and Beijing campus both follow this philosophy. They utilize permeable paving to allow rainwater to naturally percolate into the ground. Additionally, they have rainwater collection systems to recycle runoff from rooftops and ground surfaces.","campusWaterConservationTitle":"Methodology","campusWaterSavingTitle":"Measurement","campusWaterSavingDesc":"We have established a water management platform that utilizes digital monitoring to achieve granular control over consumption, thereby enhancing resource efficiency and supporting sustainable operations.","campusWaterRecyclingTitle":"Management","campusWaterRecyclingDesc":"We have developed a smart water management system built around a \\"monitor-conserve-recycle\\" framework. To improve water efficiency systematically, we have deployed smart water meters, upgraded to Class 1 water-efficient fixtures, and established a recycling network for air conditioning condensate as well as wastewater from direct drinking water systems. In FY2026, we expanded water recycling retrofits across self-used office campuses, yielding 58,471 cubic meters of reclaimed water.","campusZeroWasteTitle":"Waste minimization","campusZeroWasteDesc":"We manage our waste impact through a rigorous process where we track, measure, and audit our waste footprint. To drive the circular economy, we adopt a two-pronged approach that centers on \\"reduction\\" to minimize waste generation and \\"waste-to-resource conversion\\" to treat and recycle waste.","campusWasteManagementTitle":"Methodology","campusEffectiveWasteTitle":"Measurement","campusEffectiveWasteDesc":"For all components of our environmental footprint, we believe that what cannot be measured cannot be managed. Waste management is no exception. On our self-used office campuses, we have digitalized waste management to gain visibility into our waste footprint and inform our management initiatives.","campusWasteRecyclingTitle":"Recycling","campusWasteRecyclingDesc":"We apply the philosophy of waste recycling across our campuses, aiming to minimize the amount of waste sent to landfills. In FY2026, our Beijing campus recycled 100% of its kitchen waste, which was converted into organic fertilizer through bio-fermentation.","campusWasteComplianceTitle":"Disposal","campusWasteComplianceDesc":"We uphold a fundamental principle of 100% compliant waste disposal. This involves partnering with qualified suppliers, tracking the entire process, and documenting the results.","campusBiophilicTitle":"Eco-friendliness","campusBiophilicDesc":"Our Xixi Campus Park C in Hangzhou, adjacent to the Xixi National Wetland Park, is home to rich biodiversity and a vibrant ecosystem. The campus features 3.2 hectares of natural water bodies and hosts over 100 plant species. Its design preserves most of the original wetlands and waterways, allowing nature to be seamlessly interwoven with the office complex. It is both a high-tech hub and a thriving natural ecosystem.","campusBiodiversityTitle":"Methodology","campusSiteSelectionTitle":"Site selection and design","campusSiteSelectionDesc":"All newly built office campuses undergo environmental impact assessments during the site selection and design phases.","campusOperationPhaseTitle":"Campus operations","campusOperationPhaseDesc":"We are committed to biodiversity preservation and ecosystem management. To create a multi-layered vegetation structure, we introduce diverse plant species, with an emphasis on native varieties. We also build ecological corridors by integrating natural habitats into campus environments or restoring degraded ones. Furthermore, we leverage landscaping to reduce light pollution and noise, thereby minimizing disturbances to animals\' life cycles.","governanceStructure":"Governance structure","managementSystem":"Management system","governanceDescription":"In 2021, we established a three-layer ESG governance framework involving the Board of Directors, the management, and working groups to ensure the effective implementation of our ESG initiatives. In FY2025, under the guidance of the Sustainability Committee, we kept deepening our ESG management system in a Plan-Do-Check-Act (PDCA) cycle.","ESGSuggestions":"Your suggestions regarding ESG","contactESG":"Please contact us at: ESG@alibaba-inc.com","intelligentOperationAlgorithm":"Intelligent O&M algorithm","intelligentOperationAlgorithmDescription":"Alibaba Cloud\'s intelligent O&M strategy integrates electrical, HVAC, and control expertise for precise optimization. As of March 31, 2026, the intelligent O&M algorithm had been deployed across 24 self-built data centers."}')},25392:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u62a5\u544a","otherReports":"\u5404\u7c7b\u62a5\u544a","esgNewsViews":"ESG\u65b0\u95fb\u53ca\u89c2\u70b9","esgRatingsAwards":"ESG\u8bc4\u7ea7\u548c\u5956\u9879","esgPolicies":"ESG\u653f\u7b56","bannerSlogan":"\u8d1f\u8d23\u4efb\u7684\u79d1\u6280\uff0c\u53ef\u6301\u7eed\u7684\u672a\u6765","letterTitle":"\u9996\u5e2d\u6267\u884c\u5b98\u7684\u4e00\u5c01\u4fe1","letterContent":"\u8fc7\u53bb\u4e00\u5e74\uff0c\u6211\u4eec\u63d0\u5347AI\u6280\u672f\u80fd\u529b\uff0c\u4e5f\u5341\u5206\u5173\u6ce8\u6280\u672f\u5411\u5584\u3002\u963f\u91cc\u5df4\u5df4\u91cd\u8981\u6a21\u578b\u8d21\u732e\u5ea6\u88ab\u8bc4\u4e3a\u5168\u7403\u7b2c\u4e09\uff0c\u57fa\u4e8eQwen\u6a21\u578b\u5f00\u53d1\u7684\u884d\u751f\u6a21\u578b\u5728Hugging Face\u5e73\u53f0\u7d2f\u8ba1\u8d85\u8fc7100000\u4e2a\uff1b\u8fbe\u6469\u9662AI\u591a\u764c\u65e9\u7b5b\u6280\u672f\u5728\u56fd\u5185\u4e0d\u5c11\u53bf\u57df\u8bd5\u70b9\u843d\u5730\u30022025\u5e74\uff0c\u4e5f\u662f\u516c\u53f8\u63d0\u51fa\\"\u4eba\u4eba\u4e09\u5c0f\u65f6\\"\u516c\u76ca\u5021\u8bae\u5341\u5468\u5e74\uff0c\u6211\u4eec\u5df2\u7d2f\u8ba1\u6d3e\u51fa34\u4f4d\u4e61\u6751\u7279\u6d3e\u5458\u6df1\u5165\u5168\u56fd29\u4e2a\u53bf\u57df\uff1b\u8fc7\u53bb\u4e00\u5e74\uff0c\u9ad8\u5fb7\\"\u8f6e\u6905\u5bfc\u822a\\"\u63d0\u4f9b\u4e86\u8d851\u4ebf\u6b21\u65e0\u969c\u788d\u8def\u7ebf\u89c4\u5212\u548c\u89c6\u969c\u5bfc\u822a\u670d\u52a1\uff1b\u6dd8\u5b9d\u95ea\u8d2d\\"\u65e0\u58f0\u9a91\u58eb\\"\u9879\u76ee\u5e2e\u52a9\u8d854200\u540d\u542c\u969c\u4eba\u58eb\u987a\u5229\u5c31\u4e1a\u2026\u5341\u5e74\u7684\u884c\u52a8\u8ba9\u6211\u4eec\u76f8\u4fe1\uff1a\u6709\u5173\u5fc3\u771f\u5b9e\u95ee\u9898\u7684\u5458\u5de5\uff0c\u624d\u80fd\u6253\u9020\u51fa\u6709\u6e29\u5ea6\u7684\u4ea7\u54c1\uff0c\u4ece\u800c\u6210\u5c31\u4e00\u5bb6\u8d1f\u8d23\u4efb\u7684\u4f01\u4e1a\u3002\\n","letterContent2":"\u6211\u4eec\u4e5f\u5e0c\u671b\uff0c\u6709\u8d8a\u6765\u8d8a\u591a\u7684\u540c\u884c\u8005\u5171\u540c\u63a2\u7d22\u53ef\u6301\u7eed\u53d1\u5c55\u7684\u672a\u6765\uff0c\u5171\u540c\u521b\u9020\u5546\u4e1a\u4e4b\u4e0a\u7684\u4ef7\u503c\uff0c\u5efa\u8bbe\u4e00\u4e2a\u5065\u5eb7\u3001\u5b8c\u5584\u3001\u5171\u8363\u7684\u53ef\u6301\u7eed\u7684\u751f\u6001\u3002","leader":"\u5434\u6cf3\u94ed","ceo":"\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u9996\u5e2d\u6267\u884c\u5b98  \u5434\u6cf3\u94ed","alibaba":"\u963f\u91cc\u4e91\u667a\u80fd\u96c6\u56e2\u8463\u4e8b\u957f\u517c\u9996\u5e2d\u6267\u884c\u5b98","LatestESGReport":"\u6700\u65b0ESG\u62a5\u544a","letterContentFirst":"ESG\u662f\u4e00\u628a\u91cd\u8981\u6807\