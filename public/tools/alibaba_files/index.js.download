\u5883\u5206\u6790\uff0c\u6211\u5011\u8b58\u5225\u6c23\u5019\u76f8\u95dc\u98a8\u96aa\u548c\u6a5f\u6703\uff0c\u8a55\u4f30\u5176\u6f5b\u5728\u696d\u52d9\u548c\u8ca1\u52d9\u5f71\u97ff\uff0c\u5236\u5b9a\u7ba1\u7406\u65b9\u6848\uff0c\u9032\u884c\u6c23\u5019\u6e1b\u7de9\u548c\u9069\u61c9\u884c\u52d5\u4e26\u5b9a\u671f\u8a55\u4f30\u63aa\u65bd\u7684\u6709\u6548\u6027\uff0c\u540c\u6642\u7a4d\u6975\u63a2\u7d22\u6c23\u5019\u8b8a\u9077\u80cc\u666f\u4e0b\u7684\u5546\u696d\u6a5f\u9047\uff0c\u5354\u52a9\u5efa\u69cb\u66f4\u6709\u6c23\u5019\u97cc\u6027\u7684\u793e\u5340\u548c\u793e\u6703\u3002","clickToLearnMore":"\u9ede\u64ca\u6b64\u8655","moreAction":"\u4e86\u89e3\u66f4\u591a\u6c23\u5019\u6e1b\u7de9\u884c\u52d5\u3002","tabAssessment":"\u8b58\u5225\u548c\u8a55\u4f30\u6c23\u5019\u98a8\u96aa\u8207\u6a5f\u9047","tabAction":"\u958b\u5c55\u6c23\u5019\u9069\u61c9\u8207\u6e1b\u7de9\u884c\u52d5","mainTitle":"\u91cd\u8981\u6c23\u5019\u98a8\u96aa\u8207\u6a5f\u9047\u53ca\u5176\u6f5b\u5728\u696d\u52d9\u548c\u8ca1\u52d9\u5f71\u97ff","subTitle":"\u6c23\u5019\u60c5\u666f\u8aaa\u660e","scenarioDescription":"\u7d50\u5408\u963f\u91cc\u5df4\u5df4\u7684\u96fb\u5546\u5e73\u53f0\u3001\u96f2\u8a08\u7b97\u548c\u7269\u6d41\u7b49\u696d\u52d9\u7684\u884c\u696d\u7279\u9ede\u3001\u71df\u904b\u6a21\u5f0f\u548c\u5730\u57df\u5206\u4f48\uff0c\u6211\u5011\u8b58\u5225\u8207\u8a55\u4f30\u91cd\u5927\u6c23\u5019\u76f8\u95dc\u98a8\u96aa\u8207\u6a5f\u9047\uff0c\u53ca\u5176\u6f5b\u5728\u696d\u52d9\u548c\u8ca1\u52d9\u5f71\u97ff\u3002\u5728\u60c5\u666f\u5206\u6790\u7684\u9078\u64c7\u4e0a\uff0c\u91dd\u5c0d\u7269\u7406\u98a8\u96aa\uff0c\u6211\u5011\u9078\u64c7IPCC \u7b2c\u516d\u6b21\u8a55\u4f30\u5831\u544a\u5171\u4eab\u793e\u6703\u7d93\u6fdf\u8def\u5f91\uff08IPCC AR6 SSP\uff09\u4e2d\u7684\u4f4e\u78b3\u60c5\u666f\uff08SSP1-2.6\uff09\u548c\u9ad8\u78b3\u60c5\u666f\uff08SSP3-7.0\u3001SSP5-8.5\uff09\uff1b\u91dd\u5c0d\u8f49\u578b\u98a8\u96aa\u548c\u8f49\u578b\u6a5f\u9047\uff0c\u6211\u5011\u9078\u64c7IEA\u7684\u4f4e\u78b3\u60c5\u666f\uff08\u6de8\u96f6\u6392\u653e\u60c5\u666f NZE\uff09\u548c\u9ad8\u78b3\u60c5\u666f\uff08\u65e2\u5b9a\u653f\u7b56\u60c5\u666fSTEPS\uff09\u3002","columnRisk":"\u6c23\u5019\u98a8\u96aa\u8207\u6a5f\u9047","columnImpact":"\u6f5b\u5728\u696d\u52d9\u8207\u8ca1\u52d9\u5f71\u97ff","columnTimeframe":"\u6642\u9593\u7bc4\u570d","physicalRisks":"\u7269\u7406\u98a8\u96aa","transitionRisks":"\u8f49\u578b\u98a8\u96aa","opportunities":"\u8f49\u578b\u6a5f\u9047","shortTerm":"\u77ed\u671f","mediumTerm":"\u4e2d\u671f","longTerm":"\u9577\u671f","banner":{"title":"\u61c9\u5c0d\u6c23\u5019\u8b8a\u5316","description":"\u6211\u5011\u6301\u7e8c\u5f37\u5316\u6c23\u5019\u6cbb\u7406\uff0c\u5be9\u95b1\u4e26\u512a\u5316\u6c23\u5019\u6230\u7565\uff0c\u7ba1\u7406\u6c23\u5019\u76f8\u95dc\u98a8\u96aa\u8207\u6a5f\u9047\u3002"},"riskData":{"extremeHeat":{"title":"\u6025\u6027-\u6975\u7aef\u9ad8\u6eab","description":"\u2022 \u51b7\u537b\u9700\u6c42\u53ca\u96fb\u8cbb\u589e\u52a0\uff0c\u7269\u6d41\u8ca8\u7269\u8b8a\u8cea\u6216\u5ef6\u8aa4\u88dc\u511f\u589e\u52a0\uff0c\u63a8\u5347\u71df\u904b\u6210\u672c\u3002\\n\u2022 \u589e\u52a0\u6216\u66f4\u63db\u88fd\u51b7\u8a2d\u5099\u5b89\u88dd\u9700\u6c42\uff0c\u63a8\u5347\u8cc7\u672c\u652f\u51fa\u3002\\n\u2022 \u4f9b\u96fb\u53ca\u51b7\u537b\u7cfb\u7d71\u6545\u969c\u3001\u9650\u96fb\u6216\u505c\u96fb\uff0c\u5f71\u97ff\u96f2\u670d\u52d9\u548c\u7269\u6d41\uff0c\u9593\u63a5\u5f71\u97ff\u963f\u91cc\u5df4\u5df4\u751f\u614b\u4e2d\u5176\u4ed6\u696d\u52d9\uff0c\u71df\u696d\u6536\u5165\u4e0b\u964d\u6216\u589e\u52a0\u8ce0\u511f\u652f\u51fa\u3002\\n\u2022 \u589e\u52a0\u6236\u5916\u5de5\u4f5c\u4eba\u54e1\u7684\u5065\u5eb7\u98a8\u96aa\uff0c\u5e36\u4f86\u9ad8\u6eab\u88dc\u8cbc\u6216\u91ab\u7642\u652f\u51fa\u589e\u52a0\u3002"},"floodCyclone":{"title":"\u6025\u6027 - \u6d2a\u6f87\u8207\u71b1\u5e36\u6c23\u65cb","description":"\u2022 \u640d\u58de\u57fa\u790e\u8a2d\u65bd\u3001\u4f9b\u96fb\u7cfb\u7d71\u548c\u8a2d\u5099\uff0c\u9020\u6210\u8cc7\u7522\u6e1b\u503c\uff0c\u589e\u52a0\u7dad\u4fee\u548c / \u6216\u8cc7\u672c\u958b\u652f\u3002\\n\u2022 \u7269\u6d41\u904b\u8f38\u6548\u7387\u4e0b\u964d\u800c\u51fa\u73fe\u5ef6\u8aa4\uff0c\u589e\u52a0\u76f8\u95dc\u8ce0\u511f\u652f\u51fa\u3002\\n\u2022 \u4f9b\u96fb\u6216\u51b7\u537b\u7cfb\u7d71\u6545\u969c\u3001\u9650\u96fb\u6216\u505c\u96fb\uff0c\u5f71\u97ff\u96f2\u670d\u52d9\u548c\u7269\u6d41\uff0c\u9593\u63a5\u5f71\u97ff\u963f\u91cc\u5df4\u5df4\u751f\u614b\u4e2d\u5176\u4ed6\u696d\u52d9\uff0c\u71df\u696d\u6536\u5165\u4e0b\u964d\u6216\u589e\u52a0\u8ce0\u511f\u652f\u51fa\u3002"},"waterDrought":{"title":"\u6162\u6027 -\u6c34\u58d3\u529b\u8207\u4e7e\u65f1","description":"\u2022 \u63a1\u53d6\u5c11\u6c34\u6216\u7121\u6c34\u88fd\u51b7\u6280\u8853\u65b9\u6848\uff0c\u88fd\u51b7\u6548\u7387\u77ed\u671f\u6709\u6240\u964d\u4f4e\uff0c\u63d0\u5347\u71df\u904b\u6210\u672c\u3002"},"policyRegulation":{"title":"\u653f\u7b56\u8207\u6cd5\u898f\u98a8\u96aa","description":"\u2022 \u4f4e\u78b3\u60c5\u666f\u4e0b\uff0c\u6c23\u5019\u653f\u7b56\uff08\u4f8b\u5982\u570b\u969b\u548c\u4e2d\u570b\u7684\u78b3\u6392\u653e\u4ea4\u6613\u9ad4\u7cfb\u548c\u80fd\u6e90\u76f8\u95dc\u7684\u653f\u7b56\uff09\u6301\u7e8c\u5f37\u5316\uff0c\u96f2\u8a08\u7b97\u3001\u7269\u6d41\u7b49\u884c\u696d\u9762\u81e8\u66f4\u70ba\u56b4\u683c\u7684\u76e3\u7ba1\u7d04\u675f\uff0c\u589e\u52a0\u71df\u904b\u6210\u672c\u548c\u8cc7\u672c\u652f\u51fa\uff1b\u6216\u900f\u904e\u4f9b\u61c9\u93c8\u50b3\u5c0e\u9593\u63a5\u5f71\u97ff\u696d\u52d9\u7684\u6210\u672c\u7d50\u69cb\u8207\u5e02\u5834\u7af6\u722d\u529b\uff0c\u589e\u52a0\u71df\u904b\u6210\u672c\u3002\\n\u2022 \u4e0a\u5e02\u5730\u53ca\u71df\u904b\u6240\u5728\u53f8\u6cd5\u7ba1\u8f44\u5340\u5c0d\u6c23\u5019\u8cc7\u8a0a\u62ab\u9732\u653f\u7b56\u65e5\u76ca\u56b4\u683c\uff0c\u589e\u52a0\u76f8\u95dc\u5408\u898f\u6210\u672c\u3002"},"technologyRisk":{"title":"\u6280\u8853\u98a8\u96aa","description":"\u2022 \u4f4e\u78b3\u60c5\u666f\u4e0b\uff0c\u96f2\u8a08\u7b97\u3001\u7269\u6d41\u7b49\u696d\u52d9\u5be6\u73fe\u8f49\u578b\u9700\u8981\u8f03\u591a\u4f4e\u78b3\u6280\u8853\u7814\u767c\u3001\u8a2d\u5099\u7f6e\u63db\uff0c\u5de5\u7a0b\u5be6\u65bd\u7b49\u76f8\u95dc\u7684\u8cc7\u672c\u652f\u51fa\uff0c\u540c\u6642\u4e5f\u53ef\u80fd\u9020\u6210\u8cc7\u7522\u6e1b\u503c\u3002"},"reputationRisk":{"title":"\u8072\u8b7d\u98a8\u96aa","description":"\u2022 \u5916\u90e8\u5c0d\u6c23\u5019\u61c9\u5c0d\u548c\u6e1b\u6392\u9032\u5c55\u95dc\u6ce8\u589e\u52a0\uff0c\u9700\u8981\u4ed8\u51fa\u66f4\u591a\u6e1b\u6392\u52aa\u529b\u3001\u66f4\u9ad8\u7684\u62ab\u9732\u548c\u6e9d\u901a\u6210\u672c\u4f86\u589e\u5f37\u5229\u76ca\u76f8\u95dc\u8005\u7684\u4fe1\u5fc3\uff0c\u4fdd\u969c\u6d88\u8cbb\u8005\u548c\u5ba2\u6236\u5fe0\u8aa0\u5ea6\u548c\u81ea\u8eab\u878d\u8cc7\u80fd\u529b\u3002"},"resourceEfficiency":{"title":"\u8cc7\u6e90\u6548\u7387\u6a5f\u9047","description":"\u2022\u7a4d\u6975\u52a0\u5927\u8cc7\u6e90\u63d0\u6548\u6280\u8853\u61c9\u7528\uff0c\u53ef\u5728\u5be6\u73fe\u6e1b\u78b3\u7684\u540c\u6642\u6e1b\u5c11\u71df\u904b\u652f\u51fa\uff1b\u5728\u4f4e\u78b3\u8f49\u578b\u904e\u7a0b\u4e2d\uff0c\u77ed\u671f\u5167\uff0c\u66f4\u65e9\u61c9\u7528\u9084\u6709\u53ef\u80fd\u5e36\u4f86\u66f4\u591a\u6a5f\u9047\u3002"},"productService":{"title":"\u7522\u54c1\u8207\u670d\u52d9\u6a5f\u9047","description":"\u2022 \u96a8\u8457\u6d88\u8cbb\u8005\u3001\u5ba2\u6236\u53ca\u5408\u4f5c\u5925\u4f34\u4f4e\u78b3\u610f\u8b58\u4e0d\u65b7\u589e\u5f37\uff0c\u5e02\u5834\u5c0d\u4f4e\u78b3\u7522\u54c1\u8207\u670d\u52d9\u7684\u9700\u6c42\u6301\u7e8c\u6500\u5347\uff0c\u6355\u6349\u5e02\u5834\u8da8\u52e2\uff0c\u8fc5\u901f\u97ff\u61c9\u5e02\u5834\u9700\u6c42\uff0c\u6191\u85c9\u7da0\u8272\u6d88\u8cbb\u54c1\uff0c\u96f2\u670d\u52d9\u3001\u7269\u6d41\u7b49\u591a\u5143\u696d\u52d9\u4f48\u5c40\uff0c\u53ef\u63d0\u9ad8\u5e02\u5834\u7af6\u722d\u529b\u3002\\n\u2022 \u4f9d\u8a17\u5305\u62ec\u4eba\u5de5\u667a\u80fd\u5728\u5167\u7684\u6578\u5b57\u6280\u8853\uff0c\u70ba\u5404\u884c\u696d\u63d0\u4f9b\u4f4e\u78b3\u89e3\u6c7a\u65b9\u6848\uff0c\u6df1\u5ea6\u8ce6\u80fd\u793e\u6703\u5be6\u73fe\u4f4e\u78b3\u8f49\u578b"}},"actionData":{"infrastructure":{"type":"\u57fa\u790e\u8a2d\u65bd","description":"\u6211\u5011\u6ce8\u91cd\u95dc\u9375\u57fa\u790e\u8a2d\u65bd\u7684\u6574\u500b\u751f\u547d\u5468\u671f\u707d\u5bb3\u9632\u8b77\u6c34\u5e73\u3002\\n\u2022 \u8a2d\u8a08\u548c\u5efa\u9020:\u8fa6\u516c\u5712\u5340\u5728\u9078\u5740\u968e\u6bb5\u5145\u5206\u8003\u616e\u6c23\u5019\u98a8\u96aa\uff0c\u8a2d\u8a08\u5efa\u9020\u904e\u7a0b\u4e2d\u878d\u5165\u6c23\u5019\u97cc\u6027\u7406\u5ff5\uff0c\u63a1\u7528\u6d77\u7dbf\u57ce\u5e02\u57ce\u5e02\u8a2d\u8a08\u539f\u5247\uff0c\u6709\u6548\u61c9\u5c0d\u96e8\u6c34\u7ba1\u7406\u6311\u6230;\u6578\u64da\u4e2d\u5fc3\u5efa\u9020\u904e\u7a0b\u4e2d\uff0c\u5145\u5206\u8003\u616e\u6f5b\u5728\u81ea\u7136\u707d\u5bb3\u98a8\u96aa\u56e0\u7d20\uff0c\u900f\u904e\u786c\u4ef6\u8a2d\u65bd\u7684\u8a2d\u8a08\u4ee5\u53ca\u6574\u9ad4\u4f48\u5c40\u898f\u5283(\u4f8b\u5982\u5728\u6d2a\u6f87\u9ad8\u767c\u5340\u57df\u63d0\u9ad8\u5ba4\u5167\u9ad8\u5ea6\uff0c\u5c07\u95dc\u9375\u8a2d\u5099\u653e\u7f6e\u65bc\u975e\u9996\u5c64\u5340\u57df)\uff0c\u589e\u5f37\u5bb9\u707d\u548c\u5bb9\u932f\u80fd\u529b\u3002\\n\u2022 \u61c9\u6025\u7269\u8cc7\u548c\u8a2d\u5099:\u90e8\u7f72\u9632\u6c34\u9598\u548c\u9632\u6c5b\u6c99\u888b\uff0c\u4f5c\u70ba\u65e5\u5e38\u6d2a\u6f87\u98b1\u98a8\u7ba1\u7406\u7684\u57fa\u790e\u914d\u7f6e;\u6578\u64da\u4e2d\u5fc3\u914d\u5099\u4e0d\u9593\u65b7\u61c9\u6025\u96fb\u6e90\u548c\u67f4\u6cb9\u767c\u96fb\u8a2d\u5099\u3002\\n\u2022 \u8a2d\u65bd\u71df\u904b\u7dad\u8b77:\u8fa6\u516c\u5712\u5340\u5728\u71df\u904b\u7dad\u8b77\u968e\u6bb5\u5efa\u7acb\u5b8c\u5584\u7684\u8a2d\u65bd\u7ba1\u7406\u7cfb\u7edf\uff0c\u5b9a\u671f\u68c0\u67e5\u7ef4\u62a4\u9ad8\u6548\u6392\u6c34\u7cfb\u7d71\u3001\u4e0b\u51f9\u5f0f\u7da0\u5730\u3001\u900f\u6c34\u92ea \u88dd\u7b49\u6c23\u5019\u9069\u61c9\u578b\u57fa\u790e\u8a2d\u65bd\u3002"},"operation":{"type":"\u71df\u904b","description":"\u6211\u5011\u5236\u5b9a\u5168\u6d41\u7a0b\u7684\u9632\u63a7\u9810\u6848\uff0c\u6db5\u84cb\u4e8b\u524d\u6e96\u5099\u3001\u4e8b\u4e2d\u57f7\u884c\u53ca\u4e8b\u5f8c\u6062\u5fa9\uff0c\u4ee5\u4fdd\u969c\u96fb\u5546\u3001\u96f2\u7aef\u3001\u7269\u6d41\u7b49\u696d\u52d9\u71df\u904b\u7684\u9023\u7e8c\u6027\u3002\u6211\u5011\u5efa\u7acb\u5206\u7d1a\u9810\u8b66\u9ad4\u7cfb\uff0c\u7d50\u5408\u6c23\u8c61\u76e3\u63a7\u6578\u64da\u63d0\u524d\u8b58\u5225\u6f5b\u5728\u98a8\u96aa;\u91dd\u5c0d\u4e0d\u540c\u6975\u7aef\u5929\u6c23\u985e\u578b(\u4f8b\u5982\u98b1\u98a8\u3001\u66b4\u96ea\u3001\u51cd\u96e8)\uff0c\u5b8c\u5584\u65e9\u671f\u9810\u8b66\u3001\u4e0a\u5831\u6d41\u7a0b\u548c\u5206\u985e\u5c08\u9805\u97ff\u61c9\u8a08\u5283\u3002"},"personnel":{"type":"\u4eba\u54e1","description":"\u6211\u5011\u5f9e\u4f5c\u696d\u74b0\u5883\u3001\u65e5\u5e38\u7ba1\u7406\u548c\u57f9\u8a13\u4e09\u500b\u65b9\u9762\u63d0\u5347\u4eba\u54e1\u7684\u6975\u7aef\u5929\u6c23\u9069\u61c9\u80fd\u529b\u3002\\n\u2022 \u4f5c\u696d\u74b0\u5883:\u512a\u5316\u8fa6\u516c\u5712\u5340\u3001\u7269\u6d41\u5009\u5eab\u7b49\u5be6\u969b\u4f5c\u696d\u74b0\u5883\uff0c\u4ee5\u4fdd\u969c\u4eba\u54e1\u5728\u5408\u9069\u7684\u74b0\u5883\u4e2d\u5de5\u4f5c\uff0c\u70ba\u9a0e\u624b\u548c\u9a0e\u624b\u63d0\u4f9b\u9632\u6691\u964d\u6eab\u7a7a\u9593\u548c\u7269\u8cc7\u7b49\u3002\\n\u2022 \u7ba1\u7406:\u5408\u7406\u5b89\u6392\u54e1\u5de5\u8f2a\u73ed\u8207\u4f11\u606f\u6642\u9593\uff0c\u843d\u5be6\u6975\u7aef\u5929\u6c23\u61c9\u5c0d\u65b9\u6848\uff0c\u6e1b\u5c11\u9ad8\u6eab\u7b49\u6975\u7aef\u5929\u6c23\u66b4\u9732\u5c0d\u5065\u5eb7\u7684\u4e0d\u5229\u5f71\u97ff\u3002\\n\u2022 \u57f9\u8a13:\u5b9a\u671f\u9032\u884c\u6975\u7aef\u5929\u6c23\u61c9\u6025\u6f14\u7df4\uff0c\u4ee5\u78ba\u4fdd\u54e1\u5de5\u80fd\u5920\u8fc5\u901f\u6709\u6548\u5730\u57f7\u884c\u61c9\u6025\u9810\u6848\u3002"},"supplyChain":{"type":"\u4f9b\u61c9\u93c8","description":"\u6211\u5011\u63a1\u53d6\u591a\u5143\u5316\u7b56\u7565\u7d50\u5408\u7db2\u7d61\u512a\u5316\u898f\u5283\uff0c\u63d0\u5347\u4f9b\u61c9\u93c8\u7684\u6c23\u5019\u97cc\u6027\u3002\u6839\u64da\