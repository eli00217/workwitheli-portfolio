9\u7684\u6700\u7ec8\u5904\u7406\u7ed3\u679c\u4ee5\u4fdd\u8bc1\u5408\u89c4\u3002","campusBiophilicTitle":"\u751f\u6001\u53cb\u597d\u56ed\u533a","campusBiophilicDesc":"\u963f\u91cc\u5df4\u5df4\u676d\u5dde\u897f\u6eaa\u56ed\u533aA\u533a\uff0c\u6bd7\u90bb\u897f\u6eaa\u56fd\u5bb6\u6e7f\u5730\u516c\u56ed\uff0c\u7269\u79cd\u4e30\u5bcc\uff0c\u751f\u673a\u52c3\u52c3\u3002\u56ed\u533a\u5185\u73b0\u67093.2 \u516c\u9877\u81ea\u7136\u6c34\u4f53\u53ca100 \u591a\u79cd\u690d\u7269\u3002\u8bbe\u8ba1\u4e2d\u4fdd\u7559\u539f\u6709\u5927\u90e8\u5206\u6e7f\u5730\u53ca\u6cb3\u6d41\uff0c\u81ea\u7136\u4e0e\u529e\u516c\u5efa\u7b51\u7fa4\u843d\u878d\u4e3a\u4e00\u4f53\u3002\u5b83\u65e2\u662f\u4e00\u4e2a\u9ad8\u79d1\u6280\u56ed\u533a\uff0c\u4e5f\u662f\u4e2a\u81ea\u7136\u751f\u6001\u7cfb\u7edf\u3002","campusBiodiversityTitle":"\u4fdd\u62a4\u751f\u7269\u591a\u6837\u6027","campusSiteSelectionTitle":"\u9009\u5740\u8bbe\u8ba1\u9636\u6bb5","campusSiteSelectionDesc":"\u5728\u9009\u5740\u548c\u8bbe\u8ba1\u9636\u6bb5\uff0c\u65b0\u5efa\u56ed\u533a\u5747\u5b8c\u6210\u73af\u5883\u5f71\u54cd\u8bc4\u4ef7\u3002","campusOperationPhaseTitle":"\u8fd0\u8425\u9636\u6bb5","campusOperationPhaseDesc":"\u6211\u4eec\u6ce8\u91cd\u751f\u7269\u591a\u6837\u6027\u4fdd\u62a4\u548c\u751f\u6001\u7cfb\u7edf\u7ba1\u7406\uff0c\u4f7f\u7528\u672c\u571f\u7269\u79cd\u3001\u591a\u5143\u5316\u690d\u7269\u79cd\u7c7b\u4e30\u5bcc\u690d\u88ab\u7ed3\u6784\u5c42\u6b21\uff0c\u5f15\u5165\u6216\u6062\u590d\u81ea\u7136\u6816\u606f\u5730\uff0c\u6253\u9020\u751f\u6001\u5eca\u9053\uff0c\u5e76\u901a\u8fc7\u666f\u89c2\u624b\u6bb5\u51cf\u5c11\u5149\u6c61\u67d3\u4e0e\u566a\u97f3\u6c61\u67d3\uff0c\u4fdd\u969c\u52a8\u7269\u751f\u6d3b\u8282\u5f8b\u3002","governanceStructure":"\u6cbb\u7406\u67b6\u6784","managementSystem":"\u7ba1\u7406\u4f53\u7cfb","governanceDescription":"\u81ea2021\u5e74\u8d77\uff0c\u6211\u4eec\u901a\u8fc7\u8463\u4e8b\u4f1a\u3001\u7ba1\u7406\u5c42\u548c\u5de5\u4f5c\u7ec4\u7684\u4e09\u5c42 ESG\u6cbb\u7406\u67b6\u6784\u6765\u4fdd\u969c\u54