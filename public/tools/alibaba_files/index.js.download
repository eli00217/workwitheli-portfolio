"campusOfficeEmissionsDesc":"\u6211\u5011\u900f\u904e\u71df\u904b\u300c\u6709\u5fc3\u300d\u4f86\u5e36\u52d5\u54e1\u5de5\u5728\u8fa6\u516c\u5834\u666f\u53c3\u8207\u7bc0\u80fd\u6e1b\u6392\uff0c\u63d0\u5347\u54e1\u5de5\u6574\u9ad4\u7bc0\u80fd\u610f\u8b58\uff0c\u63a8\u52d5\u54e1\u5de5\u8e10\u884c\u96a8\u624b\u95dc\u71c8\u3001\u96d9\u9762\u5217\u5370\u7b49\u30022026\u8ca1\u5e74\uff0c107,682\u540d\u54e1\u5de5\u900f\u904e\u300c\u6709\u5fc3\u300d\u53c3\u8207\u5b8c\u62102,876,540\u6b21\u7da0\u8272\u4f4e\u78b3\u53cb\u597d\u884c\u70ba\u3002","campusTravelEmissionsTitle":"\u51fa\u884c\u74b0\u7bc0","campusTravelEmissionsDesc":"\u6211\u5011\u900f\u904e\u71df\u904b\u300c\u6b61\u884c\u300d\u5e73\u81fa\uff0c\u4f86\u5e36\u52d5\u54e1\u5de5\u5728\u51fa\u884c\u5834\u666f\u53c3\u8207\u7bc0\u80fd\u6e1b\u6392\uff0c\u63a8\u52d5\u54e1\u5de5\u8e10\u884c\u591a\u4eba\u62fc\u8eca\u7b49\u7bc0\u80fd\u884c\u52d5\u30022026\u8ca1\u5e74\uff0c60,258\u540d\u54e1\u5de5\u900f\u904e\u300c\u6b61\u884c\u300d\u53c3\u8207\u5b8c\u62101,134,200\u6b21\u4f4e\u78b3\u5dee\u65c5\u884c\u70ba\uff0c\u5be6\u73fe\u6e1b\u6392\u91cf\u8fd16,989.3\u5678\u3002","campusSpongeCityTitle":"\u6d77\u7dbf\u57ce\u5e02\u5712\u5340","campusSpongeCityDesc":"\u6211\u5011\u5f9e\u8a2d\u8a08\u958b\u59cb\u5c31\u878d\u5165\u4fdd\u8b77\u6c34\u8cc7\u6e90\u7684\u610f\u8b58\u3002\u65b0\u5efa\u5712\u5340\uff0c\u6211\u5011\u63a1\u7528\u6d77\u7dbf\u57ce\u5e02\u7684\u8a2d\u8a08\u7406\u5ff5\u3002\u9019\u500b\u8a2d\u8a08\u7406\u5ff5\u662f\u6307\u900f\u904e\u63a1\u7528\u5404\u7a2e\u63aa\u65bd\uff0c\u4f7f\u5f97\u57ce\u5e02\u50cf\u6d77\u7dbf\u4e00\u6a23\u5177\u5099\u826f\u597d\u7684\u300c\u5438\u6c34\u3001\u84c4\u6c34\u3001\u6ef2\u6c34\u3001\u6de8\u6c34\u300d\u80fd\u529b\uff0c\u5f9e\u800c\u6709\u6548\u61c9\u5c0d\u6c34\u8cc7\u6e90\u77ed\u7f3a\u3001\u6d2a\u6f87\u707d\u5bb3\u548c\u6c34\u6c61\u67d3\u7b49\u554f\u984c\u3002\\n\u963f\u91cc\u5df4\u5df4\u676d\u5dde\u5712\u5340\u897f\u6eaa C \u5340\u3001\u5317\u4eac\u5712\u5340\u5747\u9075\u5faa\u9019\u4e00\u7406\u5ff5\uff0c\u63a1\u53d6\u4e86\u4e00\u7cfb\u5217\u8209\u63aa\u3002\u8b6c\u5982\uff0c\u9078\u7528\u900f\u6c34\u6027\u92ea\u88dd\u6750\u6599\uff0c\u4f7f\u96e8\u6c34\u80fd\u5920\u76f4\u63a5\u6ef2\u900f\u5230\u5730\u4e0b\uff1b\u5efa\u8a2d\u96e8\u6c34\u6536\u96c6\u7cfb\u7d71\uff0c\u5c07\u5c4b\u9802\u548c\u5730\u9762\u7684\u96e8\u6c34\u6536\u96c6\u8d77\u4f86\u91cd\u8907\u518d\u5229\u7528\u3002","campusWaterConservationTitle":"\u5712\u5340\u7684\u6c34\u8cc7\u6e90\u7ba1\u7406","campusWaterSavingTitle":"\u8861\u91cf","campusWaterSavingDesc":"\u6211\u5011\u69cb\u5efa\u4e86\u6c34\u8cc7\u6e90\u7ba1\u7406\u5e73\u53f0\uff0c\u900f\u904e\u6578\u5b57\u5316\u76e3\u6e2c\uff0c\u5be6\u73fe\u5c0d\u7528\u6c34\u7684\u7cbe\u7d30\u5316\u7ba1\u63a7\uff0c\u63d0\u5347\u8cc7\u6e90\u5229\u7528\u6548\u7387\uff0c\u652f\u63f4\u53ef\u6301\u7e8c\u71df\u904b\u3002","campusWaterRecyclingTitle":"\u7ba1\u7406\u9ad4\u7cfb","campusWaterRecyclingDesc":"\u6211\u5011\u69cb\u5efa\u300c\u76e3\u6e2c - \u7bc0\u6c34 - \u56de\u7528\u300d\u7684\u667a\u6167\u5316\u6c34\u8cc7\u6e90\u7ba1\u7406\u9ad4\u7cfb\u3002\u900f\u904e\u90e8\u7f72\u667a\u80fd\u6c34\u8868\u7cfb\u7d71\u3001\u5347\u7d1a\u4e00\u7d1a\u6c34\u6548\u8a2d\u5099\uff0c\u4ee5\u53ca\u5efa\u7acb\u76f4\u98f2\u6c34\u5ee2\u6c34\u8207\u7a7a\u8abf\u51b7\u51dd\u6c34\u5faa\u74b0\u5229\u7528\u7db2\u7d61\uff0c\u7cfb\u7d71\u5316\u63d0\u5347\u6c34\u8cc7\u6e90\u5229\u7528\u6548\u7387\u30022026\u8ca1\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u81ea\u7528\u8fa6\u516c\u5712\u5340\u6301\u7e8c\u62d3\u5c55\u5faa\u74b0\u6c34\u7cfb\u7d71\u7684\u6539\u9020\u548c\u6295\u5165\u71df\u904b\uff0c\u5168\u5e74\u5faa\u74b0\u7528\u6c34\u91cf\u9054\u523058,471\u7acb\u65b9\u7c73\u3002","campusZeroWasteTitle":"\u7b56\u7565","campusZeroWasteDesc":"\u6211\u5011\u9ad8\u5ea6\u91cd\u8996\u81ea\u8eab\u7684\u5ee2\u68c4\u7269\u5f71\u97ff\uff0c\u5c0d\u5ee2\u68c4\u7269\u8db3\u8de1\u9032\u884c\u8ffd\u8e64\u3001\u8a08\u91cf\u548c\u5be9\u8a08\uff0c\u4e26\u4e14\u5805\u6301\u300c\u6e1b\u91cf\u5316\u300d\uff08\u5373\u6e1b\u5c11\u5ee2\u68c4\u7269\u7522\u751f\uff09\u548c\u300c\u8cc7\u6e90\u5316\u300d\uff08\u5373\u5ee2\u68c4\u7269\u8655\u7406\u4e26\u5faa\u74b0\u5229\u7528\uff09\u539f\u5247\uff0c\u63a8\u52d5\u5faa\u74b0\u7d93\u6fdf\u767c\u5c55\u3002","campusWasteManagementTitle":"\u5ee2\u68c4\u7269\u7ba1\u7406\u4e3e\u63aa","campusEffectiveWasteTitle":"\u8861\u91cf","campusEffectiveWasteDesc":"\u8207\u5176\u4ed6\u74b0\u5883\u8db3\u8de1\u4e00\u6a23\uff0c\u6211\u5011\u8a8d\u70ba\u6c92\u6709\u8861\u91cf\u5247\u96e3\u4ee5\u7ba1\u7406\u3002\u5728\u81ea\u7528\u8fa6\u516c\u5712\u5340\uff0c\u6211\u5011\u5df2\u5be6\u73fe\u5ee2\u68c4\u7269\u7684\u6578\u5b57\u5316\u7ba1\u7406\uff0c\u4ee5\u638c\u63e1\u5ee2\u68c4\u7269\u8db3\u8de1\uff0c\u5f9e\u800c\u6307\u5c0e\u7ba1\u7406\u52d5\u4f5c\u3002","campusWasteRecyclingTitle":"\u5faa\u74b0\u5229\u7528","campusWasteRecyclingDesc":"\u6211\u5011\u9084\u5c07\u5ee2\u68c4\u7269\u5faa\u74b0\u518d\u5229\u7528\u7684\u7406\u5ff5\u61c9\u7528\u5728\u5712\u5340\u5167\uff0c\u76e1\u529b\u6e1b\u5c11\u6700\u7d42\u5ee2\u68c4\u7269\u586b\u57cb\u30022026\u8ca1\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u5317\u4eac\u5712\u5340\u5df2\u5be6\u73fe100%\u5eda\u9918\u5783\u573e\u56de\u6536\u4e26\u4e14\u7d93\u751f\u7269\u767c\u9175\u8655\u7406\u8f49\u5316\u70ba\u6709\u6a5f\u80a5\u3002","campusWasteComplianceTitle":"\u5408\u898f\u8655\u7f6e","campusWasteComplianceDesc":"\u6211\u5011\u4ee5\u300c100% \u5408\u898f\u8655\u7406\u5ee2\u68c4\u7269\u300d\u70ba\u57fa\u672c\u539f\u5247\uff0c\u5c0b\u627e\u7b26\u5408\u8cc7\u8cea\u8981\u6c42\u7684\u4f9b\u61c9\u5546\u9032\u884c\u5408\u4f5c\uff0c\u4e26\u8ffd\u8e64\u548c\u8a18\u9304\u5ee2\u68c4\u7269\u7684\u6700\u7d42\u8655\u7406\u7d50\u679c\u4ee5\u4fdd\u8b49\u5408\u898f\u3002","campusBiophilicTitle":"\u751f\u614b\u53cb\u597d\u5712\u5340","campusBiophilicDesc":"\u963f\u91cc\u5df4\u5df4\u676d\u5dde\u897f\u6eaa\u5712\u5340A\u5340\uff0c\u6bd7\u9130\u897f\u6eaa\u570b\u5bb6\u6fd5\u5730\u516c\u5712\uff0c\u7269\u7a2e\u8c50\u5bcc\uff0c\u751f\u6a5f\u52c3\u52c3\u3002\u5712\u5340\u5167\u73fe\u67093.2 \u516c\u9803\u81ea\u7136\u6c34\u9ad4\u53ca100 \u591a\u7a2e\u690d\u7269\u3002\u8a2d\u8a08\u4e2d\u4fdd\u7559\u539f\u6709\u5927\u90e8\u5206\u6fd5\u5730\u53ca\u6cb3\u6d41\uff0c\u81ea\u7136\u8207\u8fa6\u516c\u5efa\u7bc9\u7fa4\u843d\u878d\u70ba\u4e00\u9ad4\u3002\u5b83\u65e2\u662f\u4e00\u500b\u9ad8\u79d1\u6280\u5712\u5340\uff0c\u4e5f\u662f\u500b\u81ea\u7136\u751f\u614b\u7cfb\u7d71\u3002","campusBiodiversityTitle":"\u4fdd\u8b77\u751f\u7269\u591a\u6a23\u6027","campusSiteSelectionTitle":"\u9078\u5740\u8a2d\u8a08\u968e\u6bb5","campusSiteSelectionDesc":"\u5728\u9078\u5740\u548c\u8a2d\u8a08\u968e\u6bb5\uff0c\u65b0\u5efa\u5712\u5340\u5747\u5b8c\u6210\u74b0\u5883\u5f71\u97ff\u8a55\u50f9\u3002","campusOperationPhaseTitle":"\u71df\u904b\u968e\u6bb5","campusOperationPhaseDesc":"\u6211\u5011\u6ce8\u91cd\u751f\u7269\u591a\u6a23\u6027\u4fdd\u8b77\u548c\u751f\u614b\u7cfb\u7d71\u7ba1\u7406\uff0c\u4f7f\u7528\u672c\u571f\u7269\u7a2e\u3001\u591a\u5143\u5316\u690d\u7269\u7a2e\u985e\u8c50\u5bcc\u690d\u88ab\u7d50\u69cb\u5c64\u6b21\uff0c\u5f15\u5165\u6216\u6062\u5fa9\u81ea\u7136\u68f2\u606f\u5730\uff0c\u6253\u9020\u751f\u614b\u5eca\u9053\uff0c\u4e26\u900f\u904e\u666f\u89c0\u624b\u6bb5\u6e1b\u5c11\u5149\u6c61\u67d3\u8207\u566a\u97f3\u6c61\u67d3\uff0c\u4fdd\u969c\u52d5\u7269\u751f\u6d3b\u7bc0\u5f8b\u3002","governanceStructure":"\u6cbb\u7406\u67b6\u69cb","managementSystem":"\u7ba1\u7406\u9ad4\u7cfb","governanceDescription":"\u81ea2021\u5e74\u8d77\uff0c\u6211\u5011\u900f\u904e\u8463\u4e8b\u6703\u3001\u7ba1\u7406\u5c64\u548c\u5de5\u4f5c\u7d44\u7684\u4e09\u5c64 ESG\u6cbb\u7406\u67b6\u69cb\u4f86\u4fdd\u969c\u548c\u843d\u5be6 ESG\u5de5\u4f5c\u7684\u63a8\u9032\u30022025 \u8ca1\u5e74\uff0c\u5728\u53ef\u6301\u7e8c\u767c\u5c55\u59d4\u54e1\u6703\u7684\u6307\u5c0e\u4e0b\uff0c\u6211\u5011\u6301\u7e8c\u6309\u7167\u8a08\u5283\u3001\u5be6\u65bd\u3001\u6aa2\u67e5\u548c\u8abf\u6574(PDCA)\u8ff4\u5708\u6df1\u5316\u963f\u91cc\u5df4\u5df4ESG\u7ba1\u7406\u9ad4\u7cfb\u3002","ESGSuggestions":"\u60a8\u5c0dESG\u7684\u5efa\u8b70","contactESG":"\u8acb\u806f\u7d61\u6211\u5011\uff1aESG@alibaba-inc.com","intelligentOperationAlgorithm":"\u667a\u80fd\u904b\u7dad\u6f14\u7b97\u6cd5","intelligentOperationAlgorithmDescription":"\u963f\u91cc\u96f2\u7684\u667a\u80fd\u6f14\u7b97\u6cd5\u904b\u7dad\u7b56\u7565\u6574\u5408\u96fb\u6c23\u3001\u6696\u901a\u3001\u81ea\u52d5\u5316\u63a7\u5236\u7b49\u591a\u9818\u57df\u7684\u5c08\u696d\u77e5\u8b58\uff0c\u5be6\u73fe\u7cbe\u7d30\u5316\u904b\u7dad\u8abf\u512a\u3002\u963f\u91cc\u96f2\u9084\u69cb\u5efa\u7ba1\u7406\u5e73\u53f0\uff0c\u5c0d\u5df2\u90e8\u7f72\u667a\u80fd\u6f14\u7b97\u6cd5\u904b\u7dad\u7b56\u7565\u7684\u6578\u64da\u4e2d\u5fc3\u9032\u884c\u5373\u6642\u7684\u76e3\u63a7\u8207\u7ba1\u7406\uff0c\u78ba\u4fdd\u904b\u884c\u6548\u679c\u548c\u7a69\u5b9a\u6027\u3002\u622a\u81f32026\u5e743\u670831\u65e5\uff0c\u667a\u80fd\u904b\u7dad\u7b97\u6cd5\u7d2f\u8a08\u572824\u500b\u81ea\u5efa\u6578\u64da\u4e2d\u5fc3\u7684\u6a5f\u623f\u843d\u5be6\u3002"}')},62776:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","bannerTitle":"Standardizing Corporate Governance","bannerDescription":"We are committed to establishing a sound corporate governance structure for transparent, efficient decision-making and a robust risk management system to safeguard operational stability. We drive sustainable development in a responsible manner to solidify Alibaba\'s standing as a trustworthy company.","actionResultsTitle":"Progress","strategyPathTitle":"Approaches","governanceArchitectureTitle":"Corporate governance","riskManagementTitle":"Risk management","esgGovernanceTitle":"ESG governance","nominatingCommitteeTitle":"100","nominatingCommitteeDesc":"The Nominating and Corporate Governance Committee achieved 100% independent director representation.","complianceCommitteeTitle":"75","complianceCommitteeDesc":"The Compliance and Risk Management Committee achieved 75% independent director representation.","femaleDirectorsTitle":"30","femaleDirectorsDesc":"Female representation on the Board of Directors remained at 30%.","complianceTrainingTitle":"Compliance","complianceTrainingUnit":"Training System","complianceTrainingDesc":"The Alibaba Group Employee Compliance Training System was released to promote compliance and risk awareness.","esgPolicyTitle":"ESG","esgPolicyUnit":"Related Management System","esgPolicyDesc":"The Alibaba Group Policy for Managing ESG-related Goals and Metrics was released.","strategyPathContent":"Alibaba is built on a foundation of public trust. We recognize that transparent, professional governance is essential to earning and maintaining stakeholder confidence. To this end, we continuously evolve our governance system by streamlining our governance structure, bolstering ESG initiatives, heightening risk management, and increasing operational transparency.","boardDiversityTitle":"Board diversity","boardDiversityDesc":"As per the Charter of the Nominating and Corporate Governance Committee, we consider age, gender, cultural background, and professional expertise for board nominations to align with our diverse business.","boardIndependenceTitle":"Board independence","boardIndependenceDesc":"As of March 31, 2026, the Board had six independent non-executive directors, accounting for 60% of its membership, and the overall proportion of non-executive directors was 70%.","riskManagementIntro":"An adequate and effective system for risk management and internal control is key to ensuring that we can achieve our strategic goals. We follow the requirements specified in the Alibaba Group Comprehensive Risk Management Framework to continuously push for the effective implementation of comprehensive risk management.","riskStructureTitle":"Risk management structure","boardComplianceCommitteeTitle":"Compliance and Risk Committee","boardComplianceCommitteeDesc":"At the group level, we have established a three-layer risk management structure. This committee is directly chaired by an independent director and tasked with overseeing the Group\'s overall efforts in compliance and risk management. That entails monitoring the effectiveness of our risk management and internal control system.","riskManagementCommitteeTitle":"Risk Management Committee","riskManagementCommitteeDesc":"This committee is primarily responsible for: (1) identifying major Group-level risks and formulating a risk governance strategy accordingly; (2) enhancing the risk management system; and (3) establishing an oversight and evaluation mechanism for risk management. It reports quarterly to the Board\'s Compliance and Risk Committee.","riskWorkingGroupTitle":"Risk Management Working Group","riskWorkingGroupDesc":"The Risk Management Working Group comprises the heads of comprehensive risk management from all businesses and the heads of other functional departments. It is responsible for implementing specific tasks in risk management.","riskProcessTitle":"Risk management process","riskIdentificationTitle":"Monitoring & identification","riskIdentificationDesc":"A monitoring mechanism based on a risk list dynamically identifies and evaluates risks. Information thus obtained is used to update the risk list.","riskControlTitle":"Assessment & governance","riskControlDesc":"Tiered management mechanisms and governance plans have been developed, with task forces formed to address major risks.","riskReportingTitle":"Reporting & decision-making","riskReportingDesc":"An efficient reporting mechanism updates the Board of Directors and the Risk Management Committee on progress in major risk governance.","riskVerificationTitle":"Validation & inspection","riskVerificationDesc":"Clear governance standards ensure effective implementation, supported by inspections and closed-loop verification for major risks.","emergencyManagementTitle":"Emergency management process","emergencyManagementDesc":"We have established emergency management teams and appointed people in charge at both the Group and all businesses. Additionally, we have established working procedures for emergency management to ensure emergency response is implemented in an orderly manner.","emergencyManagementContent":"The Alibaba Group Specifications for Handling Emergency Service Unit (ESU) Incidents defines standards for classifying and grading risk incidents as well as procedural workflows for: (1) pre-incident readiness and prevention; (2) incident response and handling; (3) post-incident review, remediation and accountability.","supervisionMechanismTitle":"Supervision, evaluation and inspection","supervisionMechanismDesc":"We have established internal supervision and evaluation mechanisms as well as external oversight and remediation mechanisms at both the Group and all businesses. The Risk Management Committee conducts annual supervision, evaluation, and review on the compliance and risk management activities of each business.","supervisionMechanismContent":"We have established a tiered supervision and inspection mechanism. As responsible entities, our businesses conduct self-inspections. Group-level functional departments perform targeted reviews, backed by at least one annual internal and external audit to ensure compliance. The Risk Management Committee conducts annual oversight and evaluations for compliance and risk management across all businesses, linking the results to team performance assessments.","riskCultureTitle":"Culture and training","riskTrainingTitle":"Risk management training","riskTrainingDesc":"In FY2026, we organized nearly 1,900 advocacy and training events to build a risk compliance culture. Risk management is integrated into the Alibaba Group Code of Business Conduct exam required for all employees.","riskCultureActivityTitle":"Compliance Day","riskCultureActivityDesc":"We hosted our 5th group-wide Compliance Day, which featured executive messages, policy briefings, and interactive sessions to disseminate compliance knowledge and bolster risk awareness.","esgGovernanceContent":"In 2021, we established a three-layer ESG governance framework involving the Board of Directors, the management, and working groups to ensure the effective implementation of our ESG initiatives. Under the guidance of the Sustainability Committee, we continuously strengthen our ESG management system in a Plan-Do-Check-Act (PDCA) cycle."}')},28160:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u62a5\u544a","bannerTitle":"\u89c4\u8303\u516c\u53f8\u6cbb\u7406","bannerDescription":"\u963f\u91cc\u5df4\u5df4\u81f4\u529b\u4e8e\u6784\u5efa\u5065\u5eb7\u7684\u516c\u53f8\u6cbb\u7406\u4f53\u7cfb\uff0c\u786e\u4fdd\u51b3\u7b56\u8fc7\u7a0b\u900f\u660e\u3001\u9ad8\u6548\uff1b\u5065\u5168\u98ce\u9669\u7ba1\u7406\u4f53\u7cfb\uff0c\u4fdd\u969c\u7ecf\u8425\u7684\u7a33\u5065\u6027\u3002\u6211\u4eec\u4ee5\u8d1f\u8d23\u4efb\u7684\u65b9\u5f0f\u63a8\u52a8\u4f01\u4e1a\u7684\u53ef\u6301\u7eed\u53d1\u5c55\uff0c\u8fd9\u4e9b\u52aa\u529b\u8ba9\u963f\u91cc\u5df4\u5df4\u6210\u4e3a\u4e00\u5bb6\u503c\u5f97\u4fe1\u8d56\u7684\u516c\u53f8\u3002","actionResultsTitle":"\u884c\u52a8\u7ed3\u679c","strategyPathTitle":"\u7b56\u7565\u4e0e\u8def\u5f84","governanceArchitectureTitle":"\u516c\u53f8\u6cbb\u7406","riskManagementTitle":"\u98ce\u9669\u7ba1\u7406","esgGovernanceTitle":"ESG\u6cbb\u7406","nominatingCommitteeTitle":"100","nominatingCommitteeDesc":"\u63d0\u540d\u53ca\u516c\u53f8\u6cbb\u7406\u59d4\u5458\u4f1a\u7684\u72ec\u7acb\u8463\u4e8b\u5360\u6bd4\u63d0\u5347\u81f3 100%","complianceCommitteeTitle":"75","complianceCommitteeDesc":"\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u7684\u72ec\u7acb\u8463\u4e8b\u5360\u6bd4\u63d0\u5347\u81f375%","femaleDirectorsTitle":"30","femaleDirectorsDesc":"\u4fdd\u6301 30% \u7684\u5973\u6027\u8463\u4e8b\u6bd4\u4f8b","complianceTrainingTitle":"\u5408\u89c4","complianceTrainingUnit":"\u57f9\u8bad\u5236\u5ea6","complianceTrainingDesc":"\u53d1\u5e03\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5408\u89c4\u57f9\u8bad\u5236\u5ea6\u300b\uff0c\u52a0\u5f3a\u5408\u89c4\u4e0e\u98ce\u9669\u610f\u8bc6","esgPolicyTitle":"ESG","esgPolicyUnit":"\u76f8\u5173\u7ba1\u7406\u5236\u5ea6","esgPolicyDesc":"\u53d1\u5e03\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2 ESG \u76f8\u5173\u76ee\u6807\u53ca\u6307\u6807\u7ba1\u7406\u5236\u5ea6\u300b","strategyPathContent":"\u963f\u91cc\u5df4\u5df4\u7684\u5546\u4e1a\u6839\u57fa\u6765\u81ea\u4e8e\u516c\u4f17\u4fe1\u4efb\u3002\u6211\u4eec\u6df1\u77e5\uff0c\u900f\u660e\u3001\u4e13\u4e1a\u7684\u6cbb\u7406\u662f\u8d62\u5f97\u5e76\u7ef4\u7cfb\u5229\u76ca\u76f8\u5173\u65b9\u4fe1\u4efb\u7684\u5173\u952e\u3002\u4e3a\u6b64\uff0c\u6211\u4eec\u6301\u7eed\u4f18\u5316\u6cbb\u7406\u4f53\u7cfb\uff0c\u5305\u62ec\u5b8c\u5584\u6cbb\u7406\u67b6\u6784\u3001\u5065\u5168ESG\u4e0e\u98ce\u9669\u7ba1\u7406\u53ca\u589e\u5f3a\u900f\u660e\u5ea6\u7b49\u4e3e\u63aa\u3002","boardDiversityTitle":"\u8463\u4e8b\u4f1a\u591a\u5143\u5316","boardDiversityDesc":"\u6211\u4eec\u4f9d\u636e\u300a\u63d0\u540d\u53ca\u516c\u53f8\u6cbb\u7406\u59d4\u5458\u4f1a\u7ae0\u7a0b\u300b\uff0c\u5728\u8463\u4e8b\u63d0\u540d\u4e2d\u7efc\u5408\u8003\u91cf\u5e74\u9f84\u3001\u6027\u522b\u3001\u6587\u5316\u80cc\u666f\u53ca\u4e13\u4e1a\u80fd\u529b\uff0c\u4ee5\u5951\u5408\u6211\u4eec\u591a\u5143\u7684\u4e1a\u52a1\u3002","boardIndependenceTitle":"\u8463\u4e8b\u4f1a\u72ec\u7acb\u6027","boardIndependenceDesc":"\u622a\u81f32026\u5e743\u670831\u65e5\uff0c\u8463\u4e8b\u4f1a\u5171\u67096\u540d\u72ec\u7acb\u975e\u6267\u884c\u8463\u4e8b\uff0c\u5360\u6bd4\u4e3a60%\uff0c\u975e\u6267\u884c\u8463\u4e8b\u7684\u5360\u6bd4\u4e3a70%\u3002","riskManagementIntro":"\u5145\u5206\u53ca\u6709\u6548\u7684\u98ce\u9669\u7ba1\u7406\u53ca\u5185\u90e8\u63a7\u5236\u7cfb\u7edf\u662f\u4fdd\u969c\u963f\u91cc\u5df4\u5df4\u63a8\u8fdb\u6218\u7565\u76ee\u6807\u7684\u5173\u952e\u3002\u4f9d\u636e\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5168\u9762\u98ce\u9669\u7ba1\u7406\u603b\u7eb2\u300b\u8981\u6c42\uff0c\u6211\u4eec\u6301\u7eed\u63a8\u8fdb\u5168\u9762\u98ce\u9669\u7ba1\u7406\u5de5\u4f5c\u843d\u5730\u3002","riskStructureTitle":"\u98ce\u9669\u7ba1\u7406\u67b6\u6784","boardComplianceCommitteeTitle":"\u8463\u4e8b\u4f1a\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a","boardComplianceCommitteeDesc":"\u8463\u4e8b\u4f1a\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u7531\u72ec\u7acb\u8463\u4e8b\u4f5c\u4e3a\u4e3b\u5e2d\u76f4\u63a5\u9886\u5bfc\uff0c\u8d1f\u8d23\u76d1\u7763\u96c6\u56e2\u6574\u4f53\u5408\u89c4\u53ca\u98ce\u9669\u7ba1\u7406\u5de5\u4f5c\u3002","riskManagementCommitteeTitle":"\u5168\u9762\u98ce\u9669\u7ba1\u7406\u59d4\u5458\u4f1a","riskManagementCommitteeDesc":"\u5168\u9762\u98ce\u9669\u7ba1\u7406\u59d4\u5458\u4f1a\u7684\u4e3b\u8981\u804c\u8d23\u4e3a\u8bc6\u522b\u96c6\u56e2\u91cd\u5927\u98ce\u9669\u5e76\u5236\u5b9a\u76f8\u5e94\u7684\u98ce\u9669\u6cbb\u7406\u7b56\u7565\uff0c\u5b8c\u5584\u98ce\u9669\u7ba1\u7406\u4f53\u7cfb\u5efa\u8bbe\u548c\u5efa\u7acb\u76d1\u7763\u8bc4\u4ef7\u673a\u5236\u7b49\uff0c\u6bcf\u5b63\u5ea6\u5411\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u6c47\u62a5\u76f8\u5173\u5de5\u4f5c\u3002","riskWorkingGroupTitle":"\u5168\u9762\u98ce\u9669\u7ba1\u7406\u5de5\u4f5c\u7ec4","riskWorkingGroupDesc":"\u5168\u9762\u98ce\u9669\u7ba1\u7406\u5de5\u4f5c\u7ec4\u7531\u5404\u4e1a\u52a1\u7684\u5168\u9762\u98ce\u9669\u7ba1\u7406\u8d1f\u8d23\u4eba\u53ca\u5176\u4ed6\u804c\u80fd\u90e8\u95e8\u8d1f\u8d23\u4eba\u7ec4\u6210\u3002\u8d1f\u8d23\u5c06\u5168\u98ce\u9669\u7ba1\u7406\u5177\u4f53\u5de5\u4f5c\u4e8b\u9879\u3002","riskProcessTitle":"\u98ce\u9669\u7ba1\u7406\u6d41\u7a0b","riskIdentificationTitle":"\u76d1\u6d4b\u4e0e\u8bc6\u522b","riskIdentificationDesc":"\u4f9d\u6258\u98ce\u9669\u6e05\u5355\u5efa\u7acb\u76d1\u6d4b\u81ea\u67e5\u673a\u5236\uff0c\u52a8\u6001\u8bc6\u522b\u8bc4\u4f30\u98ce\u9669\u5e76\u66f4\u65b0\u6e05\u5355\u3002","riskControlTitle":"\u8bc4\u4f30\u4e0e\u6cbb\u7406","riskControlDesc":"\u5236\u5b9a\u5206\u5c42\u7ba1\u7406\u673a\u5236\u548c\u6cbb\u7406\u65b9\u6848\uff0c\u7ec4\u5efa\u4e13\u73ed\u5e94\u5bf9\u91cd\u5927\u98ce\u9669\u3002","riskReportingTitl