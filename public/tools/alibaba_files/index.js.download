,"supervisionCertificationDesc":"\u963f\u91cc\u5df4\u5df4\u89c4\u5b9a\u5e76\u76d1\u7763\u5404\u4e1a\u52a1\u6bcf\u5e74\u81f3\u5c11\u5f00\u5c55\u4e00\u6b21\u5168\u9762\u7684\u6570\u636e\u5b89\u5168\u4e0e\u9690\u79c1\u4fdd\u62a4\u5ba1\u8ba1\u3002\u5178\u578b\u95ee\u9898\u5f00\u5c55\u4e13\u9879\u5ba1\u8ba1\uff0c\u5e76\u5bf9\u5ba1\u8ba1\u53d1\u73b0\u95ee\u9898\u8fdb\u884c\u6574\u6539\u3002","networkSecurityTitle":"\u5b88\u62a4\u7f51\u7edc\u5b89\u5168","networkSecurityDesc":"\u7f51\u7edc\u5b89\u5168\u7684\u57fa\u7840\u4fdd\u969c\u4f5c\u7528\u65e5\u76ca\u7a81\u51fa\u3002\u6211\u4eec\u5236\u5b9a\u4e86\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u7f51\u7edc\u5b89\u5168\u603b\u7eb2\u300b\uff0c\u660e\u786e\u516c\u53f8\u7684\u7f51\u7edc\u5b89\u5168\u7ba1\u7406\u67b6\u6784\u548c\u804c\u8d23\uff0c\u660e\u786e\u5404\u9879\u7ba1\u7406\u8981\u6c42\u3002","supervisionOrg":"\u8463\u4e8b\u4f1a","supervisionOrgHover":"\u5408\u89c4\u53ca\u98ce\u9669\u7ba1\u7406\u59d4\u5458\u4f1a\u5bf9\u7f51\u7edc\u5b89\u5168\u76f8\u5173\u4e8b\u5b9c\u5177\u6709\u63a7\u5236\u3001\u51b3\u7b56\u6743\u3002","managementOrg":"\u7ba1\u7406\u5c42","managementOrgHover":"\u6210\u7acb\u7f51\u7edc\u5b89\u5168\u51b3\u7b56\u5c0f\u7ec4\uff0c\u7531\u5168\u9762\u98ce\u9669\u7ba1\u7406\u5de5\u4f5c\u7ec4\u3001\u96c6\u56e2\u5b89\u5168\u90e8\u603b\u88c1\u3001\u9996\u5e2d\u6cd5\u52a1\u5b98\u53ca\u5404\u4e1a\u52a1\u5b89\u5168\u8d1f\u8d23\u4eba\u7ec4\u6210\uff0c\u8d1f\u8d23\u7edf\u7b79\u5168\u5c40\u98ce\u9669\u3001\u5ba1\u5b9a\u5173\u952e\u7b56\u7565\u5e76\u5bf9\u91cd\u5927\u5b89\u5168\u4e8b\u4ef6\u8fdb\u884c\u6700\u7ec8\u51b3\u7b56\u3002","executionTeam":"\u6267\u884c\u5c42","executionTeamHover":"\u6210\u7acb\u7f51\u7edc\u5b89\u5168\u7ba1\u7406\u5c0f\u7ec4\u548c\u7f51\u7edc\u5b89\u5168\u6267\u884c\u5c0f\u7ec4\uff0c\u524d\u8005\u8d1f\u8d23\u5efa\u7acb\u7ba1\u7406\u4f53\u7cfb\uff0c\u540e\u8005\u5219\u5c06\u7ba1\u7406\u8981\u6c42\u548c\u7b56\u7565\u843d\u5730\u6267\u884c\u3002\u540c\u65f6\uff0c\u5404\u4e1a\u52a1\u5747\u8bbe\u7acb\u7