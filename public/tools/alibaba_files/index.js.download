":"\u672c\u7db2\u7ad9\u4f7f\u7528Cookie\u53ca\u5176\u4ed6\u985e\u4f3c\u7684\u8a2d\u5099\u8cc7\u8a0a\u8b58\u5225\u6280\u8853\uff0c\u4ee5\u5e6b\u52a9\u6211\u5011\u78ba\u4fdd\u7db2\u7ad9\u7684\u5b89\u5168\u6027\u548c\u529f\u80fd\u6027\uff08\u5fc5\u8981Cookie\uff09\uff0c\u4e26\u7528\u65bc\u5206\u6790\u76ee\u7684\uff08\u6548\u80fd\u6216\u5206\u6790\u985eCookie\uff09\u3002\u60a8\u53ef\u4ee5\u9078\u64c7\u63a5\u53d7\u6240\u6709\u5206\u6790\u985eCookie\uff0c\u6216\u5168\u90e8\u62d2\u7d55\u3002\u60a8\u53ef\u4ee5\u900f\u904e\u6211\u5011\u7684\u300aCookie\u653f\u7b56\u300b${link}\u7372\u53d6\u66f4\u591a\u95dc\u65bcCookie\u7684\u8cc7\u8a0a\u3002","learn_more":"\uff08\u9ede\u64ca\u6b64\u8655\uff09","accept_cookies":"\u5141\u8a31\u6240\u6709","reject_ookies":"\u62d2\u7d55\u6240\u6709","cookie_title":"\u60a8\u7684Cookie\u504f\u597d\u8a2d\u5b9a","welcome":"\u6b61\u8fce\u8a2a\u554fAlibabagroup.com!"}')},27267:function(e){"use strict";e.exports=JSON.parse('{"mainTitle":"An Exciting Future, Together!","campusBtnText":"Students and Graduates","socialBtnText":"Experienced Professionals","joinAlibaba":"Join Alibaba","joinNow":"Join Now"}')},47143:function(e){"use strict";e.exports=JSON.parse('{"mainTitle":"\u4e00\u8d77\u6253\u5f00\u6709\u610f\u601d\u7684\u672a\u6765\uff01","campusBtnText":"\u6821\u56ed\u62db\u8058","socialBtnText":"\u793e\u4f1a\u62db\u8058","joinAlibaba":"\u52a0\u5165\u963f\u91cc\u5df4\u5df4","joinNow":"\u7acb\u5373\u52a0\u5165"}')},75929:function(e){"use strict";e.exports=JSON.parse('{"mainTitle":"\u4e00\u8d77\u6253\u958b\u6709\u610f\u601d\u7684\u672a\u4f86\uff01","campusBtnText":"\u6821\u5712\u62db\u8058","socialBtnText":"\u793e\u6703\u62db\u8058","joinAlibaba":"\u52a0\u5165\u963f\u91cc\u5df4\u5df4","joinNow":"\u7acb\u5373\u52a0\u5165"}')},8483:function(e){"use strict";e.exports=JSON.parse('{"climateStrategyTitle":"Climate Strategy and Actions - Alibaba Group","climateStrategyKeywords":"climate strategy,climate change,ESG,sustainability,Alibaba","climateStrategyDescription":"Learn about Alibaba\'s climate strategy and actions, identifying risks and opportunities through climate scenario analysis, developing management plans and conducting climate mitigation and adaptation actions","title":"Climate strategy and action","description":"We monitor external changes to dynamically review and update our climate strategy. Leveraging climate scenario analysis, we identify risks and opportunities, assessing their business and financial impacts to formulate management plans. Additionally, we execute mitigation and adaptation actions subject to regular effectiveness evaluation, while exploring climate-driven business opportunities to foster a more resilient society. ","clickToLearnMore":"Click here","moreAction":" to learn more about our climate mitigation efforts.","tabAssessment":"Risks and opportunities","tabAction":"Adaptation and mitigation","mainTitle":"Climate risks and opportunities","subTitle":"Climate Scenario Description","scenarioDescription":"We conduct scenario analysis to assess climate risks and opportunities across our e-commerce, cloud, and logistics operations. For physical risks, we apply the low-emission (SSP1-2.6) and high-emission (SSP3-7.0, SSP5-8.5) pathways from the IPCC AR6 SSP. For transition risks and opportunities, we use the IEA\'s NZE and STEPS scenarios.","columnRisk":"Climate Risks and Opportunities","columnImpact":"Potential impacts on our business and finances","columnTimeframe":"Time Horizon","physicalRisks":"Physical Risks","transitionRisks":"Transition Risks","opportunities":"Transition Opportunities","shortTerm":"Short-term","mediumTerm":"Medium-term","longTerm":"Long-term","scenarioTabTitle":"Climate Scenario Description","scenarioTabDescription":"Combined with Alibaba\'s current situation, we use different climate scenarios from the Intergovernmental Panel on Climate Change (IPCC) and the International Energy Agency (IEA) to analyze potential impacts and business response strategies under each scenario.","scenarioColumnName":"Climate Scenarios","scenarioColumnImpact":"Potential Impacts & Strategies","scenarioColumnTimeframe":"Time Horizon","ipccLowScenarios":"IPCC Low-Carbon Scenarios","ipccHighScenarios":"IPCC High-Carbon Scenarios","ieaLowScenarios":"IEA Low-Carbon Scenarios","ieaHighScenarios":"IEA High-Carbon Scenarios","banner":{"title":"Responding to climate change","description":"We enhance climate governance and refine our climate strategy to better manage climate-related risks and opportunities."},"riskData":{"extremeHeat":{"title":"Acute -- extreme heat","description":"\u2022Operating costs rise because: (1) cooling demand increases; and (2) more compensation is required for products spoiled in transit or delayed in delivery.\\n\u2022Demand for installing and replacing cooling equipment increases.\\n\u2022Our operations are subject to power supply failures, cooling system malfunctions, electricity rationing, and power outages. These have a direct impact on businesses in the Alibaba ecosystem, resulting in lower operating revenue or higher compensation.\\n\u2022Outdoor workers are subject to more health threats, which leads to more spending on hot weather allowances or medical expenses."},"floodCyclone":{"title":"Acute -- floods and tropical cyclones","description":"\u2022Infrastructure such as power supply systems and equipment could be damaged, which translates into asset impairment and increased maintenance costs and/or capital expenditure.\\n\u2022Logistics efficiency declines, resulting in delays and increased compensation.\\n\u2022Our operations are subject to power supply failures, cooling system malfunctions, electricity rationing, and power outages. They have a direct impact on businesses in the Alibaba ecosystem, resulting in lower operating revenue or higher compensation."},"waterDrought":{"title":"Chronic -- water stress and droughts","description":"\u2022Using low-water or waterless cooling solutions lowers cooling efficiency over the short term, leading to higher operating costs."},"policyRegulation":{"title":"Policy and regulatory risks","description":"\u2022In low-emission scenarios, climate policies continue to toughen up, and more stringent regulations translate into higher operating costs and capital expenditure. Tighter regulation indirectly affects the cost structures and market competitiveness of our businesses via supply chains, driving up operating costs.\\n\u2022As disclosure policies for climate information become ever stricter, we face growing compliance costs."},"technologyRisk":{"title":"Risks associated with technologies","description":"\u2022In low-emission scenarios, business transformation requires significant capital expenditure for R&D on low-carbon technologies, equipment replacement, and project implementation. Meanwhile, it may cause asset impairment."},"reputationRisk":{"title":"Reputational risks","description":"\u2022Amid the growing focus on our climate response and emissions reduction progress, we must make additional efforts to reduce emissions and make more disclosures to strengthen stakeholder confidence. These efforts enable us to maintain customer loyalty and our financing capabilities."},"resourceEfficiency":{"title":"Opportunities associated with resource efficiency","description":"\u2022Leveraging resource-efficient technologies allows us to cut operating expenditure while reducing emissions. In our low-carbon transition, adopting these technologies earlier over the short term may bring about more opportunities."},"productService":{"title":"Opportunities associated with products and services","description":"\u2022As customers and partners develop a stronger low-carbon awareness, demand for low-carbon products and services is rising. We can enhance our market competitiveness by responding quickly to demand and leveraging our diversified business portfolio.\\n\u2022Leveraging digital technologies, we can deliver low-carbon solutions to various industries, empowering a society-wide low-carbon transition."}},"actionData":{"infrastructure":{"type":"Infrastructure","description":"We prioritize disaster resilience across the full lifecycle of critical infrastructure.\\n\u2022Design and construction: For office campuses, we embed climate resilience into design and construction, adopting the sponge city concept. For data centers, we mitigate natural disaster risks in physical design and strategic planning. Examples include elevating ground floors in flood-prone zones and placing critical equipment on the second or higher floors.\\n\u2022Emergency response: We deploy water gates and flood-control sandbags as standard defensive measures. Our data centers are equipped with UPS systems and diesel generators.\\n\u2022Operation and maintenance:  Throughout the operation and maintenance of our office campuses, we use a comprehensive facility management system that features regular inspection and maintenance for climate-resilient infrastructure."},"operation":{"type":"Operations","description":"We develop comprehensive, end-to-end contingency plans spanning pre-incident preparedness, incident response, and post-incident recovery. These ensure business continuity across various businesses. We have a multi-layered early warning system that leverages meteorological data for the identification of potential risks, enabling us to adapt our warning mechanisms, reporting protocols, and response strategies to specific extreme weather scenarios."},"personnel":{"type":"Personnel","description":"We help workers adapt to extreme weather.\\n\u2022 Working environments: We optimize physical environments across our office campuses and logistics warehouses to enhance comfort. For couriers and delivery riders, we provide dedicated cooling spaces and anti-heatstroke supplies.\\n\u2022 Management: By scheduling worker shifts and breaks appropriately as well as implementing extreme weather protocols, we mitigate health risks associated with exposure to extreme heat and other harsh conditions.\\n\u2022 Training: We conduct regular extreme weather drills to prepare workers to execute response protocols swiftly and effectively."},"supplyChain":{"type":"Supply chains","description":"We enhance supply chain resilience by integrating strategic diversification with optimized network planning. Leveraging extreme weather forecasts, we adapt our supplier mix to ensure stability, while dynamically selecting shipping warehouses and delivery routes to maintain operational efficiency."}},"systematicBuildingCapabilities":"A systematic approach to climate adaptation","infrastructure":"Infrastructure","operations":"Operations","personnel":"Personnel","supplyChain":"Supply chains","operatingExpenditure":"Operating expenditure","operatingRevenue":"Operating revenue","assetImpairment":"Asset impairment","capitalExpenditure":"Capital expenditure","operatingCosts":"Operating costs","financingCosts":"Financing costs","governance":{"title":"Climate governance","description":"Climate governance is integral to Alibaba\'s ESG governance and risk management system. The Board\'s Sustainability Committee oversees climate-related risks and opportunities, evaluating response strategies and tracking progress toward targets. The ESG Strategy and Operations Department has established a cross-functional Climate Change Working Group, comprising members from Legal and Compliance, Internal Control, Enterprise Risk Management, and Investor Relations. The Group coordinates with businesses to drive the implementation of climate initiatives.","image":"https://img.alicdn.com/imgextra/i1/O1CN01XbcHKM1zfV9wbWxw1_!!6000000006741-0-tps-2880-900.jpg"},"strategySection":{"title":"Climate strategy and action","tabAssessment":"Climate risks and opportunities","tabAction":"Climate actions","assessmentDescription":"Based on low-emission and high-emission climate scenarios from the Intergovernmental Panel on Climate Change (IPCC) and the International Energy Agency (IEA), we conduct climate risk and opportunity assessments across our international and domestic e-commerce, cloud computing, logistics, and other businesses, covering short, medium, and long terms.","actionDescription":"We build operational resilience through climate adaptation and mitigation, while empowering broader societal resilience via our products, services, and external collaboraton.","assessmentCards":[{"title":"Physical risks","description":"Physical risks mainly include extreme heat, floods, tropical cyclones, water stress and droughts. While they are generally manageable over the short term, their impact may escalate in the high-emission scenario over the medium- to long term."},{"title":"Transition risks","description":"Transition risks mainly concern policies, legal requirements, markets, technologies, and reputation."},{"title":"Transition opportunities","description":"Transition opportunities primarily arise from improved resource efficiency as well as  innovations in products and services. They may increase amid our low-carbon transition."}],"actionCards":[{"title":"Adaptation and mitigation","description":"For adaptation, we embed physical risk management into the asset lifecycle, covering infrastructure, operations, workforce, and the value chain. For mitigation, we incorporate targeted actions into our day-to-day operations to address risks across policies, legal requirements, markets, technologies, and reputation."},{"title":"Products and services","description":"We integrate climate adaptation and mitigation into the continuous optimization of our products and services, leveraging our internal operational capabilities to extend resilience across the broader value chain and society at large."},{"title":"External collaboration","description":"We engage in broad external collaborations, ranging from climate standard-setting to cross-sectoral joint research and international exchanges, aligning our business and climate strategies with domestic and international climate agendas."}]},"riskManagement":{"title":"Climate risk management","description":"We integrate climate risks into Alibaba Group\'s risk taxonomy, where they are evaluated against standardized criteria and managed in tiers based on impact and likelihood. In FY2026, we launched an internal platform empowering our businesses to identify and assess physical climate risks. Additionally, we leverage a dedicated monitoring system to track climate events and dynamically validate our assessments.","image":"https://img.alicdn.com/imgextra/i2/O1CN01Yz9w0p1NMZmYbFuhX_!!6000000001553-0-tps-2880-900.jpg"},"navGovernance":"Climate governance","navStrategy":"Climate strategy and action","navRiskManagement":"Climate risk management"}')},44235:function(e){"use strict";e.exports=JSON.parse('{"climateStrategyTitle":"\u6c14\u5019\u6218\u7565\u4e0e\u884c\u52a8 - \u963f\u91cc\u5df4\u5df4\u96c6\u56e2","climateStrategyKeywords":"\u6c14\u5019\u6218\u7565,\u6c14\u5019\u53d8\u5316,ESG,\u53ef\u6301\u7eed\u53d1\u5c55,\u963f\u91cc\u5df4\u5df4","climateStrategyDescription":"\u4e86\u89e3\u963f\u91cc\u5df4\u5df4\u7684\u6c14\u5019\u6218\u7565\u4e0e\u884c\u52a8,\u901a\u8fc7\u6c14\u5019\u60c5\u666f\u5206\u6790\u8bc6\u522b\u98ce\u9669\u4e0e\u673a\u9047,\u5236\u5b9a\u7ba1\u7406\u65b9\u6848\u5e76\u5f00\u5c55\u6c14\u5019\u51cf\u7f13\u4e0e\u9002\u5e94\u884c\u52a8","title":"\u6c14\u5019\u6218\u7565\u4e0e\u884c\u52a8","description":"\u963f\u91cc\u5df4\u5df4\u6301\u7eed\u76d1\u7763\u5916\u90e8\u73af\u5883\u53d8\u5316\uff0c\u5ba1\u89c6\u5e76\u66f4\u65b0\u6c14\u5019\u6218\u7565\u3002\u901a\u8fc7\u6c14\u5019\u60c5\u666f\u5206\u6790\uff0c\u6211\u4eec\u8bc6\u522b\u6c14\u5019\u76f8\u5173\u98ce\u9669\u548c\u673a\u9047\uff0c\u8bc4\u4f30\u5176\u6f5c\u5728\u4e1a\u52a1\u548c\u8d22\u52a1\u5f71\u54cd\uff0c\u5236\u5b9a\u7ba1\u7406\u65b9\u6848\uff0c\u5f00\u5c55\u6c14\u5019\u51cf\u7f13\u548c\u9002\u5e94\u884c\u52a8\u5e76\u5b9a\u671f\u8bc4\u4f30\u63aa\u65bd\u7684\u6709\u6548\u6027\uff0c\u540c\u65f6\u79ef\u6781\u63a2\u7d22\u6c14\u5019\u53d8\u5316\u80cc\u666f\u4e0b\u7684\u5546\u4e1a\u673a\u9047\uff0c\u52a9\u529b\u6784\u5efa\u66f4\u6709\u6c14\u5019\u97e7\u6027\u7684\u793e\u533a\u548c\u793e\u4f1a\u3002","clickToLearnMore":"\u70b9\u51fb\u6b64\u5904","moreAction":"\u4e86\u89e3\u66f4\u591a\u6c14\u5019\u51cf\u7f13\u884c\u52a8\u3002","tabAssessment":"\u8bc6\u522b\u548c\u8bc4\u4f30\u6c14\u5019\u98ce\u9669\u4e0e\u673a\u9047","tabAction":"\u5f00\u5c55\u6c14\u5019\u9002\u5e94\u4e0e\u51cf\u7f13\u884c\u52a8","mainTitle":"\u91cd\u8981\u6c14\u5019\u98ce\u9669\u4e0e\u673a\u9047\u53ca\u5176\u6f5c\u5728\u4e1a\u52a1\u548c\u8d22\u52a1\u5f71\u54cd","subTitle":"\u6c14\u5019\u60c5\u666f\u8bf4\u660e","scenarioDescription":"\u7ed3\u5408\u963f\u91cc\u5df4\u5df4\u7684\u7535\u5546\u5e73\u53f0\u3001\u4e91\u8ba1\u7b97\u548c\u7269\u6d41\u7b49\u4e1a\u52a1\u7684\u884c\u4e1a\u7279\u70b9\u3001\u8fd0\u8425\u6a21\u5f0f\u548c\u5730\u57df\u5206\u5e03\uff0c\u6211\u4eec\u8bc6\u522b\u4e0e\u8bc4\u4f30\u91cd\u5927\u6c14\u5019\u76f8\u5173\u98ce\u9669\u4e0e\u673a\u9047\uff0c\u53ca\u5176\u6f5c\u5728\u4e1a\u52a1\u548c\u8d22\u52a1\u5f71\u54cd\u3002\u5728\u60c5\u666f\u5206\u6790\u7684\u9009\u62e9\u4e0a\uff0c\u9488\u5bf9\u7269\u7406\u98ce\u9669\uff0c\u6211\u4eec\u9009\u62e9IPCC \u7b2c\u516d\u6b21\u8bc4\u4f30\u62a5\u544a\u5171\u4eab\u793e\u4f1a\u7ecf\u6d4e\u8def\u5f84\uff08IPCC AR6 SSP\uff09\u4e2d\u7684\u4f4e\u78b3\u60c5\u666f\uff08SSP1-2.6\uff09\u548c\u9ad8\u78b3\u60c5\u666f\uff08SSP3-7.0\u3001SSP5-8.5\uff09\uff1b\u9488\u5bf9\u8f6c\u578b\u98ce\u9669\u548c\u8f6c\u578b\u673a\u9047\uff0c\u6211\u4eec\u9009\u62e9IEA\u7684\u4f4e\u78b3\u60c5\u666f\uff08\u51c0\u96f6\u6392\u653e\u60c5\u666f NZE\uff09\u548c\u9ad8\u78b3\u60c5\u666f\uff08\u65e2\u5b9a\u653f\u7b56\u60c5\u666fSTEPS\uff09\u3002","columnRisk":"\u6c14\u5019\u98ce\u9669\u4e0e\u673a\u9047","columnImpact":"\u6f5c\u5728\u4e1a\u52a1\u4e0e\u8d22\u52a1\u5f71\u54cd","columnTimeframe":"\u65f6\u95f4\u8303\u56f4","physicalRisks":"\u7269\u7406\u98ce\u9669","transitionRisks":"\u8f6c\u578b\u98ce\u9669","opportunities":"\u8f6c\u578b\u673a\u9047","shortTerm":"\u77ed\u671f","mediumTerm":"\u4e2d\u671f","longTerm":"\u957f\u671f","scenarioTabTitle":"\u6c14\u5019\u60c5\u666f\u8bf4\u660e","scenarioTabDescription":"\u7ed3\u5408\u963f\u91cc\u5df4\u5df4\u73b0\u72b6\uff0c\u6211\u4eec\u9009\u7528\u8054\u5408\u56fd\u653f\u5e9c\u95f4\u6c14\u5019\u53d8\u5316\u4e13\u95e8\u59d4\u5458\u4f1a\uff08IPCC\uff09\u4e0e\u56fd\u9645\u80fd\u6e90\u7f72\uff08IEA\uff09\u7684\u4e0d\u540c\u6c14\u5019\u60c5\u666f\uff0c\u5206\u6790\u5404\u60c5\u666f\u4e0b\u7684\u6f5c\u5728\u5f71\u54cd\u548c\u4e1a\u52a1\u5e94\u5bf9\u7b56\u7565\u3002","scenarioColumnName":"\u6c14\u5019\u60c5\u666f","scenarioColumnImpact":"\u6f5c\u5728\u5f71\u54cd\u4e0e\u7b56\u7565","scenarioColumnTimeframe":"\u65f6\u95f4\u8303\u56f4","ipccLowScenarios":"IPCC\u4f4e\u78b3\u60c5\u666f","ipccHighScenarios":"IPCC\u9ad8\u78b3\u60c5\u666f","ieaLowScenarios":"IEA\u4f4e\u78b3\u60c5\u666f","ieaHighScenarios":"IEA\u9ad8\u78b3\u60c5\u666f","banner":{"title":"\u5e94\u5bf9\u6c14\u5019\u53d8\u5316","description":"\u6211\u4eec\u6301\u7eed\u5f3a\u5316\u6c14\u5019\u6cbb\u7406\uff0c\u5ba1\u9605\u5e76\u4f18\u5316\u6c14\u5019\u6218\u7565\uff0c\u7ba1\u7406\u6c14\u5019\u76f8\u5173\u98ce\u9669\u4e0e\u673a\u9047\u3002"},"riskData":{"extremeHeat":{"title":"\u6025\u6027-\u6781\u7aef\u9ad8\u6e29","description":"\u2022 \u51b7\u5374\u9700\u6c42\u53ca\u7535\u8d39\u589e\u52a0\uff0c\u7269\u6d41\u8d27\u7269\u53d8\u8d28\u6216\u5ef6\u8bef\u8865\u507f\u589e\u52a0\uff0c\u63a8\u5347\u8fd0\u8425\u6210\u672c\u3002\\n\u2022 \u589e\u52a0\u6216\u66f4\u6362\u5236\u51b7\u8bbe\u5907\u5b89\u88c5\u9700\u6c42\uff0c\u63a8\u5347\u8d44\u672c\u652f\u51fa\u3002\\n\u2022 \u4f9b\u7535\u53ca\u51b7\u5374\u7cfb\u7edf\u6545\u969c\u3001\u9650\u7535\u6216\u505c\u7535\uff0c\u5f71\u54cd\u4e91\u670d\u52a1\u548c\u7269\u6d41\uff0c\u95f4\u63a5\u5f71\u54cd\u963f\u91cc\u5df4\u5df4\u751f\u6001\u4e2d\u5176\u4ed6\u4e1a\u52a1\uff0c\u8425\u4e1a\u6536\u5165\u4e0b\u964d\u6216\u589e\u52a0\u8d54\u507f\u652f\u51fa\u3002\\n\u2022 \u589e\u52a0\u6237\u5916\u5de5\u4f5c\u4eba\u5458\u7684\u5065\u5eb7\u98ce\u9669\uff0c\u5e26\u6765\u9ad8\u6e29\u8865\u8d34\u6216\u533b\u7597\u652f\u51fa\u589e\u52a0\u3002"},"floodCyclone":{"title":"\u6025\u6027 - \u6d2a\u6d9d\u4e0e\u70ed\u5e26\u6c14\u65cb","description":"\u2022 \u635f\u574f\u57fa\u7840\u8bbe\u65bd\u3001\u4f9b\u7535\u7cfb\u7edf\u548c\u8bbe\u5907\uff0c\u9020\u6210\u8d44\u4ea7\u51cf\u503c\uff0c\u589e\u52a0\u7ef4\u4fee\u548c / \u6216\u8d44\u672c\u5f00\u652f\u3002\\n\u2022 \u7269\u6d41\u8fd0\u8f93\u6548\u7387\u4e0b\u964d\u800c\u51fa\u73b0\u5ef6\u8bef\uff0c\u589e\u52a0\u76f8\u5173\u8d54\u507f\u652f\u51fa\u3002\\n\u2022 \u4f9b\u7535\u6216\u51b7\u5374\u7cfb\u7edf\u6545\u969c\u3001\u9650\u7535\u6216\u505c\u7535\uff0c\u5f71\u54cd\u4e91\u670d\u52a1\u548c\u7269\u6d41\uff0c\u95f4\u63a5\u5f71\u54cd\u963f\u91cc\u5df4\u5df4\u751f\u6001\u4e2d\u5176\u4ed6\u4e1a\u52a1\uff0c\u8425\u4e1a\u6536\u5165\u4e0b\u964d\u6216\u589e\u52a0\u8d54\u507f\u652f\u51fa\u3002"},"waterDrought":{"title":"\u6162\u6027 -\u6c34\u538b\u529b\u4e0e\u5e72\u65f1","description":"\u2022 \u91c7\u53d6\u5c11\u6c34\u6216\u65e0\u6c34\u5236\u51b7\u6280\u672f\u65b9\u6848\uff0c\u5236\u51b7\u6548\u7387\u77ed\u671f\u6709\u6240\u964d\u4f4e\uff0c\u63d0\u5347\u8fd0\u8425\u6210\u672c\u3002"},"policyRegulation":{"title":"\u653f\u7b56\u4e0e\u6cd5\u89c4\u98ce\u9669","description":"\u2022 \u4f4e\u78b3\u60c5\u666f\u4e0b\uff0c\u6c14\u5019\u653f\u7b56\uff08\u4f8b\u5982\u56fd\u9645\u548c\u4e2d\u56fd\u7684\u78b3\u6392\u653e\u4ea4\u6613\u4f53\u7cfb\u548c\u80fd\u6e90\u76f8\u5173\u7684\u653f\u7b56\uff09\u6301\u7eed\u5f3a\u5316\uff0c\u4e91\u8ba1\u7b97\u3001\u7269\u6d41\u7b49\u884c\u4e1a\u9762\u4e34\u66f4\u4e3a\u4e25\u683c\u7684\u76d1\u7ba1\u7ea6\u675f\uff0c\u589e\u52a0\u8fd0\u8425\u6210\u672c\u548c\u8d44\u672c\u652f\u51fa\uff1b\u6216\u901a\u8fc7\u4f9b\u5e94\u94fe\u4f20\u5bfc\u95f4\u63a5\u5f71\u54cd\u4e1a\u52a1\u7684\u6210\u672c\u7ed3\u6784\u4e0e\u5e02\u573a\u7ade\u4e89\u529b\uff0c\u589e\u52a0\u8fd0\u8425\u6210\u672c\u3002\\n\u2022 \u4e0a\u5e02\u5730\u53ca\u8fd0\u8425\u6240\u5728\u53f8\u6cd5\u7ba1\u8f96\u533a\u5bf9\u6c14\u5019\u4fe1\u606f\u62ab\u9732\u653f\u7b56\u65e5\u76ca\u4e25\u683c\uff0c\u589e\u52a0\u76f8\u5173\u5408\u89c4\u6210\u672c\u3002"},"technologyRisk":{"title":"\u6280\u672f\u98ce\u9669","description":"\u2022 \u4f4e\u78b3\u60c5\u666f\u4e0b\uff0c\u4e91\u8ba1\u7b97\u3001\u7269\u6d41\u7b49\u4e1a\u52a1\u5b9e\u73b0\u8f6c\u578b\u9700\u8981\u8f83\u591a\u4f4e\u78b3\u6280\u672f\u7814\u53d1\u3001\u8bbe\u5907\u7f6e\u6362\uff0c\u5de5\u7a0b\u5b9e\u65bd\u7b49\u76f8\u5173\u7684\u8d44\u672c\u652f\u51fa\uff0c\u540c\u65f6\u4e5f\u53ef\u80fd\u9020\u6210\u8d44\u4ea7\u51cf\u503c\u3002"},"reputationRisk":{"title":"\u58f0\u8a89\u98ce\u9669","description":"\u2022 \u5916\u90e8\u5bf9\u6c14\u5019\u5e94\u5bf9\u548c\u51cf\u6392\u8fdb\u5c55\u5173\u6ce8\u589e\u52a0\uff0c\u9700\u8981\u4ed8\u51fa\u66f4\u591a\u51cf\u6392\u52aa\u529b\u3001\u66f4\u9ad8\u7684\u62ab\u9732\u548c\u6c9f\u901a\u6210\u672c\u6765\u589e\u5f3a\u5229\u76ca\u76f8\u5173\u65b9\u7684\u4fe1\u5fc3\uff0c\u4fdd\u969c\u6d88\u8d39\u8005\u548c\u5ba2\u6237\u5fe0\u8bda\u5ea6\u548c\u81ea\u8eab\u878d\u8d44\u80fd\u529b\u3002"},"resourceEfficiency":{"title":"\u8d44\u6e90\u6548\u7387\u673a\u9047","description":"\u2022\u79ef\u6781\u52a0\u5927\u8d44\u6e90\u63d0\u6548\u6280\u672f\u5e94\u7528\uff0c\u53ef\u5728\u5b9e\u73b0\u51cf\u78b3\u7684\u540c\u65f6\u51cf\u5c11\u8fd0\u8425\u652f\u51fa\uff1b\u5728\u4f4e\u78b3\u8f6c\u578b\u8fc7\u7a0b\u4e2d\uff0c\u77ed\u671f\u5185\uff0c\u66f4\u65e9\u5e94\u7528\u8fd8\u6709\u53ef\u80fd\u5e26\u6765\u66f4\u591a\u673a\u9047\u3002"},"productService":{"title":"\u4ea7\u54c1\u4e0e\u670d\u52a1\u673a\u9047","description":"\u2022 \u968f\u7740\u6d88\u8d39\u8005\u3001\u5ba2\u6237\u53ca\u5408\u4f5c\u4f19\u4f34\u4f4e\u78b3\u610f\u8bc6\u4e0d\u65ad\u589e\u5f3a\uff0c\u5e02\u573a\u5bf9\u4f4e\u78b3\u4ea7\u54c1\u4e0e\u670d\u52a1\u7684\u9700\u6c42\u6301\u7eed\u6500\u5347\uff0c\u6355\u6349\u5e02\u573a\u8d8b\u52bf\uff0c\u8fc5\u901f\u54cd\u5e94\u5e02\u573a\u9700\u6c42\uff0c\u51ed\u501f\u7eff\u8272\u6d88\u8d39\u54c1\uff0c\u4e91\u670d\u52a1\u3001\u7269\u6d41\u7b49\u591a\u5143\u4e1a\u52a1\u5e03\u5c40\uff0c\u53ef\u63d0\u9ad8\u5e02\u573a\u7ade\u4e89\u529b\u3002\\n\u2022 \u4f9d\u6258\u5305\u62ec\u4eba\u5de5\u667a\u80fd\u5728\u5185\u7684\u6570\u5b57\u6280\u672f\uff0c\u4e3a\u5404\u884c\u4e1a\u63d0\u4f9b\u4f4e\u78b3\u89e3\u51b3\u65b9\u6848\uff0c\u6df1\u5ea6\u8d4b\u80fd\u793e\u4f1a\u5b9e\u73b0\u4f4e\u78b3\u8f6c\u578b"}},"actionData":{"infrastructure":{"type":"\u57fa\u7840\u8bbe\u65bd","description":"\u6211\u4eec\u6ce8\u91cd\u5173\u952e\u57fa\u7840\u8bbe\u65bd\u7684\u5168\u751f\u547d\u5468\u671f\u707e\u5bb3\u9632\u62a4\u6c34\u5e73\u3002\\n\u2022 \u8bbe\u8ba1\u548c\u5efa\u9020:\u529e\u516c\u56ed\u533a\u5728\u9009\u5740\u9636\u6bb5\u5145\u5206\u8003\u8651\u6c14\u5019\u98ce\u9669\uff0c\u8bbe\u8ba1\u5efa\u9020\u8fc7\u7a0b\u4e2d\u878d\u5165\u6c14\u5019\u97e7\u6027\u7406\u5ff5\uff0c\u91c7\u7528\u6d77\u7ef5\u57ce\u5e02\u8bbe\u8ba1\u539f\u5219\uff0c\u6709\u6548\u5e94\u5bf9\u96e8\u6c34\u7ba1\u7406\u6311\u6218;\u6570\u636e\u4e2d\u5fc3\u5efa\u9020\u8fc7\u7a0b\u4e2d\uff0c\u5145\u5206\u8003\u8651\u6f5c\u5728\u81ea\u7136\u707e\u5bb3\u98ce\u9669\u56e0\u7d20\uff0c\u901a\u8fc7\u786c\u4ef6\u8bbe\u65bd\u7684\u8bbe\u8ba1\u4ee5\u53ca\u6574\u4f53\u5e03\u5c40\u89c4\u5212(\u4f8b\u5982\u5728\u6d2a\u6d9d\u9ad8\u53d1\u533a\u57df\u63d0\u9ad8\u5ba4\u5185\u9ad8\u5ea6\uff0c\u5c06\u5173\u952e\u8bbe\u5907\u653e\u7f6e\u4e8e\u975e\u9996\u5c42\u533a\u57df)\uff0c\u589e\u5f3a\u5bb9\u707e\u548c\u5bb9\u9519\u80fd\u529b\u3002\\n\u2022 \u5e94\u6025\u7269\u8d44\u548c\u8bbe\u5907:\u90e8\u7f72\u9632\u6c34\u95f8\u548c\u9632\u6c5b\u6c99\u888b\uff0c\u4f5c\u4e3a\u65e5\u5e38\u6d2a\u6d9d\u53f0\u98ce\u7ba1\u7406\u7684\u57fa\u7840\u914d\u7f6e;\u6570\u636e\u4e2d\u5fc3\u914d\u5907\u4e0d\u95f4\u65ad\u5e94\u6025\u7535\u6e90\u548c\u67f4\u6cb9\u53d1\u7535\u8bbe\u5907\u3002\\n\u2022 \u8bbe\u65bd\u8fd0\u7ef4:\u529e\u516c\u56ed\u533a\u5728\u8fd0\u8425\u7ef4\u62a4\u9636\u6bb5\u5efa\u7acb\u5b8c\u5584\u7684\u8bbe\u65bd\u7ba1\u7406\u7cfb\u7edf\uff0c\u5b9a\u671f\u68c0\u67e5\u7ef4\u62a4\u9ad8\u6548\u6392\u6c34\u7cfb\u7edf\u3001\u4e0b\u51f9\u5f0f\u7eff\u5730\u3001\u900f\u6c34\u94fa\u88c5\u7b49\u6c14\u5019\u9002\u5e94\u578b\u57fa\u7840\u8bbe\u65bd\u3002"},"operation":{"type":"\u8fd0\u8425","description":"\u6211\u4eec\u5236\u5b9a\u5168\u6d41\u7a0b\u7684\u9632\u63a7\u9884\u6848\uff0c\u6db5\u76d6\u4e8b\u524d\u51c6\u5907\u3001\u4e8b\u4e2d\u6267\u884c\u53ca\u4e8b\u540e\u6062\u590d\uff0c\u4ee5\u4fdd\u969c\u7535\u5546\u3001\u4e91\u3001\u7269\u6d41\u7b49\u4e1a\u52a1\u8fd0\u8425\u7684\u8fde\u7eed\u6027\u3002\u6211\u4eec\u5efa\u7acb\u5206\u7ea7\u9884\u8b66\u4f53\u7cfb\uff0c\u7ed3\u5408\u6c14\u8c61\u76d1\u63a7\u6570\u636e\u63d0\u524d\u8bc6\u522b\u6f5c\u5728\u98ce\u9669;\u9488\u5bf9\u4e0d\u540c\u6781\u7aef\u5929\u6c14\u7c7b\u578b(\u5982\u53f0\u98ce\u3001\u66b4\u96ea\u3001\u51bb\u96e8)\uff0c\u5b8c\u5584\u65e9\u671f\u9884\u8b66\u3001 \u4e0a\u62a5\u6d41\u7a0b\u548c\u5206\u7c7b\u4e13\u9879\u54cd\u5e94\u8ba1\u5212\u3002"},"personnel":{"type":"\u4eba\u5458","description":"\u6211\u4eec\u4ece\u4f5c\u4e1a\u73af\u5883\u3001\u65e5\u5e38\u7ba1\u7406\u548c\u57f9\u8bad\u4e09\u4e2a\u65b9\u9762\u63d0\u5347\u4eba\u5458\u7684\u6781\u7aef\u5929\u6c14\u9002\u5e94\u80fd\u529b\u3002\\n\u2022 \u4f5c\u4e1a\u73af\u5883:\u4f18\u5316\u529e\u516c\u56ed\u533a\u3001\u7269\u6d41\u4ed3\u5e93\u7b49\u7269\u7406\u4f5c\u4e1a\u73af\u5883\u4ee5\u4fdd\u969c\u4eba\u5458\u5728\u9002\u5b9c\u7684\u73af\u5883\u4e2d\u5de5\u4f5c\uff0c\u4e3a\u5feb\u9012\u5458\u548c\u9a91\u624b\u63d0\u4f9b\u9632\u6691\u964d\u6e29\u7a7a\u95f4\u548c\u7269\u8d44\u7b49\u3002\\n\u2022 \u7ba1\u7406:\u5408\u7406\u5b89\u6392\u5458\u5de5\u8f6e\u73ed\u4e0e\u4f11\u606f\u65f6\u95f4\uff0c\u843d\u5b9e\u6781\u7aef\u5929\u6c14\u5e94\u5bf9\u65b9\u6848\uff0c\u51cf\u5c11\u9ad8\u6e29\u7b49\u6781\u7aef\u5929\u6c14\u66b4\u9732\u5bf9\u5065\u5eb7\u7684\u4e0d\u5229\u5f71\u54cd\u3002\\n\u2022 \u57f9\u8bad:\u5b9a\u671f\u8fdb\u884c\u6781\u7aef\u5929\u6c14\u5e94\u6025\u6f14\u7ec3\uff0c\u4ee5\u786e\u4fdd\u5458\u5de5\u80fd\u591f\u8fc5\u901f\u6709\u6548\u5730\u6267\u884c\u5e94\u6025\u9884\u6848\u3002"},"supplyChain":{"type":"\u4f9b\u5e94\u94fe","description":"\u6211\u4eec\u91c7\u53d6\u591a\u5143\u5316\u7b56\u7565\u7ed3\u5408\u7f51\u7edc\u4f18\u5316\u89c4\u5212\uff0c\u63d0\u9ad8\u4f9b\u5e94\u94fe\u7684\u6c14\u5019\u97e7\u6027\uff0c\u6839\u636e\u6781\u7aef\u5929\u6c14\u9884\u8b66\u548c\u5206\u6790\uff0c\u7075\u6d3b\u8c03\u6574\u4f9b\u5e94\u5546\u7ec4\u5408\u4ee5\u786e\u4fdd \u7a33\u5b9a\u4f9b\u5e94\uff0c\u540c\u65f6\u52a8\u6001\u4f18\u5316\u53d1\u8d27\u4ed3\u5e93\u9009\u5740\u4e0e\u7269\u6d41\u914d\u9001\u8def\u5f84\u89c4\u5212\uff0c\u786e\u4fdd\u4f9b\u5e94\u94fe\u7684\u9ad8\u6548\u8fd0\u8f6c\u4e0e\u4ea4\u4ed8\u80fd\u529b\u3002"}},"systematicBuildingCapabilities":"\u4f53\u7cfb\u5316\u6784\u5efa\u6c14\u5019\u9002\u5e94\u80fd\u529b","infrastructure":"\u57fa\u7840\u8bbe\u65bd","operations":"\u8fd0\u8425","personnel":"\u4eba\u5458","supplyChain":"\u4f9b\u5e94\u94fe","operatingExpenditure":"\u8fd0\u8425\u652f\u51fa","operatingRevenue":"\u8425\u4e1a\u6536\u5165","assetImpairment":"\u8d44\u4ea7\u4ef7\u503c","capitalExpenditure":"\u8d44\u672c\u652f\u51fa","operatingCosts":"\u8fd0\u8425\u6210\u672c","financingCosts":"\u878d\u8d44\u6210\u672c","governance":{"title":"\u6c14\u5019\u6cbb\u7406","description":"\u6c14\u5019\u6cbb\u7406\u662f\u963f\u91cc\u5df4\u5df4 ESG \u6cbb\u7406\u548c\u98ce\u9669\u7ba1\u7406\u4f53\u7cfb\u7684\u4e00\u90e8\u5206\u3002\u8463\u4e8b\u4f1a\u53ef\u6301\u7eed\u53d1\u5c55\u59d4\u5458\u4f1a\u8d1f\u8d23\u76d1\u7763\u6c14\u5019\u76f8\u5173\u98ce\u9669\u4e0e\u673a\u9047\uff0c\u5ba1\u9605\u5e94\u5bf9\u7b56\u7565\u548c\u76ee\u6807\u8fdb\u5ea6\u3002\u5728\u53ef\u6301\u7eed\u53d1\u5c55\u7ba1\u7406\u59d4\u5458\u4f1a\u9886\u5bfc\u4e0b\uff0cESG \u6218\u7565\u8fd0\u8425\u4e0e\u7814\u7a76\u90e8\u7275\u5934\u6210\u7acb\u6c14\u5019\u53d8\u5316\u5de5\u4f5c\u7ec4\uff0c\u6210\u5458\u5305\u62ec\u6cd5\u52a1\u3001\u5185\u63a7\u3001\u5168\u9762\u98ce\u9669\u7ba1\u7406\u53ca\u6295\u8d44\u8005\u5173\u7cfb\u7b49\u90e8\u95e8\uff0c\u534f\u540c\u5404\u4e1a\u52a1\u96c6\u56e2\u548c\u516c\u53f8\u63a8\u8fdb\u5de5\u4f5c\u3002","image":"https://img.alicdn.com/imgextra/i1/O1CN01XbcHKM1zfV9wbWxw1_!!6000000006741-0-tps-2880-900.jpg"},"strategySection":{"title":"\u6c14\u5019\u6218\u7565\u4e0e\u884c\u52a8","tabAssessment":"\u8bc6\u522b\u4e0e\u8bc4\u4f30\u6c14\u5019\u98ce\u9669\u548c\u673a\u9047","tabAction":"\u6c14\u5019\u884c\u52a8","assessmentDescription":"\u6211\u4eec\u57fa\u4e8e\u8054\u5408\u56fd\u653f\u5e9c\u95f4\u6c14\u5019\u53d8\u5316\u4e13\u95e8\u59d4\u5458\u4f1a\uff08IPCC\uff09\u4e0e\u56fd\u9645\u80fd\u6e90\u7f72\uff08IEA\uff09\u7684\u4f4e\u78b3\u548c\u9ad8\u78b3\u6c14\u5019\u60c5\u666f\uff0c\u5bf9\u56fd\u9645\u548c\u56fd\u5185\u7535\u5546\u3001\u4e91\u8ba1\u7b97\u3001\u7269\u6d41\u7b49\u4e1a\u52a1\u5f00\u5c55\u6c14\u5019\u98ce\u9669\u4e0e\u673a\u9047\u8bc4\u4f30\uff0c\u8986\u76d6\u77ed\u4e2d\u957f\u671f\u3002","actionDescription":"\u6211\u4eec\u4ece\u6c14\u5019\u9002\u5e94\u548c\u6c14\u5019\u51cf\u7f13\u4e24\u65b9\u9762\u63d0\u5347\u81ea\u8eab\u8fd0\u8425\u97e7\u6027\uff0c\u5e76\u900f\u8fc7\u4ea7\u54c1\u670d\u52a1\u548c\u5916\u90e8\u534f\u4f5c\u652f\u6301\u66f4\u5e7f\u6cdb\u7684\u793e\u4f1a\u97e7\u6027\u3002","assessmentCards":[{"title":"\u7269\u7406\u98ce\u9669","description":"\u4e3b\u8981\u4e3a\u6781\u7aef\u9ad8\u6e29\u3001\u6d2a\u6d9d\u4e0e\u70ed\u5e26\u6c14\u65cb\u3001\u6c34\u538b\u529b\u4e0e\u5e72\u65f1\u3002\u7269\u7406\u98ce\u9669\u5728\u77ed\u671f\u5185\u603b\u4f53\u53ef\u63a7\uff0c\u4f46\u5728\u9ad8\u78b3\u60c5\u666f\u4e0b\uff0c\u4e2d\u957f\u671f\u5f71\u54cd\u53ef\u80fd\u4e0a\u5347\u3002"},{"title":"\u8f6c\u578b\u98ce\u9669","description":"\u8f6c\u578b\u98ce\u9669\u4e3b\u8981\u4f53\u73b0\u5728\u653f\u7b56\u4e0e\u6cd5\u89c4\u3001\u6280\u672f\u3001\u5e02\u573a\u548c\u58f0\u8a89\u7b49\u65b9\u9762\u3002\u4f4e\u78b3\u60c5\u666f\u4e0b\u4e2d\u671f\u6709\u589e\u52a0\u8d8b\u52bf\u3002"},{"title":"\u8f6c\u578b\u673a\u9047","description":"\u8f6c\u578b\u673a\u9047\u4e3b\u8981\u6765\u81ea\u8d44\u6e90\u6548\u7387\u63d0\u5347\u548c\u4ea7\u54c1\u670d\u52a1\u521b\u65b0\uff0c\u5e76\u53ef\u80fd\u968f\u4f4e\u78b3\u8f6c\u578b\u63a8\u8fdb\u800c\u589e\u52a0\u3002"}],"actionCards":[{"title":"\u9002\u5e94\u4e0e\u51cf\u7f13","description":"\u9002\u5e94\u5c42\u9762\uff0c\u9488\u5bf9\u4e3b\u8981\u7269\u7406\u98ce\u9669\uff0c\u56f4\u7ed5\u57fa\u7840\u8bbe\u65bd\u3001\u8fd0\u8425\u3001\u4eba\u5458\u3001\u4ef7\u503c\u94fe\u56db\u4e2a\u7ef4\u5ea6\uff0c\u5c06\u7269\u7406\u98ce\u9669\u7ba1\u7406\u8981\u6c42\u5d4c\u5165\u5173\u952e\u8d44\u4ea7\u5168\u751f\u547d\u5468\u671f\u7ba1\u7406\u6d41\u7a0b\u3002\u51cf\u7f13\u5c42\u9762\uff0c\u9488\u5bf9\u653f\u7b56\u4e0e\u6cd5\u89c4\u3001\u6280\u672f\u3001\u5e02\u573a\u4e0e\u58f0\u8a89\u56db\u7c7b\u8f6c\u578b\u98ce\u9669\uff0c\u7ed3\u5408\u5176\u7279\u5f81\u90e8\u7f72\u76f8\u5e94\u7684\u51cf\u7f13\u884c\u52a8\uff0c\u5e76\u5d4c\u5165\u65e5\u5e38\u7ba1\u7406\u673a\u5236\u3002"},{"title":"\u4ea7\u54c1\u4e0e\u670d\u52a1","description":"\u6211\u4eec\u5c06\u6c14\u5019\u9002\u5e94\u4e0e\u51cf\u7f13\u8981\u6c42\u7eb3\u5165\u76f8\u5173\u4ea7\u54c1\u548c\u670d\u52a1\u7684\u6301\u7eed\u4f18\u5316\uff0c\u628a\u81ea\u8eab\u8fd0\u8425\u4e2d\u6c89\u6dc0\u7684\u80fd\u529b\u5e94\u7528\u5230\u66f4\u5e7f\u6cdb\u7684\u4ef7\u503c\u94fe\u4e2d\uff0c\u63a8\u8fdb\u4ece\u81ea\u8eab\u97e7\u6027\u5411\u793e\u4f1a\u97e7\u6027\u7684\u5ef6\u4f38\u3002"},{"title":"\u5916\u90e8\u534f\u4f5c","description":"\u6211\u4eec\u5f00\u5c55\u5916\u90e8\u534f\u4f5c\uff0c\u4ece\u79ef\u6781\u53c2\u4e0e\u6c14\u5019\u53d8\u5316\u9886\u57df\u6807\u51c6\u5236\u5b9a\uff0c\u5230\u8de8\u754c\u8054\u5408\u7814\u7a76\u53ca\u56fd\u9645\u4ea4\u6d41\uff0c\u5c06\u81ea\u8eab\u7684\u4e1a\u52a1\u53d1\u5c55\u548c\u6c14\u5019\u5e94\u5bf9\u6218\u7565\u878d\u5165\u5168\u7403\u548c\u4e2d\u56fd\u7684\u6c14\u5019\u6cbb\u7406\u8bae\u7a0b\u3002"}]},"riskManagement":{"title":"\u6c14\u5019\u98ce\u9