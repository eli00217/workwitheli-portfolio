1\u7b97\u673a\u6559\u5ba4\\"\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u7d2f\u8ba1\u6350\u5efa300\u95f4\\"\u4e91\u8ba1\u7b97\u673a\u6559\u5ba4\\"\uff0c\u8ba9\u8d8528\u4e07\u5e08\u751f\u62e5\u6709\u4e2a\u4eba\u4e91\u7535\u8111\u8d26\u53f7\u3002\u56f4\u7ed5 AI \u8d4b\u80fd\u4e61\u6751\u6559\u80b2\uff0c\u6211\u4eec\u5f00\u5c55\u4e86\u4e00\u7cfb\u5217\u6d3b\u52a8\uff0c\u5305\u62ec\u7ec4\u7ec7\u8001\u5e08\u5b66\u4e60\u5728\u6559\u5b66\u8fc7\u7a0b\u4e2d\u5982\u4f55\u4f7f\u7528AI\uff0c\u5f15\u5bfc\u5b66\u751f\u4f53\u9a8c\u548c\u5e94\u7528AI \u5927\u6a21\u578b\u80fd\u529b\u7b49\u3002","ruralPractice5Title":"\\"\u5c0f\u9e7f\u706f\\"\u513f\u7ae5\u91cd\u75be\u6551\u52a9\u9879\u76ee","ruralPractice5Desc":"\\"\u5c0f\u9e7f\u706f\\"\u513f\u7ae5\u91cd\u75be\u6551\u52a9\u516c\u76ca\u9879\u76ee\u7531\u963f\u91cc\u5df4\u5df4\u516c\u76ca\u3001\u963f\u91cc\u5065\u5eb7\u516c\u76ca\u8054\u5408\u673a\u6784\u5171\u540c\u53d1\u8d77\uff0c \u901a\u8fc7\\"\u4e3b\u52a8\u6551\u52a9\\"\u7684\u65b9\u5f0f\uff0c\u4e3a\u91cd\u75be\u513f\u7ae5\u63d0\u4f9b\u533b\u7597\u63f4\u52a9\u53ca\u8bca\u7597\u8d39\u7528\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\\"\u5c0f\u9e7f\u706f\\"\u9879\u76ee\u7d2f\u8ba1\u6295\u51654,859 \u4e07\u5143\uff0c\u63f4\u52a9\u7b26\u5408\u6761\u4ef6\u7684\u60a3\u513f 2,300 \u4eba\u3002","emergencyReliefTitle":"\u5e94\u6025\u6551\u707e","emergencyIntroText":"\u5728\u707e\u60c5\u9762\u524d\uff0c\u963f\u91cc\u5df4\u5df4\u5145\u5206\u8c03\u52a8\u5404\u4e1a\u52a1\u7684\u80fd\u529b\u548c\u8d44\u6e90\uff0c\u591a\u65b9\u4f4d\u54cd\u5e94\u5e94\u6025\u6551\u707e\u5de5\u4f5c\u30022025 \u8d22\u5e74\uff0c\u6211\u4eec\u4e0e\u4e2d\u56fd\u5e94\u6025\u7ba1\u7406\u90e8\u6551\u707e\u53f8\u8fbe\u6210\u5408\u4f5c\u534f\u8bae\uff0c\u81f4\u529b\u4e8e\u4e3a\u5168\u9762\u63d0\u5347\u793e\u4f1a\u5e94\u6025\u7269\u8d44\u7efc\u5408\u4fdd\u969c\u80fd\u529b\u505a\u51fa\u8d21\u732e\u3002\u6b64\u5916\uff0c\u83dc\u9e1f\u8fd8\u81ea\u4e3b\u7814\u53d1\u56fd\u5185\u9996\u4e2a\\"\u5e94\u6025\u7269\u8d44\u8ffd\u6eaf\u7ba1\u7406\u5e73\u53f0\\"\uff0c\u4e3a\u7edf\u8ba1\u3001\u91c7\u8d2d\u3001\u8fd0\u8f93\u3001\u53d1\u653e\u6551\u707e\u7269\u8d44\u7b49\u590d\u6742\u7684\u6d41\u7a0b\u7ba1\u7406\u73af\u8282\u5b9e\u73b0\u63d0\u6548\u3002","reliefCase1Title":"\u54cd\u5e94\u897f\u85cf\u9707\u707e","reliefCase1Desc":"2025\u5e741\u6708\uff0c\u897f\u85cf\u65e5\u5580\u5219\u5e02\u5b9a\u65e5\u53bf\u53d1\u751f 6.8 \u7ea7\u5730\u9707\uff0c\u6211\u4eec\u542f\u52a8\u5e94\u6025\u7269\u8d44\u653f\u793e\u534f\u540c\u4fdd\u969c\u673a\u5236\uff0c\u7b2c\u4e00\u65f6\u95f4\u8c03\u914d\u8d44\u6e90\uff0c\u5148\u540e\u7ec4\u7ec7\u4e09\u4e2a\u6279\u6b21\u7684\u7269\u8d44\u9a70\u63f4\u707e\u533a\u3002","reliefCase2Title":"\u5e94\u5bf9\u6d2a\u6d9d\u707e\u5bb3","reliefCase2Desc":"2025\u8d22\u5e74\uff0c\u6c34\u707e\u671f\u95f4\uff0c\u963f\u91cc\u5df4\u5df4\u5bf9\u5305\u62ec\u6e56\u5357\u7701\u8d44\u5174\u5e02\u3001\u8d35\u5dde\u7701\u9547\u8fdc\u53bf\u3001\u6d77\u5357\u7701\u6587\u660c\u5e02\u7b49\u5728\u5185\u7684 9 \u7701 17 \u533a\u53bf\u5e02\u5f00\u5c55\u6551\u63f4\u3002","reliefCase3Title":"\u53c2\u4e0e\u6551\u52a9\u8d8a\u5357\u707e\u60c5","reliefCase3Desc":"2024\u5e749\u6708\uff0c\u8d85\u5f3a\u53f0\u98ce\u201c\u6469\u7faf\u201d\u7740\u9646\u8d8a\u5357\u671f\u95f4\uff0cLazada\u901a\u8fc7\u6350\u8d60\u8d44\u91d1\u548c\u7269\u8d44\u3001\u7ec4\u7ec7\u5458\u5de5\u6350\u52a9\u3001\u534f\u8c03\u7269\u6d41\u8d44\u6e90\u53c2\u4e0e\u5e94\u6025\u6551\u707e\u3002","techForSocialTitle":"\u79d1\u6280\u52a9\u529b\u89e3\u51b3\u793e\u4f1a\u6311\u6218","techIntroText":"\u4f5c\u4e3a\u4e00\u5bb6\u79d1\u6280\u516c\u53f8\uff0c\u6211\u4eec\u9664\u4e86\u5c06\u79d1\u6280\u89c6\u4e3a\u63a8\u52a8\u81ea\u8eab\u4e1a\u52a1\u53d1\u5c55\u7684\u5f15\u64ce\u5916\uff0c\u4e5f\u5728\u79ef\u6781\u63a2\u7d22\u79d1\u6280\u6240\u80fd\u5e26\u6765\u7684\u793e\u4f1a\u4ef7\u503c\u3002","techSolution1Title":"AI\u8f85\u52a9\u764c\u75c7\u7b5b\u67e5","techSolution1Desc":"2025 \u8d22\u5e74\uff0c\u6211\u4eec\u5c06 AI \u8d4b\u80fd CT \u5f71\u50cf\u8bc6\u522b\u80f0\u817a\u764c\u7684\u80fd\u529b\u6269\u5c55\u5e94\u7528\u4e8e\u591a\u79cd\u764c\u75c7\u7684\u7b5b\u67e5\u73af\u8282\uff0c\u5e76\u901a\u8fc7\u4e0e\u533b\u9662\u5408\u4f5c\uff0c\u4ee5\u516c\u76ca\u7684\u65b9\u5f0f\u63a8\u52a8\\"\u5e73\u626b CT+AI\\"\u591a\u764c\u7b5b\u67e5\u6280\u672f\u5728\u5b9e\u8df5\u4e2d\u8bd5\u70b9\u843d\u5730\u3002","techSolution2Title":"\u53c2\u4e0e\u65e0\u4eba\u533a\u6551\u63f4","techSolution2Desc":"\u9ad8\u5fb7\u5730\u56fe\u7814\u53d1\u63a8\u51fa\\"\u536b\u661f\u65e0\u7f51\u5bfc\u822a\\"\u529f\u80fd\uff0c\u6709\u6548\u89e3\u51b3\u7528\u6237\u5728\u65e0\u7f51\u7edc\u73af\u5883\u4e0b\u7684\u65b9\u5411\u8ff7\u5931\u95ee\u9898\uff1b\u540c\u65f6\u4e0a\u7ebf\u7684\\"\u536b\u661f\u6c42\u6551\\"\u529f\u80fd\uff0c\u901a\u8fc7\u536b\u661f\u53ef\u5b9e\u73b0\u7d27\u6025\u901a\u8baf\u3002\u540c\u65f6\uff0c\u9ad8\u5fb7\u5730\u56fe\u63a8\u51fa\u4e00\u5957\u5b8c\u6574\u7684\u673a\u5236\u4e0e\u6d41\u7a0b\uff0c\u5b9e\u73b0\\"\u65e0\u4eba\u533a\u6709\u9ad8\u5fb7\\"\u3002","techSolution3Title":"\u516b\u89c2\u6c14\u8c61\u5927\u6a21\u578b","techSolution3Desc":"\u5e94\u7528 AI \u6280\u672f\u7684\u6c14\u8c61\u9884\u6d4b\u80fd\u591f\u52a9\u529b\u7535\u529b\u7cfb\u7edf\u66f4\u52a0\u7cbe\u51c6\u5339\u914d\u7535\u529b\u9700\u6c42\u4e0e\u4f9b\u7ed9\u30022025 \u8d22\u5e74\uff0c\u6211\u4eec\u6b63\u5f0f\u53d1\u5e03\u516b\u89c2\u6c14\u8c61\u5927\u6a21\u578b\u5e76\u5df2\u7387\u5148\u5728\u53ef\u518d\u751f\u80fd\u6e90\u5360\u6bd4\u9ad8\u7684\u65b0\u578b\u7535\u529b\u7cfb\u7edf\u843d\u5730\u3002","employmentSupportTitle":"\u4fc3\u8fdb\u521b\u4e1a\u5c31\u4e1a","employmentIntroText":"\u6211\u4eec\u548c\u751f\u6001\u5408\u4f5c\u4f19\u4f34\u6210\u529f\u5f00\u5c55\u4e1a\u52a1\u7684\u540c\u65f6\uff0c\u4e5f\u5e26\u6765\u521b\u4e1a\u5c31\u4e1a\u673a\u4f1a\u3002\u8fd9\u4e9b\u673a\u4f1a\u540c\u65f6\u5448\u73b0\u5305\u5bb9\u3001\u9ad8\u8d28\u91cf\u7b49\u7279\u70b9\u3002","inclusiveEmploymentTitle":"\u5305\u5bb9\u7684\u521b\u4e1a\u5c31\u4e1a","inclusiveEmploymentDesc":"\u657