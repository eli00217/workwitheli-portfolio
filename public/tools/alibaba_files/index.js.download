29\u4fdd\u969c\uff0c\u63a8\u52d5\u5efa\u8a2d\u300c\u5feb\u6a02\u5de5\u4f5c\u3001\u8a8d\u771f\u751f\u6d3b\u300d\u7684\u6c1b\u570d\u3002","recruitingTalentsTitle":"\u62db\u8058\u4eba\u624d","recruitingTalentsDescription":"\u70ba\u4e86\u80fd\u5920\u300c\u9078\u5c0d\u5408\u9069\u7684\u4eba\uff0c\u62db\u5230\u5408\u9069\u7684\u4eba\u300d\uff0c\u6211\u5011\u5728\u5efa\u7acb\u591a\u6a23\u5316\u4eba\u624d\u62db\u8058\u7ba1\u9053\u7684\u540c\u6642\uff0c\u4e5f\u975e\u5e38\u91cd\u8996\u61c9\u5fb5\u8005\u7684\u9ad4\u9a57\u548c\u9eb5\u8a66\u904e\u7a0b\u4e2d\u7684\u5408\u898f\u7ba1\u7406\u3002","socialRecruitmentTitle":"\u591a\u6a23\u5316\u7684\u62db\u8058\u6e20\u9053","socialRecruitmentDescription":"\u5efa\u8a2d\u958b\u653e\u3001\u591a\u6a23\u7684\u4eba\u624d\u62db\u8058\u6e20\u9053\u4f86\u6eff\u8db3\u4eba\u624d\u9700\u6c42\uff0c\u5305\u62ec\u793e\u6703\u62db\u8058\u3001\u6821\u5712\u62db\u8058\u3001\u54e1\u5de5\u5167\u63a8\u7b49\u3002\u300c\u963f\u91cc\u661f\u300d\u4eba\u624d\u8a08\u5283\u62db\u52df\u4e26\u57f9\u990a\u5168\u7403\u9802\u5c16\u9752\u5e74\u79d1\u7814\u4eba\u624d\u3002","socialRecruitmentLink":"\u7acb\u5373\u52a0\u5165","campusRecruitmentTitle":"\u91cd\u8996\u62db\u8058\u9ad4\u9a57","campusRecruitmentDescription":"\u900f\u904e\u5236\u5b9a\u6a19\u6e96\u62db\u8058\u6d41\u7a0b\u3001\u63d0\u4f9b\u9762\u8a66\u5b98\u57f9\u8a13\u548c\u5efa\u7acb\u61c9\u5fb5\u8005\u9ad4\u9a57\u53cd\u994b\u6a5f\u5236\u7b49\u65b9\u5f0f\u4f86\u63d0\u5347\u62db\u8058\u9ad4\u9a57\uff0c\u4fdd\u969c\u61c9\u5fb5\u8005\u80fd\u5920\u7372\u5f97\u5e73\u7b49\u3001\u900f\u660e\u3001\u53cb\u5584\u7684\u62db\u8058\u9ad4\u9a57\u3002","compensationSystemTitle":"\u516c\u5e73\u3001\u6709\u7af6\u722d\u529b\u7684\u85aa\u916c\u548c\u7e3e\u6548\u8a55\u4f30\u9ad4\u7cfb","compensationSystemDescription":"\u6211\u5011\u81f4\u529b\u65bc\u8207\u54e1\u5de5\u5171\u4eab\u767c\u5c55\u6210\u679c\uff0c\u5efa\u7acb\u54e1\u5de5\u5408\u6cd5\u6b0a\u76ca\u9ad4\u7cfb\uff0c\u4f7f\u5f97\u85aa\u916c\u6fc0\u52f5\u517c\u5177\u5167\u90e8\u516c\u5e73\u6027\u548c\u5916\u90e8\u7af6\u722d\u529b\u3002","compensationSystemContent":"\u963f\u91cc\u5df4\u5df4\u5168\u9ad4\u54e1\u5de5\u6bcf\u5e74\u63a5\u53d7\u7e3e\u6548\u8a55\u4f30\uff0c\u7e3e\u6548\u7d50\u679c\u61c9\u7528\u65bc\u5168\u9ad4\u54e1\u5de5\u7684\u77ed\u671f\u548c\u9577\u671f\u6fc0\u52f5\u3002\u6211\u5011\u5f9e\u591a\u500b\u7dad\u5ea6\u8a55\u4f30\u54e1\u5de5\u7e3e\u6548\u8868\u73fe\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u76ee\u6a19\u7ba1\u7406\u6a5f\u5236\u3001\u696d\u7e3e\u548c\u50f9\u503c\u89c0\u7684\u7e3e\u6548\u8003\u6838\u5236\u5ea6\u3001\u5718\u968a\u7e3e\u6548\u8003\u6838\u6a5f\u5236\u3001\u968e\u6bb5\u6027\u9748\u6d3b\u7e3e\u6548\u53ca\u767c\u5c55\u5c0d\u8a71\uff1b\u6211\u5011\u5efa\u7acb\u8207\u7e3e\u6548\u639b\u9264\u7684\u6fc0\u52f5\u6a5f\u5236\uff0c\u70ba\u6240\u6709\u54e1\u5de5\u63d0\u4f9b\u5177\u6709\u5e02\u5834\u7af6\u722d\u529b\u7684\u85aa\u916c\u798f\u5229\u3002","heartWarmingBenefitsTitle":"\u6709\u6eab\u5ea6\u7684\u798f\u5229\u6b0a\u76ca","heartWarmingBenefitsDescription":"\u963f\u91cc\u5df4\u5df4\u81f4\u529b\u65bc\u70ba\u6240\u6709\u54e1\u5de5\u63d0\u4f9b\u6709\u6eab\u5ea6\u7684\u798f\u5229\u3002\u4e0d\u540c\u570b\u5bb6\u3001\u5730\u5340\u53ca\u884c\u696d\u5c0d\u54e1\u5de5\u798f\u5229\u7684\u6cd5\u5f8b\u898f\u5b9a\u4e0d\u76e1\u76f8\u540c\u3002\u6211\u5011\u5145\u5206\u5c0a\u91cd\u548c\u9075\u5faa\u76f8\u95dc\u7684\u898f\u5b9a\uff0c\u5236\u5b9a\u4e86\u8207\u6240\u5728\u5730\u5340\u76f8\u9069\u61c9\u7684\u798f\u5229\u9ad4\u7cfb\uff0c\u70ba\u54e1\u5de5\u751a\u81f3\u5176\u5bb6\u5c6c\u63d0\u4f9b\u751f\u6d3b\u4fdd\u969c\uff0c\u4ee5\u6e1b\u8f15\u5f8c\u9867\u4e4b\u6182\u3002","socialSecurityTitle":"\u4e94\u96aa\u4e00\u91d1","socialSecurityDescription":"\u5de5\u50b7\u4fdd\u96aa\u3001\u5931\u696d\u4fdd\u96aa\u3001\u57fa\u672c\u91ab\u7642\u4fdd\u96aa\u3001\u57fa\u672c\u990a\u8001\u4fdd\u96aa\u3001\u751f\u80b2\u4fdd\u96aa\u3001\u4f4f\u623f\u516c\u7a4d\u91d1","statutoryLeaveTitle":"\u6cd5\u5b9a\u5047\u671f","statutoryLeaveDescription":"\u5e74\u5047\u3001\u5a5a\u5047\u3001\u5b55\u6aa2\u5047\u3001\u7522\u5047\u3001\u80b2\u5152\u5047\u3001\u54fa\u4e73\u6642\u9593\u3001\u966a\u7522\u5047","workLifeBalanceTitle":"\u751f\u6d3b\u5e73\u8861","workLifeBalanceDescription":"\u7279\u8272\u5047\u671f\uff1a\u966a\u4f34\u5047\u3001\u9577\u671f\u670d\u52d9\u5047\u3001\u8def\u9014\u5047\u3001outing\u5047\u3001\u5f48\u6027\u8fa6\u516c","featuredGiftsTitle":"\u7279\u8272\u79ae","featuredGiftsDescription":"\u5165\u8077\u5468\u5e74\u79ae\u3001\u963f\u91cc\u5bb6\u66f8\u3001\u5a66\u5973\u7bc0\u79ae\u7269\u3001\u4e2d\u79cb\u79ae\u5305\u3001\u5348\u9910\u665a\u9910\u591c\u5bb5\u88dc\u8cbc","employeeSupportTitle":"\u54e1\u5de5\u652f\u6301\u548c\u4fdd\u969c","employeeSupportDescription":"iHelp\u84b2\u516c\u82f1\u4e92\u52a9\u8a08\u5283\u3001iHope\u5f69\u8679\u8a08\u5283\u3001iHome\u7f6e\u696d\u8a08\u5283\u3001\u88dc\u5145\u578b\u5546\u696d\u4fdd\u96aa\uff08\u542b\u4eba\u8eab\u96aa\u3001\u5546\u696d\u88dc\u5145\u91ab\u7642\u4fdd\u96aa\u548c\u767e\u842c\u91ab\u7642\u96aa\uff09","familyCareTitle":"\u95dc\u611b\u5bb6\u4eba","familyCareDescription":"\u5b50\u5973\u7d9c\u5408\u5546\u696d\u4fdd\u96aa\u3001\u5eb7\u4e43\u99a8\u7236\u6bcd\u9ad4\u6aa2\u3001\u5bb6\u5ead\u95dc\u611b\u6d3b\u52d5\uff08\u80b2\u5152\u8ab2\u5802\u3001\u5065\u5eb7\u8aee\u8a62\u7b49\uff09\uff0c\u53ca\u5176\u4ed6\u7279\u8272\u4fdd\u969c\u7b49\uff08iHelp\u84b2\u516c\u82f1\u4e92\u52a9\u8a08\u5283\u3001iHope\u5f69\u8679\u8a08\u5283\uff09","healthcareTitle":"\u5065\u5eb7\u91ab\u7642","healthcareDescription":"\u5e74\u5ea6\u5065\u5eb7\u9ad4\u6aa2\u548c\u89e3\u8b80\u3001iHealth\u54e1\u5de5\u5065\u5eb7\u95dc\u611b\uff08\u542b\u8eab\u5fc3\u5065\u5eb7\u8aee\u8a62\u3001\u5065\u5eb7\u666e\u53ca\u3001\u5065\u5eb7\u6d3b\u52d5\u3001\u5065\u5eb7\u4e2d\u5fc3\u7b49\uff09\u3001\u7406\u7642\u670d\u52d9\u3001\u904b\u52d5\u5065\u8eab\u5834\u6240","aliLetterHomeTitle":"\u963f\u91cc\u5bb6\u66f8","aliLetterHomeDescription":"\u963f\u91cc\u5df4\u5df4\u6bcf\u5e74\u90fd\u6703\u5411\u54e1\u5de5\u5bb6\u4eba\u5bc4\u9001\u7cbe\u5fc3\u6e96\u5099\u7684\u5bb6\u66f8\uff0c\u9019\u4efd\u5bb6\u66f8\u4e0d\u50c5\u662f\u4e00\u4efd\u79ae\u7269\uff0c\u66f4\u860a\u542b\u8457\u963f\u91cc\u5df4\u5df4\u5c0d\u6bcf\u4f4d\u54e1\u5de5\u5bb6\u5ead\u7684\u95dc\u61f7\u8207\u611f\u8b1d\u3002","aliDayTitle":"\u300c510\u300d\u963f\u91cc\u65e5","aliDayDescription":"\u70ba\u4e86\u7d00\u5ff5\u963f\u91cc\u4eba\u7684\u6fc0\u60c5\u548c\u4fe1\u5ff5\uff0c\u6211\u5011\u5c07\u6bcf\u5e74\u7684 5 \u6708 10 \u65e5\u5b9a\u70ba\u300c\u963f\u91cc\u65e5\u300d\uff0c\u4ee5\u7d00\u5ff5\u300c\u975e\u5178\u300d\u4e2d\u51dd\u7d50\u7684\u679c\u65b7\u3001\u5718\u7d50\u3001\u656c\u696d\u3001\u4e92\u52a9\u4e92\u611b\u7684\u7cbe\u795e\uff0c\u4e5f\u7528\u9019\u4e00\u5929\u4f86\u8868\u9054\u5c0d\u89aa\u53cb\u7684\u611f\u6069\u3002\u9019\u4e00\u5929\uff0c\u54e1\u5de5\u6703\u5e36\u8457\u81ea\u5df1\u7684\u89aa\u53cb\u8d70\u9032\u8fa6\u516c\u5712\u5340\uff0c\u9ad4\u9a57\u3001\u611f\u53d7\u963f\u91cc\u7684\u5de5\u4f5c\u74b0\u5883\u8207\u6587\u5316\u6c1b\u570d\u3002","supportingMothersTitle":"\u63d0\u4f9b\u80b2\u5152\u652f\u6301","supportingMothersDescription":"\u6211\u5011\u900f\u904e\u5b55\u5a66\u5b78\u6821\u548c\u80b2\u5152\u8ab2\u5802\uff0c\u5e6b\u52a9\u6e96\u7236\u6bcd\u548c\u65b0\u664b\u7236\u6bcd\u5f9e\u5bb9\u9069\u61c9\u300c\u65b0\u624b\u7238\u5abd\u300d\u7684\u89d2\u8272\uff1b\u8207\u6240\u5728\u5730\u5e7c\u5152\u5712\u53ca\u6a5f\u69cb\u5408\u4f5c\uff0c\u70ba\u54e1\u5de5\u5b50\u5973\u5728\u5165\u5712\u3001\u8a17\u7ba1\u53ca\u5065\u5eb7\u6aa2\u67e5\u7b49\u65b9\u9762\u63d0\u4f9b\u4fbf\u5229\u3002","talentDevelopmentOpportunities":"\u8c50\u5bcc\u7684\u4eba\u624d\u767c\u5c55\u6a5f\u6703","talentDevelopmentOpportunitiesTitle":"\u8c50\u5bcc\u7684\u4eba\u624d\u767c\u5c55\u6a5f\u6703","talentDevelopmentOpportunitiesDescription":"\u6211\u5011\u5e0c\u671b\u6bcf\u4f4d\u54e1\u5de5\u5728\u963f\u91cc\u5df4\u5df4\u90fd\u80fd\u66f4\u597d\u5be6\u73fe\u500b\u4eba\u50f9\u503c\uff0c\u5145\u5206\u767c\u63ee\u81ea\u8eab\u6f5b\u529b\uff0c\u4e26\u4e14\u7372\u5f97\u8c50\u5bcc\u7684\u8077\u696d\u767c\u5c55\u7a7a\u9593\u548c\u5145\u6eff\u6311\u6230\u7684\u6210\u9577\u6a5f\u6703\u3002","careerDevelopmentTitle":"\u8077\u696d\u767c\u5c55\u6a5f\u6703","careerDevelopmentDescription":"\u6211\u5011\u95dc\u6ce8\u6bcf\u4f4d\u54e1\u5de5\u7684\u6210\u9577\u8207\u767c\u5c55\uff0c\u7121\u8ad6\u662f\u65b0\u4eba\u3001\u5165\u8077\u4e00\u5b9a\u5e74\u9650\u7684\u54e1\u5de5\u9084\u662f\u7ba1\u7406\u8005\uff0c\u901a\u904e\u4e0d\u540c\u7684\u65b9\u5f0f\u727d\u5f15\u4ed6\u5011\u6210\u9577\u3002","careerDevelopmentSubtitle":"\u6211\u5011\u5efa\u7acb\u4e86\u8986\u84cb\u5168\u54e1\u7684\u3001\u591a\u6a23\u5316\u7684\u5167\u5916\u90e8\u5b78\u7fd2\u767c\u5c55\u9805\u76ee\uff0c\u70ba\u54e1\u5de5\u63d0\u4f9b\u5b78\u7fd2\u8207\u767c\u5c55\u5e73\u53f0\uff0c\u5e6b\u52a9\u54e1\u5de5\u5be6\u73fe\u500b\u4eba\u548c\u8077\u696d\u96d9\u91cd\u6210\u9577\u3002","mentorCultureTitle":"\u65b0\u54e1\u5de5\u878d\u5165","mentorCultureDescription":"\u6211\u5011\u70ba\u65b0\u54e1\u5de5\u63d0\u4f9b\u65b0\u4eba\u5730\u5716\u5c0e\u822a\u3001\u5e2b\u5144\u5e2b\u59d0\u6307\u5c0e\u3001\u300c\u767e\u5e74\u963f\u91cc\u300d\u6587\u5316\u57f9\u8a13\u7b49\u7cfb\u5217\u652f\u6301\uff0c\u5e6b\u52a9\u4ed6\u5011\u5feb\u901f\u878d\u5165\u5de5\u4f5c\u74b0\u5883\u3002\u6211\u5011\u9084\u70ba\u6821\u62db\u751f\u3001\u6280\u8853\u65b0\u4eba\u53ca\u5be6\u7fd2\u751f\u7fa4\u9ad4\u8a2d\u8a08\u4e86\u5c08\u9805\u57f9\u990a\u9805\u76ee\uff0c\u4ee5\u5e6b\u52a9\u4ed6\u5011\u66f4\u597d\u9069\u61c9\u5f9e\u5b78\u6821\u5411\u8077\u5834\u7684\u8f49\u8b8a\u3002\u3000","workAnniversaryTitle":"\u6649\u5347\u6a5f\u5236","workAnniversaryDescription":"\u6211\u5011\u5efa\u7acb\u4e86\u516c\u5e73\u900f\u660e\u7684\u6649\u5347\u8a55\u4f30\u6a5f\u5236\uff0c\u7d9c\u5408\u7e3e\u6548\u3001\u50f9\u503c\u89c0\u3001\u7ba1\u7406\u8005\u8a55\u50f9\u53ca\u540c\u4e8b\u53cd\u994b\u7b49\u591a\u65b9\u8996\u89d2\u9032\u884c\u8003\u91cf\u3002","jobTransferTitle":"\u8f49\u5d17\u6a5f\u5236","jobTransferDescription":"\u70ba\u54e1\u5de5\u63d0\u4f9b\u958b\u653e\u3001\u900f\u660e\u7684\u8f49\u5d17\u6a5f\u6703\u3002\u9019\u4e00\u6a5f\u5236\u65e2\u80fd\u66f4\u597d\u5339\u914d\u54e1\u5de5\u80fd\u529b\u548c\u5d17\u4f4d\u9700\u6c42\uff0c\u4e5f\u80fd\u9a45\u52d5\u7ba1\u7406\u8005\u95dc\u6ce8\u54e1\u5de5\u6210\u9577\uff0c\u8b93\u4eba\u624d\u81ea\u7531\u6d41\u52d5\u3002","talentTrainingTitle":"\u57f9\u8a13\u8207\u767c\u5c55","talentTrainingSubtitle":"\u6211\u5011\u5efa\u7acb\u4e86\u8986\u84cb\u5168\u54e1\u7684\u3001\u591a\u6a23\u5316\u7684\u5167\u5916\u90e8\u5b78\u7fd2\u767c\u5c55\u9805\u76ee\uff0c\u70ba\u54e1\u5de5\u63d0\u4f9b\u5b78\u7fd2\u8207\u767c\u5c55\u5e73\u53f0\uff0c\u5e6b\u52a9\u54e1\u5de5\u5be6\u73fe\u500b\u4eba\u548c\u8077\u696d\u96d9\u91cd\u6210\u9577\u3002","newEmployeeTrainingTab":"\u65b0\u4eba\u57f9\u8a13","leadershipTrainingTab":"\u9818\u5c0e\u529b\u767c\u5c55","professionalTrainingTab":"\u5c08\u696d\u80fd\u529b\u57f9\u990a","aiCapabilityTrainingTab":"AI\u5b78\u7fd2\u8207\u5be6\u8e10","managementTraineeTitle":"\u7ba1\u7406\u57f9\u8a13\u751f\u8a08\u5283","managementTraineeDescription":"\u6211\u5011\u70ba\u65b0\u54e1\u5de5\u63d0\u4f9b\u65b0\u4eba\u5165\u8077\u77e5\u8b58\u5c0e\u5f15\u3001\u5e2b\u5144\u5e2b\u59d0\u5339\u914d\u3001\u7dda\u4e0a\u5b78\u7fd2\u5730\u5716\u3001\u7dda\u4e0a\u7dda\u4e0b\u57f9\u8a13\u9805\u76ee\u7b49\u7cfb\u5217\u652f\u6301\uff0c\u5e6b\u52a9\u4ed6\u5011\u5feb\u901f\u878d\u5165\u5de5\u4f5c\u74b0\u5883\u3002\u9664\u6b64\u4ee5\u5916\uff0c\u6211\u5011\u7684\u4e3b\u8981\u696d\u52d9\u9084\u70ba\u6821\u62db\u751f\u958b\u767c\u4e86\u7ba1\u7406\u57f9\u8a13\u751f\u57f9\u8a13\u53ca\u5b9a\u5236\u57f9\u8a13\u9805\u76ee\uff0c\u4ee5\u5e6b\u52a9\u4ed6\u5011\u66f4\u597d\u9069\u61c9\u5f9e\u5b78\u6821\u5411\u8077\u5834\u7684\u8f49\u8b8a\u3002","leadershipProgramTitle":"\u9818\u5c0e\u529b\u57f9\u8a13","leadershipProgramDescription":"\u6211\u5011\u69cb\u5efa\u8986\u84cb\u57fa\u5c64\u3001\u4e2d\u968e\u53ca\u9ad8\u968e\u7ba1\u7406\u8005\u7684\u5206\u5c64\u57f9\u990a\u9ad4\u7cfb\uff0c\u9762\u5411\u57fa\u5c64\u7ba1\u7406\u8005\u63a8\u51fa\u300c\u4fe0\u5ba2\u884c\u300d\u7b49\u9805\u76ee\u5e6b\u52a9\u5176\u5b8c\u6210\u89d2\u8272\u8f49\u8b8a\uff0c\u70ba\u4e2d\u968e\u7ba1\u7406\u8005\u63d0\u4f9b\u7d44\u7e54\u5354\u540c\u8207\u6230\u7565\u50b3\u5c0e\u57f9\u8a13\uff0c\u5c0d\u9ad8\u968e\u7ba1\u7406\u8005\uff0c\u91cd\u9ede\u805a\u7126\u5546\u696d\u6d1e\u5bdf\u8207\u6cbb\u7406\u80fd\u529b\u57f9\u990a\u3002\u6b64\u5916\uff0c\u6211\u5011\u4e5f\u70ba\u6d77\u5916\u7ba1\u7406\u8005\u8a2d\u8a08DARE\u9818\u5c0e\u529b\u57f9\u8a13\uff0c\u63d0\u5347\u8de8\u6587\u5316\u7ba1\u7406\u8207\u6230\u7565\u5354\u540c\u80fd\u529b\u3002","professionalDevelopmentTitle":"\u5c08\u696d\u80fd\u529b\u57f9\u990a","professionalDevelopmentDescription":"\u6211\u5011\u63d0\u4f9b\u8986\u84cb\u6280\u8853\u3001\u71df\u904b\u3001\u7522\u54c1\u3001\u8ca1\u52d9\u53caESG\u7b49\u9818\u57df\u7684\u5c08\u696d\u57f9\u8a13\u8cc7\u6e90\uff0c\u70ba\u54e1\u5de5\u6253\u9020\u963f\u91cc\u5b78\u7fd2\u3001ATA\u3001\u5947\u9ede\u5b78\u5802\u7b49\u5e73\u53f0\u548c\u5b78\u7fd2\u793e\u5340\u3002\u5404\u696d\u52d9\u55ae\u5143\u9084\u7d50\u5408\u81ea\u8eab\u9700\u6c42\u63a8\u51fa\u5b9a\u5411\u57f9\u990a\u9805\u76ee\uff0c\u6b64\u5916\uff0c\u6211\u5011\u4e5f\u652f\u6301\u54e1\u5de5\u8003\u53d6CPA\u3001CFA\u7b49\u5c08\u696d\u8a8d\u8b49\u3002","aiCapabilityTitle":"AI\u6642\u4ee3\u80fd\u529b\u5efa\u8a2d","aiCapabilityDescription":"\u6211\u5011\u70ba\u54e1\u5de5\u63d0\u4f9b\u8c50\u5bcc\u7684AI\u5b78\u7fd2\u8cc7\u6e90\u8207\u5be6\u8e10\u652f\u6301\uff0c\u900f\u904e\u300cAI\u554f\u9053\u300d\u6574\u5408\u8ab2\u7a0b\u8207AI\u7522\u54c1\uff0c\u5c07\u77e5\u8b58\u5b78\u7fd2\u8207\u5be6\u8e10\u61c9\u7528\u76f8\u7d50\u5408\u3002ATA\u4e0a\u7dda AI\u5c08\u984c\u8207AI\u5be6\u8e10\u5c08\u5340\uff0c\u70ba\u54e1\u5de5\u63d0\u4f9b\u524d\u6cbf\u8cc7\u8a0a\u548c\u696d\u52d9\u53c3\u8003\u3002\u6211\u5011\u9084\u7d44\u7e54\u4e3b\u984c\u57f9\u8a13\u8207\u76f4\u64ad\uff0c\u4e26\u900f\u904e\u300cAI\u751f\u7522\u529b\u8a08\u5283\u300d\u958b\u653e\u6a21\u578b\u5de5\u5177\u3001\u8a08\u7b97\u8cc7\u6e90\u548c\u8fa6\u516c\u5de5\u5177\uff0c\u652f\u6301\u54e1\u5de5\u5728\u6280\u8853\u7814\u767c\u8207\u696d\u52d9\u5275\u65b0\u4e2d\u63a2\u7d22\u548c\u61c9\u7528AI\u3002","employeeHealthVitality":"\u54e1\u5de5\u5065\u5eb7\u8207\u6d3b\u529b","employeeHealthVitalityTitle":"\u54e1\u5de5\u7684\u5065\u5eb7\u8207\u6d3b\u529b","employeeHealthVitalityDescription":"\u54e1\u5de5\u8eab\u5fc3\u5065\u5eb7\u662f\u6211\u5011\u7684\u9996\u8981\u95dc\u6ce8\u4e4b\u4e00\u3002\u901a\u904e\u5b89\u5168\u8212\u9069\u4e14\u667a\u80fd\u4fbf\u6377\u7684\u8fa6\u516c\u74b0\u5883\uff0c\u5c08\u696d\u5168\u9762\u7684\u91ab\u7642\u5065\u5eb7\u4fdd\u969c\u3001\u8c50\u5bcc\u591a\u5f69\u7684\u516c\u53f8\u6d3b\u52d5\uff0c\u6211\u5011\u70ba\u54e1\u5de5\u63d0\u4f9b\u591a\u7dad\u5ea6\u652f\u6301\uff0c\u8b93\u8077\u5834\u74b0\u5883\u5145\u6eff\u751f\u6a5f\u8207\u6d3b\u529b\u3002","occupationalHealthTitle":"\u8077\u696d\u5065\u5eb7\u8207\u5b89\u5168\u4fdd\u969c","occupationalHealthDescription":"\u6211\u5011\u53c3\u8003 ISO 45001 \u6a19\u6e96\uff0c\u767c\u4f48\u4e86\u9069\u7528\u65bc\u4e0d\u540c\u5834\u6240\u7ba1\u7406\u7684\u5167\u90e8\u5236\u5ea6\u8207\u5de5\u4f5c\u898f\u7bc4\uff0c\u4e26\u5f9e\u98a8\u96aa\u9632\u7bc4\u3001\u61c9\u6025\u7ba1\u7406\u548c\u5b89\u5168\u57f9\u8a13\u4e09\u500b\u65b9\u9762\u4f86\u843d\u5be6\u5177\u9ad4\u7684\u7ba1\u7406\u8981\u6c42\u3002","riskManagementTitle":"\u98a8\u96aa\u9632\u7bc4","riskManagementDescription":"\u5728\u8fa6\u516c\u5712\u5340\u3001\u7269\u6d41\u5834\u6240\u53ca\u6578\u64da\u4e2d\u5fc3\u7b49\u5de5\u4f5c\u5834\u6240\uff0c\u6211\u5011\u5df2\u5efa\u7acb\u8986\u84cb\u98a8\u96aa\u8b58\u5225\u3001\u8ffd\u8e64\u8207\u6301\u7e8c\u6539\u9032\u7684\u54e1\u5de5\u5065\u5eb7\u8207\u5b89\u5168\u7ba1\u7406\u9ad4\u7cfb\u3002","safetyTrainingTitle":"\u61c9\u6025\u7ba1\u7406","safetyTrainingDescription":"\u5236\u5b9a\u4e86\u300a\u5b89\u5168\u61c9\u6025\u64cd\u4f5c\u6307\u5f15\u300b\u7b49\u5236\u5ea6