9\u548c\u8d22\u52a1\u62a5\u544a","pleaseSelect":"\u8bf7\u9009\u62e9","submitSuccess":"\u63d0\u4ea4\u6210\u529f","company":"\u516c\u53f8","companyTip":"\u8bf7\u8f93\u5165\u60a8\u7684\u516c\u53f8","position":"\u804c\u52a1\u4fe1\u606f","positionTip":"\u8bf7\u8f93\u5165\u60a8\u7684\u804c\u52a1\u4fe1\u606f","individualInvestor":"\u4e2a\u4eba\u6295\u8d44\u8005","institutionalInvestor":"\u673a\u6784\u6295\u8d44\u4eba","broker":"\u5238\u5546","others":"\u5176\u4ed6"}')},35428:function(e){"use strict";e.exports=JSON.parse('{"title":"\u96fb\u90f5\u8a02\u95b1","subTitle":"\u5982\u3000\u95a3\u4e0b\u6b32\u7372\u5f97\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u7684\u6700\u65b0\u8cc7\u8a0a\uff0c\u8acb\u65bc\u4e0b\u8868\u586b\u59a5\u500b\u4eba\u8cc7\u6599\u4e26\u9078\u64c7\u5e0c\u671b\u6536\u53d6\u7684\u96fb\u90f5\u63d0\u793a\u7a2e\u985e\u3002","firstName":"\u540d\u5b57","lastName":"\u59d3\u6c0f","userType":"\u7528\u6236\u985e\u578b","userState":"\u570b\u5bb6/\u5730\u5340","organization":"\u6a5f\u69cb","email":"\u96fb\u5b50\u90f5\u7bb1","phone":"\u96fb\u8a71","subject":"\u4e3b\u984c","message":"\u5167\u5bb9","verificationCode":"\u9a57\u8b49\u78bc","submit":"\u63d0\u4ea4","privacyStatement":"\u96b1\u79c1\u8072\u660e","statementContent":"\u60a8\u53ef\u4ee5\u5728\u4e0d\u5411\u6211\u5011\u63d0\u4f9b\u4efb\u4f55\u500b\u4eba\u8cc7\u6599\u7684\u60c5\u6cc1\u4e0b\u700f\u89bd\u672c\u7db2\u7ad9\uff0c\u7136\u800c\uff0c\u5982\u679c\u60a8\u8981\u6c42\u6536\u53d6\u67d0\u985e\u901a\u77e5\u6216\u66f4\u65b0\uff0c\u6211\u5011\u53ef\u80fd\u6703\u6536\u96c6\u60a8\u81ea\u9858\u63d0\u4f9b\u7684\u500b\u4eba\u8eab\u4efd\u8b58\u5225\u8cc7\u8a0a\uff0c\u5305\u62ec\u59d3\u540d\u3001\u96fb\u8a71\u865f\u78bc\u96fb\u90f5\u5730\u5740\u3001\u90f5\u5bc4\u5730\u5740\u53ca\u4efb\u4f55\u5176\u4ed6\u53ef\u8b93\u4ed6\u4eba\u8b58\u5225\u60a8\u8eab\u4efd\u7684\u8cc7\u6599\u3002\u6211\u5011\u4e5f\u53ef\u80fd\u5728\u60a8\u4f7f\u7528\u672c\u7db2\u7ad9\u7684\u904e\u7a0b\u4e2d\uff0c\u6536\u96c6\u67d0\u4e9b\u60a8\u7684\u975e\u500b\u4eba\u8eab\u4efd\u8b58\u5225\u8cc7\u8a0a\uff0c\u4f8b\u5982\u60a8\u4f7f\u7528\u7684\u4e92\u806f\u7db2\u700f\u89bd\u5668\u548c\u64cd\u4f5c\u7cfb\u7d71\u898f\u683c\u3001\u7db2\u7ad9\u700f\u89bd\u9ede\u64ca\u6578\u64da\u7b49\u3002","statementBottom":"\u5982\u9700\u53d6\u6d88\u6295\u8cc7\u8005\u95dc\u4fc2\u96fb\u90f5\u8a02\u95b1\uff0c\u8acb\u81f3\u76f8\u95dc\u8a02\u95b1\u90f5\u4ef6\u9ede\u64ca\u201c\u53d6\u6d88\u8a02\u95b1\u201d\u3002","back":"\u8fd4\u56de","firstNameTip":"\u8acb\u8f38\u5165\u60a8\u7684\u540d\u5b57","lastNameTip":"\u8acb\u8f38\u5165\u60a8\u7684\u59d3\u6c0f","userTypeTip":"\u8acb\u9078\u64c7\u7528\u6236\u985e\u578b","userStateTip":"\u8acb\u9078\u64c7\u570b\u5bb6/\u5730\u5340","emailTip":"\u8acb\u8f38\u5165\u60a8\u7684\u90f5\u7bb1","phoneTip":"\u8acb\u8f38\u5165\u60a8\u7684\u624b\u6a5f","subjectTip":"\u8acb\u8f38\u5165\u4e3b\u984c","messageTip":"\u8acb\u8f38\u5165\u7559\u8a00","verificationCodeTip":"\u8acb\u8f38\u5165\u9a57\u8b49\u78bc","organizationTip":"\u8acb\u586b\u5beb\u6a5f\u69cb","category":"\u63d0\u793a\u7a2e\u985e","categoryTip":"\u8acb\u9078\u64c7\u63d0\u793a\u7a2e\u985e","pressReleases":"\u65b0\u805e","events":"\u6d3b\u52d5","SECFilings":"\u7f8e\u570b\u8b49\u4ea4\u6703\u516c\u544a/\u9999\u6e2f\u806f\u4ea4\u6240\u516c\u544a","endDayStockQuote":"\u6bcf\u65e5\u6536\u76e4\u80a1\u50f9","financialReports":"\u696d\u7e3e\u548c\u8ca1\u52d9\u5831\u544a","pleaseSelect":"\u8acb\u9078\u64c7","submitSuccess":"\u63d0\u4ea4\u6210\u529f","company":"\u516c\u53f8","companyTip":"\u8acb\u8f38\u5165\u60a8\u7684\u516c\u53f8","position":"\u8077\u52d9\u8cc7\u8a0a","positionTip":"\u8acb\u8f38\u5165\u60a8\u7684\u8077\u52d9\u8cc7\u8a0a","individualInvestor":"\u500b\u4eba\u6295\u8cc7\u8005","institutionalInvestor":"\u6a5f\u69cb\u6295\u8cc7\u4eba","broker":"\u5238\u5546","others":"\u5176\u4ed6"}')},7330:function(e){"use strict";e.exports=JSON.parse('{"bannerTitle":"Advancing carbon neutrality","bannerSubtitle":"As we pursue business growth, we weave low-carbon principles into our development strategy and daily operations to fulfill our commitment to emissions reduction.","progressOverviewTitle":"Progress","progressOverviewDescription":"Alibaba\'s sustainability efforts begin with measuring emissions accurately. Since our first comprehensive inventory of greenhouse gas emissions in 2021, we have constantly strengthened data governance and implemented a digital management system to dynamically monitor changes in emissions and reduction figures.","navCarbonTarget":"Goals","navCarbonProgress":"Progress","navStrategyPath":"Approaches","navOperationReduction":"Full-chain decarbonization","navEcosystemReduction":"Platform-led decarbonization","carbonTargetTitle":"Goals","goal1Title":"Decarbonizing Alibaba","goal1Description":"We will achieve carbon neutrality in our own operations by 2030.","goal2Title":"Greening the value chain","goal2Description":"We will collaborate with our upstream and downstream partners to achieve a 50% reduction in the net emissions intensity of the value chain by 2030 as compared to 2020.","goal3Title":"Enabling a digital ecosystem for the circular economy","goal3Description":"We pledge to leverage our digital platforms to encourage even broader participation from society. Between 2021 and 2035, these efforts will reduce a cumulative total of 1.5 gigatons of emissions beyond our own operations and the value chain.","scope1":"Scope 1","scope2":"Scope 2","scope3":"Scope 3","scope3Plus":"Scope 3+","scopeFilter12":"Scopes 1&2","scopeFilter3":"Scope 3","scopeFilter3Plus":"Scope 3+","chartTitle12":"Net emissions from our own operations","chartSubtitle12":"Unit: 10,000 tCO\u2082e","chartTitle3":"Net emissions intensity in the value chain","chartSubtitle3":"Unit: MtCO2e/million RMB","chartTitle3Plus":"Avoided emissions across the platform ecosystem","chartSubtitle3Plus":"Unit: million MtCO\u2082e","baseYear":"Base year","fy2022":"FY2022","fy2023":"FY2023","fy2024":"FY2024","fy2025":"FY2025","fy2026":"FY2026","netEmissions":"Net emissions","netEmissionsIntensity":"Net emissions intensity","emissionsReduction":"Avoided emissions","progressTitle":"Progress in FY2026","progress1":"Net emissions from our own operations totaled 2.296 million tons, down 4.6% year on year.","progress2":"The net emissions intensity in the value chain was 8.0 tons per million RMB of revenue, down 10.1% year on year.","progress3":"We engaged and enabled the platform ecosystem to avoid around 100 million tons of emissions, up 21.3% year on year.","strategyPathTitle":"Approaches","strategyPathDescription":"In 2021, we announced our carbon neutrality goals, anchored by three major approaches: tech-driven efficiency, resource transition, and ecosystem collaboration.","strategy1Title":"Tech-driven efficiency","strategy1Description":"At Alibaba, we explore and adopt various measures to conserve energy and boost efficiency.","strategy2Title":"Resource transition","strategy2Description":"We use low-carbon resources wherever feasible.","strategy3Title":"Ecosystem collaboration","strategy3Description":"We partner with diverse stakeholders to explore scenarios for decarbonization and build a green future.","operationReductionTitle":"Full-chain decarbonization","operation1Title":"Green cloud computing","operation1Description":"Alibaba Cloud pledges to power 100% of its operations with clean energy by 2030.","operation2Title":"Smart circular logistics","operation2Description":"Leveraging efficient operations, we fulfill our low-carbon commitment across all stages, including order processing, warehousing, packaging, and transportation.","operation3Title":"Sustainable campuses","operation3Description":"Together with our employees, we reduce emissions and build a green future by advancing smart energy management, transitioning to clean energy, and promoting resource circularity. ","operation4Title":"Sustainable retail spaces","operation4Description":"Physical stores are vital touchpoints for engaging consumers in sustainability. Freshippo drives emissions reduction across key emissions sources: electricity, natural gas, and packaging.","ecosystemReductionTitle":"Platform-led decarbonization","ecosystemDesc1":"We decarbonize the platform ecosystem via two strategies: enablement and engagement. Avoided emissions in the platform ecosystem do not offset emissions from our operations and the value chain. Enablement means providing low-carbon alternatives that yield lower whole-lifecycle emissions without affecting functionality, while engagement means leveraging platform mechanics, channel operations, procurement rules, traffic routing, product tagging, and business matchmaking to scale low-carbon adoption and achieve quantifiable avoided emissions.","ecosystemDesc2":"Enablement refers to providing alternative products or services that\xa0generate lower\xa0emissions\xa0without\xa0compromising\xa0functionality. Engagement involves proactive interventions that encourage stakeholders across the business ecosystem to adopt emissions reduction initiatives.","engagementTitle":"Engagement","enablementTitle":"Enablement","lowCarbonProducts":"Low-carbon products","lowCarbonProductsDescTitle":"Low-carbon products","lowCarbonProductsDesc":"by expanding green consumption options through e-commerce platforms and promoting the sale of low-carbon goods, GHG emissions at the consumption end are reduced.","lowCarbonTravel":"Mobility","lowCarbonTravelDescTitle":"Mobility services","lowCarbonTravelDesc":"by recommending and guiding users toward low-carbon travel modes, such as walking, cycling, taking bus, and taking metro, through the Amap application, GHG emissions from transportation are reduced.","lowCarbonDining":"Catering","lowCarbonDiningDescTitle":"Catering services","lowCarbonDiningDesc":"by nudging food delivery users on instant retail platforms toward low-carbon consumption choices, such as reducing single-use plastic usage and minimizing food waste, GHG emissions associated with consumable use and waste disposal are reduced.","consumerRecycling":"Reuse &  recycling","consumerRecyclingDescTitle":"Reuse and recycling","consumerRecyclingDesc":"by facilitating the circulation of idle goods between users or channeling them into standardized recycling streams to extend their useful life, GHG emissions associated with the production of brand-new replacements are reduced.","lowCarbonCloud":"Cloud computing","lowCarbonCloudDescTitle":"Cloud computing","lowCarbonCloudDesc":"by adopting cloud computing services in lieu of on-premises data centers, users can reduce GHG emissions associated with equivalent IT workloads through consolidated infrastructure, energy efficiency optimization, high-efficiency hardware, clean energy utilization, and cloud-native scheduling capabilities.","lowCarbonLogistics":"Mobility","lowCarbonLogisticsDescTitle":"Mobility services","lowCarbonLogisticsDesc":"by providing high-precision route optimization and navigation services, vehicle idling and excess mileage caused by congestion or detours are decreased, thereby reducing GHG emissions from user travel.","lowCarbonOffice":"Digital workplace","lowCarbonOfficeDescTitle":"Digital workplace","lowCarbonOfficeDesc":"by leveraging online conferencing and paperless office features within online collaborative platform, users can reduce GHG emissions stemming from work-related travel and office consumable usage.","lowCarbonProduction":"Industry","lowCarbonProductionDescTitle":"Industrial production","lowCarbonProductionDesc":"by deploying intelligent management systems to optimize industrial production processes, energy and material consumption per unit of output is reduced, thereby lowering GHG emissions particularly during the manufacturing stage.","methodologyTitle":" Key capabilities","scientificMeasurement":"Science-based assessment","scientificMeasurementDesc":"Science-based assessment ensures consistency, reproducibility, and comparability through a structured methodology framework, precise definitions of key elements (system boundaries, functional units, reference scenarios, etc.), and standardized procedures.","digitalManagement":"Digital management","digitalManagementDesc":"Digital management leverages specialized platforms to facilitate data collection, version control, audit trails, and reproducible calculations\u2014thereby enhancing assurance-readiness and reducing the costs of large-scale management. ","professionalVerification":"Third-party assurance","professionalVerificationDesc":"Third-party assurance involves independent third-party verification to validate the reasonableness and authenticity of methodologies, data, and outcomes. This bolsters the credibility of external communications and mitigates potential reporting risks.","ecosystemPartnership":"Ecological co-construction","ecosystemPartnershipDesc":"Ecological co-construction drives methodological consensus, data availability, and the dissemination of best practices through active collaboration with industry partners, research institutions, assurance providers, and standards-setting organizations."}')},55239:function(e){"use strict";e.exports=JSON.parse('{"bannerTitle":"\u63a8\u8fdb\u78b3\u4e2d\u548c","bannerSubtitle":"\u963f\u91cc\u5df4\u5df4\u5728\u4fdd\u969c\u4e1a\u52a1\u589e\u957f\u7684\u540c\u65f6\uff0c\u79ef\u6781\u5c06\u7eff\u8272\u4f4e\u78b3\u7406\u5ff5\u878d\u5165\u53d1\u5c55\u6218\u7565\u4e0e\u65e5\u5e38\u8fd0\u8425\uff0c\u6301\u7eed\u5c65\u884c\u51cf\u6392\u627f\u8bfa\u3002","progressOverviewTitle":"\u8fdb\u5c55","progressOverviewDescription":"\u963f\u91cc\u5df4\u5df4\u7684\u53ef\u6301\u7eed\u53d1\u5c55\u5de5\u4f5c\u59cb\u4e8e\u7cbe\u51c6\u6d4b\u91cf\u6392\u653e\u3002\u81ea2021\u5e74\u9996\u6b21\u5f00\u5c55\u5168\u9762\u6e29\u5ba4\u6c14\u4f53\u6392\u653e\u76d8\u67e5\u4ee5\u6765\uff0c\u6211\u4eec\u6301\u7eed\u5b8c\u5584\u6570\u636e\u6cbb\u7406\u5e76\u90e8\u7f72\u6570\u5b57\u5316\u7ba1\u7406\u7cfb\u7edf\uff0c\u52a8\u6001\u76d1\u6d4b\u6392\u653e\u91cf\u4e0e\u51cf\u6392\u91cf\u53d8\u5316\u3002","navCarbonTarget":"\u76ee\u6807","navCarbonProgress":"\u8fdb\u5c55","navStrategyPath":"\u7b56\u7565","navOperationReduction":"\u8fd0\u8425\u548c\u4ef7\u503c\u94fe\u51cf\u6392","navEcosystemReduction":"\u5e73\u53f0\u751f\u6001\u51cf\u6392","carbonTargetTitle":"\u76ee\u6807","goal1Title":"\u505a\u597d\u7eff\u8272\u963f\u91cc\u5df4\u5df4","goal1Description":"\u4e0d\u665a\u4e8e2030\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u5b9e\u73b0\u81ea\u8eab\u8fd0\u8425\u78b3\u4e2d\u548c\u3002","goal2Title":"\u505a\u5f3a\u7eff\u8272\u4ef7\u503c\u94fe","goal2Description":"\u4e0d\u665a\u4e8e2030\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u534f\u540c\u4e0a\u4e0b\u6e38\u4ef7\u503c\u94fe\u5b9e\u73b0\u51c0\u6392\u653e\u5f3a\u5ea6\u6bd42020\u5e74\u964d\u4f4e50%\u3002","goal3Title":"\u505a\u5927\u7eff\u8272\u751f\u6001","goal3Description":"\u963f\u91cc\u5df4\u5df4\u627f\u8bfa\u901a\u8fc7\u5e73\u53f0\u7684\u65b9\u5f0f\u6fc0\u53d1\u66f4\u5927\u7684\u793e\u4f1a\u53c2\u4e0e\uff0c\u5728\u81ea\u8eab\u8fd0\u8425\u548c\u4ef7\u503c\u94fe\u4ee5\u5916\uff0c2021\u5e74\u52302035\u5e74\u768415\u5e74\u671f\u95f4\u5b9e\u73b0\u7d2f\u8ba1\u51cf\u639215\u4ebf\u5428\u3002","scope1":"\u8303\u56f41","scope2":"\u8303\u56f42","scope3":"\u8303\u56f43","scope3Plus":"\u8303\u56f43+","scopeFilter12":"\u8303\u56f41&2","scopeFilter3":"\u8303\u56f43","scopeFilter3Plus":"\u8303\u56f43+","chartTitle12":"\u81ea\u8eab\u8fd0\u8425\u51c0\u6392\u653e\u91cf","chartSubtitle12":"\u5355\u4f4d:\u4e07\u5428\u4e8c\u6c27\u5316\u78b3\u5f53\u91cf","chartTitle3":"\u4ef7\u503c\u94fe\u51c0\u6392\u653e\u5f3a\u5ea6","chartSubtitle3":"\u5355\u4f4d: \u5428\u4e8c\u6c27\u5316\u78b3\u5f53\u91cf\u6bcf\u767e\u4e07\u4eba\u6c11\u5e01\u6536\u5165","chartTitle3Plus":"\u5e73\u53f0\u751f\u6001\u907f\u514d\u6392\u653e\u91cf","chartSubtitle3Plus":"\u5355\u4f4d:\u767e\u4e07\u5428\u4e8c\u6c27\u5316\u78b3\u5f53\u91cf","baseYear":"\u57fa\u51c6\u5e74","fy2022":"2022\u8d22\u5e74","fy2023":"2023\u8d22\u5e74","fy2024":"2024\u8d22\u5e74","fy2025":"2025\u8d22\u5e74","fy2026":"2026\u8d22\u5e74","netEmissions":"\u51c0\u6392\u653e\u91cf","netEmissionsIntensity":"\u51c0\u6392\u653e\u5f3a\u5ea6","emissionsReduction":"\u907f\u514d\u6392\u653e\u91cf","progressTitle":"2026\u8d22\u5e74\u8fdb\u5c55","progress1":"\u81ea\u8eab\u8fd0\u8425\u51c0\u6392\u653e\u91cf\u4e3a 229.6 \u4e07\u5428\uff0c\u540c\u6bd4\u4e0b\u964d 4.6%","progress2":"\u4ef7\u503c\u94fe\u51c0\u6392\u653e\u5f3a\u5ea6\u4e3a 8.0 \u5428\u6bcf\u767e\u4e07\u4eba\u6c11\u5e01\u6536\u5165\uff0c\u540c\u6bd4\u964d\u4f4e 10.1%","progress3":"\u5e26\u52a8\u548c\u8d4b\u80fd\u5e73\u53f0\u751f\u6001\u5171\u8ba1\u907f\u514d\u6392\u653e 1.0 \u4ebf\u5428\uff0c\u540c\u6bd4\u589e\u957f 21.3%\u3002","strategyPathTitle":"\u7b56\u7565","strategyPathDescription":"2021 \u5e74\uff0c\u6211\u4eec\u5bf9\u5916\u5ba3\u5e03\u78b3\u4e2d\u548c\u76ee\u6807\uff0c\u5e76\u786e\u7acb\u4e09\u5927\u51cf\u6392\u6838\u5fc3\u7b56\u7565\uff1a\u8fd0\u7528\u6280\u672f\u63d0\u6548\u3001\u8f6c\u53d8\u8d44\u6e90\u4f7f\u7528\u65b9\u5f0f\u548c\u63a8\u52a8\u53c2\u4e0e\u8005\u751f\u6001\u3002","strategy1Title":"\u6280\u672f\u63d0\u6548","strategy1Description":"\u5728\u963f\u91cc\u5df4\u5df4\uff0c\u6211\u4eec\u81f4\u529b\u4e8e\u8bc6\u522b\u5e76\u843d\u5b9e\u5404\u9879\u8282\u80fd\u589e\u6548\u63aa\u65bd\u3002","strategy2Title":"\u8f6c\u53d8\u8d44\u6e90\u4f7f\u7528\u65b9\u5f0f","strategy2Description":"\u79c9\u6301\u53ef\u884c\u6027\u539f\u5219\uff0c\u6211\u4eec\u4f18\u5148\u9009\u7528\u4f4e\u78b3\u8d44\u6e90\u3002","strategy3Title":"\u63a8\u52a8\u53c2\u4e0e\u8005\u751f\u6001","strategy3Description":"\u6211\u4eec\u643a\u624b\u591a\u5143\u53c2\u4e0e\u8005\uff0c\u6301\u7eed\u62d3\u5c55\u51cf\u78b3\u573a\u666f\uff0c\u5171\u5efa\u7eff\u8272\u672a\u6765\u3002","operationReductionTitle":"\u8fd0\u8425\u548c\u4ef7\u503c\u94fe\u51cf\u6392","operation1Title":"\u7eff\u8272\u4e91\u8ba1\u7b97","operation1Description":"2030\u5e74\u8d77\uff0c\u963f\u91cc\u4e91\u627f\u8bfa100%\u91c7\u7528\u6e05\u6d01\u80fd\u6e90\u3002","operation2Title":"\u6570\u66