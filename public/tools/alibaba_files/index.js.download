\u77ed\u7247\u3001\u5275\u610f\u8a2d\u8a08\u7b49\u539f\u5275\u4f5c\u54c1\u63d0\u4f9b\u5099\u6848\u548c\u7dad\u6b0a\u3002\u900f\u904e\u5716\u50cf\u6d6e\u6c34\u5370\u3001\u77ed\u7247\u6d6e\u6c34\u5370\u6280\u8853\u5c07\u539f\u5275\u5716\u7247\u3001\u77ed\u7247\\"\u84cb\u6233\\"\u5b58\u8b49\uff0c\u539f\u5275\u5546\u5bb6\u906d\u9047\u4fb5\u6b0a\u6642\u53ef\u5be6\u73fe\u4e00\u9375\u7dad\u6b0a\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u963f\u91cc\u5df4\u5df4\u539f\u5275\u4fdd\u8b77\u5e73\u53f0\u5df2\u7d2f\u8a08\u4fdd\u8b77\u8d85\u904e 8.9 \u5104\u5f35\u5716\u7247\uff0c\u8d85\u904e 1.5 \u5104\u689d\u77ed\u7247\uff0c\u8d85\u904e 93\u842c\u4efd\u8a2d\u8a08\u624b\u7a3f\u3002","complianceAwarenessTitle":"\u5408\u898f\u610f\u8b58","complianceAwarenessDesc":"\u6211\u5011\u7684\u96fb\u5546\u5e73\u53f0\u900f\u904e\u57f9\u8a13\u548c\u8f14\u5c0e\u63d0\u5347\u5546\u5bb6\u5408\u898f\u610f\u8b58\uff0c\u9810\u9632\u77e5\u8b58\u7522\u6b0a\u4fb5\u6b0a\u3002","trainingGuidanceTitle":"\u57f9\u8a13\u548c\u8f14\u5c0e","trainingGuidanceDesc":"\u57f9\u8a13\u548c\u8f14\u5c0e\u662f\u9810\u9632\u77e5\u8b58\u7522\u6b0a\u4fb5\u6b0a\u7684\u91cd\u8981\u9014\u5f91\u3002\u6211\u5011\u900f\u904e\u5716\u6587\u3001\u77ed\u7247\u3001\u76f4\u64ad\u7b49\u5f62\u5f0f\uff0c\u5411\u5546\u5bb6\u50b3\u905e\u5408\u6cd5\u5408\u898f\u7d93\u71df\u7406\u5ff5\uff0c\u539a\u690d\u5275\u65b0\u6c1b\u570d\uff0c\u4e26\u5f15\u5c0e\u5546\u5bb6\u5c0a\u91cd\u548c\u4fdd\u8b77\u77e5\u8b58\u7522\u6b0a\u3002","multiGovernanceTitle":"\u591a\u65b9\u5171\u6cbb","multiGovernanceDesc":"\u6211\u5011\u81f4\u529b\u65bc\u7528\u5408\u4f5c\u8207\u5c0d\u8a71\u65b9\u5f0f\uff0c\u806f\u5408\u5229\u76ca\u76f8\u95dc\u65b9\uff0c\u5171\u540c\u95dc\u6ce8\u548c\u89e3\u6c7a\u91cd\u8981\u7684\u77e5\u8b58\u7522\u6b0a\u554f\u984c\uff0c\u63a8\u52d5\u591a\u65b9\u5171\u6cbb\u3002","aacaTitle":"\u963f\u91cc\u5df4\u5df4\u6253\u5047\u806f\u76df","aacaDesc":"2017\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u6253\u5047\u806f\u76df(AACA)\u6210\u7acb\uff0c\u5e0c\u671b\u900f\u904e\u963f\u91cc\u5df4\u5df4\u7684\u6280\u8853\uff0c\u7d50\u5408\u6b0a\u5229\u4eba\u7684\u54c1\u724c\u77e5\u8b58\u3001\u884c\u696d\u7279\u5fb5\u7b49\u624b\u6bb5\u4f86\u5171\u540c\u6cbb\u7406\u5047\u8ca8\u3002\u622a\u81f32026\u5e743\u670831\u65e5\uff0c\u5df2\u6709\u8d85\u904e 1,300 \u500b\u54c1\u724c\u52a0\u5165\u8a72\u806f\u76df\u3002","aliInternationalEcoTitle":"\u570b\u969b\u5408\u4f5c","aliInternationalEcoDesc":"\u963f\u91cc\u570b\u969b\u6578\u5b57\u5546\u696d\u96c6\u5718\u6301\u7e8c\u6df1\u5316\u8207\u570b\u969b\u7d44\u7e54\u5408\u4f5c\uff0c\u5df2\u8207\u4e16\u754c\u77e5\u8b58\u7522\u6b0a\u7d44\u7e54\uff08WIPO\uff09\u3001\u570b\u969b\u53cd\u5047\u5192\u806f\u76df\uff08IACC\uff09\u3001\u97d3\u570b\u77e5\u8b58\u7522\u6b0a\u4fdd\u8b77\u5c40\uff08KOIPA\uff09\u7b49\u6a5f\u69cb\u5efa\u7acb\u5354\u4f5c\u6a5f\u5236\uff0c\u4f9d\u8a17\u4e2d\u5c0f\u4f01\u696d\u8aee\u8a62\u59d4\u54e1\u6703\uff08SAC\uff09\u50be\u807d\u4e2d\u5c0f\u5fae\u4f01\u696d\u8a34\u6c42\uff0c\u4e26\u806f\u5408IACC\u63a8\u9032MarketSafe\xae\u9805\u76ee\uff0c\u5f62\u6210\u7531\u5e73\u53f0\u8cc7\u52a9\u3001IACC \u5354\u52a9\u4e2d\u5c0f\u5fae\u4f01\u696d\u7dad\u6b0a\u6295\u8a34\u7684\u5354\u4f5c\u6a5f\u5236\u3002","diverseCommunityTitle":"\u591a\u5143\u7684\u96fb\u5546\u793e\u7fa4","diverseCommunityDesc":"\u5e73\u53f0\u9023\u63a5\u8457\u5927\u91cf\u7684\u6d88\u8cbb\u8005\uff0c\u4ed6\u5011\u6bcf\u5929\u8cfc\u8cb7\u548c\u4f7f\u7528\u4e0d\u540c\u7684\u5546\u54c1\u8207\u670d\u52d9\uff0c\u9700\u8981\u5ee3\u6cdb\u591a\u5143\u7684\u5546\u5bb6\u5171\u540c\u53c3\u8207\u3002\u6211\u5011\u6301\u7e8c\u5438\u5f15\u548c\u9f13\u52f5\u591a\u5143\u7684\u7fa4\u9ad4\u5728\u5e73\u53f0\u4e0a\u63a2\u7d22\u5546\u6a5f\uff0c\u4e26\u70ba\u5546\u5bb6\u63d0\u4f9b\u96fb\u5546\u5165\u9580\u53ca\u6210\u9577\u8ab2\u7a0b\uff0c\u78ba\u4fdd\u4e0d\u540c\u9700\u6c42\u7684\u5546\u5bb6\u90fd\u80fd\u53c3\u8207\u4e26\u53d7\u76ca\u3002","diverseMerchantsTab":"\u591a\u5143\u5316\u5546\u5bb6","merchantGrowthTab":"\u53ef\u6301\u7e8c\u767c\u5c55","smeMerchantsCardDesc":"\u300c\u842c\u80fd\u7684\u6dd8\u5bf6\u300d\u5438\u5f15\u8457\u4e0d\u540c\u985e\u578b\u7684\u5275\u696d\u8005\u7a4d\u6975\u53c3\u8207\u5176\u4e2d\uff0c\u5c24\u5176\u662f\u4e2d\u5c0f\u5fae\u4f01\u696d\u30022026\u8ca1\u5e74\uff0c\u6dd8\u5bf6\u5929\u8c93\u5e74\u5ea6\u6d3b\u8e8d\u5546\u5bb6\u4e2d\uff0c93.3%\u662f\u4e2d\u5c0f\u5fae\u5546\u5bb6\u3002","smallMerchantsTitle":"\u4e2d\u5c0f\u5fae\u4f01\u696d","brandMerchantsTitle":"\u54c1\u724c\u5546","brandMerchantsDesc":"\u5929\u8c93\u5df2\u6210\u70ba\u570b\u969b\u53ca\u672c\u571f\u54c1\u724c\u7684\u9996\u9078\u5408\u4f5c\u5925\u4f34\u3002\u7d55\u5927\u591a\u6578\u5728\u4e2d\u570b\u71df\u904b\u7684\u570b\u969b\u4e00\u7dda\u54c1\u724c\u5747\u5df2\u5165\u99d0\u5929\u8c93\u5e73\u53f0\u3002","crossBorderMerchantsTitle":"\u8de8\u5883\u5546\u5bb6","crossBorderMerchantsDesc":"Alibaba.com \u662f\u7d9c\u5408\u578b\u5916\u8cbf\u7dda\u4e0a\u6279\u767c\u4ea4\u6613\u5e73\u53f0\u30022026 \u8ca1\u5e74\uff0c\u5168\u7403\u6709\u8d85\u904e24\u842c\u500b\u8ce3\u5bb6\u900f\u904eAlibaba.com\u89f8\u9054\u4f86\u81ea191\u500b\u570b\u5bb6\u548c\u5730\u5340\u76844,700\u842c\u540d\u8cb7\u5bb6\u3002","industrialMerchantsTitle":"\u7522\u696d\u5e36\u5546\u5bb6","industrialMerchantsDesc":"\u7d9c\u5408\u578b\u5167\u8cbf\u7dda\u4e0a\u6279\u767c\u4ea4\u6613\u5e73\u53f01688.com \u81f4\u529b\u65bc\u5e6b\u52a9\u7522\u696d\u5e36\u5546\u5bb6\u66f4\u597d\u5730\u9023\u63a5\u5e02\u5834\u3002\u622a\u81f32026\u5e743\u670831\u65e5\uff0c\u5df2\u6709\u8d85\u904e28\u842c\u500b\u7522\u696d\u5e36\u5de5\u5ee0\u57281688.com\u958b\u5e97\u3002","ecommerceCoursesTitle":"\u6dd8\u5bf6\u5b98\u65b9\u5b78\u7fd2\u4e2d\u5fc3","ecommerceCoursesDesc":"\u6dd8\u5bf6\u5b98\u65b9\u5b78\u7fd2\u4e2d\u5fc3\u70ba\u5546\u5bb6\u63d0\u4f9b\u514d\u8cbb\u7684\u96fb\u5546\u71df\u904b\u8ab2\u7a0b\u30022025 \u8ca1\u5e74\uff0c\u8d85\u904e 533 \u842c\u4eba\u6b21\u900f\u904e\u5b78\u7fd2\u4e2d\u5fc3\u53c3\u8207\u4e86\u96fb\u5546\u77e5\u8b58\u5b78\u7fd2\u3002","legalEducationTitle":"\u5408\u898f\u6700\u524d\u7dda","legalEducationDesc":"\u6dd8\u5bf6\u5929\u8c93\u9762\u5411\u5546\u5bb6\u63a8\u51fa\u666e\u6cd5\u6559\u80b2\u6b04\u76ee\u2014\u2014\u300a\u5408\u898f\u6700\u524d\u7dda\u300b\u3002\u8a72\u6b04\u76ee\u5b9a\u671f\u9080\u8acb\u653f\u7b56\u5236\u5b9a\u8005\u548c\u57f7\u6cd5\u90e8\u9580\u5c08\u5bb6\u5206\u4eab\uff0c\u4e3b\u984c\u5305\u62ec\u79c1\u96b1\u4fdd\u8b77\u3001\u53cd\u8a50\u3001\u5408\u898f\u7d93\u71df\u548c\u672a\u6210\u5e74\u4eba\u4fdd\u8b77\u7b49\u7684\u653f\u7b56\u548c\u5be6\u969b\u6848\u4f8b\u3002 "}')},36990:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","bannerTitle":"Giving Back to Society and Communities","bannerDescription":"Since Alibaba\'s inception, we have been addressing social challenges while pursuing business growth. Investing in society drives our own innovation and business growth, and social development broadens our market space.","actionResults":"Progress","actionResultsTitle":"Progress","strategyPath":"Approaches","strategyPathTitle":"Approaches","strategyPathDescription":"We champion a philosophy of participatory philanthropy, mobilizing employees, merchants, and stakeholders across society to join us in doing good. We partner with diverse organizations in key sectors to launch targeted initiatives that deliver a positive social impact. These initiatives primarily focus on rural revitalization, ecological conservation, support for the disabled and vulnerable, emergency response, and tech-driven solutions to social problems. We also foster entrepreneurship and job creation across our spheres of influence to advance social inclusion.","ruralRevitalization":"Rural revitalization","emergencyRelief":"Emergency response","techForSocial":"Tech-driven social solutions","employmentSupport":"Entrepreneurship and employment","publicWelfare":"Inclusive engagement","ruralCommissionersTitle":"34","ruralCommissionersUnit":"","ruralCommissionersDesc":"To introduce talent into the countryside, we have deployed a total of 34 rural revitalization commissioners.","xiaoluLampTitle":"2,300","xiaoluLampUnit":"","xiaoluLampDesc":"The cumulative total number of critically ill children helped by the Xiao Lu Lantern Project reached 2,300.","cloudClassroomTitle":"300","cloudClassroomUnit":"","cloudClassroomDesc":"In the Cloud for Youth Program, the cumulative total number of cloud computer classrooms that we built and donated reached 300, with personal cloud computer accounts available for over 280,000 teachers and students across China.","fortuneListPrefix":"","fortuneListTitle":"Recognition from Fortune","fortuneListUnit":"","fortuneListDesc":"We ranked among the top 10 on Fortune\u2019s 2024 Change the World list for developing an AI tool to detect multiple cancers on CT scans.","silentRidersPrefix":"Over ","silentRidersTitle":"4,200","silentRidersUnit":"","silentRidersDesc":"The number of active hearing-or speech-impaired delivery riders on the Taobao Instant Commerce platform exceeded 4,200.","disabilityAwardPrefix":"","disabilityAwardTitle":"National model","disabilityAwardUnit":"","disabilityAwardDesc":"The Alibaba Foundation was recognized as a \\"National Model Organization for Disability Inclusion.\\"","volunteerHoursTitle":"209,086","volunteerHoursUnit":" hours","volunteerHoursDesc":"Our employees clocked 209,086 hours of volunteer service.","hugsGroupTitle":"168,244","hugsGroupUnit":"","hugsGroupDesc":"123 Hugs and Help Groups established by our employees drew a total attendance of 168,244 in their philanthropic activities.","threeHoursPrefix":"Over ","threeHoursTitle":"430 million","threeHoursUnit":"","threeHoursDesc":"The Three Hours for a Better World Platform attracted over 10.33 million users, who performed over 430 million philanthropic actions.","goodsForGoodPrefix":"Over ","goodsForGoodTitle":"450 million","goodsForGoodUnit":"","goodsForGoodDesc":"The Goods for Good Program engaged over 1.72 million merchants and over 450 million users.","ruralRevitalizationTitle":"Rural revitalization","ruralIntroText":"The urban-rural development imbalance is a widespread global problem that has long hindered balanced regional growth. Rural development is defined by unique local characteristics, and a one-size-fits-all approach is unlikely to make a real difference. As we make efforts to tackle this problem, we place great emphasis on synergizing our business operations with advantageous local resources.","ruralCommissionerModelTitle":"Rural revitalization commissioner model","ruralCommissionerModelDesc":"We have developed a rural revitalization commissioner model to station senior employees in underdeveloped counties. By aligning our business resources with local endowments, they bridge the urban-rural divide across four dimensions: local industries, talent pools, technologies, and livelihoods.","ruralProgramCard1Desc":"In 2019, we launched the rural revitalization commissioner model, deploying senior employees to underdeveloped counties, where they harness our resources to accelerate local development.","ruralProgramCard2Desc":"As of March 31, 2025, we had deployed a total of 34 revitalization commissioners to 29 counties across China, including Julu in Hebei, Yijun in Shaanxi, and Ping\'an in Qinghai.","ruralProgramCard3Desc":"We have developed a rural revitalization commissioner model to station senior employees in underdeveloped counties. By aligning our business resources with local assets, they bridge the urban-rural divide across four dimensions: local industries, talent pipelines, technologies, and livelihoods.","industrialSupportTitle":"Industrial support","industrialSupportDesc":"We offer fresh perspectives to transform rural economies, as exemplified by our support for agri-product marketing and rural cultural tourism.","talentSupportTitle":"Talent support","talentSupportDesc":"We support rural development by bringing in outside talent and nurturing homegrown professionals.","techSupportTitle":"Technological support","techSupportDesc":"We harness our digital intelligence expertise to propel rural development.","livelihoodSupportTitle":"Medical support","livelihoodSupportDesc":"We provide medical aid to bolster the well-being of underserved rural populations.","ruralPracticeTitle":"Practices","ruralPractice1Title":"In-field livestreaming","ruralPractice1Desc":"In FY2025, Taobao and Tmall collaborated with our county-based rural revitalization commissioners to host year-round livestreams featuring seasonal local agri-products. The platforms deployed high-caliber livestreamers to source regions, where they worked from in-field studios to boost sales. This initiative also sharpened the e-commerce capabilities and digital literacy of local merchants.","ruralPractice2Title":"Freshippo Villages","ruralPractice2Desc":"By bridging consumer insights with production, Freshippo has established its Freshippo Village model, a demand-driven, contract farming system aimed at standardizing, premiumizing, and branding local agri-products. As of March 31, 2025, it had built 173 Freshippo Villages across 29 provincial-level regions in China and expanded the model overseas.","ruralPractice3Title":"Pacer Plan","ruralPractice3Desc":"In collaboration with ecosystem partners, we enlist seasoned e-commerce experts as consultants to provide six months of on-the-ground support for merchants in counties served by our rural revitalization commissioners. This initiative, known as the Pacer Plan, helps nurture local digital talent. As of March 31, 2025, it had been implemented across 17 counties.","ruralPractice4Title":"Cloud for Youth Program","ruralPractice4Desc":"The Cloud for Youth Program equips rural schools with cloud computer classrooms. As of March 31, 2025, we had built a total of 300 cloud computer classrooms, providing over 280,000 teachers and students with personal cloud computer accounts. To empower rural education with AI, we hosted workshops to help rural teachers bring AI into the classroom and give students hands-on experience with AI models.","ruralPractice5Title":"Xiao Lu Lantern Project","ruralPractice5Desc":"Alibaba Philanthropy and Alibaba Health Philanthropy have launched the Xiao Lu Lantern Project together with partner organizations to help critically ill children. The project reaches out to their families, providing medical aid as well as financial support to cover diagnosis and treatment expenses. As of March 31, 2025, it had spent a total of RMB48.59 million helping 2,300 eligible children.","emergencyReliefTitle":"Emergency response","emergencyIntroText":"In the face of disasters, we fully mobilize the capabilities and resources of our various businesses, assisting with emergency response and disaster relief across multiple fronts. In FY2025, we reached a partnership agreement with the Disaster Relief Division of China\'s Ministry of Emergency Management to contribute to a comprehensive enhancement of society\'s overall capacity for emergency response supplies. In the fiscal year, Cainiao independently developed China\'s first traceability management platform for emergency response supplies to improve efficiency across complex process management stages for such supplies, including statistics, procurement, transportation, and distribution.","reliefCase1Title":"Earthquake in Tibet","reliefCase1Desc":"In response to the January 2025 earthquake in Dingri County, Shigatse City, Tibet, we activated a government-society joint relief mechanism to mobilize resources and deliver three successive batches of supplies.","reliefCase2Title":"Floods","reliefCase2Desc":"In FY2025, our flood relief efforts covered 17 districts, counties, and cities in nine provinces, including Zixing in Hunan, Zhenyuan in Guizhou, and Wenchang in Hainan.","reliefCase3Title":"Disaster relief in Vietnam","reliefCase3Desc":"When Super Typhoon Yagi struck Vietnam in September 2024, Lazada responded with financial, material, and logistical support, bolstered by employee donations.","techForSocialTitle":"Tech-driven social solutions","techIntroText":"As a tech company, we not only drive our business growth with technologies but also actively explore the potential social value that technologies can create.","techSolution1Title":"AI for cancer screening","techSolution1Desc":"In FY2025, we adapted our AI tool for detecting pancreatic cancer on plain CT scans to cover multiple cancers. Partnering with hospitals, we launched a philanthropic pilot to democratize access to this technology.","techSolution2Title":"Rescue in uninhabited areas","techSolution2Desc":"Amap has launched a satellite-based offline navigation feature to prevent disorientation in areas without network coverage. Its satellite SOS feature, rolled out at the same time, enables emergency communication via satellite. Additionally, Amap has established a comprehensive rescue system to ensure that help is reachable even in no man\'s land.","techSolution3Title":"Baguan meteorological large model","techSolution3Desc":"AI-powered weather forecasting helps power grids match supply and demand with greater precision. In FY2025, we launched the Baguan meteorological large model, pioneering its application in modern energy infrastructure with a high penetration of renewable energy.","employmentSupportTitle":"Entrepreneurship and employment","employmentIntroText":"As we work with our ecosystem partners to achieve business success, we create inclusive, high-quality opportunities for entrepreneurship and employment.","inclusiveEmploymentTitle":"Inclusion","inclusiveEmploymentDesc":"The low entry barrier for using digital technologies significantly boosts employment inclusiveness across genders, educational backgrounds, and geographic regions. Our business model diminishes the hurdles to entrepreneurship and employment for groups such as women, people with disabilities, and individuals from underdeveloped regions, fostering a more equitable and inclusive environment where they can set up their own businesses or land jobs.","silentRiderProgramTitle":"Silent Rider Care Program","silentRiderProgramDesc":"Taobao Instant Commerce has launched the Silent Rider Care Program to support hearing- or speech-impaired delivery riders with platform features like automated calling, electronic communication cards, and speech-to-text conversion. Pre-set communication templates are available to streamline interactions. The program proactively manages the expectations of merchants as well as consumers and provides priority access to 24-hour live support.","disabilityEmploymentTitle":"Empowering merchants with disabilities","disabilityEmploymentDesc":"The Barrier-free Entrepreneurship and Employment Assistance Plan provides free training and business consultation services for merchants with disabilities. As of March 31, 2025, it had served a total of 4,700 merchants with disabilities.","qualityEmploymentTitle":"Digital education for success","cloudClassTitle":"Cloud Classroom","cloudClassDesc":"The Cloud Classroom, our online learning system, provides continuous support for digital talent development within enterprises. In FY2025, it served about 4.02 million learners, with a combined learning time of 23.39 million hours.","orangeClassTitle":"Orange Class","orangeClassDesc":"The Orange Class, our inclusive education program, leverages premium resources to practice a \\"learn, train, compete, certify, and hire\\" approach. As of March 31, 2025, it had benefited a total of over 310,000 learners.","flexibleEmploymentTitle":"Protection for gig workers","flexibleEmploymentDesc":"Delivery riders are a key part of the gig economy. The majority of delivery riders on the Taobao Instant Commerce platform are crowdsourced delivery riders working on a flexible basis. We are committed to enhancing employment security for delivery riders across multiple dimensions, including occupational rights & benefits, occupational safety, and career care & development.","occupationalRightsTitle":"Occupational rights and interests","occupationalRightsDesc":"Taobao Instant Commerce ensures that delivery riders earn at least the local minimum wage. Across multiple cities, the platform is expanding a dual-protection system integrating occupational injury insurance and commercial insurance. Furthermore, it is piloting a program in certain cities to enroll delivery riders in the state social security system.","occupationalSafetyTitle":"Occupational safety","occupationalSafetyDesc":"Taobao Instant Commerce adopts a holistic approach to delivery rider safety, covering everything from safety standards and training to smart early warning systems and protective equipment.","careerDevelopmentTitle":"Career care","careerDevelopmentDesc":"Taobao Instant Commerce\'s delivery rider support system provides 24/7 assistance and offers care via the Orange Plan, the Orange Fund, and Care Stations. It fosters a sense of belonging and social recognition by presenting platform badges and empowering delivery riders to earn honors such as the National Model Worker Award.","publicWelfareTitle":"Inclusive engagement","encourageParticipationTitle":"Encouraging participation from everyone","encourageParticipationDesc":"Philanthropy is never a solitary endeavor. It is about spreading goodwill. We make consistent efforts to inspire employee giving and collaborate with partners to lower participation barriers, empowering everyone to contribute. In FY2026, Alibaba Group donated about RMB280 million to Alibaba-initiated charitable foundations.","threeHoursProgramTitle":"Three Hours for a Better World","threeHoursProgramDesc":"We launched the Three Hours for a Better World Initiative on September 10, 2015 to encourage employees to translate their passion for philanthropy into concrete actions. In FY2026, our full-time employees clocked 253,584 hours of volunteer service.","goodsForGoodProgramTitle":"Goods for Good","goodsForGoodProgramDesc":"We have launched the Goods for Good Program to mobilize broad participation in philanthropy. When a consumer purchases a \\"Goods for Good\\" product, a merchant-configured portion of the proceeds is donated to a philanthropic organization or project. In FY2026, the Goods for Good Program engaged over 1.56 million merchants and more than 430 million users.","consumerExperienceTitle":"Creating Excellent Consumer Experience","digitalLifeTitle":"Fostering Inclusive and Healthy Digital Life","diversityEquityInclusion":"Diversity, Equity & Inclusion","talentAttractionRetention":"Talent Attraction & Retention","talentDevelopmentOpportunities":"Rich Talent Development Opportunities","employeeHealthVitality":"Employee Health & Vitality","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"of employees are female","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"Forbes Global Best Employer","familyCareLeaveTitle":"Over 60,000","familyCareLeaveDesc":"Caring for families, employees enjoy precious time with their loved ones through family care leave","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"Multiple Alibaba campuses, data centers and logistics facilities have obtained certification","firstAidTrainingTitle":"Over 14,000","firstAidTrainingDesc":"Alibaba has cumulatively trained first aid heroes","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"Alibaba office environment satisfaction rate 93.1%"}')},54038:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u62a5\u544a","bannerTitle":"\u56de\u9988\u793e\u4f1a\u548c\u793e\u533a","bannerDescription":"\u963f\u91cc\u5df4\u5df4\u81ea\u8bde\u751f\u8d77\uff0c\u5c31\u5728\u4fdd\u6301\u81ea\u8eab\u53d1\u5c55\u7684\u540c\u65f6\u79ef\u6781\u5e94\u5bf9\u793e\u4f1a\u6311\u6218\u3002\u968f\u7740\u5728\u793e\u4f1a\u548c\u793e\u533a\u4e2d\u6301\u7eed\u6295\u5165\uff0c\u6211\u4eec\u4e5f\u4ece\u4e2d\u83b7\u5f97\u81ea\u8eab\u6280\u672f\u521b\u65b0\u548c\u5546\u4e1a\u62d3\u5c55\u7684\u673a\u9047\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u66f4\u597d