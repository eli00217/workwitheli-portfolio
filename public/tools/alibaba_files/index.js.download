\u614e\u5224\u5b9a\u662f\u5426\u69cb\u6210\u9055\u898f\uff0c\u4e26\u64da\u6b64\u4f5c\u51fa\u76f8\u61c9\u8655\u7406\uff0c\u5305\u62ec\u8a13\u8aa1\u3001\u8b66\u544a\u3001\u8a18\u904e\u3001\u89e3\u50f1\u7b49\u3002","riskManagementTitle":"\u98a8\u96aa\u7ba1\u7406","riskIdentification":"\u98a8\u96aa\u8b58\u5225\u8207\u6539\u9032","ethicsRiskIdentificationDesc":"\u6839\u64da\u6b77\u53f2\u8caa\u8150\u6848\u4ef6\uff0c\u4e3b\u52d5\u8b58\u5225\u91cd\u9ede\u98a8\u96aa\uff0c\u5c0d\u91cd\u9ede\u696d\u52d9\u548c\u9ad8\u98a8\u96aa\u5d17\u4f4d\u958b\u5c55\u5c08\u9805\u8a55\u4f30\uff0c\u4e26\u5236\u5b9a\u76f8\u61c9\u7684\u61c9\u5c0d\u7ba1\u7406\u65b9\u6cd5\u3002","managementResponsibility":"\u7ba1\u7406\u8005\u8cac\u4efb","managementResponsibilityDesc":"\u7ba1\u7406\u8005\u8981\u91cd\u8996\u98a8\u96aa\u63a7\u5236\uff0c\u9032\u884c\u6587\u5316\u5ba3\u50b3\uff0c\u7d66\u4e88\u5718\u968a\u6210\u54e1\u6709\u6548\u7684\u6307\u5c0e\u8207\u5e6b\u52a9\u3002\u5718\u968a\u7684\u5ec9\u6b63\u98a8\u96aa\u8b58\u5225\u8207\u8655\u7406\u7684\u7e3e\u6548\u8868\u73fe\u4e5f\u7d0d\u5165\u7ba1\u7406\u8005\u7684\u7e3e\u6548\u8003\u6838\u3002","supervisionTitle":"\u76e3\u7763\u8207\u5be9\u8a08","supervisionDesc":"\u6211\u5011\u5efa\u7acb\u4e86\u5167\u5916\u90e8\u5be9\u8a08\u6a5f\u5236\uff0c\u8a55\u4f30\u5167\u90e8\u63a7\u5236\u6a5f\u5236\u9632\u63a7\u8150\u6557\u7684\u6709\u6548\u6027\u3002\u5ec9\u6b63\u5408\u898f\u90e8\u806f\u5408\u5be9\u8a08\u3001\u5167\u63a7\u7b49\u90e8\u9580\uff0c\u6bcf\u5e74\u5c0d\u9ad8\u98a8\u96aa\u696d\u52d9\u958b\u5c55\u5ec9\u6b63\u5be9\u8a08\u3002\u6bcf\u5b63\u5ea6\u5411\u5916\u90e8\u5be9\u8a08\u6a5f\u69cb\u62ab\u9732\u8150\u6557\u4e8b\u4ef6\uff0c\u4e26\u56de\u61c9\u98a8\u96aa\u7ba1\u63a7\u554f\u8a62\u3002\u91dd\u5c0d\u5be9\u8a08\u8b58\u5225\u51fa\u7684\u554f\u984c\uff0c\u6211\u5011\u5efa\u7acb\u6301\u7e8c\u8ddf\u8e64\u6a5f\u5236\uff0c\u78ba\u4fdd\u76f8\u95dc\u90e8\u9580\u843d\u5be6\u6574\u6539\u3002","disclosureReporting":"\u8463\u4e8b\u6703\u532f\u5831","disclosureReportingDesc":"\u6bcf\u5b63\u5ea6\u5411\u8463\u4e8b\u6703\u5be9\u8a08\u59d4\u54e1\u6703\u548c\u5408\u898f\u53ca\u98a8\u96aa\u59d4\u54e1\u6703\u532f\u5831\u8caa\u8150\u6848\u4ef6\u3001\u98a8\u96aa\u6574\u6539\u548c\u8aa0\u4fe1\u6587\u5316\u5efa\u8a2d\u7b49\u8b70\u984c\u7684\u9032\u5c55\u3002","internalControl":"\u5be9\u8a08","internalControlDesc":"\u6bcf\u5b63\u5ea6\u5411\u5916\u90e8\u5be9\u8a08\u6a5f\u69cb\u62ab\u9732\u8caa\u8150\u4e8b\u4ef6\uff0c\u56de\u7b54\u98a8\u96aa\u7ba1\u63a7\u554f\u984c\u3002\u6b64\u5916\uff0c\u5ec9\u6b63\u5408\u898f\u90e8\u806f\u5408\u5167\u5be9\u90e8\u5c0d\u91cd\u9ede\u98a8\u96aa\u958b\u5c55\u5be9\u8a08\uff0c\u4ee5\u8a55\u4f30\u5167\u90e8\u63a7\u5236\u6a5f\u5236\u548c\u7a0b\u5e8f\u7684\u6709\u6548\u6027\u3002","integrityConstruction":"\u6587\u5316\u5efa\u8a2d","integrityConstructionDesc":"\u963f\u91cc\u5df4\u5df4\u5c0d\u8caa\u8150\u884c\u70ba\u96f6\u5bb9\u5fcd\uff0c\u4e26\u9762\u5411\u8463\u4e8b\u6703\u3001\u7ba1\u7406\u5c64\u3001\u54e1\u5de5\u548c\u5408\u4f5c\u5925\u4f34\u958b\u5c55\u4e0d\u540c\u985e\u578b\u7684\u57f9\u8a13\u6d3b\u52d5\uff0c\u5546\u696d\u884c\u70ba\u6e96\u5247\u548c\u8003\u6838\u662f\u54e1\u5de5\u6bcf\u5e74\u7684\u5fc5\u4fee\u8ab2\uff0c\u6211\u5011\u4e5f\u5728\u6b64\u57fa\u790e\u4e0a\u8209\u8fa6\u5404\u7a2e\u57f9\u8a13\u6d3b\u52d5\uff0c\u6253\u9020\u8aa0\u4fe1\u6587\u5316\u30022025\u8ca1\u5e74\uff0c\u54e1\u5de5\u5546\u696d\u884c\u70ba\u6e96\u5247\u8a8d\u8b49\uff08\u5167\u542b\u5ec9\u6b63\u57f9\u8a13\u8207\u8003\u6838\uff09\u901a\u904e\u7387\u9054100%\u3002","supplyChainTitle":"\u6df1\u5316\u4f9b\u61c9\u5546\u7ba1\u7406","supplyChainDesc":"\u6253\u9020\u5ec9\u6f54\u3001\u8aa0\u4fe1\u3001\u53ef\u6301\u7e8c\u7684\u5546\u696d\u74b0\u5883\u662f\u6211\u5011\u7ba1\u7406\u4f9b\u61c9\u5546\u7684\u6838\u5fc3\uff0c\u9019\u4e5f\u8207 ESG \u7406\u5ff5\u4e0d\u8b00\u800c\u5408\u3002\u6211\u5011\u767c\u5e03\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u63a7\u80a1\u6709\u9650\u516c\u53f8\u4f9b\u61c9\u5546\u5408\u898f\u7ba1\u7406\u898f\u7bc4\u300b\uff0c\u5404\u696d\u52d9\u4ee5\u6b64\u70ba\u57fa\u7dda\u8981\u6c42\uff0c\u53ef\u4f9d\u64da\u696d\u52d9\u5be6\u969b\u9700\u8981\uff0c\u5236\u5b9a\u5404\u81ea\u7684\u4f9b\u61c9\u5546\u5408\u898f\u7ba1\u7406\u76f8\u95dc\u653f\u7b56\u3002","esgStructureTitle":"\u4f9b\u61c9\u93c8ESG\u7ba1\u7406\u67b6\u69cb","esgStructureText":"\u6211\u5011\u6210\u7acb\u4f9b\u61c9\u93c8\u7ba1\u7406\u5c08\u9805\u7d44\uff0c\u76f4\u63a5\u5411\u53ef\u6301\u7e8c\u767c\u5c55\u7ba1\u7406\u59d4\u54e1\u6703\u532f\u5831\u3002\u5176\u4e3b\u8981\u8077\u8cac\u70ba\uff0c\u5b9a\u7fa9\u963f\u91cc\u5df4\u5df4\u4f9b\u61c9\u5546 ESG \u7ba1\u7406\u7684\u6a19\u6e96\u548c\u57fa\u7dda\uff0c\u4e26\u64da\u6b64\u63a8\u52d5\u4f9b\u61c9\u5546 ESG \u7ba1\u7406\u5be6\u8e10\u3002","supplierProcessTitle":"\u4f9b\u61c9\u5546\u7ba1\u7406\u6d41\u7a0b","supplierProcessText":"\u6211\u5011\u5efa\u7acb\u4e86\u4f9b\u61c9\u5546\u6578\u5b57\u5316\u7ba1\u7406\u7cfb\u7d71\uff0c\u8986\u84cb\u51c6\u5165\u3001\u9078\u64c7\u3001\u8a55\u4f30\u53ca\u98a8\u96aa\u7ba1\u7406\u56db\u5927\u74b0\u7bc0\u3002\u6211\u5011\u8981\u6c42\u4f9b\u61c9\u5546\u63d0\u4f9b\u76f8\u95dc\u7684\u8a8d\u8b49\u548c\u8cc7\u8cea\u6587\u4ef6\uff0c\u4e26\u9032\u884c\u5be9\u6838\uff0c\u63a8\u52d5\u4f9b\u61c9\u5546\u7c3d\u7f72\u300a\u8aa0\u4fe1\u7d04\u5b9a\u51fd\u300b\uff1b\u5728\u516c\u6b63\u516c\u5e73\u7684\u57fa\u790e\u4e0a\uff0c\u5404\u696d\u52d9\u53ef\u5efa\u7acb\u9069\u5408\u5be6\u969b\u9700\u8981\u7684\u4f9b\u61c9\u5546\u9078\u64c7\u6a19\u6e96\uff1b\u6211\u5011\u7684\u4e3b\u8981\u696d\u52d9\u5747\u69cb\u5efa\u4e86\u7b26\u5408\u81ea\u8eab\u696d\u52d9\u767c\u5c55\u7684\u4f9b\u61c9\u5546\u7e3e\u6548\u8a55\u50f9\u6a5f\u5236\uff0c\u5c0d\u4f9b\u61c9\u5546\u5408\u4f5c\u60c5\u6cc1\u9032\u884c\u9031\u671f\u6027\u7684\u8a55\u4f30\uff1b\u6211\u5011\u5728\u4e3b\u8981\u696d\u52d9\u7684\u4f9b\u61c9\u5546\u7ba1\u7406\u7cfb\u7d71\u8a2d\u7f6e\u4e86\u6578\u5b57\u5316\u98a8\u96aa\u9632\u63a7\u6a21\u584a\uff0c\u5be6\u73fe\u5c0d\u4f9b\u61c9\u5546\u51c6\u5165\u8a55\u4f30\u53ca\u5408\u4f5c\u5168\u6d41\u7a0b\u7684\u667a\u80fd\u98a8\u96aa\u8b58\u5225\u8207\u52d5\u614b\u76e3\u63a7\u3002","esgPracticeTitle":"\u4f9b\u61c9\u5546ESG\u7ba1\u7406","esgPracticeIntro":"\u4f9b\u61c9\u5546 ESG \u7ba1\u7406\u5be6\u8e10\uff1a\u6211\u5011\u5ba3\u5c0e\u4e26\u4e14\u651c\u624b\u4f9b\u61c9\u5546\u4e00\u8d77\u5be6\u8e10 ESG\u3002\u4f9b\u61c9\u93c8\u7ba1\u7406\u5c08\u9805\u7d44\u5b9a\u7fa9\u963f\u91cc\u5df4\u5df4\u4f9b\u61c9\u5546 ESG \u7ba1\u7406\u7684\u6a19\u6e96\u548c\u57fa\u7dda\uff0c\u4e26\u64da\u6b64\u63a8\u52d5\u4f9b\u61c9\u5546 ESG\u7ba1\u7406\u5be6\u8e10\u3002","guidelinesTabTitle":"\u5ba3\u5c0e\u4f9b\u61c9\u5546\u7c3d\u7f72 ESG \u884c\u70ba\u6e96\u5247","integrationTabTitle":"ESG\u9010\u6b65\u878d\u5165\u4f9b\u61c9\u5546\u7ba1\u7406\u9ad4\u7cfb","guidelinesContent":"\u300a\u963f\u91cc\u5df4\u5df4\u4f9b\u61c9\u5546 ESG \u884c\u70ba\u6e96\u5247\u898f\u7bc4\u300b\u660e\u78ba\u4f9b\u61c9\u5546\u61c9\u8a72\u9075\u5faa\u7684 ESG \u539f\u5247\uff0c\u5305\u62ec\u7981\u6b62\u4f7f\u7528\u7ae5\u5de5\u53ca\u5f37\u8feb\u52de\u52d5\u3001\u52de\u5de5\u6b0a\u76ca\u4fdd\u8b77\u3001\u4fdd\u969c\u8077\u696d\u5065\u5eb7\u548c\u5b89\u5168\u3001\u74b0\u5883\u4fdd\u8b77\u3001 \u6578\u64da\u5b89\u5168\u8207\u79c1\u96b1\u4fdd\u8b77\u3001\u5546\u696d\u9053\u5fb7\u7b49\u3002","integrationCard1Title":"ESG\u7d0d\u5165\u4f9b\u61c9\u5546\u7684\u9078\u64c7\u548c\u8a55\u4f30","integrationCard1Desc":"\u5728\u79df\u8cc3\u8cc7\u6599\u4e2d\u5fc3\u7684\u7ba1\u7406\u4e0a\uff0c\u6211\u5011\u5c07\u4f9b\u61c9\u5546\u7684\u74b0\u5883\u7e3e\u6548\u878d\u5165\u5230\u8a55\u4f30\u74b0\u7bc0\u3002\u5728\u90e8\u5206\u54c1\u985e\uff0c\u767c\u8d77\\"\u963f\u91cc\u5df4\u5df4\u4f9b\u61c9\u5546ESG\u7a4d\u5206\u9805\u76ee\\"\uff0c\u6536\u96c6\u548c\u8a55\u4f30\u4f9b\u61c9\u5546ESG\u8868\u73fe\u3002","integrationCard2Title":"\u5347\u7d1a\u4f9b\u61c9\u5546 ESG \u98a8\u96aa\u8b58\u5225","integrationCard2Desc":"\u6211\u5011\u8a66\u9ede\u5c07 ESG \u98a8\u96aa\u8b58\u5225\u7d0d\u5165\u4f9b\u61c9\u5546\u98a8\u96aa\u76e3\u6e2c\u9ad4\u7cfb\u4e2d\uff0c\u5f37\u5316\u4f9b\u61c9\u5546 ESG\u98a8\u96aa\u8b58\u5225\u548c\u9810\u8b66\u80fd\u529b\u3002","integrationCard3Title":"\u4f9b\u61c9\u5546ESG\u5408\u898f\u5de5\u4f5c\u6aa2\u67e5\u548c\u7cfe\u504f","integrationCard3Desc":"\u6211\u5011\u5c07ESG \u98a8\u96aa\u878d\u5165\u5230\u4f9b\u61c9\u5546\u7684\u5408\u898f\u5de5\u4f5c\u6aa2\u67e5\u3002\u751f\u614b\u7528\u5de5ESG \u5408\u898f\u5de5\u4f5c\u6aa2\u67e5\u8986\u84cb\u7528\u5de5\u898f\u7bc4\u3001\u8077\u696d\u5b89\u5168\u3001\u5546\u696d\u9053\u5fb7\u3001\u6295\u8a34\u6a5f\u5236\u65b9\u9762\u3002","integrationCard4Title":"ESG\u57f9\u8a13","integrationCard4Desc":"\u6211\u5011\u6301\u7e8c\u6295\u5165\u8cc7\u6e90\u52a0\u5f37\u4f9b\u61c9\u5546\u7ba1\u7406\u90e8\u9580\u7684\u54e1\u5de5\u57f9\u8a13\u3002\u5305\u62ec\u5ec9\u6b63\u5408\u898f\u3001\u6cd5\u5f8b\u6cd5\u898f\u3001ESG \u4ee5\u53ca\u63a1\u8cfc\u5c08\u696d\u6280\u80fd\u7b49\u5404\u500b\u5c64\u9762\u7684\u57f9\u8a13\u3002\u6b64\u5916\uff0c\u6211\u5011\u4e5f\u70ba\u4e3b\u8981\u696d\u52d9\u7684\u4f9b\u61c9\u5546\u63d0\u4f9b\u4e86ESG\u5408\u898f\u57f9\u8a13\u3002","dataPrivacyTitle":"\u4fdd\u8b77\u6578\u64da\u5b89\u5168\u8207\u79c1\u96b1","dataPrivacyDesc":"\u6211\u5011\u767c\u5e03\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u6578\u64da\u5b89\u5168\u7e3d\u7db1\u300b\uff0c\u8986\u84cb\u6578\u64da\u63a1\u96c6\u3001 \u6d41\u52d5\u3001\u5b58\u5132\u3001\u4f7f\u7528\u548c\u92b7\u6bc0\u7684\u751f\u547d\u5468\u671f\u5404\u500b\u74b0\u7bc0\uff0c\u660e\u78ba\u6578\u64da\u751f\u547d\u5468\u671f\u5b89\u5168\u7ba1\u7406\u8981\u6c42\uff0c\u78ba\u4fdd\u6578\u64da\u5b89\u5168\u7ba1\u63a7\u63aa\u65bd\u5be6\u65bd\u5230\u4f4d\u3002","managementStructureTitle":"\u7ba1\u7406\u67b6\u69cb","boardLevel":"\u8463\u4e8b\u6703","boardLevelDesc":"\u5408\u898f\u53ca\u98a8\u96aa\u59d4\u54e1\u6703\u8ca0\u8cac\u76e3\u7763\u96c6\u5718\u6578\u64da\u5b89\u5168\u8207\u500b\u4eba\u8cc7\u6599\u4fdd\u8b77\u5408\u898f\u4e8b\u5b9c\uff0c\u7531\u7368\u7acb\u8463\u4e8b\u4f5c\u70ba\u4e3b\u5e2d\u76f4\u63a5\u9818\u5c0e\u3002\u5408\u898f\u53ca\u98a8\u96aa\u59d4\u54e1\u6703\u5b9a\u671f\u6307\u5c0e\u6578\u64da\u5b89\u5168\u8207\u79c1\u96b1\u4fdd\u8b77\u7684\u6230\u7565\u4ee5\u53ca\u5be9\u67e5\u65e5\u5e38\u5de5\u4f5c\u3002","managementLevel":"\u7ba1\u7406\u5c64","managementLevelDesc":"\u6210\u7acb\u6578\u64da\u5b89\u5168\u6c7a\u7b56\u5c0f\u7d44\uff0c\u7531\u5168\u9762\u98a8\u96aa\u7ba1\u7406\u5de5\u4f5c\u7d44\u3001\u96c6\u5718\u5b89\u5168\u90e8\u7e3d\u88c1\u3001\u9996\u5e2d\u6cd5\u52d9\u5b98\u4ee5\u53ca\u5404\u696d\u52d9\u7684\u5b89\u5168\u8ca0\u8cac\u4eba\u7d44\u6210\uff0c\u8ca0\u8cac\u5236\u5b9a\u6578\u64da\u5b89\u5168\u7b56\u7565\u3001\u76ee\u6a19\u548c\u6578\u64da\u5b89\u5168\u98a8\u96aa\u6c7a\u7b56\u7b49\u3002","executionLevel":"\u57f7\u884c\u5c64","executionLevelDesc":"\u6210\u7acb\u6578\u64da\u5b89\u5168\u7ba1\u7406\u5c0f\u7d44\u548c\u6578\u64da\u5b89\u5168\u57f7\u884c\u5c0f\u7d44\u3002\u6b64\u5916\uff0c\u6211\u5011\u5728\u5404\u696d\u52d9\u5206\u5225\u8a2d\u7acb\u6578\u64da\u5b89\u5168\u8cac\u4efb\u4eba\u548c\u500b\u4eba\u8cc7\u6599\u4fdd\u8b77\u8ca0\u8cac\u4eba\u3002","securityPrinciplesTitle":"\u6578\u64da\u5b89\u5168\u7ba1\u7406\u539f\u5247","legalityPrinciple":"\u5408\u6cd5\u6b63\u7576","legalityDesc":"\u5c0d\u6578\u64da\u7684\u8655\u7406\u61c9\u7576\u6eff\u8db3\u6240\u6709\u9069\u7528\u7684\u6cd5\u5f8b\u6cd5\u898f\u8981\u6c42\uff0c\u4e14\u7b26\u5408\u516c\u958b\u6b63\u7576\u539f\u5247","legalityHoverDesc":"\u5c0d\u6578\u64da\u7684\u8655\u7406\u61c9\u7576\u6eff\u8db3\u6240\u6709\u9069\u7528\u7684\u6cd5\u5f8b\u6cd5\u898f\u8981\u6c42\uff0c\u4e14\u7b26\u5408\u516c\u958b\u6b63\u7576\u539f\u5247","purposePrinciple":"\u76ee\u7684\u660e\u78ba\u548c\u9650\u5236","purposeDesc":"\u6578\u64da\u8655\u7406\u6d3b\u52d5\u61c9\u7576\u660e\u78ba\u3001\u6e05\u6670\u3001\u5177\u9ad4\u7684\u6578\u64da\u8655\u7406\u76ee\u7684\uff0c\u4e14\u5f8c\u7e8c\u904e\u7a0b\u4e2d\u4e0d\u5f97\u8d85\u51fa\u6216\u9055\u53cd\u4ee5\u4e0a\u76ee\u7684\u9032\u884c\u4efb\u4f55\u6578\u64da\u8655\u7406\u6d3b\u52d5","purposeHoverDesc":"\u6578\u64da\u8655\u7406\u6d3b\u52d5\u61c9\u7576\u660e\u78ba\u3001\u6e05\u6670\u3001\u5177\u9ad4\u7684\u6578\u64da\u8655\u7406\u76ee\u7684\uff0c\u4e14\u5f8c\u7e8c\u904e\u7a0b\u4e2d\u4e0d\u5f97\u8d85\u51fa\u6216\u9055\u53cd\u4ee5\u4e0a\u76ee\u7684\u9032\u884c\u4efb\u4f55\u6578\u64da\u8655\u7406\u6d3b\u52d5","minimizationPrinciple":"\u6700\u5c0f\u5fc5\u8981","minimizationDesc":"\u6578\u64da\u8655\u7406\u6d3b\u52d5\u904e\u7a0b\u4e2d\uff0c\u5404\u500b\u968e\u6bb5\u90fd\u61c9\u9075\u5b88\u6700\u5c0f\u5fc5\u8981\u539f\u5247","minimizationHoverDesc":"\u6578\u64da\u8655\u7406\u6d3b\u52d5\u904e\u7a0b\u4e2d\uff0c\u5404\u500b\u968e\u6bb5\u90fd\u61c9\u9075\u5b88\u6700\u5c0f\u5fc5\u8981\u539f\u5247","transparencyPrinciple":"\u516c\u958b\u900f\u660e","transparencyDesc":"\u8655\u7406\u500b\u4eba\u8cc7\u6599\u61c9\u7576\u9075\u5faa\u516c\u958b\u3001\u900f\u660e\u539f\u5247\uff0c\u516c\u958b\u500b\u4eba\u8cc7\u6599\u8655\u7406\u898f\u5247\uff0c\u660e\u793a\u8655\u7406\u76ee\u7684\u3001\u65b9\u5f0f\u548c\u7bc4\u570d","transparencyHoverDesc":"\u8655\u7406\u500b\u4eba\u8cc7\u6599\u61c9\u7576\u9075\u5faa\u516c\u958b\u3001\u900f\u660e\u539f\u5247\uff0c\u516c\u958b\u500b\u4eba\u8cc7\u6599\u8655\u7406\u898f\u5247\uff0c\u660e\u793a\u8655\u7406\u76ee\u7684\u3001\u65b9\u5f0f\u548c\u7bc4\u570d","consentPrinciple":"\u77e5\u60c5\u540c\u610f","consentDesc":"\u8655\u7406\u500b\u4eba\u8cc7\u6599\u61c9\u7576\u9075\u5b88\u77e5\u60c5\u540c\u610f\u539f\u5247\uff0c\u78ba\u4fdd\u7528\u6236\u77e5\u66c9\u4e26\u540c\u610f\u500b\u4eba\u8cc7\u6599\u8655\u7406\u898f\u5247","consentHoverDesc":"\u8655\u7406\u500b\u4eba\u8cc7\u6599\u61c9\u7576\u9075\u5b88\u77e5\u60c5\u540c\u610f\u539f\u5247\uff0c\u78ba\u4fdd\u7528\u6236\u77e5\u66c9\u4e26\u540c\u610f\u500b\u4eba\u8cc7\u6599\u8655\u7406\u898f\u5247","storagePrinciple":"\u5b58\u5132\u9650\u5236","storageDesc":"\u61c9\u6309\u7d04\u5b9a\u7684\u76ee\u7684\u6216\u7528\u9014\u5b58\u5132\u6578\u64da\uff0c\u5305\u62ec\u5b58\u5132\u6578\u64da\u4e0d\u5f97\u8d85\u51fa\u6700\u521d\u7533\u8acb\u6642\u6240\u8aaa\u660e\u7684\u5b58\u5132\u6642\u9650\u3001\u5b58\u5132\u4f4d\u7f6e\u7b49","storageHoverDesc":"\u61c9\u6309\u7d04\u5b9a\u7684\u76ee\u7684\u6216\u7528\u9014\u5b58\u5132\u6578\u64da\uff0c\u5305\u62ec\u5b58\u5132\u6578\u64da\u4e0d\u5f97\u8d85\u51fa\u6700\u521d\u7533\u8acb\u6642\u6240\u8aaa\u660e\u7684\u5b58\u5132\u6642\u9650\u3001\u5b58\u5132\u4f4d\u7f6e\u7b49","securityPrinciple":"\u5b89\u5168\u4fdd\u969c","securityDesc":"\u9075\u5b88\u516c\u53f8\u5b89\u5168\u7d05\u7dda\u7b49\u76f8\u95dc\u5b89\u5168\u8981\u6c42\uff0c\u5c0d\u6578\u64da\u7684\u6574\u500b\u751f\u547d\u5468\u671f\u63d0\u4f9b\u5408\u7406\u5fc5\u8981\u7684\u4fdd\u8b77\u6a5f\u5236","securityHoverDesc":"\u9075\u5b88\u516c\u53f8\u5b89\u5168\u7d05\u7dda\u7b49\u76f8\u95dc\u5b89\u5168\u8981\u6c42\uff0c\u5c0d\u6578\u64da\u7684\u6574\u500b\u751f\u547d\u5468\u671f\u63d0\u4f9b\u5408\u7406\u5fc5\u8981\u7684\u4fdd\u8b77\u6a5f\u5236","accountabilityPrinciple":"\u8cac\u4efb\u6e05\u6670\u53ef\u8ffd\u6eaf","accountabilityDesc":"\u660e\u78ba\u5404\u65b9\u5728\u6578\u64da\u8655\u7406\u6d3b\u52d5\u904e\u7a0b\u4e2d\u7684\u8cac\u4efb\uff0c\u4e26\u63a1\u7528\u53ef\u884c\u7684\u6280\u8853\u624b\u6bb5\u5c0d\u6578\u64da\u8655\u7406\u904e\u7a0b\u9032\u884c\u8a18\u9304\u4ee5\u4fbf\u65bc\u8ffd\u6eaf","accountabilityHoverDesc":"\u660e\u78ba\u5404\u65b9\u5728\u6578\u64da\u8655\u7406\u6d3b\u52d5\u904e\u7a0b\u4e2d\u7684\u8cac\u4efb\uff0c\u4e26\u63a1\u7528\u53ef\u884c\u7684\u6280\u8853\u624b\u6bb5\u5c0d\u6578\u64da\u8655\u7406\u904e\u7a0b\u9032\u884c\u8a18\u9304\u4ee5\u4fbf\u65bc\u8ffd\u6eaf","managementProcessTitle":"\u6578\u64da\u5b89\u5168\u7ba1\u7406\u6d41\u7a0b","step1Title":"\u500b\u4eba\u8cc7\u6599\u63a1\u96c6\u968e\u6bb5","step1Desc":"\u500b\u4eba\u8cc7\u6599\u63a1\u96c6\u968e\u6bb5\uff0c\u9075\u5faa\u77e5\u60c5\u540c\u610f\u548c\u6700\u5c0f\u5fc5\u8981\u539f\u5247\uff0c\u660e\u78ba\u63a1\u96c6\u76ee\u7684\u4e26\u7372\u5f97\u7528\u6236\u6388\u6b0a","step2Title":"\u6578\u64da\u5206\u985e\u5206\u7d1a","step2Desc":"\u6211\u5011\u5c0d\u6578\u64da\u9032\u884c\u5206\u7d1a\u5206\u985e\u7ba1\u7406\uff0c\u7279\u5225\u662f\u5c0d\u7528\u6236\u500b\u4eba\u8cc7\u6599\u7b49\u654f\u611f\u6578\u64da\u9032\u884c\u91cd\u9ede\u4fdd\u8b77","step3Title":"\u6578\u64da\u5b58\u5132","step3Desc":"\u5728\u6578\u64da\u5b58\u5132\u74b0\u7bc0\uff0c\u63a1\u7528\u52a0\u5bc6\u5b58\u5132\u3001\u5efa\u7acb\u5fc5\u8981\u7684\u6578\u64da\u5bb9\u707d\u5099\u4efd\u8207\u6062\u5fa9\u4e26\u78ba\u4fdd\u5b58\u5132\u74b0\u5883\u5b89\u5168","step4Title":"\u6578\u64da\u8a2a\u554f\u63a7\u5236","step4Desc":"\u5728\u6578\u64da\u4f7f\u7528\u6642\uff0c\u5be6\u65bd\u8a2a\u554f\u63a7\u5236\u4e26\u9032\u884c\u5b89\u5168\u76e3\u63a7","step5Title":"\u6578\u64da\u50b3\u8f38","step5Desc":"\u6578\u64da\u50b3\u8f38\u904e\u7a0b\u4e2d\uff0c\u4f7f\u7528\u5b89\u5168\u5354\u8b70\u6216\u8005\u5b89\u5168\u50b3\u8f38\u901a\u9053\u9032\u884c\u50b3\u8f38","step6Title":"\u6578\u64da\u92b7\u6bc0","step6Desc":"\u6578\u64da\u92b7\u6bc0\u968e\u6bb5\uff0c\u5efa\u7acb\u5be9\u6279\u6d41\u7a0b\uff0c\u63a1\u7528\u5b89\u5168\u92b7\u6bc0\u6280\u8853\u4e26\u4fdd\u7559\u64cd\u4f5c\u8a18\u9304","crossBorderManagement":"\u6578\u64da\u8de8\u5883\u7ba1\u7406","crossBorderDesc":"\u6d89\u53ca\u6578\u64da\u8de8\u5883\u6642\uff0c \u6211\u5011\u6703\u63d0\u524d\u9032\u884c\u6578\u64da\u5b89\u5168\u548c\u79c1\u96b1\u4fdd\u8b77\u5f71\u97ff\u6027\u8a55\u4f30\u4e26\u63a1\u53d6\u76f8\u61c9\u7684\u5b89\u5168\u63aa\u65bd\uff0c\u78ba\u4fdd\u6578\u64da\u8de8\u5883\u5408\u6cd5\u5408\u898f\u4e26\u5f97\u5230\u4fdd\u8b77\uff0c\u4e26\u78ba\u4fdd\u9075\u5b88\u7576\u5730\u6cd5\u898f\u548c\u76e3\u7ba1\u90e8\u9580\u7684\u8981\u6c42\u9032\u884c\u6578\u64da\u8655\u7406\u3002","externalDisclosure":"\u5c0d\u5916\u6578\u64da\u62ab\u9732\u7ba1\u7406","externalDisclosureDesc":"\u91dd\u5c0d\u6578\u64da\u5c0d\u5916\u62ab\u9732\uff0c\u5236\u5b9a\u4e86\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u5c0d\u5916\u6578\u64da\u62ab\u9732\u7d30\u5247\u300b\uff0c\u900f\u904e\u300c\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u5c0d\u5916\u6578\u64da\u62ab\u9732\u5e73\u53f0\u300d\u9032\u884c\u6d41\u7a0b\u7ba1\u7406\u3002","partnerManagement":"\u5408\u4f5c\u65b9\u6578\u64da\u7ba1\u7406","partnerManagementDesc":"\u5408\u4f5c\u524d\u5be9\u6838\u6578\u64da\u5b89\u5168\u8cc7\u8cea\u548c\u7ba1\u7406\u80fd\u529b\uff0c\u7c3d\u7f72\u5305\u62ec\u6578\u64da\u5b89\u5168\u7ba1\u7406\u548c\u5be9\u8a08\u8981\u6c42\u7684\u5354\u8b70\uff0c\u5c0d\u91cd\u8981\u5408\u4f5c\u65b9\u57f7\u884c\u76e1\u8077\u8abf\u67e5\uff1b\u5408\u4f5c\u4e2d\u52d5\u614b\u76e3\u63a7\u3001\u5b9a\u671f\u5be9\u8a08\u4e26\u6bcf\u5e74\u8a55\u4f30\u7ba1\u7406\u80fd\u529b\uff1b\u5c0d\u9055\u898f\u5408\u4f5c\u65b9\u63a1\u53d6\u66ab\u505c\u6388\u6b0a\u3001\u9650\u5236\u8abf\u7528\u3001\u6e05\u9000\u7b49\u8655\u7f6e\u3002","privacyImpactTitle":"\u79c1\u96b1\u5f71\u97ff\u8a55\u4f30\u6d41\u7a0b","privacyImpactIntro":"\u91dd\u5c0d\u570b\u5167\u904b\u71df\u7684 APP\uff0c\u5404\u696d\u52d9\u5efa\u7acb\u4e86\u79c1\u96b1\u5f71\u97ff\u8a55\u4f30\u6d41\u7a0b\uff0c\u65e8\u5728\u78ba\u4fdd\u79c1\u96b1\u4fdd\u8b77\u63aa\u65bd\u5f97\u5230\u5145\u5206\u8003\u616e\uff0c\u4e26\u7b26\u5408\u76f8\u95dc\u6cd5\u5f8b\u6cd5\u898f\u8981\u6c42\u3002\u91dd\u5c0d\u6d77\u5916\u904b\u71df\u7684 APP\uff0c\u6211\u5011\u7684\u696d\u52d9\u4e5f\u6703\u6839\u64da\u5404\u5730\u5340\u7684\u6cd5\u5f8b\u6cd5\u898f\u5236\u5b9a\u4e26\u57f7\u884c\u76f8\u61c9\u7684\u7ba1\u7406\u63aa\u65bd\u3002","developmentStage":"APP\u958b\u767c\u968e\u6bb5","developmentStageDesc":"\u7814\u767c\u5e73\u53f0\u4e0a\u5d4c\u5165\u7684\u79c1\u96b1\u5408\u898f\u6383\u63cf\u5de5\u5177\uff0c\u53ef\u81ea\u52d5\u9032\u884c\u5408\u898f\u6383\u63cf\u3002","preLaunchStage":"APP\u4e0a\u7dda\u524d","preLaunchStageDesc":"\u65b0\u7522\u54c1\u3001\u65b0\u529f\u80fd\u4e0a\u7dda\u524d\u9700\u900f\u904e\u79c1\u96b1\u4fdd\u8b77\u5408\u898f\u548c\u5b89\u5168\u8a55\u5be9\u3002","postLaunchStage":"APP\u4e0a\u7dda\u5f8c","postLaunchStageDesc":"\u6301\u7