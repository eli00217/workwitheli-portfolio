76\u4e2d\u53ea\u670961%-62% \u5728\u53d7\u63a7\u8a2d\u65bd\u4e2d\u5f97\u5230\u8655\u7406\u3002\u6211\u5011\u5805\u6301\\"\u6e1b\u91cf\u5316\\"\u548c\\"\u8cc7\u6e90\u5316\\"\u8655\u7406\uff0c\u52aa\u529b\u63a8\u52d5\u5ee2\u68c4\u7269\u5408\u898f\u9ad8\u6548\u7ba1\u7406\u3002","wasteDataCenterTitle":"\u6578\u64da\u4e2d\u5fc3","wasteDataCenterContent":"\u6211\u5011\u7684\u81ea\u5efa\u6578\u64da\u4e2d\u5fc3\u6240\u6709\u5371\u96aa\u5ee2\u68c4\u7269100%\u4ea4\u7531\u6301\u8b49\u5c08\u696d\u6a5f\u69cb\u8655\u7406\uff0c\u4e26\u69cb\u5efa\u4e86IT\u8a2d\u5099\u56de\u6536\u9ad4\u7cfb\uff0c\u63a8\u52d5\u8cc7\u6e90\u5faa\u74b0\u518d\u751f\u3002","wasteOfficeParkTitle":"\u8fa6\u516c\u5712\u5340","wasteOfficeParkContent":"\u6211\u5011\u5728\u8fa6\u516c\u5712\u5340\u5805\u6301\u300c100%\u5408\u898f\u8655\u7406\u5ee2\u68c4\u7269\u300d\u539f\u5247\uff0c\u63a8\u884c\u5ee2\u68c4\u7269\u6578\u5b57\u5316\u7ba1\u7406\uff0c\u4e26\u8a66\u9ede\u5c07\u5eda\u9918\u5783\u573e\u8f49\u5316\u70ba\u6709\u6a5f\u80a5\uff0c\u63a8\u52d5\u8cc7\u6e90\u5faa\u74b0\u5229\u7528\u3002","wasteRetailTitle":"\u96f6\u552e\u5834\u6240","wasteRetailContent":"\u76d2\u99ac\u81f4\u529b\u65bc\u5ee2\u68c4\u7269\u7684\u7cbe\u7d30\u5316\u7ba1\u7406\uff0c\u5be6\u65bd\u91dd\u5c0d\u6027\u7684\u6cbb\u7406\u8209\u63aa\uff0c\u76ee\u6a19\u662f\u5be6\u73fe\u5ee2\u68c4\u7269100%\u5408\u898f\u8655\u7f6e\u3002","ecosystemDescription":"\u6211\u5011\u4e0d\u65b7\u5b78\u7fd2\u548c\u8ddf\u8e64\u751f\u7269\u591a\u6a23\u6027\u98a8\u96aa\u8207\u6a5f\u9047\u7684\u6846\u67b6\u548c\u6307\u6a19\uff0c\u81f4\u529b\u65bc\u5728\u904b\u71df\u4e2d\u4fdd\u8b77\u751f\u7269\u591a\u6a23\u6027\uff0c\u4e26\u5354\u540c\u591a\u65b9\u53c3\u8207\u5171\u7528\u548c\u5171\u6cbb\u3002","ecosystemCard1Title":"\u8fa6\u516c\u5712\u5340","ecosystemCard1Description":"\u70ba\u76e1\u53ef\u80fd\u964d\u4f4e\u751a\u81f3\u626d\u8f49\u5712\u5340\u8a2d\u8a08\u548c\u5efa\u9020\u904e\u7a0b\u4e2d\u5e36\u4f86\u7684\u8ca0\u9762\u5f71\u97ff\uff0c\u6211\u5011\u5c07\u751f\u7269\u591a\u6a23\u6027\u7684\u8003\u91cf\u878d\u5165\u5230\u5712\u5340\u8a2d\u8a08\u548c\u904b\u71df\u74b0\u7bc0\uff0c\u5982\u4f7f\u7528\u672c\u571f\u7269\u7a2e\u3001\u591a\u5143\u5316\u690d\u7269\u7a2e\u985e\u8c50\u5bcc\u690d\u88ab\u7d50\u69cb\u5c64\u6b21\uff0c\u6253\u9020\u751f\u614b\u5eca\u9053\u7b49\uff0c\u4f7f\u4eba\u8207\u81ea\u7136\u548c\u8ae7\u76f8\u8655\u3002","ecosystemCard2Title":"\u96fb\u5546\u5e73\u81fa","ecosystemCard2Description":"\u751f\u7269\u591a\u6a23\u6027\u7684\u98a8\u96aa\u4e4b\u4e00\u662f\u975e\u6cd5\u91ce\u751f\u52d5\u690d\u7269\u4ea4\u6613\u3002\u6211\u5011\u7684\u96fb\u5546\u5e73\u81fa\u9762\u5411\u5546\u5bb6\uff0c\u900f\u904e\u4eba\u5de5\u667a\u80fd\u6f14\u7b97\u6cd5\u5c0d\u6587\u672c\u3001\u5716\u7247\u3001\u8996\u983b\u7b49\u5167\u5bb9\u5be6\u65bd\u76f8\u95dc\u98a8\u96aa\u7684\u5be6\u6642\u76e3\u6e2c\uff1b\u9762\u5411\u6d88\u8cbb\u8005\uff0c\u6301\u7e8c\u904b\u71df\\"\u7da0\u7db2\u8a08\u5283\\"\uff0c\u958b\u5c55\u516c\u773e\u751f\u614b\u6cd5\u6cbb\u5ba3\u50b3\u6559\u80b2\u3002","ecosystemCard3Title":"\u63a8\u52d5\u591a\u65b9\u53c3\u8207","ecosystemCard3Description":"\u6211\u5011\u81f4\u529b\u65bc\u69cb\u5efa\u591a\u65b9\u5354\u540c\u7684\u53ef\u6301\u7e8c\u767c\u5c55\u751f\u614b\u9ad4\u7cfb\uff0c\u4e26\u8207\u653f\u5e9c\u90e8\u9580\u3001\u76e3\u7ba1\u6a5f\u69cb\u53ca\u5c08\u696d\u7d44\u7e54\u5efa\u7acb\u4f19\u4f34\u95dc\u4fc2\u30022024\u5e745\u6708\uff0c\u963f\u91cc\u5df4\u5df4\u652f\u6301\u8209\u8fa6\u4ee5\u300c\u4e0a\u6d77\uff0c\u66f4\u597d\u7684\u81ea\u7136\u6559\u80b2\u300d\u70ba\u4e3b\u984c\u76842024 \u4e2d\u570b\u81ea\u7136\u6559\u80b2\u5927\u6703\u3002"}')},54560:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","actionResults":"Progress","actionResultsTitle":"Progress","actionResultCard1Title":"4.54","actionResultCard1Unit":"","actionResultCard1Desc":"Employees\u2019 rating for our workplace integrity increased to 4.54 out of 5.","actionResultCard2Prefix":"","actionResultCard2Title":"Industry leader","actionResultCard2Unit":"","actionResultCard2Desc":"We received a three-star rating from the Data Security Working Committee of the China Cybersecurity Industry Alliance for our performance in data security and privacy protection.","actionResultCard3Title":"20,092","actionResultCard3Unit":"","actionResultCard3Desc":"20,092 suppliers signed the Alibaba Supplier ESG Code of Conduct.","actionResultCard4Prefix":"","actionResultCard4Title":"AI Safety Commitments","actionResultCard4Unit":"","actionResultCard4Desc":"We signed the AI Safety Commitments, published by the China AI Industry Alliance.","actionResultCard5Title":"ISO 42001","actionResultCard5Desc":"Alibaba Cloud and DingTalk obtained the ISO 42001 certification for AI management systems.","strategyPath":"Approaches","strategyPathTitle":"Approaches","strategyPathDescription":"Guided by Alibaba\'s mission, vision, and values, we have established the Alibaba Group Code of Business Conduct. It covers key ESG-related topics, such as observing business ethics, choosing trustworthy partners, safeguarding data security, and protecting privacy. Each year, all employees are required to receive training and pass an exam on this code. We stress business integrity and have established a governance structure to support its implementation. At the board level, the Compliance and Risk Committee and the Sustainability Committee oversee and manage relevant matters.","bannerTitle":"Business integrity","bannerDescription":"Alibaba is built on integrity, right from day one. This underpins our ability to retain top talent and serve customers. It is also the driving force behind our social responsibility.","consumerExperienceTitle":"Creating Excellent Consumer Experience","digitalLifeTitle":"Fostering Inclusive and Healthy Digital Life","diversityEquityInclusion":"Diversity, Equity & Inclusion","talentAttractionRetention":"Talent Attraction & Retention","talentDevelopmentOpportunities":"Rich Talent Development Opportunities","employeeHealthVitality":"Employee Health & Vitality","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"of employees are female","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"Forbes Global Best Employer","familyCareLeaveTitle":"Over 60,000","familyCareLeaveDesc":"Caring for families, employees enjoy precious time with their loved ones through family care leave","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"Multiple Alibaba campuses, data centers and logistics facilities have obtained certification","firstAidTrainingTitle":"Over 14,000","firstAidTrainingDesc":"Alibaba has cumulatively trained first aid heroes","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"Alibaba office environment satisfaction rate 93.1%","integrityCommerce":"Business ethics","supplyChainManagement":"Supplier management","dataPrivacySecurity":"Data security and privacy","networkSecurityProtection":"Cybersecurity","ethicalTechnology":"Technology ethics","integrityCommerceTitle":"Business ethics","integrityCommerceDesc":"As a platform company, we recognize the paramount importance of building an open, transparent, and fair operating environment. In our efforts to create a sustainable business landscape, we operate with compliance, integrity, and honesty, requiring every employee to demonstrate high standards of business ethics. We attach great importance to creating and maintaining a market environment characterized by fair competition. We are committed to competing fairly and strictly prohibit imposing unreasonable restrictions on partners or engaging in discriminatory treatment toward customers.","managementStructure":"Management structure","managementSupervision":"Board oversight","managementSupervisionDesc":"As the highest oversight body, the Board\'s Compliance and Risk Committee oversees anti-corruption management and is briefed quarterly on corruption cases, risk remediation, and integrity culture initiatives.","managementExecution":"Execution","managementExecutionDesc":"The Integrity and Compliance Department and the Legal and Compliance Department serve as the executive bodies for anti-corruption management. The former is charged with preventing corruption, investigating misconduct, and fostering a culture of integrity, while the latter is responsible for revising, interpreting, and enforcing anti-corruption rules.","independentMechanism":"Operational mechanism","independentMechanismDesc":"The Integrity and Compliance Department operates independently of all businesses, Internal Audit, and Internal Control in a coordinated multi-line defense system.","reportAndInvestigation":"Reporting and investigation","independentReportChannel":"Independent reporting channels","independentReportChannelDesc":"We maintain 24/7 independent reporting channels accessible via our official website, dedicated emails, and hotlines, with support for multiple languages, including English and Spanish.","whistleblowerProtection":"Whistleblower Protection","whistleblowerProtectionDesc":"We accept anonymous reporting and strictly prohibit retaliation. Our code of business conduct explicitly mandates whistleblower protection, guaranteeing the confidentiality of the whistleblower\'s identity and the reported information.","investigationHandling":"Handling","investigationHandlingDesc":"Upon receiving a lead about corruption, the Integrity and Compliance Department conducts an investigation jointly with the department of the employee involved. They determine whether a violation has occurred and, if so, take the appropriate disciplinary action,  which may be a reprimand, a warning, a demerit, or termination.","riskManagementTitle":"Risk management","riskIdentification":"Risk identification and remediation","riskIdentificationDesc":"Routine risk assessments cover scenarios involving data security and privacy protection. Continuous monitoring on data security risks and incidents enables real-time alerts and proactive defense against anomalous operations.","managementResponsibility":"Management accountability","managementResponsibilityDesc":"Managers are required to prioritize risk control, champion an anti-corruption culture, and provide their teams with effective guidance. A team\'s outcomes in identifying and handling integrity risks are factored into its manager\'s performance review.","supervisionTitle":"Oversight and audit","supervisionDesc":"Internal and external audits evaluate anti-corruption controls. The Integrity and Compliance Department works with Audit and Internal Control to conduct annual integrity audits on high-risk operations. Corruption incidents are disclosed quarterly to external auditors, and we respond to their inquiries about risk control. Continuous tracking ensures departments involved remediate all identified issues.","disclosureReporting":"Board briefings","disclosureReportingDesc":"Each quarter, the Board\'s Audit Committee and Compliance and Risk Management Committee are briefed on corruption cases, risk remediation, and integrity culture building.","internalControl":"Audits","internalControlDesc":"Each quarter, we disclose corruption incidents to an external audit firm and answer its questions about risk control. The Integrity and Compliance Department, in conjunction with Internal Audit, examines major risks to evaluate the effectiveness of internal controls.","integrityConstruction":"Cultural building","integrityConstructionDesc":"We maintain zero-tolerance for corruption and provide tailored training for the Board of Directors, management, employees, and partners. All employees are required to complete training and pass an exam on the Alibaba Group Code of Business Conduct each year. Additionally, we launch diverse initiatives to foster a culture of integrity. In FY2025, our employees achieved a 100% passing rate for the Alibaba Group Code of Business Conduct certification, which comprises integrity training and an exam.","supplyChainTitle":"Supplier management","supplyChainDesc":"Creating an ethical, trustworthy, and sustainable business environment is central to our supplier management. It also aligns seamlessly with the ESG philosophy. We have released the Alibaba Group Holding Limited Supplier Compliance Management Specifications. With this document as the baseline, all businesses can develop their own policies for supplier compliance management.","esgStructureTitle":"Supply chain ESG management","esgStructureText":"We have established the Supply Chain Management Working Group, which reports directly to the Sustainability Steering Committee. It is primarily tasked with defining standards for supplier ESG management and driving actions accordingly.","managementProcessTitle":"Data security management process","managementProcessText":"We have established a digital supplier management system covering four key areas: admission, selection, assessment and risk management. We require suppliers to provide relevant certification and qualification documents for review, and promote suppliers to sign the \'Integrity Commitment Letter\'. On the basis of fairness and justice, each business can establish supplier selection standards suitable for actual needs. Our main businesses have built supplier performance evaluation mechanisms that are in line with their business development, and conduct periodic evaluations of supplier cooperation. The supplier management systems of our main businesses have a digital risk control module that enables smart risk identification and dynamic monitoring across the full lifecycle of supplier management, from onboarding and evaluation to ongoing collaboration.","esgPracticeTitle":"Supplier ESG management","esgPracticeIntro":"Management practices for supplier ESG: We advocate for ESG and work hand in hand with suppliers to practice it. We have established the Supply Chain Management Working Group, which defines Alibaba\'s standard and baseline for supplier ESG management and, based on these, promotes management practices for supplier ESG.","guidelinesTabTitle":"ESG code of conduct","integrationTabTitle":"Integrating ESG into supplier management","guidelinesContent":"The Alibaba Supplier ESG Code of Conduct outlines the ESG principles that suppliers must adhere to, including the prohibition of child or forced labor, labor rights protection, occupational health and safety, environmental protection, data security, privacy protection, and business ethics.","integrationCard1Title":"Embedding ESG in supplier selection and evaluation","integrationCard1Desc":"In the management of leased data centers, we incorporate environmental performance into supplier evaluation. For some categories, we have launched the Alibaba Supplier ESG Scoring Program to collect data and evaluate the ESG performance of suppliers.","integrationCard2Title":"Identifying ESG risks among suppliers","integrationCard2Desc":"In a pilot initiative, we have integrated ESG factors into our supplier risk monitoring system, sharpening our ability to detect and flag ESG risks among suppliers.","integrationCard3Title":"ESG compliance for suppliers","integrationCard3Desc":"We have integrated ESG risk assessment into supplier compliance checks. ESG compliance checks for outsourced labor cover labor regulations, occupational safety, business ethics, and grievance mechanisms.","integrationCard4Title":"ESG training","integrationCard4Desc":"We continuously invest resources to enhance training for our supplier management teams. This training covers various areas, including integrity, legal requirements, ESG, and procurement skills. Additionally, we provide ESG compliance training for the suppliers of our main businesses.","dataPrivacyTitle":"Data security and privacy","dataPrivacyDesc":"We have released the Data Security Guidelines of Alibaba Group (General Guideline). These guidelines cover all stages of the data lifecycle, from collection and movement to storage, use, and destruction. They set forth security management requirements throughout the data lifecycle and mandate that data security control measures be effectively implemented.","managementStructureTitle":"Management structure","boardLevel":"Board","boardLevelDesc":"Chaired by an independent director, the Compliance and Risk Committee oversees data security and privacy protection across the Group, offering strategic guidance and reviewing day-to-day work.","managementLevel":"Management","managementLevelDesc":"We have established a decision-making group for data security comprising members from the Risk Management Working Group, the President of Alibaba Group\'s Security Department, the General Counsel, and the security heads of all businesses. It formulates policies, sets goals, and makes decisions.","executionLevel":"Execution","executionLevelDesc":"We have established a management group and an execution group for data security. Furthermore, we have appointed Data Protection Officers and Personal Information Protection Officers for all businesses.","securityPrinciplesTitle":"Management principles","legalityPrinciple":"Legality and legitimacy","legalityDesc":"Data processing must comply with all applicable legal and regulatory requirements, adhering to the principles of legality and legitimacy.","legalityHoverDesc":"Data processing must comply with all applicable legal and regulatory requirements, adhering to the principles of openness and legitimacy.","purposePrinciple":"Clear purposes and restrictions","purposeDesc":"Data processing must have explicit, clear, and specific purposes and must not be conducted beyond or contrary to such purposes during subsequent stages.","purposeHoverDesc":"Data processing must have explicit, clear, and specific purposes and must not be conducted beyond or contrary to such purposes during subsequent stages.","minimizationPrinciple":"Minimal necessity","minimizationDesc":"The principle of minimal necessity applies to every stage of data processing.","minimizationHoverDesc":"The principle of minimal necessity applies to every stage of data processing.","transparencyPrinciple":"Openness and transparency","transparencyDesc":"The processing of personal information must follow the principles of openness and transparency. The rules governing such processing must be disclosed, with its purpose, method, and scope clearly indicated.","transparencyHoverDesc":"The processing of personal information must follow the principles of openness and transparency. The rules governing such processing must be disclosed, with its purpose, method, and scope clearly indicated.","consentPrinciple":"Informed consent","consentDesc":"The processing of personal information must follow the principle of informed consent, ensuring that users are aware of and agree to the rules governing the processing of their personal information.","consentHoverDesc":"The processing of personal information must follow the principle of informed consent, ensuring that users are aware of and agree to the rules governing the processing of their personal information.","storagePrinciple":"Storage limitation","storageDesc":"Data must be stored in accordance with the agreed purpose or use, not exceeding the storage period and location specified during the initial application.","storageHoverDesc":"Data must be stored in accordance with the agreed purpose or use, not exceeding the storage period and location specified during the initial application.","securityPrinciple":"Security safeguards","securityDesc":"Security requirements, such as the company\'s security red lines, must be complied with, and reasonably necessary protection mechanisms must be in place throughout the entire data lifecycle.","securityHoverDesc":"Security requirements, such as the company\'s security red lines, must be complied with, and reasonably necessary protection mechanisms must be in place throughout the entire data lifecycle.","accountabilityPrinciple":"Accountability and traceability","accountabilityDesc":"Responsibilities of all parties involved in data processing must be clearly defined, with feasible technical measures adopted to record the data processing process to ensure traceability.","accountabilityHoverDesc":"Responsibilities of all parties involved in data processing must be clearly defined, with feasible technical measures adopted to record the data processing process to ensure traceability.","step1Title":"At the stage of personal information collection","step1Desc":"For data collection, we clarify the purpose and obtain user authorization, adhering to the principles of informed consent and minimal necessity.","step2Title":"We classify and categorize data","step2Desc":"We classify data based on sensitivity, ensuring the highest level of protection for personal information.  ","step3Title":"For data storage","step3Desc":"For data storage, we adopt encryption and establish necessary disaster recovery, backup, and restoration mechanisms within a secure storage environment.","step4Title":"When it comes to using data","step6Desc":"For data destruction, we enforce an approval process, use secure destruction technologies, and maintain operation logs.","step5Title":"For data management","step4Desc":"For data usage, we deploy strict access control and security monitoring.","step6Title":"For data destruction","step5Desc":"For data transfers, we use secure protocols or secure transmission channels.","crossBorderManagement":"Cross-border data management","crossBorderDesc":"For cross-border data transfers, we conduct prior impact assessments on security and privacy, formulating necessary measures to ensure compliance and protection.","externalDisclosure":"Data disclosure management","externalDisclosureDesc":"For external data disclosure, we have established the Detailed Rules of Alibaba Group for External Data Disclosure and manage the process through the Alibaba Group Data Disclosure Platform.","partnerManagement":"Partner data management","partnerManagementDesc":"Pre-engagement, we vet security credentials as well as management capabilities and sign agreements featuring security and audit clauses. For key partners, we conduct due diligence. During collaboration, we perform dynamic monitoring, periodic audits, and annual capability evaluations. Upon non-compliance, we take disciplinary actions such as suspending authorization, restricting access, and terminating cooperation.","privacyImpactTitle":"Privacy impact assessments","privacyImpactIntro":"Businesses operating apps within the Chinese Mainland have established processes for privacy impact assessments, designed to ensure that privacy protection measures for their apps receive adequate consideration and comply with applicable laws and regulations. Businesses operating apps outside the Chinese Mainland formulate and adopt management measures based on local laws and regulations. One example is the Personal Data Protection Impact Assessment Policy of Alibaba International Digital Commerce Group, which has already been released.","developmentStage":"App development","developmentStageDesc":"A privacy compliance scanning tool integrated into the R&D platform performs an automated scan.","preLaunchStage":"Before launch","preLaunchStageDesc":"A new product or feature must pass a privacy and security review before going live.","postLaunchStage":"After launch","postLaunchStageDesc":"Security compliance checks are performed on a regular basis.","dataRiskManagementTitle":"Data risk management","riskIdentificationTitle":"Risk identification and resolution","dataBackupTitle":"Data backup and disaster recovery","dataBackupDesc":"Robust disaster recovery mechanisms ensure business data is backed up at least every seven days. Data in critical systems has real-time backups, supported by local and geo-redundant disaster recovery capabilities. Data recovery drills occur at least annually, with validation logs retained.","incidentResponseTitle":"Incident response and post-mortem analysis","incidentResponseDesc":"Our protocols cover incident classification, monitoring, early warning, response, post-mortem analysis, and accountability, complete with regular drills. Personal information incidents are promptly reported to users and regulators as legally required.","securityTrainingTitle":"Building a data security culture","securityTrainingDesc":"As a component of our risk prevention efforts, we place a great emphasis on training employees, suppliers, and partners in the field of data security and privacy protection. New employees are required to receive data security training upon onboarding. Data security is included in our annual company-wide training program for the Alibaba Group Code of Business Conduct, which comes with an exam. Furthermore, we launched bug bounty programs open to the general public.","riskPlatformTitle":"Data risk management platform","riskPlatformDesc":"The role-based authorization system on the Data Security Platform has been optimized to boost data access efficiency. An escalated approval mechanism is available for sensitive data. For higher efficiency, AI is used to detect anomalous operations.","supervisionCertificationTitle":"Oversight and audit","supervisionCertificationDesc":"Each year, we mandate and oversee at least one comprehensive audit on data security and privacy protection at each business. For typical problems, we conduct targeted audits and remediate identified issues.","networkSecurityTitle":"Cybersecurity","networkSecurityDesc":"The foundational role of cybersecurity is becoming increasingly prominent. We have formulated the Network Security Guidelines of Alibaba Group to define our cybersecurity management structure, responsibilities, and management requirements.","supervisionOrg":"Board of Directors","supervisionOrgHover":"The Compliance and Risk Committee holds ultimate control and decision-making power over cybersecurity matters.","managementOrg":"Management","managementOrgHover":"A cybersecurity decision-making group, comprising staff from the Risk Management Working Group, the President of the Group\'s Security Department, the General Counsel, and the security heads of our businesses, coordinates risk management, approves key strategies, and makes final decisions on major security incidents.","executionTeam":"Execution","executionTeamHover":"We have established a management group and an execution group for cybersecurity. The former is responsible for building a management system, while the latter implements management requirements and strategies. Each business has appointed its head of cybersecurity.","securityManagementTitle":"Parctices","securityManagementDesc":"Following the principles of trusted management and defense-in-depth, our cybersecurity protection relies on the security assurance systems of our cloud platforms while also implementing safeguards tailored to cloud services. This approach protects both customers and ourselves.","cloudSecuritySystemTitle":"Security architecture for cloud platforms","developmentPhase":"Development","publishedPhase":"Post-launch","developmentProcessTitle":"Development process","designStage":" Initiation and design","designStageDesc":"Security experts participate from the start and hold veto power over design proposals.","codingStage":"Coding","codingStageDesc":"Developers are required to use standardized security toolkits and coding plugins with security detection features.","testingStage":"Testing","testingStageDesc":"An in-house scanner built into the R&D process identifies vulnerabilities and blocks exploits like unauthorized access. Automated tests generated from specifications ensure high-coverage testing for the APIs of core products.","releaseStage":"Release & change","releaseStageDesc":"Before a product or change goes live, a scan for the default configuration and sensitive information ensures adherence to baseline requirements, such as least privilege and a minimum attack surface, thereby securing passwords and access keys.","defenseInDepthTitle":"Defense in depth","defenseInDepthDesc":"We have an end-to-end defense system covering endpoints, public networks, backbone networks, and data centers, offering multi-layered protection.","zeroTrustTitle":"Zero-trust architectures","zeroTrustDesc":"Alibaba Cloud enforces security requirements via multi-layered controls based on zero trust principles.","trustedManagementTitle":"Trusted management","trustedManagementDesc":"Alibaba Cloud adopts the philosophy of trusted management. With our technical capabilities and operational management measures, we provide customers with a secure and trusted platform environment across all dimensions, such as physical data centers, hardware security, virtualized execution environments, operating systems, and containers.","productSecurityTitle":"Cloud product security","admissionMechanism":"Intrusion detection and response","admissionMechanismDesc":"This mechanism monitors anomalous behavior and traffic to analyze potential risks and respond accordingly.","reverseVerification":"Adversarial security validation","reverseVerificationDesc":"We continuously validate product security through red/blue teaming and simulation exercises.","proactiveDiscovery":"Proactive discovery of new risks","proactiveDiscoveryDesc":"We collect and analyze information to discover new risks, which are then promptly addressed through system hardening and fixes.","customerSecurityTitle":"Security assurance for customers","crossLinkIdentity":"End-to-end identity management and fine-grained authorization","crossLinkIdentityDesc":"Alibaba Cloud advocates the principle of least privilege, allowing customers to grant fine-grained cloud permissions on demand.","nativeSecurity":"Native security","nativeSecurityDesc":"Alibaba Cloud\'s security capabilities scale elastically with dynamic demand for cloud computing resources, helping to reduce security costs.","proactiveAttack":"High availability against attacks","proactiveAttackDesc":"Alibaba Cloud\'s high-availability architecture integrates tenant isolation and load balancing across compute, storage, and networks, supported by rigorous monitoring and rapid disaster recovery.","businessSecuritySystemTitle":"Cybersecurity framework for cloud operations","terminalSecurity":"Endpoint security","terminalSecurityHover":"We deploy endpoint detection and response (EDR), data loss prevention (DLP), intranet access control, and access permission mechanisms.","gatewaySecurity":"Gateway security","gatewaySecurityHover":"We utilize DDoS protection, WAF, and bastion hosts to defend against external attacks.","appHostSecurity":"Application & host security","appHostSecurityHover":"We embed automated scans into development, deploy runtime application self-protection plus dynamic monitoring, and conduct regular penetration testing to minimize the attack surface.","storageSecurity":"Storage security","storageSecurityHover":"We use preventive methods, including data encryption, access control, and data backup.","defenseInDepthDetailDesc":"We adopt the guiding philosophy of defense in depth, having established an end-to-end, multi-layered protection system that covers endpoints, gateways, applications, hosts, and storage. This approach employs multiple layers and diverse types of protective measures to ensure security.","defenseInDepthBusinessDesc":"We have constructed a comprehensive protection system that encompasses endpoints, gateways, applications, hosts, and storage systems.","trustedManagementDetailDesc":"We deploy trusted identity management, trusted authentication, and trusted behavior auditing to ensure that only authorized entities can perform specific operations.","trustedEnvironment":"Trusted environments","trustedStorage":"Trusted storage","trustedIdentity":"Trusted identities","trustedCall":"Trusted calls","emergencyTrainingTitle":"Emergency management and training","emergencyManagement":"Emergency management","emergencyManagementDesc":"We have established clear standards for risk classification, defined team responsibilities, and established emergency protocols. This framework ensures a rapid, effective, and orderly response to security incidents. Once a risk is resolved, we conduct a review to identify management deficiencies, implement improvements, and hold responsible parties accountable.","networkSecurityTraining":"Cybersecurity training","networkSecurityTrainingDesc":"We have launched the Security Service Center for all employees, providing regularly updated learning resources on cybersecurity and data security to bolster their knowledge in these critical areas.","networkSupervisionTitle":"Supervision and certification","networkSupervisionCertificationDesc":"As per our cybersecurity management policy, we conduct annual compliance inspections across our businesses, using methods like interviews, operational data reviews, walkthrough tests, and red/blue teaming. Our businesses hold certifications in data security, privacy protection, and cybersecurity, such as ISO 27001 and the Multi-Level Protection Scheme. Click here to view our cyber and data security certifications.","ethicalTechnologyTitle":"Technology ethics","ethicalTechnologyDesc":"While we adhere to our strategy of \\"AI-driven\\", we pay close attention to matters such as safety, fairness, and privacy in the domain of AI. Drawing inspiration from mechanisms and initiatives for AI governance, such as the Global Digital Compact, the Global AI Governance Initiative, and the Artificial Intelligence Act, we have proposed six fundamental principles for technology ethics governance, including people-centricity, inclusion & integrity, privacy protection, safety & reliability, trustworthiness & controllability, and open co-governance.","managementProcessSystemTitle":"Management process","managementProcessSystemIntro":"We have optimized our governance system and measures to address emerging risks, such as content safety, privacy protection, and model safety. For issues that are unclear or lack established consensus, we consistently invest resources in collaborative research with academia and industries as well as stakeholders on the upstream and downstream. We classify our AI-related business scenarios into two major categories defined along the line between AI models and applications built upon these models. We have bolstered our management measures for technology ethics in these two aspects.","modelTrainingStage":"Model training","modelTrainingStageDesc":"During dataset construction, we perform data cleansing and safety filtering. This process also involves measures such as incremental pre-training, reinforcement learning, and safety alignment.","serviceOnlineStage":"Service launch","serviceOnlineStageDesc":"We implement a review mechanism based on risk classification and grading to balance AI development and its governance.","contentGenerationStage":"Content generation","contentGenerationStageDesc":"Robust technologies, including retrieval augmentation as well as review and filtering on inputs and outputs, are in place to guard against risks.","contentDisseminationStage":"Content distribution","contentDisseminationStageDesc":"In consumer-facing scenarios, we check images, videos, and audios for AI-generated content, marking it with a prominent label and reminder.","aiGovernanceCapacityTitle":"AI governance capabilities","aiGovernanceCapacityIntro":"In response to the rapid iteration of AI and the constant expansion of its application scenarios, we are working actively to explore and build governance capabilities, particularly for technologies, so that we can address challenges and seize opportunities.","techEthicsDataConstruction":"Tech ethics datasets & AI usage guidelines","techEthicsDataConstructionDesc":"Our Chinese-language tech ethics dataset spans 11 major dimensions and 36 fine-grained categories, featuring evaluation benchmarks. Our open-source AI behavioral guidelines shift model safety from passive detection to active discipline, using constructive safety alignment to substitute guidance for outright refusals.","securityEnhancementConstruction":"Safety evaluation & guardrails","securityEnhancementConstructionDesc":"The S-Eval framework addresses 102 risk types across 8 dimensions. The open-source YuFeng-XGuard-Reason model generates risk attribution data, while native technologies like PlugGuard and QwenGuard embed safety checks into the inference process.","blueArmySecurityTest":"AI marking & AIGC detection","blueArmySecurityTestDesc":"43 patents have been granted for AI marking, earning us three Grade-A certificates at the 6th China AI Competition. Our watermarking technology resists attacks, ensuring watermarks remain extractable even after content is cropped or compressed.","autoSecurityEvaluationFramework":"Sandbox for agents","autoSecurityEvaluationFrameworkDesc":"OpenSandbox, an open-source general-purpose sandbox for agents, delivers comprehensive security via container isolation, network control, and resource constraints. It holds the OpenSSF Best Practices Silver certification.","consensusPracticeTitle":"Multi-stakeholder consensus","consensusPracticeIntro":"We advocate for technology ethics governance within the company. To that end, we have launched various initiatives for sharing insights on cutting-edge technologies and governance trends or organizing seminars that bring together internal and external experts. These initiatives focus technical personnel\'s attention on technologies that may lead to ethical issues and risks that are associated with technology ethics. As a result, we can enhance their awareness and competence in the field of technology ethics. Furthermore, we actively engage in activities such as industry conferences and standard formulation.","proactiveExchangeTitle":"Culture building","proactiveExchangeDesc":"Our AI compliance training for R&D, algorithm, product, and compliance roles covers regulatory trends, algorithm transparency, and privacy. The AI Chaser series, co-developed with universities and industry partners, demystifies complex tech and ethics to foster a public understanding of responsible AI.","standardConstructionTitle":"Standard-setting","standardConstructionDesc":"We spearhead and contribute to the formulation of standards and guidelines for AI safety, AIGC marking, and digital watermarking. These efforts improve governance industry-wide.","consensusEstablishmentTitle":"Frontier tech collaboration","consensusEstablishmentDesc":"We collaborate with academic and research institutions, including Tsinghua University, Zhejiang University, and the Shanghai AI Laboratory, on AI safety and compliance to set up joint labs and build governance standards.","dataSecurityTrainingTitle":"Data backup and disaster recovery","dataSecurityTrainingDesc":"Data security training is required for all new hires during onboarding. Each year, all employees must complete training on the Alibaba Code of Business Conduct and pass an exam.","ethicsRiskIdentificationDesc":"Informed by past corruption cases, we identify material risks, conduct targeted assessments for core operations as well as high-risk roles, and implement mitigation controls.","managementStructureDesc":"We have established a specialized committee tasked with building a tech ethics governance system. This committee is chaired by our CTO, who also heads the tech ethics working group. It reports to the Sustainability Steering Committee. Each business has set up a standing body for tech ethics.","supplierProcessTitle":"Supplier management process","supplierProcessText":"Our digital supplier management system spans the entire lifecycle: onboarding, selection, evaluation, and risk management. We verify supplier credentials and mandate a written integrity pledge. All businesses can set selection criteria and performance metrics tailored to their operational needs. For the suppliers of our main businesses, we integrate smart risk modules that enable dynamic monitoring and risk detection.","integrityCultureBuildingTitle":"Culture development","integrityTrainingTitle":"Integrity training","integrityTrainingDesc":"We maintain zero tolerance for corruption, providing training for the Board, management, employees, and partners. Employees must receive annual training on our Code of Business Conduct and pass an exam, complemented by various training initiatives.","complianceConsultancyTitle":"Compliance consultancy","complianceConsultancyDesc":"We offer multiple channels for compliance advice. Employees can receive guidance via AI assistants, hotlines, emails, and websites, while partners can seek consultancy via emails, phone calls, and websites.","deterrentEducationTitle":"Deterrent education","deterrentEducationDesc":"Our internal online community contextualizes compliance policies via scenario-based reminders. To deter misconduct, we issue real-time risk alerts, publish quarterly case studies, and produce annual video reenactments of actual violations.","privacyRightsGuaranteeTitle":"Safeguarding privacy","privacyRightKnowTitle":"Right to know","privacyRightKnowDesc":"Privacy policies are publicly disclosed and explain our rules. Our apps obtain user consent via pop-ups upon initial use and request separate opt-ins for third-party data processing.","privacyRightManageTitle":"Right to manage","privacyRightManageDesc":"In-app privacy modules allow users to manage system permissions, authorizations, advertisements, and recommendations.","privacyRightDeleteChangeTitle":"Right to delete and change","privacyRightDeleteChangeDesc":"Streamlined processes are available for profile updates and account deletion. Upon request, we assist users in accessing, copying, rectifying, or deleting their personal information.","privacyFeedbackChannelTitle":"Feedback channels","privacyFeedbackChannelDesc":"Users can submit feedback or complaints via in-app customer support, the Alibaba Security Center\'s information leakage module, and Personal Information Protection Officers specified in apps\' privacy policies.","cyberRiskMgmtSectionTitle":"Cybersecurity risk management","cyberRiskIdentAssessTitle":"Risk identification & assessment","cyberRiskIdentAssessDesc":"Risks are identified via asset stocktakes, vulnerability scans, penetration tests, threat intelligence, and employee-reported information. These risks are classified, with critical ones reported to regulators.","cyberIncidentResponseTitle":"Incident response & drills","cyberIncidentResponseDesc":"An established response framework governs incident reporting, severity classification, and protocol execution. Regular cybersecurity drills are also conducted.","cyberSecurityCommTitle":"Cybersecurity communication","cyberSecurityCommDesc":"Internal newsletters and monthly reports share insights and trends. Employees report vulnerabilities via the Security Response Center or dedicated emails, while website announcements and in-person visits keep external shareholders informed.","cyberTrainingCapacityTitle":"Training and capacity building","cyberTrainingAssessTitle":"Training and assessment","cyberTrainingAssessDesc":"We offer general and role-specific cybersecurity training. All staff must pass a Code of Business Conduct exam that has a cybersecurity module, and technical roles require security baseline certification.","cyberKnowledgeSharingTitle":"Knowledge sharing","cyberKnowledgeSharingDesc":"Our Security Service Center offers learning resources to employees and outsourced workers.","techEthicsReviewTitle":"Tech ethics review","techEthicsReviewDesc":"Our tech ethics review mechanism covers AI activities that carry potential ethical risks. The review process includes identification, assessment, and inspection, utilizing procedures tailored to technology types and risk levels. Evolving risks are continuously tracked.","processTabCardsTitle":"Management processes & systems","modelResearchTab":"Model development and training","sourceScreeningTitle":"Source screening","sourceScreeningDesc":"Our data intake mechanism prioritizes reputable datasets and incorporates self-built tech ethics datasets to ensure compliance and diversity.","multiLayerFilterTitle":"Data processing","multiLayerFilterDesc":"A multi-layer filtering mechanism identifies and rectifies content that exhibits discriminatory language or inappropriate values. This reduces the inclusion of risky data.","standardAnnotationTitle":"Standardized annotation","standardAnnotationDesc":"A clear line is drawn between functional and safety annotations. This distinction, together with annotator training and cross-validation, ensures accurate and consistent annotation results.","safetyAlignmentTitle":"Safety alignment","safetyAlignmentDesc":"Leveraging preference optimization strategies, we align models with human values and compliance requirements, training them to identify risky prompts and generate safe responses.","safetyEvaluationTitle":"Safety evaluation","safetyEvaluationDesc":"Our rigorous testing spans different risk types and attack methods. Continuous updates to the test bank address emerging threats, forming a closed loop from problem discovery to safety enhancement.","deploymentInteractionTab":"Deployment and interaction","contentAccuracySafetyTitle":"Content accuracy & safety","contentAccuracySafetyDesc":"An intervention mechanism and an omnimodal safety engine apply guardrails to user inputs and model outputs. Regular risk assessments drive strategy optimization.","aigcMarkingTitle":"AIGC marking","aigcMarkingDesc":"Visible tags added to content and user interfaces, paired with invisible marks in file metadata, protect the public\'s right to know and ensure traceability.","userDisclosureFeedbackTitle":"User notification and feedback","userDisclosureFeedbackDesc":"The limitations and usage norms of AI services are publicly disclosed. Feedback and complaint channels are readily available for us to hear from users.","ethicsIncidentResponseTitle":"Monitoring and optimization","ethicsIncidentResponseDesc":"Operational monitoring on models and applications triggers an alert upon any anomaly to facilitate remediation and optimization. Update logs are retained to inform safety strategies.","supplierManagementSystemTitle":"Supplier management system","supplierProcessStep1Title":"Onboarding","supplierProcessStep1Desc":"We evaluate credentials, quality, and compliance, requiring suppliers to sign an Honesty and Integrity Agreement. As of March 31, 2026, 43,000 suppliers had signed the Honesty and Integrity Agreement, with a 100% signing rate among mainland Chinese suppliers using standard contracts.","supplierProcessStep2Title":"Selection","supplierProcessStep2Desc":"We apply fair, differentiated criteria weighing quality, service, technical expertise, and costs to select high-performing suppliers.","supplierProcessStep3Title":"Assessment","supplierProcessStep3Desc":"We track supplier performance across quality, service, and delivery, leveraging a feedback loop to drive improvements for products and services.","supplierProcessStep4Title":"Consequence management","supplierProcessStep4Desc":"We enforce punitive measures for violations, including mandatory remediation, suspension, and termination. In FY2026, 48 suppliers were permanently blocklisted for bribing our employees.","supplierRiskManagementTitle":"Supplier risk management","supplierRiskManagementDesc":"We monitor supply chain risks with digital tools and assess risks based on regulatory, legal, and security factors. Targeted reviews or on-site audits drive remediation for key suppliers and high-risk categories.","supplierEsgManagementSystemTitle":"Supplier ESG management system","supplierEsgProcessTitle":"Supplier ESG management process","supplierEsgProcessStep1Title":"Onboarding","supplierEsgProcessStep1Desc":"The Alibaba Supplier ESG Code of Conduct defines basic requirements for labor rights, occupational health & safety, environmental protection, data security, privacy protection, and business ethics.","supplierEsgProcessStep2Title":"Assessment","supplierEsgProcessStep2Desc":"Supplier performance is tracked via a dedicated mechanism and targeted initiatives, and ESG is embedded into some procurement categories.","supplierEsgProcessStep3Title":"Training","supplierEsgProcessStep3Desc":"Multi-dimensional compliance training enhances ESG capabilities for suppliers, empowering them to enhance ESG compliance and sustainability performance.","supplierEsgRiskManagementTitle":"Supplier ESG risk management","supplierEsgRiskManagementDesc":"ESG metrics are integrated into our supplier risk monitoring system, where an early warning mechanism empowers procurement teams to identify and mitigate risks."}')},85611:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u62a5\u544a","actionResults":"\u884c\u52a8\u7ed3\u679c","actionResultsTitle":"\u884c\u52a8\u7ed3\u679c","actionResultCard1Title":"4.54","actionResultCard1Unit":"\u5206","actionResultCard1Desc":"\u5458\u5de5\u5bf9\u5ec9\u6d01\u7684\u5de5\u4f5c\u73af\u5883\u8ba4\u53ef\u5ea6\u63d0\u5347\u81f3 4.54 \u5206\uff08\u6ee1\u52065\u5206\uff09","actionResultCard2Prefix":"","actionResultCard2Title":"\u884c\u4e1a\u9886\u5148\u6c34\u5e73","actionResultCard2Unit":"","actionResultCard2Desc":"\u963f\u91cc\u5df4\u5df4\u5728\u4e2d\u56fd\u7f51\u7edc\u5b89\u5168\u4ea7\u4e1a\u8054\u76df\u6570\u636e\u5b89\u5168\u5de5\u4f5c\u59d4\u5458\u4f1a\u7ec4\u7ec7\u7684\u6570\u636e\u5b89\u5168\u548c\u4e2a\u4eba\u4fe1\u606f\u4fdd\u62a4\u793e\u4f1a\u8d23\u4efb\u8bc4\u4ef7\u4e2d\uff0c\u83b7\u8bc4\u4e09\u661f\u7ea7\uff08\u7cfb\u7edf\u7ea7\uff09","actionResultCard3Title":"20,092","actionResultCard3Unit":"\u5bb6","actionResultCard3Desc":"\u5df2\u6709 20,092 \u5bb6\u4f9b\u5e94\u5546\u7b7e\u7f72 ESG \u884c\u4e3a\u51c6\u5219","actionResultCard4Prefix":"","actionResultCard4Title":"\u300a\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u627f\u8bfa\u300b","actionResultCard4Unit":"","actionResultCard4Desc":"\u963f\u91cc\u5df4\u5df4\u7b7e\u7f72\u4e86\u7531\u4e2d\u56fd\u4eba\u5de5\u667a\u80fd\u4ea7\u4e1a\u53d1\u5c55\u8054\u76df\u53d1\u5e03\u7684\u300a\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u627f\u8bfa\u300b","actionResultCard5Title":"ISO42001","actionResultCard5Desc":"\u963f\u91cc\u4e91\u548c\u9489\u9489\u901a\u8fc7 ISO42001 \u4eba\u5de5\u667a\u80fd\u7ba1\u7406\u4f53\u7cfb\u8ba4\u8bc1","strategyPath":"\u7b56\u7565\u4e0e\u8def\u5f84","strategyPathTitle":"\u7b56\u7565\u4e0e\u8def\u5f84","strategyPathDescription":"\u4ee5\u963f\u91cc\u5df4\u5df4\u4f7f\u547d\u3001\u613f\u666f\u548c\u4ef7\u503c\u89c2\u4e3a\u6307\u5f15\uff0c\u6211\u4eec\u5236\u5b9a\u9002\u7528\u4e8e\u5168\u4f53\u5458\u5de5\u7684\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u300b\u3002\u8be5\u51c6\u5219\u6db5\u76d6\u591a\u9879\u4e0e ESG \u606f\u606f\u76f8\u5173\u7684\u8bae\u9898\uff0c\u5982\u606a\u5b88\u5546\u4e1a\u9053\u5fb7\u3001\u9009\u62e9\u503c\u5f97\u4fe1\u8d56\u7684\u5546\u4e1a\u4f19\u4f34\u4ee5\u53ca\u6570\u636e\u5b89\u5168\u4e0e\u9690\u79c1\u4fdd\u62a4\u7b49\u3002\u6211\u4eec\u8981\u6c42\u5168\u4f53\u5458\u5de5\u6bcf\u5e74\u53c2\u4e0e\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u57f9\u8bad\u5e76\u901a\u8fc7\u8003\u8bd5\uff1b\u6211\u4eec\u91cd\u89c6\u8bda\u4fe1\u7ecf\u8425\uff0c\u5e76\u901a\u8fc7\u642d\u5efa\u6cbb\u7406\u67b6\u6784\u6765\u843d\u5b9e\u3002\u5728\u8463\u4e8b\u4f1a\u5c42\u9762\uff0c\u6211\u4eec\u8bbe\u7acb\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u548c\u53ef\u6301\u7eed\u53d1\u5c55\u59d4\u5458\u4f1a\uff0c\u5206\u522b\u76d1\u7763\u548c\u7ba1\u7406\u76f8\u5173\u8bae\u9898\u3002","bannerTitle":"\u575a\u6301\u8bda\u4fe1\u7ecf\u8425","bannerDescription":"\u4ece\u6210\u7acb\u7684\u7b2c\u4e00\u5929\u8d77\uff0c\u963f\u91cc\u5df4\u5df4\u5c31\u628a\u8bda\u4fe1\u4f5c\u4e3a\u7acb\u8eab\u4e4b\u672c\u3002\u8fd9\u662f\u6211\u4eec\u7559\u4f4f\u4eba\u624d\u3001\u670d\u52a1\u597d\u6d88\u8d39\u8005\u548c\u4f01\u4e1a\u5ba2\u6237\u7684\u57fa\u7840\uff0c\u540c\u65f6\u4e5f\u662f\u6211\u4eec\u8df5\u884c\u793e\u4f1a\u8d23\u4efb\u7684\u521d\u5fc3\u3002","consumerExperienceTitle":"\u521b\u9020\u826f\u597d\u7684\u6d88\u8d39\u4f53\u9a8c","digitalLifeTitle":"\u8425\u9020\u5305\u5bb9\u5065\u5eb7\u7684\u6570\u5b57\u751f\u6d3b","diversityEquityInclusion":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d","talentAttractionRetention":"\u4eba\u624d\u7684\u5438\u5f15\u548c\u4fdd\u7559","talentDevelopmentOpportunities":"\u4e30\u5bcc\u7684\u4eba\u624d\u53d1\u5c55\u673a\u4f1a","employeeHealthVitality":"\u5458\u5de5\u5065\u5eb7\u4e0e\u6d3b\u529b","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"\u5458\u5de5\u4e3a\u5973\u6027","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"\u798f\u5e03\u65af\u5168\u7403\u6700\u4f73\u96c7\u4e3b","familyCareLeaveTitle":"\u8d856\u4e07","familyCareLeaveDesc":"\u5173\u7231\u5bb6\u4eba\uff0c\u5458\u5de5\u5229\u7528\u966a\u4f34\u5047\u4eab\u53d7\u4e0e\u5bb6\u4eba\u7684\u5b9d\u8d35\u65f6\u5149","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"\u963f\u91cc\u5df4\u5df4\u7684\u591a\u4e2a\u56ed\u533a\u3001\u6570\u636e\u4e2d\u5fc3\u548c\u7269\u6d41\u573a\u6240\u83b7\u5f97\u4e86\u8ba4\u8bc1","firstAidTrainingTitle":"\u8d8514000\u540d","firstAidTrainingDesc":"\u963f\u91cc\u5df4\u5df4\u7d2f\u8ba1\u57f9\u8bad\u6025\u6551\u4fa0","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"\u963f\u91cc\u5df4\u5df4\u529e\u516c\u73af\u5883\u6ee1\u610f\u5ea693.1%","integrityCommerce":"\u606a\u5b88\u5546\u4e1a\u9053\u5fb7","supplyChainManagement":"\u6df1\u5316\u4f9b\u5e94\u5546\u7ba1\u7406","dataPrivacySecurity":"\u4fdd\u62a4\u6570\u636e\u5b89\u5168\u4e0e\u9690\u79c1","networkSecurityProtection":"\u5b88\u62a4\u7f51\u7edc\u5b89\u5168","ethicalTechnology":"\u5b8c\u5584\u79d1\u6280\u4f26\u7406","integrityCommerceTitle":"\u606a\u5b88\u5546\u4e1a\u9053\u5fb7","integrityCommerceDesc":"\u4f5c\u4e3a\u4e00\u5bb6\u5e73\u53f0\u516c\u53f8\uff0c\u5efa\u7acb\u516c\u5f00\u900f\u660e\u3001\u516c\u5e73\u516c\u6b63\u7684\u7ecf\u8425\u73af\u5883\u81f3\u5173\u91cd\u8981\u3002\u963f\u91cc\u5df4\u5df4\u89