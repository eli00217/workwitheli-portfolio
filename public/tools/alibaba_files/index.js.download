uff0c\u69cb\u5efa\u4e86\u5305\u62ec\u7d42\u7aef\u3001\u7db2\u95dc\u3001\u61c9\u7528/\u4e3b\u6a5f\u548c\u5b58\u5132\u5728\u5167\u7684\u7acb\u9ad4\u9632\u8b77\u9ad4\u7cfb\uff0c\u63a1\u7528\u591a\u5c64\u6b21\u3001\u591a\u7a2e\u985e\u7684\u9632\u8b77\u63aa\u65bd\u4f86\u78ba\u4fdd\u5b89\u5168\u3002","defenseInDepthBusinessDesc":"\u69cb\u5efa\u4e86\u5305\u62ec\u7d42\u7aef\u3001\u7db2\u95dc\u3001\u61c9\u7528/\u4e3b\u6a5f\u548c\u5b58\u5132\u5728\u5167\u7684\u7acb\u9ad4\u9632\u8b77\u9ad4\u7cfb\u3002","trustedManagementDetailDesc":"\u63a1\u53d6\u53ef\u4fe1\u8eab\u4efd\u7ba1\u7406\u3001\u53ef\u4fe1\u8a8d\u8b49\u8207\u6388\u6b0a\u3001\u53ef\u4fe1\u884c\u70ba\u5be9\u8a08\u7b49\u63aa\u65bd\u4f86\u78ba\u4fdd\u53ea\u6709\u7d93\u904e\u6388\u6b0a\u7684\u884c\u70ba\u4e3b\u9ad4\u80fd\u5920\u57f7\u884c\u7279\u5b9a\u7684\u64cd\u4f5c\u3002","trustedEnvironment":"\u53ef\u4fe1\u74b0\u5883","trustedStorage":"\u53ef\u4fe1\u5b58\u5132","trustedIdentity":"\u53ef\u4fe1\u8eab\u4efd","trustedCall":"\u53ef\u4fe1\u8abf\u7528","emergencyTrainingTitle":"\u61c9\u6025\u8207\u57f9\u8a13","emergencyManagement":"\u61c9\u6025\u7ba1\u7406","emergencyManagementDesc":"\u6211\u5011\u660e\u78ba\u98a8\u96aa\u4e8b\u4ef6\u7684\u5206\u7d1a\u5206\u985e\u7ba1\u7406\u6a19\u6e96\u3001\u8ca0\u8cac\u5718\u968a\u3001\u5831\u544a\u548c\u97ff\u61c9\u7684\u61c9\u6025\u8655\u7406\u6d41\u7a0b\uff0c\u78ba\u4fdd\u5feb\u901f\u3001\u6709\u6548\u548c\u6709\u5e8f\u5730\u97ff\u61c9\u5b89\u5168\u4e8b\u4ef6\u3002\u5728\u98a8\u96aa\u8655\u7f6e\u7d50\u675f\u4e4b\u5f8c\uff0c\u6211\u5011\u6703\u5c0d\u98a8\u96aa\u4e8b\u4ef6\u9032\u884c\u5fa9\u76e4\uff0c\u5728\u7ba1\u7406\u63aa\u65bd\u4e0a\u67e5\u6f0f\u88dc\u7f3a\uff0c\u540c\u6642\u5c0d\u98a8\u96aa\u4e8b\u4ef6\u9032\u884c\u8ffd\u8cac\u3002","networkSecurityTraining":"\u7db2\u7d61\u5b89\u5168\u57f9\u8a13","networkSecurityTrainingDesc":"\u6bcf\u5e74\uff0c\u9762\u5411\u5168\u9ad4\u54e1\u5de5\u7684\u5546\u696d\u884c\u70ba\u6e96\u5247\u57f9\u8a13\u548c\u8003\u8a66\u4e2d\u5747\u5305\u542b\u7db2\u7d61\u5b89\u5168\u6a21\u584a\u3002\u6b64\u5916\uff0c\u6211\u5011\u9084\u70ba\u5168\u9ad4\u54e1\u5de5\u958b\u653e\u4e86\u5b89\u5168\u670d\u52d9\u4e2d\u5fc3\u5e73\u53f0\uff0c\u4e0d\u5b9a\u671f\u66f4\u65b0\u7db2\u7d61\u5b89\u5168\u3001\u6578\u64da\u5b89\u5168\u3001\u500b\u4eba\u8d44\u6599\u5b89\u5168\u7b49\u5b78\u7fd2\u8cc7\u6599\uff0c\u5e6b\u52a9\u4ed6\u5011\u52a0\u5f37\u79c1\u96b1\u4fdd\u8b77\u8207\u6578\u64da\u5b89\u5168\u4ee5\u53ca\u7db2\u7d61\u5b89\u5168\u7b49\u5c08\u696d\u77e5\u8b58\u7684\u5b78\u7fd2\u3002","networkSupervisionTitle":"\u76e3\u7763\u8207\u8a8d\u8b49","networkSupervisionCertificationDesc":"\u963f\u91cc\u5df4\u5df4\u6bcf\u5e74\u4f9d\u64da\u7db2\u7d61\u5b89\u5168\u7ba1\u7406\u5236\u5ea6\u5c0d\u5404\u696d\u52d9\u958b\u5c55\u7db2\u7d61\u5b89\u5168\u5408\u898f\u6aa2\u67e5\uff0c\u65b9\u6cd5\u5305\u62ec\u6e9d\u901a\u8a2a\u8ac7\u3001\u71df\u904b\u6578\u64da\u6392\u67e5\u3001\u7a7f\u884c\u6e2c\u8a66\u3001\u7d05\u85cd\u5c0d\u6297\u9a57\u8b49\u7b49\u3002\u6b64\u5916\uff0c\u5404\u696d\u52d9\u5747\u7372\u5f97\u6578\u64da\u5b89\u5168\u3001\u79c1\u96b1\u4fdd\u8b77\u548c\u7db2\u7d61\u5b89\u5168\u65b9\u9762\u7684\u8a8d\u8b49\uff0c\u5982ISO 27001\u3001\u4fe1\u606f\u7cfb\u7d71\u5b89\u5168\u7b49\u7d1a\u4fdd\u8b77\u7b49\u3002\u9ede\u64ca\u67e5\u770b\u7db2\u7d61\u548c\u6578\u64da\u5b89\u5168\u8a8d\u8b49\u3002","ethicalTechnologyTitle":"\u5b8c\u5584\u79d1\u6280\u502b\u7406","ethicalTechnologyDesc":"\u6211\u5011\u5728\u5805\u6301\u300cAI \u9a45\u52d5\u300d\u696d\u52d9\u6230\u7565\u767c\u5c55\u7684\u540c\u6642\uff0c\u4e5f\u6642\u523b\u95dc\u6ce8\u8a72\u9818\u57df\u7684\u5b89\u5168\u3001\u516c\u5e73\u3001\u79c1\u96b1\u7b49\u554f\u984c\uff0c\u5be6\u8e10\u8ca0\u8cac\u4efb\u7684\u4eba\u5de5\u667a\u80fd\u3002\u53c3\u8003\u300a\u5168\u7403\u6578\u5b57\u5951\u7d04\u300b\u300a\u5168\u7403\u4eba\u5de5\u667a\u80fd\u6cbb\u7406\u5021\u8b70\u300b\u300a\u4eba\u5de5\u667a\u80fd\u6cd5\u6848\u300b\u7b49\u4eba\u5de5\u667a\u80fd\u6cbb\u7406\u6a5f\u5236\u6216\u8005\u5021\u8b70\uff0c\u963f\u91cc\u5df4\u5df4\u63d0\u51fa\u79d1\u6280\u502b\u7406\u6cbb\u7406\u516d\u9805\u57fa\u672c\u6e96\u5247:\u300c\u4ee5\u4eba\u70ba\u672c\u3001\u666e\u60e0\u6b63\u76f4\u3001\u79c1\u96b1\u4fdd\u8b77\u3001\u5b89\u5168\u53ef\u9760\u3001\u53ef\u4fe1\u53ef\u63a7\u3001\u958b\u653e\u5171\u6cbb\u300d\u3002","managementProcessSystemTitle":"\u7ba1\u7406\u6d41\u7a0b\u8207\u9ad4\u7cfb","managementProcessSystemIntro":"\u6211\u5011\u5c0d\u5df2\u7d93\u6d6e\u73fe\u51fa\u4f86\u7684\u5167\u5bb9\u5b89\u5168\u3001\u79c1\u96b1\u4fdd\u8b77\u3001\u6a21\u578b\u5b89\u5168\u7b49\u98a8\u96aa\uff0c\u5df2\u512a\u5316\u6cbb\u7406\u9ad4\u7cfb\u8207\u63aa\u65bd\u3002\u5c0d\u5c1a\u672a\u770b\u6e05\u3001\u672a\u5f62\u6210\u5171\u8b58\u7684\u554f\u984c\uff0c\u9084\u5728\u6301\u7e8c\u6295\u5165\u8cc7\u6e90\uff0c\u8207\u5b78\u754c\u3001\u696d\u754c\u53ca\u884c\u696d\u4e0a\u4e0b\u6e38\u5171\u540c\u7814\u7a76\u3002\u6211\u5011\u5c07\u4eba\u5de5\u667a\u80fd\u76f8\u95dc\u7684\u696d\u52d9\u5834\u666f\u5206\u70ba\u6a21\u578b\u4ee5\u53ca\u57fa\u65bc\u6a21\u578b\u7684\u61c9\u7528\u5169\u5927\u985e\uff0c\u5728\u9019\u5169\u500b\u65b9\u9762\u52a0\u5f37\u79d1\u6280\u502b\u7406\u7ba1\u7406\u63aa\u65bd\u3002","modelTrainingStage":"\u6a21\u578b\u8a13\u7df4\u968e\u6bb5","modelTrainingStageDesc":"\u5728\u8cc7\u6599\u96c6\u69cb\u5efa\u904e\u7a0b\u4e2d\uff0c\u5c0d\u8cc7\u6599\u9032\u884c\u6e05\u6d17\u3001\u5b89\u5168\u904e\u6ffe\u3002\u4e26\u63a1\u53d6\u589e\u91cf\u9810\u8a13\u7df4\u3001\u5f37\u5316\u5b78\u7fd2\u3001\u88fd\u4f5c\u5b89\u5168\u8a9e\u6599\u548c\u5b89\u5168\u6027\u5c0d\u9f4a\u7b49\u63aa\u65bd\u3002","serviceOnlineStage":"\u670d\u52d9\u4e0a\u7dda\u968e\u6bb5","serviceOnlineStageDesc":"\u6211\u5011\u63a1\u53d6\u98a8\u96aa\u5206\u985e\u5206\u7d1a\u5be9\u67e5\u6a5f\u5236\uff0c\u4ee5\u5e73\u8861\u4eba\u5de5\u667a\u80fd\u7684\u767c\u5c55\u548c\u6cbb\u7406\u96d9\u76ee\u6a19\u3002","contentGenerationStage":"\u5167\u5bb9\u751f\u6210\u968e\u6bb5","contentGenerationStageDesc":"\u63a1\u53d6\u8f38\u5165\u8f38\u51fa\u5be9\u6838\u904e\u6ffe\u3001\u6aa2\u7d22\u5f0f\u589e\u5f37\u6280\u8853\u7b49\u7ba1\u7406\u63aa\u65bd\u4f86\u9632\u7bc4\u98a8\u96aa\u3002","contentDisseminationStage":"\u5167\u5bb9\u50b3\u64ad\u968e\u6bb5","contentDisseminationStageDesc":"\u5728\u9762\u5411\u6d88\u8cbb\u8005\u7684\u4eba\u5de5\u667a\u80fd\u751f\u6210\u5167\u5bb9\u50b3\u64ad\u5834\u666f\uff0c\u5c0d\u5716\u7247\u3001\u5f71\u7247\u3001\u97f3\u983b\u7b49\u5167\u5bb9\u9032\u884c\u6a19\u8b58\u6aa2\u6e2c\u3002\u4e26\u5728\u751f\u6210\u5167\u5bb9\u4ecb\u9762\u6dfb\u52a0\u986f\u8457\u7684AI\u6a19\u8b58\u548c\u63d0\u793a\u3002","aiGovernanceCapacityTitle":"\u4eba\u5de5\u667a\u80fd\u6cbb\u7406\u80fd\u529b\u5efa\u8a2d","aiGovernanceCapacityIntro":"\u5728\u4eba\u5de5\u667a\u80fd\u6280\u8853\u5feb\u901f\u8fed\u4ee3\u3001\u61c9\u7528\u5834\u666f\u6301\u7e8c\u62d3\u5c55\u7684\u80cc\u666f\u4e0b\uff0c\u6211\u5011\u6b63\u8457\u529b\u63a8\u9032\u63a2\u7d22\u548c\u69cb\u5efa\u8207\u4e4b\u76f8\u9069\u61c9\u7684\u6cbb\u7406\u80fd\u529b\uff0c\u7279\u5225\u662f\u6280\u8853\u6cbb\u7406\u80fd\u529b\uff0c\u4ee5\u61c9\u5c0d\u6311\u6230\u4e26\u628a\u63e1\u6a5f\u9047\u3002","techEthicsDataConstruction":"\u79d1\u6280\u502b\u7406\u6578\u64da\u96c6\u8207AI\u884c\u70ba\u6307\u5357","techEthicsDataConstructionDesc":"\u69cb\u5efa\u4e2d\u6587\u79d1\u6280\u502b\u7406\u6578\u64da\u96c6\uff0c\u8986\u84cb11\u5927\u7dad\u5ea6\u300136\u9805\u7d30\u5206\u6a19\u7c64\uff0c\u5efa\u7acb\u914d\u5957\u8a55\u6e2c\u57fa\u6e96\u3002\u958b\u6e90AI\u6a21\u578b\u8207\u61c9\u7528\u884c\u70ba\u6307\u5357\uff0c\u5c07\u6a21\u578b\u5b89\u5168\u5f9e\u88ab\u52d5\u6aa2\u6e2c\u8f49\u70ba\u4e3b\u52d5\u898f\u8a13\uff0c\u63d0\u51fa\u300c\u5efa\u8a2d\u6027\u5b89\u5168\u5c0d\u9f4a\u300d\u7406\u5ff5\uff0c\u4ee5\u5f15\u5c0e\u66ff\u4ee3\u76f4\u63a5\u62d2\u7d55\u3002","securityEnhancementConstruction":"\u5b89\u5168\u8a55\u6e2c\u8207\u8b77\u6b04","securityEnhancementConstructionDesc":"\u63d0\u51fa\u300c\u516b\u722a\u9b5a\u300d\uff08S-Eval\uff09\u8a55\u6e2c\u6846\u67b6\uff0c\u6db5\u84cb8\u500b\u98a8\u96aa\u7dad\u5ea6\u3001102\u500b\u7d30\u5206\u985e\u578b\uff1b\u958b\u6e90\u300c\u6d77\u8c5a\u300d\u8b77\u6b04\u6a21\u578b\uff0c\u540c\u6b65\u751f\u6210\u98a8\u96aa\u6b78\u56e0\u89e3\u91cb\uff1b\u7814\u767cPlugGuard\u3001QwenGuard\u7b49\u300c\u539f\u751f\u8b77\u6b04\u300d\u6280\u8853\uff0c\u5c07\u5b89\u5168\u6aa2\u6e2c\u5d4c\u5165\u63a8\u7406\u904e\u7a0b\u3002","blueArmySecurityTest":"AI\u6a19\u8b58\u8207\u751f\u6210\u5167\u5bb9\u6aa2\u6e2c","blueArmySecurityTestDesc":"\u7d2f\u8a08\u7372\u5f97AI\u6a19\u8b58\u76f8\u95dc\u5c08\u522943\u9805\uff0c\u5728\u7b2c\u516d\u5c46\u4e2d\u570b\u4eba\u5de5\u667a\u80fd\u5927\u8cfd\u4e2d\u69ae\u7372\u4e09\u9805A\u7d1a\u8b49\u66f8\u3002\u5176\u4e2d\u57fa\u65bc\u6df1\u5ea6\u5b78\u7fd2\u7684\u96b1\u5f0f\u6c34\u5370\u6280\u8853\u517c\u5177\u9b6f\u68d2\u6027\u8207\u6297\u653b\u64ca\u80fd\u529b\uff0c\u5167\u5bb9\u7d93\u88c1\u526a\u3001\u58d3\u7e2e\u5f8c\u4ecd\u53ef\u6709\u6548\u63d0\u53d6\u3002","autoSecurityEvaluationFramework":"\u667a\u80fd\u9ad4\u61c9\u7528\u6c99\u7bb1","autoSecurityEvaluationFrameworkDesc":"\u7814\u767c\u4e26\u958b\u6e90\u4e86\u901a\u7528\u667a\u80fd\u9ad4\u61c9\u7528\u6c99\u7bb1OpenSandbox\uff0c\u63d0\u4f9b\u5bb9\u5668\u9694\u96e2\u3001\u7db2\u7d61\u7ba1\u63a7\u3001\u8cc7\u6e90\u9650\u5236\u7b49\u5b8c\u6574\u5b89\u5168\u65b9\u6848\uff0c\u5df2\u7372OpenSSF Best Practices\u9280\u7d1a\u8a8d\u8b49\u3002","consensusPracticeTitle":"\u591a\u65b9\u5171\u8b58","consensusPracticeIntro":"\u6211\u5011\u5167\u90e8\u958b\u5c55\u79d1\u6280\u502b\u7406\u6cbb\u7406\u7684\u5ba3\u5c0e\uff0c\u900f\u904e\u524d\u6cbf\u6280\u8853\u548c\u6cbb\u7406\u8da8\u52e2\u4ea4\u6d41\u3001\u5167\u5916\u90e8\u5c08\u5bb6\u7814\u8a0e\u6703\u7b49\u591a\u7a2e\u5f62\u5f0f\uff0c\u63d0\u9ad8\u6280\u8853\u4eba\u5c0d\u65bc\u79d1\u6280\u502b\u7406\u76f8\u95dc\u6280\u8853\u8207\u98a8\u96aa\u7684\u95dc\u6ce8\uff0c\u63d0\u5347\u5176\u79d1\u6280\u502b\u7406\u610f\u8b58\u548c\u7d20\u990a\uff1b\u5728\u5916\u90e8\uff0c\u6211\u5011\u7a4d\u6975\u53c3\u8207\u884c\u696d\u6703\u8b70\u3001\u6a19\u6e96\u5efa\u8a2d\u7b49\u5de5\u4f5c\u3002","proactiveExchangeTitle":"\u6587\u5316\u5efa\u8a2d","proactiveExchangeDesc":"\u6211\u5011\u70ba\u7814\u767c\u3001\u7b97\u6cd5\u3001\u7522\u54c1\u53ca\u5408\u898f\u7b49\u95dc\u9375\u5d17\u4f4d\u63d0\u4f9bAI\u5408\u898f\u57f9\u8a13\uff0c\u6db5\u84cb\u6cd5\u898f\u8da8\u52e2\u3001\u7b97\u6cd5\u900f\u660e\u5ea6\u8207\u79c1\u96b1\u4fdd\u8b77\u3002\u540c\u6642\u806f\u5408\u9ad8\u6821\u8207\u7522\u696d\u754c\u6253\u9020\u300a\u8ffdAI\u7684\u4eba\u300b\u79d1\u666e\u6b04\u76ee\uff0c\u805a\u7126AI\u524d\u6cbf\u6280\u8853\u8207\u502b\u7406\u722d\u8b70\uff0c\u5c07\u8907\u96dc\u6280\u8853\u8f49\u5316\u70ba\u901a\u4fd7\u8868\u9054\uff0c\u63a8\u52d5\u516c\u773e\u5c0d\u8ca0\u8cac\u4efbAI\u7684\u7406\u89e3\u3002","standardConstructionTitle":"\u6a19\u6e96\u5efa\u8a2d","standardConstructionDesc":"\u6211\u5011\u727d\u982d\u53ca\u6df1\u5ea6\u53c3\u8207\u570b\u5167\u5916\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u3001\u751f\u6210\u5408\u6210\u5167\u5bb9\u6a19\u8b58\u3001\u6aa2\u6e2c\u53ca\u6578\u5b57\u6c34\u5370\u7b49\u9818\u57df\u7684\u6a19\u6e96\u8207\u6307\u5357\u5236\u5b9a\uff0c\u63a8\u52d5\u884c\u696d\u898f\u7bc4\u767c\u5c55\u3002","consensusEstablishmentTitle":"\u524d\u6cbf\u6280\u8853\u5408\u4f5c","consensusEstablishmentDesc":"\u6211\u5011\u8207\u6e05\u83ef\u5927\u5b78\u3001\u6d59\u6c5f\u5927\u5b78\u3001\u4e0a\u6d77\u4eba\u5de5\u667a\u80fd\u5be6\u9a57\u5ba4\u7b49\u9ad8\u6821\u8207\u6a5f\u69cb\u958b\u5c55AI\u5408\u898f\u5b89\u5168\u8207\u5408\u898f\u76f8\u95dc\u5408\u4f5c\uff0c\u5982\u5171\u5efa\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u5be6\u9a57\u5ba4\u3001\u5171\u5efaAI\u6cbb\u7406\u6a19\u6e96\u7b49\u3002","managementStructureDesc":"\u963f\u91cc\u5df4\u5df4\u8a2d\u7acb\u79d1\u6280\u502b\u7406\u6cbb\u7406\u59d4\u54e1\u6703\uff0c\u8ca0\u8cac\u5efa\u7acb\u4e26\u6301\u7e8c\u5b8c\u5584\u79d1\u6280\u502b\u7406\u6cbb\u7406\u9ad4\u7cfb\u3002\u59d4\u54e1\u6703\u4e3b\u5e2d\uff08\u9996\u5e2d\u6280\u8853\u5b98\uff09\u517c\u4efb\u