e\u78ba\u6cbb\u7406\u6a19\u6e96\u78ba\u4fdd\u843d\u5be6\uff0c\u5c0d\u91cd\u5927\u98a8\u96aa\u5be6\u65bd\u5c08\u9805\u6aa2\u67e5\u8207\u9589\u74b0\u9a57\u6536\u3002","emergencyManagementTitle":"\u61c9\u6025\u7ba1\u7406\u6d41\u7a0b","emergencyManagementDesc":"\u6211\u5011\u5728\u96c6\u5718\u548c\u5404\u696d\u52d9\u5747\u7d44\u5efa\u4e86\u61c9\u6025\u7ba1\u7406\u5718\u968a\u4e26\u4efb\u547d\u8cac\u4efb\u4eba\uff0c\u5efa\u7acb\u61c9\u6025\u7ba1\u7406\u5de5\u4f5c\u6d41\u7a0b\uff0c\u4fdd\u969c\u61c9\u6025\u5de5\u4f5c\u6709\u5e8f\u958b\u5c55\u3002","emergencyManagementContent":"\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u5718 ESU \u4e8b\u4ef6\u7ba1\u7406\u5236\u5ea6\u300b\u660e\u78ba\u4e86\u98a8\u96aa\u4e8b\u4ef6\u7684\u5206\u985e\u5b9a\u7d1a\u6a19\u6e96\u3001\u4e8b\u524d\u6e96\u5099\u8207\u9810\u9632\u3001\u4e8b\u767c\u97ff\u61c9\u8207\u8655\u7f6e\u4ee5\u53ca\u4e8b\u5f8c\u8986\u76e4\u6539\u9032\u8207\u554f\u8cac\u7684\u76f8\u95dc\u6d41\u7a0b\u3002","supervisionMechanismTitle":"\u76e3\u7763\u8a55\u50f9\u8207\u6aa2\u67e5\u6a5f\u5236","supervisionMechanismDesc":"\u6211\u5011\u5728\u96c6\u5718\u548c\u5404\u696d\u52d9\u5efa\u7acb\u5167\u90e8\u7684\u76e3\u7763\u8a55\u50f9\u548c\u5916\u90e8\u7684\u76e3\u7763\u6574\u6539\u6a5f\u5236\u3002\u5168\u9762\u98a8\u96aa\u7ba1\u7406\u59d4\u54e1\u6703\u5c0d\u5404\u696d\u52d9\u7684\u5408\u898f\u53ca\u98a8\u96aa\u7ba1\u7406\u5de5\u4f5c\u958b\u5c55\u5e74\u5ea6\u76e3\u7763\u8a55\u50f9\u8207\u6aa2\u67e5\u3002","supervisionMechanismContent":"\u963f\u91cc\u5df4\u5df4\u5efa\u7acb\u5206\u5c64\u76e3\u7763\u8207\u6aa2\u67e5\u6a5f\u5236\u3002\u5404\u696d\u52d9\u4f5c\u70ba\u8cac\u4efb\u4e3b\u9ad4\u843d\u5be6\u81ea\u67e5\uff1b\u96c6\u5718\u8077\u80fd\u90e8\u9580\u958b\u5c55\u5c08\u9805\u6aa2\u67e5\uff0c\u4e26\u6bcf\u5e74\u81f3\u5c11\u9032\u884c\u4e00\u6b21\u5167\u5916\u90e8\u5be9\u8a08\uff0c\u78ba\u4fdd\u5408\u898f\u843d\u5be6\u3002\u554f\u8cac\u5c64\u9762\uff0c\u98a8\u7ba1\u6703\u5c0d\u5404\u696d\u52d9\u7684\u5408\u898f\u53ca\u98a8\u96aa\u7ba1\u7406\u5de5\u4f5c\u958b\u5c55\u5e74\u5ea6\u76e3\u7763\u8207\u8a55\u4f30\uff0c\u6aa2\u67e5\u7d50\u679c\u8207\u76f8\u95dc\u5718\u968a\u7e3e\u6548\u639b\u9264\u3002","riskCultureTitle":"\u98a8\u96aa\u7ba1\u7406\u6587\u5316\u8207\u57f9\u8a13","riskTrainingTitle":"\u98a8\u96aa\u7ba1\u7406\u57f9\u8a13","riskTrainingDesc":"2026\u8ca1\u5e74\uff0c\u6211\u5011\u5171\u7d44\u7e54\u8fd11,900\u6b21\u5408\u898f\u8207\u98a8\u96aa\u6587\u5316\u5ba3\u50b3\u57f9\u8a13\u6d3b\u52d5\uff0c\u4e26\u5c07\u98a8\u96aa\u7ba1\u7406\u76f8\u95dc\u5167\u5bb9\u7d0d\u5165\u8986\u84cb\u5168\u9ad4\u54e1\u5de5\u7684\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u5546\u696d\u884c\u70ba\u6e96\u5247\u8003\u8a66\u4e2d\u3002","riskCultureActivityTitle":"\u96c6\u5718\u5408\u898f\u65e5","riskCultureActivityDesc":"\u6211\u5011\u958b\u5c55\u7b2c\u4e94\u5c46\u96c6\u5718\u5408\u898f\u65e5\u6d3b\u52d5\uff0c\u900f\u904e\u9ad8\u7ba1\u5bc4\u8a9e\u3001\u5236\u5ea6\u5ba3\u5c0e\u3001\u4e92\u52d5\u9ad4\u9a57\u7b49\u5f62\u5f0f\u5411\u5168\u9ad4\u54e1\u5de5\u666e\u53ca\u591a\u9818\u57df\u5408\u898f\u77e5\u8b58\uff0c\u5f37\u5316\u5168\u54e1\u98a8\u96aa\u610f\u8b58\u3002","esgGovernanceContent":"\u81ea 2021 \u5e74\u8d77\uff0c\u6211\u5011\u900f\u904e\u8463\u4e8b\u6703\u3001\u7ba1\u7406\u5c64\u548c\u5de5\u4f5c\u7d44\u7684\u4e09\u5c64 ESG \u6cbb\u7406\u67b6\u69cb\u4f86\u4fdd\u969c\u548c\u843d\u5be6 ESG\u5de5\u4f5c\u7684\u63a8\u9032\u3002\u5728\u53ef\u6301\u7e8c\u767c\u5c55\u59d4\u54e1\u6703\u7684\u6307\u5c0e\u4e0b\uff0c\u6211\u5011\u6301\u7e8c\u6309\u7167\u8a08\u5283\u3001\u5be6\u65bd\u3001\u6aa2\u67e5\u548c\u8abf\u6574(PDCA)\u5faa\u74b0\u6df1\u5316\u963f\u91cc\u5df4\u5df4ESG\u7ba1\u7406\u9ad4\u7cfb\u3002"}')},55095:function(e){"use strict";e.exports=JSON.parse('{"bannerTitle":"Conserving and restoring nature","bannerSubtitle":"With a focus on packaging, water, waste, and biodiversity, we are moving toward a 4R circular economy built on reduction, reuse, recycling, and renewable resource transition.","actionResults":"Progress","strategyPath":"Approaches","reducePackaging":"Packaging","saveWater":"Water","reduceWaste":"Waste","protectEcosystem":"Nature","actionResultCard1Title":"169,000","actionResultCard1Unit":"tons","actionResultCard1Description":"Cainiao followed a reduce-recycle-reuse approach to cut the use of packaging materials by 169,000 tons.","actionResultCard2Title":"1.144","actionResultCard2Unit":"L/kWh","actionResultCard2Description":"The annual average WUE of Alibaba Cloud\'s self-built data centers dropped to 1.144 L/kWh","actionResultCard3Title":"21.28","actionResultCard3Unit":"million","actionResultCard3Description":"The GreenNet Program has redirected a total of 21.28 million searches related to wildlife trading to public awareness and educational pages.","strategyReduceTitle":"Reduce","strategyReduceDescription":"We streamline resource inputs at the source to deliver greater value with fewer resources.","strategyReuseTitle":"Reuse","strategyReuseDescription":"We repair, refurbish, and reuse items wherever possible to extend their lifecycles.","strategyRenewableTitle":"Renewable resource transition","strategyRenewableDescription":"We prioritize the use of renewable resources to fuel our green transformation.","strategyRecycleTitle":"Recycle","strategyRecycleDescription":"We recycle products, packaging, and materials to extend resource lifecycles.","packagingDescription":"In FY2026, Cainiao followed a reduce-recycle-reuse approach to cut the use of packaging materials by 189,000 tons.","packagingCardContent":"We provide harmless and easy-to-use packaging for consumers, despite the complexities of product categories, weather conditions, and transportation modes in our operating environments. Cainiao reduces the use of packaging materials and champions their recycling and reuse, harnessing technologies to address diverse challenges and balance sustainable development goals with consumer needs.","waterDescription":"The World Meteorological Organization\'s State of Global Water Resources report highlights intensifying stress on global water supplies and dwindling available resources. Against this backdrop, we systematically identify, assess, and manage water risks across our operations in compliance with local regulations. Furthermore, we regularly disclose our water footprint data and continuously enhance water efficiency.","waterCard1Title":"Data centers","waterCard1Description":"We emphasize balancing WUE and PUE for a systematic assessment of resource risks, while taking location-specific measures to reduce water consumption and improve water efficiency.","waterCard2Title":"Office campuses","waterCard2Description":"We integrate sustainable water management into both the design and operational phases of our office campuses. By adopting the \\"sponge city\\" design concept and deploying intelligent water management systems, we strive to maximize the utilization efficiency of water resources.","waterCard3Title":"Retail spaces","waterCard3Description":"Seafood preservation is the largest contributor to Freshippo\'s water footprint. We actively explore efficient water-saving solutions that do not compromise product quality or customer experience.","wasteDescription":"The world generates an estimated 2.1-2.3 gigatons of municipal solid waste annually, of which only 61% to 62% is treated in controlled facilities. For compliant, efficient waste management, we adopt a two-pronged approach that focuses on waste reduction and resource recovery.","wasteDataCenterTitle":"Data centers","wasteDataCenterContent":"100% of hazardous waste from our self-built data centers is handled by licensed contractors. Furthermore, we have built an IT equipment recycling system to promote resource circularity.","wasteOfficeParkTitle":"Office campuses","wasteOfficeParkContent":"On our office campuses, we adhere to the principle of 100% compliant waste disposal. This involves digitalizing our waste management and piloting a program that converts kitchen waste into organic fertilizer to facilitate resource recycling.","wasteRetailTitle":"Retail spaces","wasteRetailContent":"Freshippo works to improve waste management, implementing specific measures to achieve 100% compliant disposal.","ecosystemDescription":"We align with evolving frameworks and metrics for biodiversity-related risks and opportunities. In addition to internal conservation efforts, we collaborate with various stakeholders to foster experience sharing and co-governance.","ecosystemCard1Title":"Office campuses","ecosystemCard1Description":"To mitigate and even reverse the negative environmental impact of campus construction, we integrate biodiversity into design and operations. Specifically, we use native species, diversify plant varieties to enrich vegetation layers, and create ecological corridors to foster harmony between human beings and nature.","ecosystemCard2Title":"E-commerce platforms","ecosystemCard2Description":"Illegal wildlife trading poses a risk to biodiversity. On our e-commerce platforms, we address this via a dual approach. For merchants, we deploy AI algorithms to monitor text, images, and videos in real time. For consumers, we run the GreenNet Program to raise their awareness and educate them on environmental laws.","ecosystemCard3Title":"Multi-stakeholder participation","ecosystemCard3Description":"We are committed to building a multi-stakeholder ecosystem for sustainable development. To this end, we forge partnerships with government agencies, regulatory bodies, and professional organizations. In May 2024, Alibaba sponsored the 2024 China Nature Education Conference, held under the theme \\"Shanghai, Better Nature Education.\\""}')},93276:function(e){"use strict";e.exports=JSON.parse('{"bannerTitle":"\u52a9\u529b\u5efa\u8bbe\u7eff\u6c34\u9752\u5c71","bannerSubtitle":"\u6211\u4eec\u56f4\u7ed5\u5305\u88c5\u3001\u6c34\u8d44\u6e90\u3001\u5e9f\u5f03\u7269\u548c\u751f\u7269\u591a\u6837\u6027\u7b49\u73af\u4fdd\u8bae\u9898\uff0c\u63a8\u52a8\u7ecf\u6d4e\u6a21\u5f0f\u5411\u201c4R\u201d\uff08Reduce, Reuse, Recycle, Renewable resource transition\uff09\u5faa\u73af\u7ecf\u6d4e\u8f6c\u578b\u3002","actionResults":"\u884c\u52a8\u7ed3\u679c","strategyPath":"\u7b56\u7565\u4e0e\u8def\u5f84","reducePackaging":"\u51cf\u5c11\u548c\u4f18\u5316\u5305\u88c5","saveWater":"\u8282\u7ea6\u6c34\u8d44\u6e90","reduceWaste":"\u51cf\u5c11\u548c\u5faa\u73af\u5e9f\u5f03\u7269","protectEcosystem":"\u4fdd\u62a4\u751f\u6001\u7cfb\u7edf","actionResultCard1Title":"16.9","actionResultCard1Unit":"\u4e07\u5428","actionResultCard1Description":"\u83dc\u9e1f\u901a\u8fc7\u51cf\u5c11\u5305\u6750\u4f7f\u7528\u3001\u5305\u88c5\u5faa\u73af\u548c\u91cd\u590d\u5229\u7528\u5171\u8ba1\u51cf\u5c1116.9 \u4e07\u5428\u5305\u88c5\u6750\u6599","actionResultCard2Title":"1.144","actionResultCard2Unit":"\u5347/\u5ea6","actionResultCard2Description":"\u963f\u91cc\u4e91\u81ea\u5efa\u6570\u636e\u4e2d\u5fc3\u7684\u5e74\u5747WUE\u964d\u4f4e\u81f31.144\u5347/\u5ea6","actionResultCard3Title":"2,128","actionResultCard3Unit":"\u4e07\u6b21","actionResultCard3Description":"\u901a\u8fc7\u7eff\u7f51\u8ba1\u5212\uff0c\u7d2f\u8ba1 2,128 \u4e07\u6b21\u7528\u6237\u7684\u91ce\u751f\u52a8\u690d\u7269\u4ea4\u6613\u76f8\u5173\u641c\u7d22\u4e00\u952e\u8f6c\u5316\u4e3a\u79d1\u666e\u6559\u80b2\u548c\u5ba3\u5bfc\u9875\u9762","strategyReduceTitle":"\u51cf\u5c11\u8d44\u6e90\u4f7f\u7528","strategyReduceDescription":"\u4ece\u6e90\u5934\u7cbe\u7b80\u8d44\u6e90\u6295\u5165\uff0c\u4ee5\u66f4\u5c11\u8d44\u6e90\u521b\u9020\u66f4\u5927\u4ef7\u503c\u3002","strategyReuseTitle":"\u91cd\u590d\u518d\u4f7f\u7528","strategyReuseDescription":"\u5c3d\u53ef\u80fd\u5bf9\u53ef\u7528\u7269\u54c1\u8fdb\u884c\u7ef4\u4fee\u3001\u6539\u9020\u518d\u5229\u7528\u548c\u591a\u6b21\u4f7f\u7528\u6765\u5ef6\u957f\u4ea7\u54c1\u751f\u547d\u5468\u671f\u3002","strategyRenewableTitle":"\u8d44\u6e90\u7684\u53ef\u518d\u751f\u8f6c\u578b","strategyRenewableDescription":"\u4f18\u5148\u91c7\u7528\u53ef\u518d\u751f\u8d44\u6e90\uff0c\u63a8\u52a8\u7eff\u8272\u5347\