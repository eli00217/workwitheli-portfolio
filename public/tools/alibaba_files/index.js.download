:"\u53ef\u4fe1\u8eab\u4efd","trustedCall":"\u53ef\u4fe1\u8c03\u7528","emergencyTrainingTitle":"\u5e94\u6025\u4e0e\u57f9\u8bad","emergencyManagement":"\u5e94\u6025\u7ba1\u7406","emergencyManagementDesc":"\u6211\u4eec\u660e\u786e\u98ce\u9669\u4e8b\u4ef6\u7684\u5206\u7ea7\u5206\u7c7b\u7ba1\u7406\u6807\u51c6\u3001\u8d1f\u8d23\u56e2\u961f\u3001\u62a5\u544a\u548c\u54cd\u5e94\u7684\u5e94\u6025\u5904\u7406\u6d41\u7a0b\uff0c\u786e\u4fdd\u5feb\u901f\u3001\u6709\u6548\u548c\u6709\u5e8f\u5730\u54cd\u5e94\u5b89\u5168\u4e8b\u4ef6\u3002\u5728\u98ce\u9669\u5904\u7f6e\u7ed3\u675f\u4e4b\u540e\uff0c\u6211\u4eec\u4f1a\u5bf9\u98ce\u9669\u4e8b\u4ef6\u8fdb\u884c\u590d\u76d8\uff0c\u5728\u7ba1\u7406\u63aa\u65bd\u4e0a\u67e5\u6f0f\u8865\u7f3a\uff0c\u540c\u65f6\u5bf9\u98ce\u9669\u4e8b\u4ef6\u8fdb\u884c\u8ffd\u8d23\u3002","networkSecurityTraining":"\u7f51\u7edc\u5b89\u5168\u57f9\u8bad","networkSecurityTrainingDesc":"\u6bcf\u5e74\uff0c\u9762\u5411\u5168\u4f53\u5458\u5de5\u7684\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u57f9\u8bad\u548c\u8003\u8bd5\u4e2d\u5747\u5305\u542b\u7f51\u7edc\u5b89\u5168\u6a21\u5757\u3002\u6b64\u5916\uff0c\u6211\u4eec\u8fd8\u4e3a\u5168\u4f53\u5458\u5de5\u5f00\u653e\u4e86\u5b89\u5168\u670d\u52a1\u4e2d\u5fc3\u5e73\u53f0\uff0c\u4e0d\u5b9a\u671f\u66f4\u65b0\u7f51\u7edc\u5b89\u5168\u3001\u6570\u636e\u5b89\u5168\u3001\u4e2a\u4eba\u4fe1\u606f\u5b89\u5168\u7b49\u5b66\u4e60\u8d44\u6599\uff0c\u5e2e\u52a9\u4ed6\u4eec\u52a0\u5f3a\u9690\u79c1\u4fdd\u62a4\u4e0e\u6570\u636e\u5b89\u5168\u4ee5\u53ca\u7f51\u7edc\u5b89\u5168\u7b49\u4e13\u4e1a\u77e5\u8bc6\u7684\u5b66\u4e60\u3002","networkSupervisionTitle":"\u76d1\u7763\u4e0e\u8ba4\u8bc1","networkSupervisionCertificationDesc":"\u963f\u91cc\u5df4\u5df4\u6bcf\u5e74\u4f9d\u636e\u7f51\u7edc\u5b89\u5168\u7ba1\u7406\u5236\u5ea6\u5bf9\u5404\u4e1a\u52a1\u5f00\u5c55\u7f51\u7edc\u5b89\u5168\u5408\u89c4\u68c0\u67e5\uff0c\u65b9\u6cd5\u5305\u62ec\u6c9f\u901a\u8bbf\u8c08\u3001\u8fd0\u8425\u6570\u636e\u6392\u67e5\u3001\u7a7f\u884c\u6d4b\u8bd5\u3001\u7ea2\u84dd\u5bf9\u6297\u9a8c\u8bc1\u7b49\u3002\u6b64\u5916\uff0c\u5404\u4e1a\u52a1\u5747\u83b7\u5f97\u6570\u636e\u5b89\u5168\u3001\u9690\u79c1\u4fdd\u62a4\u548c\u7f51\u7edc\u5b89\u5168\u65b9\u9762\u7684\u8ba4\u8bc1\uff0c\u5982ISO 27001\u3001\u4fe1\u606f\u7cfb\u7edf\u5b89\u5168\u7b49\u7ea7\u4fdd\u62a4\u7b49\u3002\u70b9\u51fb\u67e5\u770b\u7f51\u7edc\u548c\u6570\u636e\u5b89\u5168\u8ba4\u8bc1\u3002","ethicalTechnologyTitle":"\u5b8c\u5584\u79d1\u6280\u4f26\u7406","ethicalTechnologyDesc":"\u6211\u4eec\u5728\u575a\u6301\\"AI \u9a71\u52a8\\"\u4e1a\u52a1\u6218\u7565\u53d1\u5c55\u7684\u540c\u65f6\uff0c\u4e5f\u65f6\u523b\u5173\u6ce8\u8be5\u9886\u57df\u7684\u5b89\u5168\u3001\u516c\u5e73\u3001\u9690\u79c1\u7b49\u95ee\u9898\uff0c\u5b9e\u8df5\u8d1f\u8d23\u4efb\u7684\u4eba\u5de5\u667a\u80fd\u3002\u53c2\u8003\u300a\u5168\u7403\u6570\u5b57\u5951\u7ea6\u300b\u300a\u5168\u7403\u4eba\u5de5\u667a\u80fd\u6cbb\u7406\u5021\u8bae\u300b\u300a\u4eba\u5de5\u667a\u80fd\u6cd5\u6848\u300b\u7b49\u4eba\u5de5\u667a\u80fd\u6cbb\u7406\u673a\u5236\u6216\u8005\u5021\u8bae\uff0c\u963f\u91cc\u5df4\u5df4\u63d0\u51fa\u79d1\u6280\u4f26\u7406\u6cbb\u7406\u516d\u9879\u57fa\u672c\u51c6\u5219:\\"\u4ee5\u4eba\u4e3a\u672c\u3001\u666e\u60e0\u6b63\u76f4\u3001\u9690\u79c1\u4fdd\u62a4\u3001\u5b89\u5168\u53ef\u9760\u3001\u53ef\u4fe1\u53ef\u63a7\u3001\u5f00\u653e\u5171\u6cbb\\"\u3002","managementProcessSystemTitle":"\u7ba1\u7406\u6d41\u7a0b\u4e0e\u4f53\u7cfb","managementProcessSystemIntro":"\u6211\u4eec\u5bf9\u5df2\u7ecf\u6d6e\u73b0\u51fa\u6765\u7684\u5185\u5bb9\u5b89\u5168\u3001\u9690\u79c1\u4fdd\u62a4\u3001\u6a21\u578b\u5b89\u5168\u7b49\u98ce\u9669\uff0c\u5df2\u4f18\u5316\u6cbb\u7406\u4f53\u7cfb\u4e0e\u63aa\u65bd\u3002\u5bf9\u5c1a\u672a\u770b\u6e05\u3001\u672a\u5f62\u6210\u5171\u8bc6\u7684\u95ee\u9898\uff0c\u8fd8\u5728\u6301\u7eed\u6295\u5165\u8d44\u6e90\uff0c\u4e0e\u5b66\u754c\u3001\u4e1a\u754c\u53ca\u884c\u4e1a\u4e0a\u4e0b\u6e38\u5171\u540c\u7814\u7a76\u3002\u6211\u4eec\u5c06\u4eba\u5de5\u667a\u80fd\u76f8\u5173\u7684\u4e1a\u52a1\u573a\u666f\u5206\u4e3a\u6a21\u578b\u4ee5\u53ca\u57fa\u4e8e\u6a21\u578b\u7684\u5e94\u7528\u4e24\u5927\u7c7b\uff0c\u5728\u8fd9\u4e24\u4e2a\u65b9\u9762\u52a0\u5f3a\u79d1\u6280\u4f26\u7406\u7ba1\u7406\u63aa\u65bd\u3002","modelTrainingStage":"\u6a21\u578b\u8bad\u7ec3\u9636\u6bb5","modelTrainingStageDesc":"\u5728\u6570\u636e\u96c6\u6784\u5efa\u8fc7\u7a0b\u4e2d\uff0c\u5bf9\u6570\u636e\u8fdb\u884c\u6e05\u6d17\u3001\u5b89\u5168\u8fc7\u6ee4\u3002\u5e76\u91c7\u53d6\u589e\u91cf\u9884\u8bad\u7ec3\u3001\u5f3a\u5316\u5b66\u4e60\u3001\u5236\u4f5c\u5b89\u5168\u8bed\u6599\u548c\u5b89\u5168\u6027\u5bf9\u9f50\u7b49\u63aa\u65bd\u3002","serviceOnlineStage":"\u670d\u52a1\u4e0a\u7ebf\u9636\u6bb5","serviceOnlineStageDesc":"\u6211\u4eec\u91c7\u53d6\u98ce\u9669\u5206\u7c7b\u5206\u7ea7\u5ba1\u67e5\u673a\u5236\uff0c\u4ee5\u5e73\u8861\u4eba\u5de5\u667a\u80fd\u7684\u53d1\u5c55\u548c\u6cbb\u7406\u53cc\u76ee\u6807\u3002","contentGenerationStage":"\u5185\u5bb9\u751f\u6210\u9636\u6bb5","contentGenerationStageDesc":"\u91c7\u53d6\u8f93\u5165\u8f93\u51fa\u5ba1\u6838\u8fc7\u6ee4\u3001\u68c0\u7d22\u5f0f\u589e\u5f3a\u6280\u672f\u7b49\u7ba1\u7406\u63aa\u65bd\u6765\u9632\u8303\u98ce\u9669\u3002","contentDisseminationStage":"\u5185\u5bb9\u4f20\u64ad\u9636\u6bb5","contentDisseminationStageDesc":"\u5728\u9762\u5411\u6d88\u8d39\u8005\u7684\u4eba\u5de5\u667a\u80fd\u751f\u6210\u5185\u5bb9\u4f20\u64ad\u573a\u666f\uff0c\u5bf9\u56fe\u7247\u3001\u89c6\u9891\u3001\u97f3\u9891\u7b49\u5185\u5bb9\u8fdb\u884c\u6807\u8bc6\u68c0\u6d4b\u3002\u5e76\u5728\u751f\u6210\u5185\u5bb9\u754c\u9762\u6dfb\u52a0\u663e\u8457\u7684AI\u6807\u8bc6\u548c\u63d0\u793a\u3002","aiGovernanceCapacityTitle":"\u4eba\u5de5\u667a\u80fd\u6cbb\u7406\u80fd\u529b\u5efa\u8bbe","aiGovernanceCapacityIntro":"\u5728\u4eba\u5de5\u667a\u80fd\u6280\u672f\u5feb\u901f\u8fed\u4ee3\u3001\u5e94\u7528\u573a\u666f\u6301\u7eed\u62d3\u5c55\u7684\u80cc\u666f\u4e0b\uff0c\u6211\u4eec\u6b63\u7740\u529b\u63a8\u8fdb\u63a2\u7d22\u548c\u6784\u5efa\u4e0e\u4e4b\u76f8\u9002\u5e94\u7684\u6cbb\u7406\u80fd\u529b\uff0c\u7279\u522b\u662f\u6280\u672f\u6cbb\u7406\u80fd\u529b\uff0c\u4ee5\u5e94\u5bf9\u6311\u6218\u5e76\u628a\u63e1\u673a\u9047\u3002","techEthicsDataConstruction":"\u79d1\u6280\u4f26\u7406\u6570\u636e\u96c6\u4e0eAI\u884c\u4e3a\u6307\u5357","techEthicsDataConstructionDesc":"\u6784\u5efa\u4e2d\u6587\u79d1\u6280\u4f26\u7406\u6570\u636e\u96c6\uff0c\u8986\u76d611\u5927\u7ef4\u5ea6\u300136\u9879\u7ec6\u5206\u6807\u7b7e\uff0c\u5efa\u7acb\u914d\u5957\u8bc4\u6d4b\u57fa\u51c6\u3002\u5f00\u6e90AI\u6a21\u578b\u4e0e\u5e94\u7528\u884c\u4e3a\u6307\u5357\uff0c\u5c06\u6a21\u578b\u5b89\u5168\u4ece\u88ab\u52a8\u68c0\u6d4b\u8f6c\u4e3a\u4e3b\u52a8\u89c4\u8bad\uff0c\u63d0\u51fa\u201c\u5efa\u8bbe\u6027\u5b89\u5168\u5bf9\u9f50\u201d\u7406\u5ff5\uff0c\u4ee5\u5f15\u5bfc\u66ff\u4ee3\u76f4\u63a5\u62d2\u7edd\u3002","securityEnhancementConstruction":"\u5b89\u5168\u8bc4\u6d4b\u4e0e\u62a4\u680f","securityEnhancementConstructionDesc":"\u63d0\u51fa\u201c\u516b\u722a\u9c7c\u201d\uff08S-Eval\uff09\u8bc4\u6d4b\u6846\u67b6\uff0c\u6db5\u76d68\u4e2a\u98ce\u9669\u7ef4\u5ea6\u3001102\u4e2a\u7ec6\u5206\u7c7b\u578b\uff1b\u5f00\u6e90\u201c\u6d77\u8c5a\u201d\u62a4\u680f\u6a21\u578b\uff0c\u540c\u6b65\u751f\u6210\u98ce\u9669\u5f52\u56e0\u89e3\u91ca\uff1b\u7814\u53d1PlugGuard\u3001QwenGuard\u7b49\u201c\u539f\u751f\u62a4\u680f\u201d\u6280\u672f\uff0c\u5c06\u5b89\u5168\u68c0\u6d4b\u5d4c\u5165\u63a8\u7406\u8fc7\u7a0b\u3002","blueArmySecurityTest":"AI\u6807\u8bc6\u4e0e\u751f\u6210\u5185\u5bb9\u68c0\u6d4b","blueArmySecurityTestDesc":"\u7d2f\u8ba1\u83b7\u5f97AI\u6807\u8bc6\u76f8\u5173\u4e13\u522943\u9879\uff0c\u5728\u7b2c\u516d\u5c4a\u4e2d\u56fd\u4eba\u5de5\u667a\u80fd\u5927\u8d5b\u4e2d\u8363\u83b7\u4e09\u9879A\u7ea7\u8bc1\u4e66\u3002\u5176\u4e2d\u57fa\u4e8e\u6df1\u5ea6\u5b66\u4e60\u7684\u9690\u5f0f\u6c34\u5370\u6280\u672f\u517c\u5177\u9c81\u68d2\u6027\u4e0e\u6297\u653b\u51fb\u80fd\u529b\uff0c\u5185\u5bb9\u7ecf\u88c1\u526a\u3001\u538b\u7f29\u540e\u4ecd\u53ef\u6709\u6548\u63d0\u53d6\u3002","autoSecurityEvaluationFramework":"\u667a\u80fd\u4f53\u5e94\u7528\u6c99\u7bb1","autoSecurityEvaluationFrameworkDesc":"\u7814\u53d1\u5e76\u5f00\u6e90\u4e86\u901a\u7528\u667a\u80fd\u4f53\u5e94\u7528\u6c99\u7bb1OpenSandbox\uff0c\u63d0\u4f9b\u5bb9\u5668\u9694\u79bb\u3001\u7f51\u7edc\u7ba1\u63a7\u3001\u8d44\u6e90\u9650\u5236\u7b49\u5b8c\u6574\u5b89\u5168\u65b9\u6848\uff0c\u5df2\u83b7OpenSSF Best Practices\u94f6\u7ea7\u8ba4\u8bc1\u3002","consensusPracticeTitle":"\u591a\u65b9\u5171\u8bc6","consensusPracticeIntro":"\u6211\u4eec\u5185\u90e8\u5f00\u5c55\u79d1\u6280\u4f26\u7406\u6cbb\u7406\u7684\u5ba3\u5bfc\uff0c\u901a\u8fc7\u524d\u6cbf\u6280\u672f\u548c\u6cbb\u7406\u8d8b\u52bf\u4ea4\u6d41\u3001\u5185\u5916\u90e8\u4e13\u5bb6\u7814\u8ba8\u4f1a\u7b49\u591a\u79cd\u5f62\u5f0f\uff0c\u63d0\u9ad8\u6280\u672f\u4eba\u5bf9\u4e8e\u79d1\u6280\u4f26\u7406\u76f8\u5173\u6280\u672f\u4e0e\u98ce\u9669\u7684\u5173\u6ce8\uff0c\u63d0\u5347\u5176\u79d1\u6280\u4f26\u7406\u610f\u8bc6\u548c\u7d20\u517b\uff1b\u5728\u5916\u90e8\uff0c\u6211\u4eec\u79ef\u6781\u53c2\u4e0e\u884c\u4e1a\u4f1a\u8bae\u3001\u6807\u51c6\u5efa\u8bbe\u7b49\u5de5\u4f5c\u3002","proactiveExchangeTitle":"\u6587\u5316\u5efa\u8bbe","proactiveExchangeDesc":"\u6211\u4eec\u4e3a\u7814\u53d1\u3001\u7b97\u6cd5\u3001\u4ea7\u54c1\u53ca\u5408\u89c4\u7b49\u5173\u952e\u5c97\u4f4d\u63d0\u4f9bAI\u5408\u89c4\u57f9\u8bad\uff0c\u6db5\u76d6\u6cd5\u89c4\u8d8b\u52bf\u3001\u7b97\u6cd5\u900f\u660e\u5ea6\u4e0e\u9690\u79c1\u4fdd\u62a4\u3002\u540c\u65f6\u8054\u5408\u9ad8\u6821\u4e0e\u4ea7\u4e1a\u754c\u6253\u9020\u300a\u8ffdAI\u7684\u4eba\u300b\u79d1\u666e\u680f\u76ee\uff0c\u805a\u7126AI\u524d\u6cbf\u6280\u672f\u4e0e\u4f26\u7406\u4e89\u8bae\uff0c\u5c06\u590d\u6742\u6280\u672f\u8f6c\u5316\u4e3a\u901a\u4fd7\u8868\u8fbe\uff0c\u63a8\u52a8\u516c\u4f17\u5bf9\u8d1f\u8d23\u4efbAI\u7684\u7406\u89e3\u3002","standardConstructionTitle":"\u6807\u51c6\u5efa\u8bbe","standardConstructionDesc":"\u6211\u4eec\u7275\u5934\u53ca\u6df1\u5ea6\u53c2\u4e0e\u56fd\u5185\u5916\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u3001\u751f\u6210\u5408\u6210\u5185\u5bb9\u6807\u8bc6\u3001\u68c0\u6d4b\u53ca\u6570\u5b57\u6c34\u5370\u7b49\u9886\u57df\u7684\u6807\u51c6\u4e0e\u6307\u5357\u5236\u5b9a\uff0c\u63a8\u52a8\u884c\u4e1a\u89c4\u8303\u53d1\u5c55\u3002","consensusEstablishmentTitle":"\u524d\u6cbf\u6280\u672f\u5408\u4f5c","consensusEstablishmentDesc":"\u6211\u4eec\u4e0e\u6e05\u534e\u5927\u5b66\u3001\u6d59\u6c5f\u5927\u5b66\u3001\u4e0a\u6d77\u4eba\u5de5\u667a\u80fd\u5b9e\u9a8c\u5ba4\u7b49\u9ad8\u6821\u4e0e\u673a\u6784\u5f00\u5c55AI\u5408\u89c4\u5b89\u5168\u4e0e\u5408\u89c4\u76f8\u5173\u5408\u4f5c\uff0c\u5982\u5171\u5efa\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u5b9e\u9a8c\u5ba4\u3001\u5171\u5efaAI\u6cbb\u7406\u6807\u51c6\u7b49\u3002","managementStructureDesc":"\u963f\u91cc\u5df4\u5df4\u8bbe\u7acb\u79d1\u6280\u4f26\u7406\u6cbb\u7406\u59d4\u5458\u4f1a\uff0c\u8d1f\u8d23\u5efa\u7acb\u5e76\u6301\u7eed\u5b8c\u5584\u79d1\u6280\u4f26\u7406\u6cbb\u7406\u4f53\u7cfb\u3002\u59d4\u5458\u4f1a\u4e3b\u5e2d\uff08\u9996\u5e2d\u6280\u672f\u5b98\uff09\u517c\u4efb\u79d1\u6280\u4f26\u7406\u4e13\u9879\u7ec4\u7ec4\u957f\uff0c\u5411\u53ef\u6301\u7eed\u53d1\u5c55\u7ba1\u7406\u59d4\u5458\u4f1a\u6c47\u62a5\u3002\u5404\u4e1a\u52a1\u5747\u5df2\u5efa\u7acb\u5e38\u6001\u5316\u79d1\u6280\u4f26\u7406\u7ec4\u7ec7\u3002","integrityCultureBuildingTitle":"\u6587\u5316\u5efa\u8bbe","integrityTrainingTitle":"\u5ec9\u6b63\u57f9\u8bad","integrityTrainingDesc":"\u963f\u91cc\u5df4\u5df4\u5bf9\u8150\u8d25\u884c\u4e3a\u96f6\u5bb9\u5fcd\uff0c\u5e76\u9762\u5411\u8463\u4e8b\u4f1a\u3001\u7ba1\u7406\u5c42\u3001\u5458\u5de5\u548c\u5408\u4f5c\u4f19\u4f34\u5f00\u5c55\u4e0d\u540c\u7c7b\u578b\u7684\u57f9\u8bad\u6d3b\u52a8\uff0c\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u548c\u8003\u8bd5\u662f\u5458\u5de5\u6bcf\u5e74\u7684\u5fc5\u4fee\u8bfe\uff0c\u6211\u4eec\u4e5f\u5728\u6b64\u57fa\u7840\u4e0a\u4e3e\u529e\u5404\u79cd\u57f9\u8bad\u6d3b\u52a8\u3002","complianceConsultancyTitle":"\u5408\u89c4\u54a8\u8be2","complianceConsultancyDesc":"\u6211\u4eec\u63d0\u4f9b\u8986\u76d6\u5185\u5916\u90e8\u7684\u5408\u89c4\u54a8\u8be2\u6e20\u9053\u3002\u5458\u5de5\u53ef\u901a\u8fc7\u667a\u80fd\u52a9\u624b\u3001\u7535\u8bdd\u3001\u90ae\u4ef6\u53ca\u7f51\u7ad9\u83b7\u53d6\u5408\u89c4\u6307\u5f15\uff1b\u5408\u4f5c\u4f19\u4f34\u53ef\u901a\u8fc7\u516c\u5f00\u90ae\u7bb1\u3001\u7535\u8bdd\u548c\u7f51\u7ad9\u83b7\u53d6\u54a8\u8be2\u3002","deterrentEducationTitle":"\u8b66\u793a\u6559\u80b2","deterrentEducationDesc":"\u6211\u4eec\u901a\u8fc7\u5185\u90e8\u7ebf\u4e0a\u793e\u533a\u5ec9\u6b63\u4e13\u680f\uff0c\u5c06\u5408\u89c4\u653f\u7b56\u8f6c\u5316\u4e3a\u4e1a\u52a1\u573a\u666f\u63d0\u9192\u3002\u6bcf\u5b63\u5ea6\u53d1\u5e03\u884c\u4e1a\u4e0e\u5185\u90e8\u5178\u578b\u6848\u4f8b\u5206\u6790\uff0c\u5e76\u5bf9\u6f5c\u5728\u98ce\u9669\u53d1\u51fa\u5373\u65f6\u9884\u8b66\uff1b\u6bcf\u5e74\u5c06\u5178\u578b\u5ec9\u6b63\u8fdd\u89c4\u4e8b\u4ef6\u5236\u4f5c\u6210\u60c5\u666f\u77ed\u7247\uff0c\u8b66\u793a\u8fdd\u89c4\u540e\u679c\u3002","privacyRightsGuaranteeTitle":"\u9690\u79c1\u6743\u5229\u4fdd\u969c","privacyRightKnowTitle":"\u77e5\u60c5\u6743","privacyRightKnowDesc":"\u516c\u5f00\u9690\u79c1\u653f\u7b56\u6e05\u6670\u8bf4\u660e\u89c4\u5219\u3002\u7528\u6237\u9996\u6b21\u4f7f\u7528\u65f6\u5f39\u7a97\u83b7\u53d6\u6388\u6743\u540c\u610f\uff1b\u7b2c\u4e09\u65b9\u5904\u7406\u4e2a\u4eba\u4fe1\u606f\u65f6\u518d\u6b21\u544a\u77e5\u5e76\u5f81\u5f97\u540c\u610f\u3002","privacyRightManageTitle":"\u7ba1\u7406\u6743","privacyRightManageDesc":"APP\u201c\u9690\u79c1\u201d\u6a21\u5757\u63d0\u4f9b\u7cfb\u7edf\u6743\u9650\u7ba1\u7406\u3001\u6388\u6743\u7ba1\u7406\u3001\u5e7f\u544a\u7ba1\u7406\u3001\u63a8\u8350\u7ba1\u7406\u7b49\u529f\u80fd\u3002","privacyRightDeleteChangeTitle":"\u5220\u9664\u548c\u53d8\u66f4\u6743","privacyRightDeleteChangeDesc":"\u63d0\u4f9b\u4fbf\u6377\u7684\u4e2a\u4eba\u4fe1\u606f\u66f4\u6539\u548c\u5220\u9664\u8d26\u53f7\u6d41\u7a0b\u3002\u5e76\u6839\u636e\u7528\u6237\u8bf7\u6c42\u534f\u52a9\u5176\u5b8c\u6210\u8bbf\u95ee\u3001\u590d\u