earlier","reportName":"Report","reportTime":"Time","reportTagType":"Type","reportDetail":"Details","reportTag":"Report","viewDetail":"View Details","esgReportCover":"ESG Report Cover","ceoLetterTitle":"A Letter from our CEO","downloadReport":"Download Report"}')},88644:function(e){"use strict";e.exports=JSON.parse('{"ratingsAndAwards":"\u8bc4\u7ea7\u4e0e\u5956\u9879","bannerSubtitle":"\u6211\u4eec\u7684\u52aa\u529b\u4ece\u672a\u6b62\u6b65\uff0c\u5e76\u81f4\u529b\u4e8e\u901a\u8fc7\u900f\u660e\u7684\u4fe1\u606f\u62ab\u9732\u6784\u5efa\u793e\u4f1a\u4fe1\u4efb\u4e0e\u4f01\u4e1a\u4fe1\u4efb\uff0c\u63a8\u52a8\u5171\u540c\u8fdb\u6b65\u3002","esgRatings":"ESG\u8bc4\u7ea7","esgAwards":"ESG\u5956\u9879","latestEsgReport":"\u6700\u65b0ESG\u62a5\u544a","reportsAndResources":"\u62a5\u544a\u53ca\u8d44\u6e90","navEsgRatings":"ESG\u8bc4\u7ea7","navEsgAwards":"ESG\u5956\u9879","navLatestEsgReport":"\u6700\u65b0ESG\u62a5\u544a","navReportsAndResources":"\u62a5\u544a\u53ca\u8d44\u6e90","filterTag":"\u6807\u7b7e","filterTime":"\u65f6\u95f4","year2025":"2025","year2024":"2024","year2023":"2023","year2022":"2022","year2021":"2021","year2020Before":"2020\u53ca\u4e4b\u524d","reportName":"\u62a5\u544a\u540d","reportTime":"\u65f6\u95f4","reportTagType":"\u6807\u7b7e\u7c7b\u578b","reportDetail":"\u8be6\u60c5","reportTag":"\u62a5\u544a","viewDetail":"\u67e5\u770b\u8be6\u60c5","esgReportCover":"ESG\u62a5\u544a\u5c01\u9762","ceoLetterTitle":"\u9996\u5e2d\u6267\u884c\u5b98\u7684\u4e00\u5c01\u4fe1","downloadReport":"\u4e0b\u8f7d\u62a5\u544a"}')},34443:function(e){"use strict";e.exports=JSON.parse('{"ratingsAndAwards":"\u8a55\u7d1a\u8207\u734e\u9805","bannerSubtitle":"\u6211\u5011\u7684\u52aa\u529b\u5f9e\u672a\u6b62\u6b65\uff0c\u4e26\u81f4\u529b\u65bc\u901a\u904e\u900f\u660e\u7684\u4fe1\u606f\u62ab\u9732\u69cb\u5efa\u793e\u6703\u4fe1\u4efb\u8207\u4f01\u696d\u4fe1\u4efb\uff0c\u63a8\u52d5\u5171\u540c\u9032\u6b65\u3002","esgRatings":"ESG\u8a55\u7d1a","esgAwards":"ESG\u734e\u9805","latestEsgReport":"\u6700\u65b0ESG\u5831\u544a","reportsAndResources":"\u5831\u544a\u53ca\u8cc7\u6e90","navEsgRatings":"ESG\u8a55\u7d1a","navEsgAwards":"ESG\u734e\u9805","navLatestEsgReport":"\u6700\u65b0ESG\u5831\u544a","navReportsAndResources":"\u5831\u544a\u53ca\u8cc7\u6e90","filterTag":"\u6a19\u7c64","filterTime":"\u6642\u9593","year2025":"2025","year2024":"2024","year2023":"2023","year2022":"2022","year2021":"2021","year2020Before":"2020\u53ca\u4e4b\u524d","reportName":"\u5831\u544a\u540d","reportTime":"\u6642\u9593","reportTagType":"\u6a19\u7c64\u985e\u578b","reportDetail":"\u8a73\u60c5","reportTag":"\u5831\u544a","viewDetail":"\u67e5\u770b\u8a73\u60c5","esgReportCover":"ESG\u5831\u544a\u5c01\u9762","ceoLetterTitle":"\u9996\u5e2d\u57f7\u884c\u5b98\u7684\u4e00\u5c01\u4fe1","downloadReport":"\u4e0b\u8f09\u5831\u544a"}')},26498:function(e){"use strict";e.exports=JSON.parse('{"alibabaIntro1":"","bannerTitle":"Building digital platforms for enterprise customers","bannerDescription":"We harness technological innovation to bridge AI and other digital technologies with the real economy. By fostering a secure, open ecosystem for digital transformation, we empower enterprises to build a sustainable future.","actionResults":"Progress","strategyPath":"Approaches","responsibleTechnology":"Responsible technologies","sustainableEcommerce":"Sustainable platforms","patentsPrefix":"About ","patentsTitle":"21,000","patentsUnit":"","patentsDesc":"We have been granted about 21,000 patents worldwide.","modelRankingPrefix":"","modelRankingTitle":"No. 3 worldwide","modelRankingUnit":"","modelRankingDesc":"In 2024, Alibaba ranked third globally among contributors to key AI models.","qwenModelsPrefix":"Over ","qwenModelsTitle":"100,000","qwenModelsUnit":"","qwenModelsDesc":"The cumulative total number of models derived from the Qwen family exceeded 100,000 on Hugging Face.","modelScopePrefix":"Over ","modelScopeTitle":"52,000","modelScopeUnit":"","modelScopeDesc":"ModelScope, our open-source community, featured over 52,000 models for developers to download and deploy.","dingTalkAIPrefix":"Over ","dingTalkAITitle":"1.77 million","dingTalkAIUnit":"","dingTalkAIDesc":"As a result of our efforts to provide micro-, small, and medium-sized enterprises (MSMEs) with various AI tools, the number of monthly active enterprises and organizations using AI on the DingTalk platform exceeded 1.77 million.","iso9001Prefix":"Over ","iso9001Title":"80","iso9001Unit":"%","iso9001Desc":"The ISO 9001 Quality Management System certification covered more than 80% of Alibaba Cloud\'s public cloud products.","smeMerchantsPrefix":"","smeMerchantsTitle":"94","smeMerchantsUnit":"%","smeMerchantsDesc":"MSMEs accounted for 94% of active merchants on Taobao and Tmall.","factoriesPrefix":"Over ","factoriesTitle":"310,000","factoriesUnit":"","factoriesDesc":"Over 310,000 industrial-belt factories have established a presence on 1688.com.","sellersPrefix":"Over ","sellersTitle":"240,000","sellersUnit":"","sellersDesc":"Alibaba.com connected over 240,000 global sellers with more than 49 million buyers from over 190 countries and regions.","innovationTitle":"Innovation","innovationDesc":"With a steadfast commitment to R&D and a comprehensive IP framework, we champion originality on our platforms and work with partners to create a thriving, sustainable digital ecosystem.","opennessTitle":"Openness","opennessDesc":"In the AI era, we advocate open-source technologies and open ecosystems to boost innovation and catalyze the global shift toward an intelligent future.","reliabilityTitle":"Reliability","reliabilityDesc":"We foster a reliable and trustworthy environment for technology and business, building a dependable platform ecosystem where all stakeholders can thrive.","techInnovationTitle":"Innovation","preferredCloudTitle":"A top-rated cloud service provider","preferredCloudDesc":"Alibaba Cloud has remained a Global Leader in Gartner\'s Magic Quadrant for Cloud Database Management Systems for six consecutive years. It is also the sole Asia-Pacific cloud provider positioned by Gartner as an emerging leader across four dimensions: generative AI cloud infrastructure, engineering, model offerings, and knowledge management applications.","topRankingTitle":"Qwen\'s stellar performance","topRankingDesc":"Qwen3.6-Plus, released in March 2026, excels at coding and agentic programming, which has made it a leader in front-end web development and complex repository-level tasks. In May 2026, Qwen3.7-Max debuted with an all-new agent-oriented design that has delivered breakthroughs in coding and reasoning.","aiCooperationTitle":"Collaborative innovation","aiCooperationDesc":"Alibaba partners extensively with universities and academic institutions worldwide to drive technological innovation. We partnered with Shanghai Jiao Tong University, Nanyang Technological University, and the Hong Kong University of Science and Technology to advance joint research on AI.","openTechTitle":"Openness","openSourceTitle":"Open-source technologies","openSourceDesc":"With a focus on AI, cloud-native applications, big data, databases, and operating systems, we have launched a wide range of open-source projects. As we advance AI technologies, we are committed to expanding our open-source initiatives. Notably, Qwen offers open-source models for language processing, multiple modalities, mathematics, and code generation. ","openEcosystemTitle":"Open ecosystem","openEcosystemDesc":"We are nurturing a model ecosystem to drive the open development of AI. In 2022, we partnered with the Opensource Development Committee of the China Computer Federation to launch ModelScope, an AI community that enables creators to upload models, which enterprises and developers can freely download and build upon.","reliableCloudTitle":"Reliability","reliableCloudDesc":"Alibaba Cloud has released specifications and policies for quality management and customer service experience. As of March 31, 2026, the ISO 9001 certification covered over 93% of its public cloud products.","productQualityTab":"Product quality","customerServiceTab":"Service experience","productLaunchTitle":"Launch","productLaunchDesc":"To ensure product stability, Alibaba Cloud has established management processes across all phases, from requirement analysis and design, through development and testing, to product launch review. ","marketManagementTitle":"In-service management","marketManagementDesc":"After a product is launched, Alibaba Cloud continuously monitors its operational status. When any metric goes beyond a predefined threshold, it issues an emergency notification, identifies the root cause, and implements emergency recovery measures. ","featureChangeTitle":"Feature changes","featureChangeDesc":"Any feature change for a product already launched must be registered in the change management system and adhere to the change process. Alibaba Cloud conducts an assessment to determine its potential impact on customers and formulate a plan for subsequent actions.","productRetirementTitle":"Discontinuation","productRetirementDesc":"Before a product is discontinued, Alibaba Cloud posts an announcement on the product\'s official website, detailing the timeline and potential impact while also reminding customers to back up their data. The discontinuation process is carried out in phases to minimize disruption to customer operations.","consultationTitle":"Customer support","consultationDesc":"Alibaba Cloud provides customers with 24/7 support through multiple channels, such as live chats, phone calls, and DingTalk. Additionally, it has introduced a smart Q&A system and automated diagnostic tools to offer convenient self-service options.","qualityTrackingTitle":"Service quality tracking","qualityTrackingDesc":"To improve customer service, Alibaba Cloud combines intelligent quality inspections with manual spot checks. When an issue is detected, an improvement checklist is pushed to the customer service agents involved, prompting them to make necessary improvements.","dingTalkCaseTitle":"Defining an AI-driven new paradigm for workplace collaboration ","dingTalkCaseDesc":"As a leading platform for workplace collaboration and enterprise management in China, DingTalk is committed to an \\"AI-driven\\" strategy. It transforms daily workspaces into an AI-native productivity platform to empower enterprises with future-ready teamwork competencies.","dingTalkCaseHover":"As of March 31, 2026, 7.83 million enterprises and organizations had adopted AI technologies on DingTalk. In FY2026, over 1.79 million enterprises and organizations were monthly active users of AI on the platform. In March 2026, DingTalk launched Wukong, an enterprise-grade AI-native workspace that embeds agentic capabilities directly into corporate workflows. By orchestrating multiple agents to handle complex, long-running tasks within a unified interface, Wukong evolves AI from a conversational assistant into a work partner capable of autonomously executing business logic.","ecommerceOverviewDesc":"Across our e-commerce platforms, we bridge technology and business, drawing on innovation to meet business needs and empower an extensive range of enterprises. We are also committed to maintaining a level playing field that provides merchants of all sizes with equitable opportunities to grow.","digitalCapabilityTitle":"Digital business solutions","digitalCapabilityDesc":"Taobao and Tmall constantly drive a digital transformation of business by helping merchants digitalize their operations, enhance consumer interaction, increase consumer retention, boost brand recognition, foster product innovations, optimize supply chain management, and improve operational efficiency.","qianniuTitle":"Qianniu","qianniuDesc":"As Alibaba\'s all-in-one merchant workbench, Qianniu integrates store management tools, market insights, and partner networks. It empowers merchants with end-to-end operational solutions to streamline their business.","alimamaTitle":"Alimama","alimamaDesc":"Alimama provides merchants with one-stop marketing services. Its AI-driven omnichannel marketing tool, Quanzhantui, features smart bidding, smart targeting, and visual data dashboards to improve marketing efficiency and create value for merchants.","yingshangbaoTitle":"Yingshangbao","yingshangbaoDesc":"Yingshangbao is Alibaba\'s risk management platform for merchants. It combines compliance self-audits, early warnings, and anti-fraud measures, helping merchants mitigate risks and achieve business continuity.","marcoAITitle":"AI solution Marco","marcoAIDesc":"Marco, an AI solution for merchants, won the SAIL Star Award at the World Artificial Intelligence Conference.","fairEnvironmentTitle":"Open and fair operating environment","fairEnvironmentDesc":"We are committed to fostering an open, fair market environment. Our e-commerce platforms provide public access to service agreements and transaction rules, which can be easily read and downloaded by merchants. Taobao and Tmall Group has formulated a policy to clarify its principles and requirements for the prevention of monopoly and unfair competition. It periodically reviews external requirements and adjusts this policy accordingly.","complianceProcessTitle":"Competition compliance","complianceProcessDesc":"At Taobao and Tmall Group, every business project undergoes a pre-launch compliance review and is only cleared for launch after passing it. During business operations, continuous screening for compliance risks allows for immediate remediation. In the event of a risk incident, a working group is mobilized to lead the investigation and response. Afterwards, it performs an in-depth root cause analysis, requiring relevant departments to establish preventive mechanisms.","complianceTrainingTitle":"Training","complianceTrainingDesc":"Taobao and Tmall Group promotes competition compliance through comprehensive education and training designed to enhance awareness and practical skills among employees. Key initiatives for this purpose include exams, in-person workshops, and live webinars.","contactUsTitle":"Report misconduct","contactUsDesc":"Unfair Competition Reporting:\\nTaobao-tousu@Alibaba-inc.com \\nTmall-tousu@Alibaba-inc.com","ipProtectionMainTitle":"IP protection","ipProtectionMainDesc":"Our platforms enforce strict merchant guidelines that prohibit IP infringement. Violations trigger immediate enforcement actions, including content removal and product delisting.","ipSystemTitle":"IP protection framework","ipSystemDesc":"Our e-commerce platforms have established clear merchant management rules, explicitly requiring merchants not to infringe on IP rights and outlining measures for handling violations. Our platforms take measures against information or products infringing on IP rights, such as removal, delisting, and deletion.","taotianIPTitle":"Taobao and Tmall Group","taotianIPDesc":"As of March 31, 2026, about 840,000 IP owners had registered on its IP protection platform, which had protected over 1.58 million rights.","aliInternationalIPTitle":"Alibaba International Digital Commerce Group","aliInternationalIPDesc":"As of March 31, 2026, its IP protection platform had onboarded over 210,000 IP owners and protected over 770,000 rights from 137 countries and regions.","originalProtectionTitle":"Alibaba Original Design Protection Platform","originalProtectionDesc":"The Alibaba Original Design Protection Platform supports registration and rights protection for original content first published by merchants on the Taobao and Tmall platforms, such as images, short videos, and creative designs. Original images and short videos can be \\"stamped\\" using the digital watermarking technology. When an infringement occurs, a single click is all the merchant needs to do to protect their own rights. As of March 31, 2025, the Alibaba Original Design Protection Platform had protected a cumulative total of over 890 million images, over 150 million short videos, and over 930,000 design manuscripts.","complianceAwarenessTitle":"Compliance awareness","complianceAwarenessDesc":"and prevent IP infringement through training and tutoring.","trainingGuidanceTitle":"Training","trainingGuidanceDesc":"Training is a vital avenue for preventing IP infringement. We leverage diverse formats, including text, images, short videos, and livestreams, to communicate the principles of compliant operations, educate merchants on IP protection, and nurture a culture of innovation.","multiGovernanceTitle":"Multi-stakeholder governance","multiGovernanceDesc":"We are committed to addressing and resolving key IP issues by uniting multiple stakeholders under a collaborative and dialogue-based approach that facilitates multi-stakeholder co-governance.","aacaTitle":"Alibaba Anti-Counterfeiting Alliance","aacaDesc":"The Alibaba Anti-Counterfeiting Alliance (AACA), founded in 2017, combats counterfeiting by leveraging our technologies, the brand knowledge of rights holders, and industry insights. As of March 31, 2026, over 1,300 brands had joined the alliance.","aliInternationalEcoTitle":"International cooperation","aliInternationalEcoDesc":"Alibaba International Digital Commerce Group has established partnerships with the World Intellectual Property Organization (WIPO), the International AntiCounterfeiting Coalition (IACC), and the Korea Intellectual Property Protection Agency (KOIPA).  The business addresses MSME needs via the Small and Medium Enterprise Advisory Committee (SAC) and runs the MarketSafe\xae Program with the IACC to offer MSMEs platform grants and IACC assistance in rights protection.","diverseCommunityTitle":"A diverse e-commerce community","diverseCommunityDesc":"A vast consumer base engages with our platforms daily, purchasing and using a wide array of products and services. Therefore, we need a diverse merchant base on our platforms. We consistently attract and encourage diverse groups of people to explore business opportunities on our platforms. We provide merchants with introductory and development courses on e-commerce and ensure that merchants with various needs can all participate and benefit.","diverseMerchantsTab":"Various merchants","merchantGrowthTab":"Sustainability","smeMerchantsCardDesc":"The \\"universal Taobao\\" attracts diverse entrepreneurs, especially MSMEs. In FY2026, MSMEs accounted for 93.3% of annual active merchants on Taobao and Tmall.","smallMerchantsTitle":"MSMEs","brandMerchantsTitle":"Brands","brandMerchantsDesc":"Tmall has become a preferred partner for both international and homegrown brands. The vast majority of top-tier international brands operating in China have established a presence on Tmall.","crossBorderMerchantsTitle":"Cross-border sellers","crossBorderMerchantsDesc":"Alibaba.com is an integrated international wholesale marketplace. In FY2026, over 240,000 sellers worldwide used this marketplace to reach 47 million buyers from 191 countries and regions.","industrialMerchantsTitle":"Industrial-belt merchants","industrialMerchantsDesc":"1688.com, our integrated domestic wholesale marketplace in China, helps industrial-belt merchants better connect with markets. As of March 31, 2026, over 280,000 industrial-belt factories had opened stores on 1688.com.","ecommerceCoursesTitle":"Taobao Learning Center","ecommerceCoursesDesc":"The Taobao Learning Center provides merchants with free courses on e-commerce operations. In FY2025, it logged over 5.33 million learning sessions.","legalEducationTitle":"Legal education","legalEducationDesc":"Taobao and Tmall Group launched the Compliance Frontline, a legal education program for merchants. It regularly invites policymakers and law enforcement experts to share insights and case studies regarding policies on privacy protection, anti-fraud, compliant operations, and minor protection."}')},69088:function(e){"use strict";e.exports=JSON.parse('{"alibabaIntro1":"","bannerTitle":"\u5171\u5efa\u6570\u667a\u5e73\u53f0\u670d\u52a1\u4f01\u4