tigation":"\u4e3e\u62a5\u4e0e\u8c03\u67e5","independentReportChannel":"\u72ec\u7acb\u4e3e\u62a5\u6e20\u9053","independentReportChannelDesc":"\u6211\u4eec\u8bbe\u7acb\u72ec\u7acb\u7684\u4e3e\u62a5\u6e20\u9053\uff0c24 \u5c0f\u65f6\u54cd\u5e94\u4e3e\u62a5\uff0c\u8def\u5f84\u5305\u62ec\u5b98\u65b9\u7f51\u7ad9\u3001\u4e13\u7528\u90ae\u7bb1\u3001\u7535\u8bdd\u70ed\u7ebf\u7b49\u591a\u6e20\u9053\u3002\u540c\u65f6\uff0c\u652f\u6301\u5305\u62ec\u82f1\u8bed\u3001\u897f\u73ed\u7259\u8bed\u5728\u5185\u7684\u591a\u4e2a\u8bed\u79cd\u3002","whistleblowerProtection":"\u4e3e\u62a5\u4eba\u4fdd\u62a4","whistleblowerProtectionDesc":"\u6211\u4eec\u652f\u6301\u63a5\u6536\u533f\u540d\u4e3e\u62a5\uff0c\u5728\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u7b49\u5236\u5ea6\u4e2d\u660e\u786e\u5199\u660e\u201c\u4e3e\u62a5\u4eba\u4fdd\u62a4\u201d\u6761\u6b3e\uff0c\u5bf9\u4e3e\u62a5\u4eba\u7684\u8eab\u4efd\u53ca\u6240\u63d0\u4f9b\u7684\u4fe1\u606f\u4e25\u683c\u4fdd\u5bc6\uff0c\u660e\u786e\u7981\u6b62\u6253\u51fb\u62a5\u590d\u3002","investigationHandling":"\u8c03\u67e5\u5904\u7f6e","investigationHandlingDesc":"\u9488\u5bf9\u8150\u8d25\u95ee\u9898\u7ebf\u7d22\uff0c\u5ec9\u6b63\u5408\u89c4\u90e8\u5c06\u8054\u5408\u6d89\u4e8b\u5458\u5de5\u6240\u5728\u90e8\u95e8\u4f9d\u89c4\u5f00\u5c55\u8c03\u67e5\uff0c\u5ba1\u614e\u5224\u5b9a\u662f\u5426\u6784\u6210\u8fdd\u89c4\uff0c\u5e76\u636e\u6b64\u4f5c\u51fa\u76f8\u5e94\u5904\u7406\uff0c\u5305\u62ec\u8bad\u8beb\u3001\u8b66\u544a\u3001\u8bb0\u8fc7\u3001\u8f9e\u9000\u7b49\u3002","riskManagementTitle":"\u98ce\u9669\u7ba1\u7406","riskIdentification":"\u98ce\u9669\u8bc6\u522b\u4e0e\u6539\u8fdb","ethicsRiskIdentificationDesc":"\u6839\u636e\u5386\u53f2\u8150\u8d25\u6848\u4ef6\uff0c\u4e3b\u52a8\u8bc6\u522b\u91cd\u70b9\u98ce\u9669\uff0c\u5bf9\u91cd\u70b9\u4e1a\u52a1\u548c\u9ad8\u98ce\u9669\u5c97\u4f4d\u5f00\u5c55\u4e13\u9879\u8bc4\u4f30\uff0c\u5e76\u5236\u5b9a\u76f8\u5e94\u7684\u5e94\u5bf9\u7ba1\u7406\u65b9\u6cd5\u3002","managementResponsibility":"\u7ba1\u7406\u8005\u8d23\u4efb","managementResponsibilityDesc":"\u7ba1\u7406\u8005\u8981\u91cd\u89c6\u98ce\u9669\u63a7\u5236\uff0c\u8fdb\u884c\u6587\u5316\u5ba3\u4f20\uff0c\u7ed9\u4e88\u56e2\u961f\u6210\u5458\u6709\u6548\u7684\u6307\u5bfc\u4e0e\u5e2e\u52a9\u3002\u56e2\u961f\u7684\u5ec9\u6b63\u98ce\u9669\u8bc6\u522b\u4e0e\u5904\u7406\u7684\u7ee9\u6548\u8868\u73b0\u4e5f\u7eb3\u5165\u7ba1\u7406\u8005\u7684\u7ee9\u6548\u8003\u6838\u3002","supervisionTitle":"\u76d1\u7763\u4e0e\u5ba1\u8ba1","supervisionDesc":"\u6211\u4eec\u5efa\u7acb\u4e86\u5185\u5916\u90e8\u5ba1\u8ba1\u673a\u5236\uff0c\u8bc4\u4f30\u5185\u90e8\u63a7\u5236\u673a\u5236\u9632\u63a7\u8150\u8d25\u7684\u6709\u6548\u6027\u3002\u5ec9\u6b63\u5408\u89c4\u90e8\u8054\u5408\u5ba1\u8ba1\u3001\u5185\u63a7\u7b49\u90e8\u95e8\uff0c\u6bcf\u5e74\u5bf9\u9ad8\u98ce\u9669\u7684\u4e1a\u52a1\u5f00\u5c55\u5ec9\u6b63\u5ba1\u8ba1\u3002\u6bcf\u5b63\u5ea6\u5411\u5916\u90e8\u5ba1\u8ba1\u673a\u6784\u62ab\u9732\u8150\u8d25\u4e8b\u4ef6\uff0c\u5e76\u56de\u5e94\u98ce\u9669\u7ba1\u63a7\u95ee\u8be2\u3002\u9488\u5bf9\u5ba1\u8ba1\u8bc6\u522b\u51fa\u7684\u95ee\u9898\uff0c\u6211\u4eec\u5efa\u7acb\u6301\u7eed\u8ddf\u8e2a\u673a\u5236\uff0c\u786e\u4fdd\u76f8\u5173\u90e8\u95e8\u843d\u5b9e\u6574\u6539\u3002","disclosureReporting":"\u8463\u4e8b\u4f1a\u6c47\u62a5","disclosureReportingDesc":"\u6bcf\u5b63\u5ea6\u5411\u8463\u4e8b\u4f1a\u5ba1\u8ba1\u59d4\u5458\u4f1a\u548c\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u6c47\u62a5\u8150\u8d25\u6848\u4ef6\u3001\u98ce\u9669\u6574\u6539\u548c\u8bda\u4fe1\u6587\u5316\u5efa\u8bbe\u7b49\u8bae\u9898\u7684\u8fdb\u5c55\u3002","internalControl":"\u5ba1\u8ba1","internalControlDesc":"\u6bcf\u5b63\u5ea6\u5411\u5916\u90e8\u5ba1\u8ba1\u673a\u6784\u62ab\u9732\u8150\u8d25\u4e8b\u4ef6\uff0c\u56de\u7b54\u98ce\u9669\u7ba1\u63a7\u95ee\u9898\u3002\u6b64\u5916\uff0c\u5ec9\u6b63\u5408\u89c4\u90e8\u8054\u5408\u5185\u5ba1\u90e8\u5bf9\u91cd\u70b9\u98ce\u9669\u5f00\u5c55\u5ba1\u8ba1\uff0c\u4ee5\u8bc4\u4f30\u5185\u90e8\u63a7\u5236\u673a\u5236\u548c\u7a0b\u5e8f\u7684\u6709\u6548\u6027\u3002","integrityConstruction":"\u6587\u5316\u5efa\u8bbe","integrityConstructionDesc":"\u963f\u91cc\u5df4\u5df4\u5bf9\u8150\u8d25\u884c\u4e3a\u96f6\u5bb9\u5fcd\uff0c\u5e76\u9762\u5411\u8463\u4e8b\u4f1a\u3001\u7ba1\u7406\u5c42\u3001\u5458\u5de5\u548c\u5408\u4f5c\u4f19\u4f34\u5f00\u5c55\u4e0d\u540c\u7c7b\u578b\u7684\u57f9\u8bad\u6d3b\u52a8\uff0c\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u548c\u8003\u8bd5\u662f\u5458\u5de5\u6bcf\u5e74\u7684\u5fc5\u4fee\u8bfe\uff0c\u6211\u4eec\u4e5f\u5728\u6b64\u57fa\u7840\u4e0a\u4e3e\u529e\u5404\u79cd\u57f9\u8bad\u6d3b\u52a8\uff0c\u6253\u9020\u8bda\u4fe1\u6587\u5316\u30022025\u8d22\u5e74\uff0c\u5458\u5de5\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u8ba4\u8bc1\uff08\u5185\u542b\u5ec9\u6b63\u57f9\u8bad\u4e0e\u8003\u8bd5\uff09\u901a\u8fc7\u7387\u8fbe100%\u3002","supplyChainTitle":"\u6df1\u5316\u4f9b\u5e94\u5546\u7ba1\u7406","supplyChainDesc":"\u6253\u9020\u5ec9\u6d01\u3001\u8bda\u4fe1\u3001\u53ef\u6301\u7eed\u7684\u5546\u4e1a\u73af\u5883\u662f\u6211\u4eec\u7ba1\u7406\u4f9b\u5e94\u5546\u7684\u6838\u5fc3\uff0c\u8fd9\u4e5f\u4e0e ESG \u7406\u5ff5\u4e0d\u8c0b\u800c\u5408\u3002\u6211\u4eec\u53d1\u5e03\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u63a7\u80a1\u6709\u9650\u516c\u53f8\u4f9b\u5e94\u5546\u5408\u89c4\u7ba1\u7406\u89c4\u8303\u300b\uff0c\u5404\u4e1a\u52a1\u4ee5\u6b64\u4e3a\u57fa\u7ebf\u8981\u6c42\uff0c\u53ef\u4f9d\u636e\u4e1a\u52a1\u5b9e\u9645\u9700\u8981\uff0c\u5236\u5b9a\u5404\u81ea\u7684\u4f9b\u5e94\u5546\u5408\u89c4\u7ba1\u7406\u76f8\u5173\u653f\u7b56\u3002","esgStructureTitle":"\u4f9b\u5e94\u94feESG\u7ba1\u7406\u67b6\u6784","esgStructureText":"\u6211\u4eec\u6210\u7acb\u4f9b\u5e94\u94fe\u7ba1\u7406\u4e13\u9879\u7ec4\uff0c\u76f4\u63a5\u5411\u53ef\u6301\u7eed\u53d1\u5c55\u7ba1\u7406\u59d4\u5458\u4f1a\u6c47\u62a5\u3002\u5176\u4e3b\u8981\u804c\u8d23\u4e3a\uff0c\u5b9a\u4e49\u963f\u91cc\u5df4\u5df4\u4f9b\u5e94\u5546 ESG \u7ba1\u7406\u7684\u6807\u51c6\u548c\u57fa\u7ebf\uff0c\u5e76\u636e\u6b64\u63a8\u52a8\u4f9b\u5e94\u5546 ESG \u7ba1\u7406\u5b9e\u8df5\u3002","supplierProcessTitle":"\u4f9b\u5e94\u5546\u7ba1\u7406\u6d41\u7a0b","supplierProcessText":"\u6211\u4eec\u5efa\u7acb\u4e86\u4f9b\u5e94\u5546\u6570\u5b57\u5316\u7ba1\u7406\u7cfb\u7edf\uff0c\u8986\u76d6\u51c6\u5165\u3001\u9009\u62e9\u3001\u8bc4\u4f30\u53ca\u98ce\u9669\u7ba1\u7406\u56db\u5927\u73af\u8282\u3002\u6211\u4eec\u8981\u6c42\u4f9b\u5e94\u5546\u63d0\u4f9b\u76f8\u5173\u7684\u8ba4\u8bc1\u548c\u8d44\u8d28\u6587\u4ef6\uff0c\u5e76\u8fdb\u884c\u5ba1\u6838\uff0c\u63a8\u52a8\u4f9b\u5e94\u5546\u7b7e\u7f72\u300a\u8bda\u4fe1\u7ea6\u5b9a\u51fd\u300b\uff1b\u5728\u516c\u6b63\u516c\u5e73\u7684\u57fa\u7840\u4e0a\uff0c\u5404\u4e1a\u52a1\u53ef\u5efa\u7acb\u9002\u5408\u5b9e\u9645\u9700\u8981\u7684\u4f9b\u5e94\u5546\u9009\u62e9\u6807\u51c6\uff1b\u6211\u4eec\u7684\u4e3b\u8981\u4e1a\u52a1\u5747\u6784\u5efa\u4e86\u7b26\u5408\u81ea\u8eab\u4e1a\u52a1\u53d1\u5c55\u7684\u4f9b\u5e94\u5546\u7ee9\u6548\u8bc4\u4ef7\u673a\u5236\uff0c\u5bf9\u4f9b\u5e94\u5546\u5408\u4f5c\u60c5\u51b5\u8fdb\u884c\u5468\u671f\u6027\u7684\u8bc4\u4f30\uff1b\u6211\u4eec\u5728\u4e3b\u8981\u4e1a\u52a1\u7684\u4f9b\u5e94\u5546\u7ba1\u7406\u7cfb\u7edf\u8bbe\u7f6e\u4e86\u6570\u5b57\u5316\u98ce\u9669\u9632\u63a7\u6a21\u5757\uff0c\u5b9e\u73b0\u5bf9\u4f9b\u5e94\u5546\u51c6\u5165\u8bc4\u4f30\u53ca\u5408\u4f5c\u5168\u6d41\u7a0b\u7684\u667a\u80fd\u98ce\u9669\u8bc6\u522b\u4e0e\u52a8\u6001\u76d1\u63a7\u3002","esgPracticeTitle":"\u4f9b\u5e94\u5546ESG\u7ba1\u7406","esgPracticeIntro":"\u4f9b\u5e94\u5546 ESG \u7ba1\u7406\u5b9e\u8df5\uff1a\u6211\u4eec\u5021\u5bfc\u5e76\u4e14\u643a\u624b\u4f9b\u5e94\u5546\u4e00\u8d77\u5b9e\u8df5 ESG\u3002\u4f9b\u5e94\u94fe\u7ba1\u7406\u4e13\u9879\u7ec4\u5b9a\u4e49\u963f\u91cc\u5df4\u5df4\u4f9b\u5e94\u5546 ESG \u7ba1\u7406\u7684\u6807\u51c6\u548c\u57fa\u7ebf\uff0c\u5e76\u636e\u6b64\u63a8\u52a8\u4f9b\u5e94\u5546 ESG\u7ba1\u7406\u5b9e\u8df5\u3002","guidelinesTabTitle":"\u5021\u5bfc\u4f9b\u5e94\u5546\u7b7e\u7f72ESG\u884c\u4e3a\u51c6\u5219","integrationTabTitle":"ESG\u9010\u6b65\u878d\u5165\u4f9b\u5e94\u5546\u7ba1\u7406\u4f53\u7cfb","guidelinesContent":"\u300a\u963f\u91cc\u5df4\u5df4\u4f9b\u5e94\u5546 ESG \u884c\u4e3a\u51c6\u5219\u89c4\u8303\u300b\u660e\u786e\u4f9b\u5e94\u5546\u5e94\u8be5\u9075\u5faa\u7684 ESG \u539f\u5219\uff0c\u5305\u62ec\u7981\u6b62\u4f7f\u7528\u7ae5\u5de5\u53ca\u5f3a\u8feb\u52b3\u52a8\u3001\u52b3\u5de5\u6743\u76ca\u4fdd\u62a4\u3001\u4fdd\u969c\u804c\u4e1a\u5065\u5eb7\u548c\u5b89\u5168\u3001\u73af\u5883\u4fdd\u62a4\u3001 \u6570\u636e\u5b89\u5168\u4e0e\u9690\u79c1\u4fdd\u62a4\u3001\u5546\u4e1a\u9053\u5fb7\u7b49\u3002","integrationCard1Title":"ESG\u7eb3\u5165\u4f9b\u5e94\u5546\u7684\u9009\u62e9\u548c\u8bc4\u4f30","integrationCard1Desc":"\u5728\u79df\u8d41\u6570\u636e\u4e2d\u5fc3\u7684\u7ba1\u7406\u4e0a\uff0c\u6211\u4eec\u5c06\u4f9b\u5e94\u5546\u7684\u73af\u5883\u7ee9\u6548\u878d\u5165\u5230\u8bc4\u4f30\u73af\u8282\u3002\u5728\u90e8\u5206\u54c1\u7c7b\uff0c\u53d1\u8d77\u201d\u963f\u91cc\u5df4\u5df4\u4f9b\u5e94\u5546ESG\u79ef\u5206\u9879\u76ee\u201c\uff0c\u6536\u96c6\u548c\u8bc4\u4f30\u4f9b\u5e94\u5546ESG\u8868\u73b0\u3002","integrationCard2Title":"\u5347\u7ea7\u4f9b\u5e94\u5546 ESG \u98ce\u9669\u8bc6\u522b","integrationCard2Desc":"\u6211\u4eec\u8bd5\u70b9\u5c06 ESG \u98ce\u9669\u8bc6\u522b\u7eb3\u5165\u4f9b\u5e94\u5546\u98ce\u9669\u76d1\u6d4b\u4f53\u7cfb\u4e2d\uff0c\u5f3a\u5316\u4f9b\u5e94\u5546 ESG\u98ce\u9669\u8bc6\u522b\u548c\u9884\u8b66\u80fd\u529b\u3002","integrationCard3Title":"\u4f9b\u5e94\u5546ESG\u5408\u89c4\u5de5\u4f5c\u68c0\u67e5\u548c\u7ea0\u504f","integrationCard3Desc":"\u6211\u4eec\u5c06ESG \u98ce\u9669\u878d\u5165\u5230\u4f9b\u5e94\u5546\u7684\u5408\u89c4\u5de5\u4f5c\u68c0\u67e5\u3002\u751f\u6001\u7528\u5de5ESG \u5408\u89c4\u5de5\u4f5c\u68c0\u67e5\u8986\u76d6\u7528\u5de5\u89c4\u8303\u3001\u804c\u4e1a\u5b89\u5168\u3001\u5546\u4e1a\u9053\u5fb7\u3001\u6295\u8bc9\u673a\u5236\u65b9\u9762\u3002","integrationCard4Title":"ESG\u57f9\u8bad","integrationCard4Desc":"\u6211\u4eec\u6301\u7eed\u6295\u5165\u8d44\u6e90\u52a0\u5f3a\u4f9b\u5e94\u5546\u7ba1\u7406\u90e8\u95e8\u7684\u5458\u5de5\u57f9\u8bad\u3002\u5305\u62ec\u5ec9\u6b63\u5408\u89c4\u3001\u6cd5\u5f8b\u6cd5\u89c4\u3001ESG \u4ee5\u53ca\u91c7\u8d2d\u4e13\u4e1a\u6280\u80fd\u7b49\u5404\u4e2a\u5c42\u9762\u7684\u57f9\u8bad\u3002\u6b64\u5916\uff0c\u6211\u4eec\u4e5f\u4e3a\u4e3b\u8981\u4e1a\u52a1\u7684\u4f9b\u5e94\u5546\u63d0\u4f9b\u4e86ESG\u5408\u89c4\u57f9\u8bad\u3002","dataPrivacyTitle":"\u4fdd\u62a4\u6570\u636e\u5b89\u5168\u4e0e\u9690\u79c1","dataPrivacyDesc":"\u6211\u4eec\u53d1\u5e03\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u6570\u636e\u5b89\u5168\u603b\u7eb2\u300b\uff0c\u8986\u76d6\u6570\u636e\u91c7\u96c6\u3001\u4f20\u8f93\u3001\u5b58\u50a8\u3001\u4f7f\u7528\u548c\u9500\u6bc1\u7684\u751f\u547d\u5468\u671f\u5404\u4e2a\u73af\u8282\uff0c\u660e\u786e\u6570\u636e\u751f\u547d\u5468\u671f\u5b89\u5168\u7ba1\u7406\u8981\u6c42\uff0c\u786e\u4fdd\u6570\u636e\u5b89\u5168\u7ba1\u63a7\u63aa\u65bd\u5b9e\u65bd\u5230\u4f4d\u3002\u963f\u91cc\u5df4\u5df4\u4e5f\u5728\u96c6\u56e2\u5b98\u7f51\u53d1\u5e03\u300a\u9690\u79c1\u653f\u7b56\u5408\u89c4\u89c4\u8303\u300b\uff0c\u5e76\u4e14\u5728\u5404APP\u4e2d\u516c\u5f00\u9690\u79c1\u4fdd\u62a4\u653f\u7b56\u3002","managementStructureTitle":"\u7ba1\u7406\u67b6\u6784","boardLevel":"\u8463\u4e8b\u4f1a","boardLevelDesc":"\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u8d1f\u8d23\u76d1\u7763\u96c6\u56e2\u6570\u636e\u5b89\u5168\u4e0e\u4e2a\u4eba\u4fe1\u606f\u4fdd\u62a4\u5408\u89c4\u4e8b\u5b9c\uff0c\u7531\u72ec\u7acb\u8463\u4e8b\u4f5c\u4e3a\u4e3b\u5e2d\u76f4\u63a5\u9886\u5bfc\u3002\u5408\u89c4\u53ca\u98ce\u9669\u59d4\u5458\u4f1a\u5b9a\u671f\u6307\u5bfc\u6570\u636e\u5b89\u5168\u4e0e\u9690\u79c1\u4fdd\u62a4\u7684\u6218\u7565\u4ee5\u53ca\u5ba1\u67e5\u65e5\u5e38\u5de5\u4f5c\u3002","managementLevel":"\u7ba1\u7406\u5c42","managementLevelDesc":"\u6210\u7acb\u6570\u636e\u5b89\u5168\u51b3\u7b56\u5c0f\u7ec4\uff0c\u7531\u5168\u9762\u98ce\u9669\u7ba1\u7406\u5de5\u4f5c\u7ec4\u3001\u96c6\u56e2\u5b89\u5168\u90e8\u603b\u88c1\u3001\u9996\u5e2d\u6cd5\u52a1\u5b98\u4ee5\u53ca\u5404\u4e1a\u52a1\u7684\u5b89\u5168\u8d1f\u8d23\u4eba\u7ec4\u6210\uff0c\u8d1f\u8d23\u5236\u5b9a\u6570\u636e\u5b89\u5168\u7b56\u7565\u3001\u76ee\u6807\u548c\u6570\u636e\u5b89\u5168\u98ce\u9669\u51b3\u7b56\u7b49\u3002","executionLevel":"\u6267\u884c\u5c42","executionLevelDesc":"\u6210\u7acb\u6570\u636e\u5b89\u5168\u7ba1\u7406\u5c0f\u7ec4\u548c\u6570\u636e\u5b89\u5168\u6267\u884c\u5c0f\u7ec4\u3002\u6b64\u5916\uff0c\u6211\u4eec\u5728\u5404\u4e1a\u52a1\u5206\u522b\u8bbe\u7acb\u6570\u636e\u5b89\u5168\u8d23\u4efb\u4eba\u548c\u4e2a\u4eba\u4fe1\u606f\u4fdd\u62a4\u8d1f\u8d23\u4eba\u3002","securityPrinciplesTitle":"\u6570\u636e\u5b89\u5168\u7ba1\u7406\u539f\u5219","legalityPrinciple":"\u5408\u6cd5\u6b63\u5f53","legalityDesc":"\u5bf9\u6570\u636e\u7684\u5904\u7406\u5e94\u5f53\u6ee1\u8db3\u6240\u6709\u9002\u7528\u7684\u6cd5\u5f8b\u6cd5\u89c4\u8981\u6c42\uff0c\u4e14\u7b26\u5408\u516c\u5f00\u6b63\u5f53\u539f\u5219","legalityHoverDesc":"\u5bf9\u6570\u636e\u7684\u5904\u7406\u5e94\u5f53\u6ee1\u8db3\u6240\u6709\u9002\u7528\u7684\u6cd5\u5f8b\u6cd5\u89c4\u8981\u6c42\uff0c\u4e14\u7b26\u5408\u516c\u5f00\u6b63\u5f53\u539f\u5219","purposePrinciple":"\u76ee\u7684\u660e\u786e\u548c\u9650\u5236","purposeDesc":"\u6570\u636e\u5904\u7406\u6d3b\u52a8\u5e94\u5f53\u660e\u786e\u3001\u6e05\u6670\u3001\u5177\u4f53\u7684\u6570\u636e\u5904\u7406\u76ee\u7684\uff0c\u4e14\u540e\u7eed\u8fc7\u7a0b\u4e2d\u4e0d\u5f97\u8d85\u51fa\u6216\u8fdd\u53cd\u4ee5\u4e0a\u76ee\u7684\u8fdb\u884c\u4efb\u4f55\u6570\u636e\u5904\u7406\u6d3b\u52a8","purposeHoverDesc":"\u6570\u636e\u5904\u7406\u6d3b\u52a8\u5e94\u5f53\u660e\u786e\u3001\u6e05\u6670\u3001\u5177\u4f53\u7684\u6570\u636e\u5904\u7406\u76ee\u7684\uff0c\u4e14\u540e\u7eed\u8fc7\u7a0b\u4e2d\u4e0d\u5f97\u8d85\u51fa\u6216\u8fdd\u53cd\u4ee5\u4e0a\u76ee\u7684\u8fdb\u884c\u4efb\u4f55\u6570\u636e\u5904\u7406\u6d3b\u52a8","minimizationPrinciple":"\u6700\u5c0f\u5fc5\u8981","minimizationDesc":"\u6570\u636e\u5904\u7406\u6d3b\u52a8\u8fc7\u7a0b\u4e2d\uff0c\u5404\u4e2a\u9636\u6bb5\u90fd\u5e94\u9075\u5b88\u6700\u5c0f\u5fc5\u8981\u539f\u5219","minimizationHoverDesc":"\u6570\u636e\u5904\u7406\u6d3b\u52a8\u8fc7\u7a0b\u4e2d\uff0c\u5404\u4e2a\u9636\u6bb5\u90fd\u5e94\u9075\u5b88\u6700\u5c0f\u5fc5\u8981\u539f\u5219","transparencyPrinciple":"\u516c\u5f00\u900f\u660e","transparencyDesc":"\u5904\u7406\u4e2a\u4eba\u4fe1\u606f\u5e94\u5f53\u9075\u5faa\u516c\u5f00\u3001\u900f\u660e\u539f\u5219\uff0c\u516c\u5f00\u4e2a\u4eba\u4fe1\u606f\u5904\u7406\u89c4\u5219\uff0c\u660e\u793a\u5904\u7406\u76ee\u7684\u3001\u65b9\u5f0f\u548c\u8303\u56f4","transparencyHoverDesc":"\u5904\u7406\u4e2a\u4eba\u4fe1\u606f\u5e94\u5f53\u9075\u5faa\u516c\u5f00\u3001\u900f\u660e\u539f\u5219\uff0c\u516c\u5f00\u4e2a\u4eba\u4fe1\u606f\u5904\u7406\u89c4\u5219\uff0c\u660e\u793a\u5904\u7406\u76ee\u7684\u3001\u65b9\u5f0f\u548c\u8303\u56f4","consentPrinciple":"\u77e5\u60c5\u540c\u610f","consentDesc":"\u5904\u7406\u4e2a\u4eba\u4fe1\u606f\u5e94\u5f53\u9075\u5b88\u77e5\u60c5\u540c\u610f\u539f\u5219\uff0c\u786e\u4fdd\u7528\u6237\u77e5\u6653\u5e76\u540c\u610f\u4e2a\u4eba\u4fe1\u606f\u5904\u7406\u89c4\u5219","consentHoverDesc":"\u5904\u7406\u4e2a\u4eba\u4fe1\u606f\u5e94\u5f53\u9075\u5b88\u77e5\u60c5\u540c\u610f\u539f\u5219\uff0c\u786e\u4fdd\u7528\u6237\u77e5\u6653\u5e76\u540c\u610f\u4e2a\u4eba\u4fe1\u606f\u5904\u7406\u89c4\u5219","storagePrinciple":"\u5b58\u50a8\u9650\u5236","storageDesc":"\u5e94\u6309\u7ea6\u5b9a\u7684\u76ee\u7684\u6216\u7528\u9014\u5b58\u50a8\u6570\u636e\uff0c\u5305\u62ec\u5b58\u50a8\u6570\u636e\u4e0d\u5f97\u8d85\u51fa\u6700\u521d\u7533\u8bf7\u65f6\u6240\u8bf4\u660e\u7684\u5b58\u50a8\u65f6\u9650\u3001\u5b58\u50a8\u4f4d\u7f6e\u7b49","storageHoverDesc":"\u5e94\u6309\u7ea6\u5b9a\u7684\u76ee\u7684\u6216\u7528\u9014\u5b58\u50a8\u6570\u636e\uff0c\u5305\u62ec\u5b58\u50a8\u6570\u636e\u4e0d\u5f97\u8d85\u51fa\u6700\u521d\u7533\u8bf7\u65f6\u6240\u8bf4\u660e\u7684\u5b58\u50a8\u65f6\u9650\u3001\u5b58\u50a8\u4f4d\u7f6e\u7b49","securityPrinciple":"\u5b89\u5168\u4fdd\u969c","securityDesc":"\u9075\u5b88\u516c\u53f8\u5b89\u5168\u7ea2\u7ebf\u7b49\u76f8\u5173\u5b89\u5168\u8981\u6c42\uff0c\u5bf9\u6570\u636e\u7684\u6574\u4e2a\u751f\u547d\u5468\u671f\u63d0\u4f9b\u5408\u7406\u5fc5\u8981\u7684\u4fdd\u62a4\u673a\u5236","securityHoverDesc":"\u9075\u5b88\u516c\u53f8\u5b89\u5168\u7ea2\u7ebf\u7b49\u76f8\u5173\u5b89\u5168\u8981\u6c42\uff0c\u5bf9\u6570\u636e\u7684\u6574\u4e2a\u751f\u547d\u5468\u671f\u63d0\u4f9b\u5408\u7406\u5fc5\u8981\u7684\u4fdd\u62a4\u673a\u5236","accountabilityPrinciple":"\u8d23\u4efb\u6e05\u6670\u53ef\u8ffd\u6eaf","accountabilityDesc":"\u660e\u786e\u5404\u65b9\u5728\u6570\u636e\u5904\u7406\u6d3b\u52a8\u8fc7\u7a0b\u4e2d\u7684\u8d23\u4efb\uff0c\u5e76\u91c7\u7528\u53ef\u884c\u7684\u6280\u672f\u624b\u6bb5\u5bf9\u6570\u636e\u5904\u7406\u8fc7\u7a0b\u8fdb\u884c\u8bb0\u5f55\u4ee5\u4fbf\u4e8e\u8ffd\u6eaf","accountabilityHoverDesc":"\u660e\u786e\u5404\u65b9\u5728\u6570\u636e\u5904\u7406\u6d3b\u52a8\u8fc7\u7a0b\u4e2d\u7684\u8d23\u4efb\uff0c\u5e76\u91c7\u7528\u53ef\u884c\u7684\u6280\u672f\u624b\u6bb5\u5bf9\u6570\u636e\u5904\u7406\u8fc7\u7a0b\u8fdb\u884c\u8bb0\u5f55\u4ee5\u4fbf\u4e8e\u8ffd\u6eaf","managementProcessTitle":"\u6570\u636e\u5b89\u5168\u7ba1\u7406\u6d41\u7a0b","step1Title":"\u4e2a\u4eba\u4fe1\u606f\u91c7\u96c6\u9636\u6bb5","step1Desc":"\u4e2a\u4eba\u4fe1\u606f\u91c7\u96c6\u9636\u6bb5\uff0c\u9075\u5faa\u77e5\u60c5\u540c\u610f\u548c\u6700\u5c0f\u5fc5\u8981\u539f\u5219\uff0c\u660e\u786e\u91c7\u96c6\u76ee\u7684\u5e76\u83b7\u5f97\u7528\u6237\u6388\u6743","step2Title":"\u6570\u636e\u5206\u7c7b\u5206\u7ea7","step2Desc":"\u5bf9\u6570\u636e\u8fdb\u884c\u5206\u7ea7\u5206\u7c7b\u7ba1\u7406\uff0c\u7279\u522b\u662f\u5bf9\u7528\u6237\u4e2a\u4eba\u4fe1\u606f\u7b49\u654f\u611f\u6570\u636e\u8fdb\u884c\u91cd\u70b9\u4fdd\u62a4","step3Title":"\u6570\u636e\u5b58\u50a8","step3Desc":"\u5728\u6570\u636e\u5b58\u50a8\u73af\u8282\uff0c\u91c7\u7528\u52a0\u5bc6\u5b58\u50a8\u3001\u5efa\u7acb\u5fc5\u8981\u7684\u6570\u636e\u5bb9\u707e\u5907\u4efd\u4e0e\u6062\u590d\u5e76\u786e\u4fdd\u5b58\u50a8\u73af\u5883\u5b89\u5168","step4Title":"\u6570\u636e\u8bbf\u95ee\u63a7\u5236","step4Desc":"\u5728\u6570\u636e\u4f7f\u7528\u65f6\uff0c\u5b9e\u65bd\u8bbf\u95ee\u63a7\u5236\u5e76\u8fdb\u884c\u5b89\u5168\u76d1\u63a7","step5Title":"\u6570\u636e\u4f20\u8f93","step5Desc":"\u6570\u636e\u4f20\u8f93\u8fc7\u7a0b\u4e2d\uff0c\u4f7f\u7528\u5b89\u5168\u534f\u8bae\u6216\u8005\u5b89\u5168\u4f20\u8f93\u901a\u9053\u8fdb\u884c\u4f20\u8f93","step6Title":"\u6570\u636e\u9500\u6bc1","step6Desc":"\u6570\u636e\u9500\u6bc1\u9636\u6bb5\uff0c\u5efa\u7acb\u5ba1\u6279\u6d41\u7a0b\uff0c\u91c7\u7528\u5b89\u5168\u9500\u6bc1\u6280\u672f\u5e76\u4fdd\u7559\u64cd\u4f5c\u8bb0\u5f55","crossBorderManagement":"\u6570\u636e\u8de8\u5883\u7ba1\u7406","crossBorderDesc":"\u6d89\u53ca\u6570\u636e\u8de8\u5883\u65f6\uff0c \u6211\u4eec\u4f1a\u63d0\u524d\u8fdb\u884c\u6570\u636e\u5b89\u5168\u548c\u9690\u79c1\u4fdd\u62a4\u5f71\u54cd\u6027\u8bc4\u4f30\u5e76\u91c7\u53d6\u76f8\u5e94\u7684\u5b89\u5168\u63aa\u65bd\uff0c\u786e\u4fdd\u6570\u636e\u8de8\u5883\u5408\u6cd5\u5408\u89c4\u5e76\u5f97\u5230\u4fdd\u62a4\uff0c\u5e76\u786e\u4fdd\u9075\u5b88\u5f53\u5730\u6cd5\u89c4\u548c\u76d1\u7ba1\u90e8\u95e8\u7684\u8981\u6c42\u8fdb\u884c\u6570\u636e\u5904\u7406\u3002","externalDisclosure":"\u5bf9\u5916\u6570\u636e\u62ab\u9732\u7ba1\u7406","externalDisclosureDesc":"\u9488\u5bf9\u6570\u636e\u5bf9\u5916\u62ab\u9732\uff0c\u5236\u5b9a\u4e86\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5bf9\u5916\u6570\u636e\u62ab\u9732\u7ec6\u5219\u300b\uff0c\u901a\u8fc7\\"\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5bf9\u5916\u6570\u636e\u62ab\u9732\u5e73\u53f0\\"\u8fdb\u884c\u6d41\u7a0b\u7ba1\u7406\u3002","partnerManagement":"\u5408\u4f5c\u65b9\u6570\u636e\u7ba1\u7406","partnerManagementDesc":"\u5408\u4f5c\u524d\u5ba1\u6838\u6570\u636e\u5b89\u5168\u8d44\u8d28\u548c\u7ba1\u7406\u80fd\u529b\uff0c\u7b7e\u7f72\u5305\u62ec\u6570\u636e\u5b89\u5168\u7ba1\u7406\u548c\u5ba1\u8ba1\u8981\u6c42\u7684\u534f\u8bae\uff0c\u5bf9\u91cd\u8981\u5408\u