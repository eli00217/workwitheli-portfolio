dSupportTitle":"\u652f\u6301\u57fa\u790e\u6c11\u751f","livelihoodSupportDesc":"\u900f\u904e\u5411\u9109\u6751\u5f31\u52e2\u7fa4\u9ad4\u63d0\u4f9b\u91ab\u7642\u5065\u5eb7\u65b9\u9762\u7684\u63f4\u52a9\u4f86\u652f\u6301\u57fa\u790e\u6c11\u751f","ruralPracticeTitle":"\u9109\u6751\u5e6b\u6276\u5be6\u8e10","ruralPractice1Title":"\u7530\u9593\u76f4\u64ad\u9593","ruralPractice1Desc":"2025 \u8ca1\u5e74\uff0c\u6dd8\u5bf6\u5929\u8c93\u5e73\u53f0\u4f9d\u8a17\u300c\u9109\u6751\u7279\u6d3e\u54e1\u300d 2025 \u8ca1\u5e74\uff0c\u6dd8\u5bf6\u5929\u8c93\u5e73\u53f0\u4f9d\u8a17\u300c\u9109\u6751\u7279\u6d3e\u54e1\u300d \u7e23\u57df\u99d0\u9ede\u6a5f\u5236\uff0c\u7d50\u5408\u7576\u5730\u7279\u8272\u8fb2\u7522\u54c1\u7684\u5b63\u7bc0\u6027\u7279\u9ede\uff0c\u5168\u5e74\u6301\u7e8c\u958b\u5c55\u516c\u76ca\u52a9\u8fb2\u76f4\u64ad\u3002\u5e73\u53f0\u900f\u904e\u7d44\u7e54\u512a\u8cea\u4e3b\u64ad\u6df1\u5165\u539f\u7522\u5730\uff0c\u6253\u9020\u300c\u7530\u9593\u76f4\u64ad\u9593\u300d\uff0c\u5728\u4fc3\u9032\u8fb2\u7522\u54c1\u92b7\u552e\u7684\u540c\u6642\uff0c\u63d0\u5347\u7e23\u57df\u5546\u5bb6\u7684\u96fb\u5546\u71df\u904b\u80fd\u529b\u548c\u6578\u5b57\u5316\u6c34\u5e73\u3002","ruralPractice2Title":"\u76d2\u99ac\u6751","ruralPractice2Desc":"\u76d2\u99ac\u6d1e\u5bdf\u6d88\u8cbb\u8da8\u52e2\uff0c\u5c07\u5e02\u5834\u9700\u6c42\u53ca\u6642\u56de\u994b\u7d66\u751f\u7522\u7aef\uff0c\u69cb\u5efa\u4e86\u300c\u76d2\u99ac\u6751\u300d\u4ee5\u9700\u5b9a\u7522\u7684\u8a02\u55ae\u8fb2\u696d\u6a21\u5f0f\uff0c\u63a8\u52d5\u7576\u5730\u8fb2\u7522\u54c1\u6a19\u6e96\u5316\u3001\u7cbe\u7d30\u5316\u3001 \u54c1\u724c\u5316\u767c\u5c55\u9032\u7a0b\u3002\u622a\u81f3 2025\u5e743\u670831\u65e5\uff0c \u76d2\u99ac\u5df2\u5728\u5168\u570b 29 \u500b\u7701(\u81ea\u6cbb\u5340\u3001\u76f4\u8f44\u5e02) \u5efa\u7acb 173 \u500b\u76d2\u99ac\u6751\uff0c\u4e26\u4e14\u4e5f\u62d3\u5c55\u300c\u76d2\u99ac\u6751\u300d \u6a21\u5f0f\u81f3\u6d77\u5916\u3002","ruralPractice3Title":"\u9109\u6751\u4eba\u624d\u966a\u8dd1\u8a08\u5283","ruralPractice3Desc":"\u6211\u5011\u651c\u624b\u751f\u614b\u5925\u4f34\uff0c\u9078\u64c7\u7d93\u9a57\u8c50\u5bcc\u7684\u96fb\u5546\u5c08\u5bb6\u4f5c\u70ba\u9867\u554f\uff0c\u900f\u904e\u7dda\u4e0b\u99d0\u9ede\u65b9\u5f0f\u5c0d\u300c\u9109\u6751\u7279\u6d3e\u54e1\u300d\u6240\u5728\u7e23\u57df\u7684\u5546\u5bb6\u9032\u884c\u70ba\u671f\u534a\u5e74\u7684\u652f\u6301\uff0c\u4fc3\u9032\u7576\u5730\u6578\u5b57\u4eba\u624d\u57f9\u990a\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u6211\u5011\u7d2f\u8a08\u572817\u500b\u7e23\u958b\u5c55\u966a\u8dd1\u8a08\u5283\u3002","ruralPractice4Title":"\u5c11\u5e74\u96f2\u52a9\u5b78\u8a08\u5283","ruralPractice4Desc":"\u300c\u5c11\u5e74\u96f2\u52a9\u5b78\u8a08\u5283\u300d\u70ba\u9109\u6751\u5b78\u6821\u6350\u5efa \u300c\u96f2\u8a08\u7b97\u6a5f\u6559\u5ba4\u300d\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u7d2f\u8a08\u6350\u5efa300\u9593\u300c\u96f2\u8a08\u7b97\u6a5f\u6559\u5ba4\u300d\uff0c\u8b93\u8d85\u904e28\u842c\u5e2b\u751f\u64c1\u6709\u500b\u4eba\u96f2\u96fb\u8166\u5e33\u865f\u3002\u570d\u7e5e AI \u8ce6\u80fd\u9109\u6751\u6559\u80b2\uff0c\u6211\u5011\u958b\u5c55\u4e86\u4e00\u7cfb\u5217\u6d3b\u52d5\uff0c\u5305\u62ec\u7d44\u7e54\u8001\u5e2b\u5b78\u7fd2\u5728\u6559\u5b78\u904e\u7a0b\u4e2d\u5982\u4f55\u4f7f\u7528AI\uff0c\u5f15\u5c0e\u5b78\u751f\u9ad4\u9a57\u548c\u61c9\u7528AI \u5927\u6a21\u578b\u80fd\u529b\u7b49\u3002","ruralPractice5Title":"\u300c\u5c0f\u9e7f\u71c8\u300d\u5152\u7ae5\u91cd\u75be\u6551\u52a9\u9805\u76ee","ruralPractice5Desc":"\u300c\u5c0f\u9e7f\u71c8\u300d\u5152\u7ae5\u91cd\u75be\u6551\u52a9\u516c\u76ca\u9805\u76ee\u7531\u963f\u91cc\u5df4\u5df4\u516c\u76ca\u3001\u963f\u91cc\u5065\u5eb7\u516c\u76ca\u806f\u5408\u6a5f\u69cb\u5171\u540c\u767c\u8d77\uff0c \u900f\u904e\u300c\u4e3b\u52d5\u6551\u52a9\u300d\u7684\u65b9\u5f0f\uff0c\u70ba\u91cd\u75be\u5152\u7ae5\u63d0\u4f9b\u91ab\u7642\u63f4\u52a9\u53ca\u8a3a\u7642\u8cbb\u7528\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u300c\u5c0f\u9e7f\u71c8\u300d\u9805\u76ee\u7d2f\u8a08\u6295\u51654,859 \u842c\u5143\uff0c\u63f4\u52a9\u7b26\u5408\u689d\u4ef6\u7684\u60a3\u5152 2,300 \u4eba\u3002","emergencyReliefTitle":"\u61c9\u6025\u6551\u707d","emergencyIntroText":"\u5728\u707d\u60c5\u9762\u524d\uff0c\u963f\u91cc\u5df4\u5df4\u5145\u5206\u8abf\u52d5\u5404\u696d\u52d9\u7684\u80fd\u529b\u548c\u8cc7\u6e90\uff0c\u591a\u65b9\u4f4d\u97ff\u61c9\u61c9\u6025\u6551\u707d\u5de5\u4f5c\u30022025 \u8ca1\u5e74\uff0c\u6211\u5011\u8207\u4e2d\u570b\u61c9\u6025\u7ba1\u7406\u90e8\u6551\u707d\u53f8\u9054\u6210\u5408\u4f5c\u5354\u8b70\uff0c\u81f4\u529b\u65bc\u70ba\u5168\u9762\u63d0\u5347\u793e\u6703\u61c9\u6025\u7269\u8cc7\u7d9c\u5408\u4fdd\u969c\u80fd\u529b\u505a\u51fa\u8ca2\u737b\u3002\u6b64\u5916\uff0c\u83dc\u9ce5\u9084\u81ea\u4e3b\u7814\u767c\u570b\u5167\u9996\u500b\u300c\u61c9\u6025\u7269\u8cc7\u8ffd\u6eaf\u7ba1\u7406\u5e73\u53f0\u300d\uff0c\u70ba\u7d71\u8a08\u3001\u63a1\u8cfc\u3001\u904b\u8f38\u3001\u767c\u653e\u6551\u707d\u7269\u8cc7\u7b49\u8907\u96dc\u7684\u6d41\u7a0b\u7ba1\u7406\u74b0\u7bc0\u5be6\u73fe\u63d0\u6548\u3002","reliefCase1Title":"\u97ff\u61c9\u897f\u85cf\u9707\u707d","reliefCase1Desc":"2025\u5e741\u6708\uff0c\u897f\u85cf\u65e5\u5580\u5247\u5e02\u5b9a\u65e5\u7e23\u767c\u751f 6.8 \u7d1a\u5730\u9707\uff0c\u6211\u5011\u555f\u52d5\u61c9\u6025\u7269\u8cc7\u653f\u793e\u5354\u540c\u4fdd\u969c\u6a5f\u5236\uff0c\u7b2c\u4e00\u6642\u9593\u8abf\u914d\u8cc7\u6e90\uff0c\u5148\u5f8c\u7d44\u7e54\u4e09\u500b\u6279\u6b21\u7684\u7269\u8cc7\u99b3\u63f4\u707d\u5340\u3002","reliefCase2Title":"\u61c9\u5c0d\u6d2a\u6f87\u707d\u5bb3","reliefCase2Desc":"2025\u8ca1\u5e74\uff0c\u6c34\u707d\u671f\u9593\uff0c\u963f\u91cc\u5df4\u5df4\u5c0d\u5305\u62ec\u6e56\u5357\u7701\u8cc7\u8208\u5e02\u3001\u8cb4\u5dde\u7701\u93ae\u9060\u7e23\u3001\u6d77\u5357\u7701\u6587\u660c\u5e02\u7b49\u5728\u5167\u7684 9 \u7701 17 \u5340\u7e23\u5e02\u958b\u5c55\u6551\u63f4\u3002","reliefCase3Title":"\u53c3\u8207\u6551\u52a9\u8d8a\u5357\u707d\u60c5","reliefCase3Desc":"2024\u5e749\u6708\uff0c\u8d85\u5f37\u98b1\u98a8\u300c\u6469\u7faf\u300d\u8457\u9678\u8d8a\u5357\u671f\u9593\uff0cLazada\u900f\u904e\u6350\u8d08\u8cc7\u91d1\u548c\u7269\u8cc7\u3001\u7d44\u7e54\u54e1\u5de5\u6350\u52a9\u3001\u5354\u8abf\u7269\u6d41\u8cc7\u6e90\u53c3\u8207\u61c9\u6025\u6551\u707d\u3002","techForSocialTitle":"\u79d1\u6280\u52a9\u529b\u89e3\u6c7a\u793e\u6703\u6311\u6230","techIntroText":"\u4f5c\u70ba\u4e00\u5bb6\u79d1\u6280\u516c\u53f8\uff0c\u6211\u5011\u9664\u4e86\u5c07\u79d1\u6280\u8996\u70ba\u63a8\u52d5\u81ea\u8eab\u696d\u52d9\u767c\u5c55\u7684\u5f15\u64ce\u5916\uff0c\u4e5f\u5728\u7a4d\u6975\u63a2\u7d22\u79d1\u6280\u6240\u80fd\u5e36\u4f86\u7684\u793e\u6703\u50f9\u503c\u3002","techSolution1Title":"AI \u8f14\u52a9\u764c\u75c7\u7be9\u67e5","techSolution1Desc":"2025 \u8ca1\u5e74\uff0c\u6211\u5011\u5c07 AI \u8ce6\u80fd CT \u5f71\u50cf\u8b58\u5225\u80f0\u817a\u764c\u7684\u80fd\u529b\u64f4\u5c55\u61c9\u7528\u65bc\u591a\u7a2e\u764c\u75c7\u7684\u7be9\u67e5\u74b0\u7bc0\uff0c\u4e26\u900f\u904e\u8207\u91ab\u9662\u5408\u4f5c\uff0c\u4ee5\u516c\u76ca\u7684\u65b9\u5f0f\u63a8\u52d5\u300c\u5e73\u6383 CT+AI\u300d\u591a\u764c\u7be9\u67e5\u6280\u8853\u5728\u5be6\u8e10\u4e2d\u8a66\u9ede\u843d\u5730\u3002","techSolution2Title":"\u53c3\u8207\u7121\u4eba\u5340\u6551\u63f4","techSolution2Desc":"\u9ad8\u5fb7\u5730\u5716\u7814\u767c\u63a8\u51fa\u300c\u885b\u661f\u7121\u7db2\u5c0e\u822a\u300d\u529f\u80fd\uff0c\u6709\u6548\u89e3\u6c7a\u7528\u6236\u5728\u7121\u7db2\u7d61\u74b0\u5883\u4e0b\u7684\u65b9\u5411\u8ff7\u5931\u554f\u984c\uff1b\u540c\u6642\u4e0a\u7dda\u7684\u300c\u885b\u661f\u6c42\u6551\u300d\u529f\u80fd\uff0c\u900f\u904e\u885b\u661f\u53ef\u5be6\u73fe\u7dca\u6025\u901a\u8a0a\u3002\u540c\u6642\uff0c\u9ad8\u5fb7\u5730\u5716\u63a8\u51fa\u4e00\u5957\u5b8c\u6574\u7684\u6a5f\u5236\u8207\u6d41\u7a0b\uff0c\u5be6\u73fe\u300c\u7121\u4eba\u5340\u6709\u9ad8\u5fb7\u300d\u3002","techSolution3Title":"\u516b\u89c0\u6c23\u8c61\u5927\u6a21\u578b","techSolution3Desc":"\u61c9\u7528 AI \u6280\u8853\u7684\u6c23\u8c61\u9810\u6e2c\u80fd\u5920\u52a9\u529b\u96fb\u529b\u7cfb\u7d71\u66f4\u52a0\u7cbe\u51c6\u5339\u914d\u96fb\u529b\u9700\u6c42\u8207\u4f9b\u7d66\u30022025 \u8ca1\u5e74\uff0c\u6211\u5011\u6b63\u5f0f\u767c\u4f48\u516b\u89c0\u6c23\u8c61\u5927\u6a21\u578b\u4e26\u5df2\u7387\u5148\u5728\u53ef\u518d\u751f\u80fd\u6e90\u5360\u6bd4\u9ad8\u7684\u65b0\u578b\u96fb\u529b\u7cfb\u7d71\u843d\u5730\u3002","employmentSupportTitle":"\u4fc3\u9032\u5275\u696d\u5c31\u696d","employmentIntroText":"\u6211\u5011\u548c\u751f\u614b\u5408\u4f5c\u5925\u4f34\u6210\u529f\u958b\u5c55\u696d\u52d9\u7684\u540c\u6642\uff0c\u4e5f\u5e36\u4f86\u5275\u696d\u5c31\u696d\u6a5f\u6703\u3002\u9019\u4e9b\u6a5f\u6703\u540c\u6642\u5448\u73fe\u5305\u5bb9\u3001\u9ad8\u8cea\u91cf\u7b49\u7279\u9ede\u3002","inclusiveEmploymentTitle":"\u5305\u5bb9\u7684\u5275\u696d\u5c31\u696d","inclusiveEmploymentDesc":"\u6578\u5b57\u6280\u8853\u61c9\u7528\u7684\u4f4e\u9580\u6abb\u7279\u6027\uff0c\u5927\u5e45\u63d0\u5347\u5c31\u696d\u5728\u6027\u5225\u3001\u5b78\u6b77\u3001\u5340\u57df\u65b9\u9762\u7684\u5305\u5bb9\u6027\u3002\u6211\u5011\u7684\u5546\u696d\u6a21\u5f0f\u964d\u4f4e\u5973\u6027\u3001\u6b98\u969c\u4eba\u58eb\u3001\u6b20\u767c\u9054\u5730\u5340\u4eba\u7fa4\u7b49\u7fa4\u9ad4\u88cf\u7684\u5275\u696d\u5c31\u696d\u58c1\u58d8\uff0c\u6700\u7d42\u5be6\u73fe\u66f4\u52a0\u5e73\u7b49\u3001\u5305\u5bb9\u7684\u5275\u696d\u5c31\u696d\u74b0\u5883\u3002","silentRiderProgramTitle":"\u7121\u8072\u9a0e\u624b","silentRiderProgramDesc":"\u6dd8\u5bf6\u9583\u8cfc\u300c\u7121\u8072\u9a0e\u624b\u95dc\u61f7\u63d0\u5347\u9805\u76ee\u300d\uff0c\u70ba\u7121\u8072\u9a0e\u624b\u63d0\u4f9b\u667a\u80fd\u5916\u547c\u3001\u96fb\u5b50\u6e9d\u901a\u5361\u3001\u8a9e\u97f3\u8f49\u6587\u5b57\u7b49\u5e73\u53f0\u529f\u80fd\uff0c\u900f\u904e\u9810\u7f6e\u7684\u6e9d\u901a\u6a21\u677f\u63d0\u5347\u6e9d\u901a\u6548\u7387\uff0c\u4e26\u63d0\u524d\u5411\u5546\u5bb6\u548c\u6d88\u8cbb\u8005\u505a\u597d\u9810\u671f\u7ba1\u7406\u548c24\u5c0f\u6642\u4eba\u5de5\u5ba2\u670d\u7684\u512a\u5148\u8655\u7406\u3002","disabilityEmploymentTitle":"\u842c\u4eba\u6b98\u969c\u4eba\u58eb\u5546\u5bb6\u5275\u696d\u5c31\u696d\u52a9\u529b\u8a08\u5283","disabilityEmploymentDesc":"\u300c\u842c\u4eba\u6b98\u969c\u4eba\u58eb\u5546\u5bb6\u5275\u696d\u5c31\u696d\u52a9\u529b\u8a08\u5283\u300d\u81f4\u529b\u65bc\u70ba\u5546\u5bb6\u4e2d\u7684\u6b98\u969c\u4eba\u58eb\u63d0\u4f9b\u514d\u8cbb\u7684\u57f9\u8a13\u548c\u7d93\u71df\u8a3a\u65b7\u670d\u52d9\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u5171\u7d2f\u8a08\u670d\u52d9 4,700 \u4f4d\u6b98\u969c\u4eba\u58eb\u5546\u5bb6\u3002","qualityEmploymentTitle":"\u9ad8\u8cea\u91cf\u7684\u5275\u696d\u5c31\u696d","cloudClassTitle":"\u6dd8\u5929\u96f2\u8ab2\u5802","cloudClassDesc":"\u300c\u96f2\u8ab2\u5802\u300d\u6301\u7e8c\u70ba\u4f01\u696d\u6578\u5b57\u5316\u4eba\u624d\u57f9\u990a\u63d0\u4f9b\u652f\u6301\u30022025 \u8ca1\u5e74\uff0c\u900f\u904e\u300c\u96f2\u8ab2\u5802\u300d\u5b78\u7fd2\u7684\u4eba\u6578\u70ba\u7d04 402 \u842c\uff0c\u5b78\u7fd2\u7e3d\u6642\u9577\u7d042,339 \u842c\u5c0f\u6642\u3002","orangeClassTitle":"\u6a59\u9ede\u540c\u5b78","orangeClassDesc":"\u300c\u6a59\u9ede\u540c\u5b78\u300d\u662f\u963f\u91cc\u5df4\u5df4\u805a\u96c6\u512a\u8cea\u6559\u80b2\u8cc7\u6e90\u6253\u9020\u300c\u5b78\u3001\u8a13\u3001 \u8cfd\u3001\u8003\u3001\u8058\u300d\u4e00\u9ad4\u5316\u7684\u666e\u60e0\u6559\u80b2\u9805\u76ee\u3002\u622a\u81f32025\u5e743\u670831\u65e5\uff0c\u7d2f\u8a08\u53c3\u8207\u8a72\u9805\u76ee\u5b78\u7fd2\u7684\u4eba\u6578\u8d85\u904e 31 \u842c\u3002","flexibleEmploymentTitle":"\u5f48\u6027\u5c31\u696d\u7684\u5b89\u5168\u548c\u4fdd\u969c","flexibleEmploymentDesc":"\u9a0e\u624b\u662f\u793e\u6703\u5f48\u6027\u5c31\u696d\u7684\u91cd\u8981\u7d44\u6210\u4e4b\u4e00\u3002\u6dd8\u5bf6\u9583\u8cfc\u5e73\u53f0\u4e0a\u7684\u6d3b\u8e8d\u9a0e\u624b\u5927\u90e8\u5206\u70ba\u5f48\u6027\u5c31\u696d\u7684\u300c\u773e\u5305\u9a0e\u624b\u300d\u3002\u6211\u5011\u5f9e\u8077\u696d\u6b0a\u76ca\u3001\u8077\u696d\u5b89\u5168\u3001\u8077\u696d\u95dc\u61f7\u8207\u767c\u5c55\u7b49\u591a\u500b\u7dad\u5ea6\u63d0\u5347\u9a0e\u624b\u5c31\u696d\u4fdd\u969c\u3002","occupationalRightsTitle":"\u8077\u696d\u6b0a\u76ca","occupationalRightsDesc":"\u6dd8\u5bf6\u9583\u8cfc\u8981\u6c42\u9a0e\u624b\u7684\u6536\u5165\u4e0d\u5f97\u4f4e\u65bc\u7576\u5730\u6700\u4f4e\u5de5\u8cc7\u6a19\u6e96\uff0c\u5728\u591a\u500b\u57ce\u5e02\u9010\u6b65\u63a8\u9032\u300c\u8077\u696d\u50b7\u5bb3\u4fdd\u969c\u548c\u5546\u696d\u4fdd\u96aa\u300d\u96d9\u4fdd\u969c\uff0c\u4e26\u5728\u90e8\u5206\u8a66\u9ede\u57ce\u5e02\u63a8\u52d5\u9a0e\u624b\u7e73\u7d0d\u793e\u4fdd\u3002","occupationalSafetyTitle":"\u8077\u696d\u5b89\u5168","occupationalSafetyDesc":"\u6dd8\u5bf6\u9583\u8cfc\u900f\u904e\u5236\u5b9a\u5b89\u5168\u6a19\u6e96\u3001\u5efa\u7acb\u57f9\u8a13\u9ad4\u7cfb\u3001\u61c9\u7528\u667a\u80fd\u9810\u8b66\u8207\u9632\u8b77\u8a2d\u5099\u7b49\u8209\u63aa\uff0c\u5168\u65b9\u4f4d\u5b88\u8b77\u9a0e\u624b\u5b89\u5168\u3002","careerDevelopmentTitle":"\u8077\u696d\u95dc\u61f7\u8207\u767c\u5c55","careerDevelopmentDesc":"\u6dd8\u5bf6\u9583\u8cfc\u69cb\u5efa\u9a0e\u624b\u5168\u9762\u652f\u6301\u9ad4\u7cfb\uff1a\u958b\u901a\u300c7\xd724\u5c0f\u6642\u300d\u5c08\u5c6c\u5ba2\u670d\uff0c\u8a2d\u7acb\u300c\u6a59\u610f\u8a08\u5283\u300d\u3001\u300c\u6a59\u57fa\u91d1\u300d\u53ca\u6eab\u6696\u9a5b\u7ad9\u63d0\u4f9b\u95dc\u611b\uff0c\u66f4\u4ee5\u69ae\u8b7d\u52f3\u7ae0\u53ca\u7533\u5831\u5168\u570b\u52de\u6a21\u69ae\u8b7d\uff0c\u63d0\u5347\u8077\u696d\u6b78\u5c6c\u8207\u793e\u6703\u8a8d\u53ef\u3002","publicWelfareTitle":"\u4eba\u4eba\u53c3\u8207\u7684\u516c\u76ca\u7406\u5ff5","encourageParticipationTitle":"\u5ba3\u5c0e\u4eba\u4eba\u53c3\u8207","encourageParticipationDesc":"\u8e10\u884c\u516c\u76ca\u548c\u793e\u6703\u8cac\u4efb\u5f9e\u4f86\u90fd\u4e0d\u662f\u4e00\u500b\u4eba\u548c\u4e00\u5bb6\u4f01\u696d\u7684\u6295\u5165\uff0c\u66f4\u6709\u610f\u7fa9\u7684\u662f\u8981\u63a8\u52d5\u5584\u610f\u5728\u4eba\u8207\u4eba\u4e4b\u9593\u50b3\u905e\u3002\u4e00\u76f4\u4ee5\u4f86\uff0c\u6211\u5011\u529b\u6c42\u9ede\u71c3\u54e1\u5de5\u7684\u516c\u76ca\u71b1\u60c5\uff0c\u651c\u624b\u5408\u4f5c\u5925\u4f34\uff0c\u5168\u529b\u964d\u4f4e\u8e10\u884c\u516c\u76ca\u7684\u9580\u6abb\uff0c\u5be6\u73fe\u300c\u4eba\u4eba\u53ef\u53c3\u8207\u300d\u30022026\u8ca1\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u5411\u963f\u91cc\u5df4\u5df4\u767c\u8d77\u7684\u516c\u76ca\u57fa\u91d1\u6703\u6350\u8d08\u7d042.8\u5104\u5143\u3002","threeHoursProgramTitle":"\u4eba\u4eba3\u5c0f\u6642","threeHoursProgramDesc":"\u6211\u5011\u65bc2015\u5e749\u670810\u65e5\u767c\u8d77\u300c\u4eba\u4eba3 \u5c0f\u6642\u300d\u5021\u8b70\uff0c\u9f13\u52f5\u6bcf\u4e00\u4f4d\u54e1\u5de5\u5c07\u5c0d\u516c\u76ca\u7684\u71b1\u5ff1\u8f49\u5316\u70ba\u5207\u5be6\u884c\u52d5\u30022026\u8ca1\u5e74\uff0c\u6b63\u5f0f\u54e1\u5de5\u7684\u5fd7\u9858\u6642\u5408\u8a08\u9054\u5230253,584\u5c0f\u6642\u3002","goodsForGoodProgramTitle":"\u516c\u76ca\u5bf6\u8c9d","goodsForGoodProgramDesc":"\u6211\u5011\u767c\u8d77\u300c\u516c\u76ca\u5bf6\u8c9d\u300d\u9805\u76ee\u3002\u6d88\u8cbb\u8005\u8cfc\u8cb7\u6a19\u8b58\u300c\u516c\u76ca\u5bf6\u8c9d\u300d \u7684\u5546\u54c1\u5f8c\uff0c\u5e73\u53f0\u6309\u7167\u5546\u5bb6\u8a2d\u7f6e\u7684\u91d1\u984d\u6350\u8d08\u81f3\u76f8\u61c9\u7684\u516c\u76ca\u7d44\u7e54\u6216\u9805\u76ee\u30022026\u8ca1\u5e74\uff0c\u300c\u516c\u76ca\u5bf6\u8c9d\u300d\u9805\u76ee\u5438\u5f15\u8d85\u904e156\u842c\u5546\u5bb6\u548c\u8d85\u904e4.3\u5104\u7528\u6236\u53c3\u8207\u3002","consumerExperienceTitle":"\u5275\u9020\u826f\u597d\u7684\u6d88\u8cbb\u9ad4\u9a57","digitalLifeTitle":"\u71df\u9020\u5305\u5bb9\u5065\u5eb7\u7684\u6578\u5b57\u751f\u6d3b","diversityEquityInclusion":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d","talentAttractionRetention":"\u4eba\u624d\u7684\u5438\u5f15\u548c\u4fdd\u7559","talentDevelopmentOpportunities":"\u8c50\u5bcc\u7684\u4eba\u624d\u767c\u5c55\u6a5f\u6703","employeeHealthVitality":"\u54e1\u5de5\u5065\u5eb7\u8207\u6d3b\u529b","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"\u54e1\u5de5\u70ba\u5973\u6027","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"\u798f\u5e03\u65af\u5168\u7403\u6700\u4f73\u50f1\u4e3b","familyCareLeaveTitle":"\u8d856\u842c","familyCareLeaveDesc":"\u95dc\u611b\u5bb6\u4eba\uff0c\u54e1\u5de5\u5229\u7528\u966a\u4f34\u5047\u4eab\u53d7\u8207\u5bb6\u4eba\u7684\u5bf6\u8cb4\u6642\u5149","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"\u963f\u91cc\u5df4\u5df4\u7684\u591a\u500b\u5712\u5340\u3001\u6578\u64da\u4e2d\u5fc3\u548c\u7269\u6d41\u5834\u6240\u7372\u5f97\u4e86\u8a8d\u8b49","firstAidTrainingTitle":"\u8d8514000\u540d","firstAidTrainingDesc":"\u963f\u91cc\u5df4\u5df4\u7d2f\u8a08\u57f9\u8a13\u6025\u6551\u4fe0","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"\u963f\u91cc\u5df4\u5df4\u8fa6\u516c\u74b0\u5883\u6eff\u610f\u5ea693.1%"}')},99594:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","bannerTitle":"Supporting Our People","bannerDescription":"Alibaba\'s most valuable treasure is our constantly developing talent pool. We hope that our employees can become their better selves. Therefore, we strive to provide every one of them with the opportunity to learn and grow in a diverse, equitable, and inclusive culture, where they can keep their passion and create value.","actionResults":"Progress","actionResultsTitle":"Progress","strategyPath":"Approaches","strategyPathTitle":"Approaches","strategyPathContent":"Our values are central to Alibaba\'s culture, guiding how we conduct business and manage talent. The Alibaba Group Code of Business Conduct serves as our framework to protect employee rights. Building on this, the Alibaba Group Employee Rights Code defines standards for human rights, safety, and DEI. We are committed to creating a safe, equitable workplace conducive to everyone\'s growth.","consumerExperienceTitle":"Creating Excellent Consumer Experience","digitalLifeTitle":"Fostering Inclusive and Healthy Digital Life","diversityEquityInclusion":"DEI","diversityEquityInclusionTitle":"DEI","diversityEquityInclusionDescription":"Alibaba\'s corporate culture champions DEI. Under the guidance of the Board\'s Sustainability Committee, we have established a Diversity, Equity, and Inclusion Working Group, which formulates policies and implements initiatives to integrate DEI into our core HR processes: selection, recruitment, development, and retention.","philosophyAndCultureTitle":"Management philosophy","practiceCasesTitle":"Practices","philosophyAndCultureDescription":"We have established a DEI Working Group under the guidance of the Sustainability Committee of the Board of Directors. This working group is responsible for formulating relevant policies and implementing specific management initiatives. We integrate this philosophy with our own principles, embedding it into our human resources practices of selecting, recruiting, developing, and retaining talent. We also organize diverse training activities.","complianceTitle":"Compliance","complianceDescription":"To safeguard the rights and interests of employees, we have established a robust compliance framework featuring regular training, compliance audits, and secure reporting channels.","meritBasedTitle":"Meritocracy","meritBasedDescription":"Our HR policies are oriented towards performance and merit, strictly prohibiting any bias based on legally protected personal characteristics, including but not limited to gender, age, race, ancestry, and religion.","respectInclusionTitle":"Respect and inclusion","respectInclusionDescription":"We encourage employees to voice their opinions freely and inspire one another so that they can unleash their full potential. To build a truly creative team, we bring together individuals with diverse backgrounds, perspectives, and skill sets.","diverseTalentPoolTitle":"A diverse talent pool","diverseTalentPoolDescription":"Alibaba acknowledges, embraces, and respects individual differences across diverse dimensions such as gender and race. In FY2026, women accounted for 34.8% of our staff.","equalWorkplaceTitle":"An equitable workplace","equalWorkplaceDescription":"We maintain zero tolerance for violence, harassment, discrimination, and bullying, ensuring safe reporting with dedicated grievance staff and digital speak-up channels.","openCommunicationTitle":"Communication, cooperation, and inclusion","openCommunicationDescription":"Our inclusive culture is continuously strengthened through open communication platforms and diverse employee engagement initiatives.","aliShipaiTitle":"Ali Shipai","aliShipaiDescription":"As of March 31, 2026, Ali Shipai, our employee-driven platform of interest communities, featured 35 formal clubs spanning sports like basketball, squash, and kendo; arts like photography, calligraphy, and painting; and personal growth activities like reading, English learning, and mindfulness.","womenNetworkingTitle":"Networking events for women","womenNetworkingDescription":"We host networking events for women, featuring accomplished female employees from diverse backgrounds to share their career experience and life wisdom. These events provide female employees with an open platform where they help one another.","culturalEventsTitle":"Cultural events","culturalEventsDescription":"We regularly host cultural events, such as homecomings and the Global Cultural Fair, inviting employees from around the world with diverse cultural backgrounds to interact and deepen mutual understanding.","employeeDevelopmentTitle":"Years-of-service recognition","employeeDevelopmentDescription":"At Alibaba, every work anniversary is a special milestone. Our unique culture likens tenure to aging wine, featuring \\"1-year Aromatic,\\" \\"3-year Mellow,\\" \\"5-year Mature,\\" and \\"10-year Fragrant\\" to track the growth journeys of employees and recognize their long-term contributions.","talentAttractionRetention":"Talent acquisition","talentAttractionRetentionTitle":"Talent acquisition","talentAttractionRetentionDescription":"We have established diverse, open channels to attract talent, and our success is always shared with employees. This is reflected in a compensation system that is both internally equitable and externally competitive, complemented by a continuously improved benefits program designed to foster an atmosphere where employees can enjoy both work and life.","recruitingTalentsTitle":"Recruitment","recruitingTalentsDescription":"To find and hire the right people, we have developed diverse recruitment channels and attach great importance to candidate experience as well as compliance management in the interview process.","socialRecruitmentTitle":"Diverse recruitment channels","socialRecruitmentDescription":"To meet our talent demand, we build open, diverse recruitment channels, including experienced hiring, campus hiring, and employee referrals. The AliStar Top Talent Program recruits and nurtures top young researchers worldwide. ","socialRecruitmentLink":"Join now","campusRecruitmentTitle":"Candidate experience","campusRecruitmentDescription":"To ensure an equal, transparent, and friendly candidate journey, we have standardized our recruitment process, provided interviewer training, and built a candidate feedback mechanism.","compensationSystemTitle":"Compensation and performance assessment","compensationSystemDescription":"We are committed to sharing the fruits of our development with our employees. There is a system to safeguard their legitimate rights and interests, ensuring that our compensation and incentive structure is both internally equitable and externally competitive.","compensationSystemContent":"All employees participate in annual performance assessments, the results of which determine their short-term and long-term incentives. We assess performance through diverse mechanisms, including management by objectives, dual assessment of business results and values, team-based appraisals, flexible periodic reviews, and development dialogues. A pay-for-performance system is in place to provide all employees with market-competitive compensation and benefits.","heartWarmingBenefitsTitle":"Thoughtful benefits","heartWarmingBenefitsDescription":"Alibaba offers thoughtful benefits to all employees. We fully respect and comply with jurisdiction- and industry-specific regulations on employee benefits. By tailoring benefit packages to local contexts, we provide support for our employees and their families, safeguarding their long-term well-being.","socialSecurityTitle":"Social security and housing provident fund","socialSecurityDescription":"Work-related injury insurance, unemployment insurance, basic medical insurance, basic pension insurance, maternity insurance, housing provident fund","statutoryLeaveTitle":"Statutory leave","statutoryLeaveDescription":"Annual leave, marriage leave, prenatal checkup leave, maternity leave, parental leave, lactation breaks, paternity leave","workLifeBalanceTitle":"Work-life balance","workLifeBalanceDescription":"Featured leave: family care leave, long service leave, travel leave, outing leave, and flexible work arrangements","featuredGiftsTitle":"Featured gifts","featuredGiftsDescription":"Gifts for work anniversaries, a Letter Home from Alibaba, Gifts for the International Women\'s Day, Gift packages for the Mid-autumn Day, meal allowances for lunch, dinner, and late-night snacks","employeeSupportTitle":"Employee support and benefits","employeeSupportDescription":"iHelp Dandelion Mutual Assistance Program, iHope Rainbow Program, iHome Property Purchase Program, supplemental commercial insurance (including personal accident insurance, supplemental commercial medical insurance, and medical insurance with a coverage limit of RMB6 million)","familyCareTitle":"Family care","familyCareDescription":"Comprehensive commercial insurance for employees\' children, physical examinations for employees\' parents under the Carnation Parent Care Plan, family care activities (parenting classes, health consulting, etc.), and other featured benefits (iHelp Dandelion Mutual Assistance Program and iHope Rainbow Program)","healthcareTitle":"Healthcare","healthcareDescription":"Annual physical examinations together with result interpretation, iHealth Employee Health Management Program (including physical health counseling, psychological counseling, health education, health activities, health centers, and more), physical therapy services, fitness facilities","aliLetterHomeTitle":"A Letter Home from Alibaba","aliLetterHomeDescription":"Each year, Alibaba sends a thoughtfully prepared letter to the family members of our employees. This letter is more than just a gift. It\'s a heartfelt expression of Alibaba\'s care and gratitude towards every employee\'s family members.","aliDayTitle":"510 AliDay","aliDayDescription":"To honor the passion and conviction of Alibaba employees, we designated May10 as Ali Day. It commemorates the spirit of decisiveness, unity, dedication, and mutual support that was forged during the SARS pandemic. This day also provides an opportunity of expressing our gratitude to the families and friends of our employees. On AliDay, our employees invite their loved ones to our office campuses, where they can experience Alibaba\'s office environment and culture firsthand.","supportingMothersTitle":"Prenatal and parenting support","supportingMothersDescription":"We host prenatal and parenting classes to help expectant and new parents navigate their new roles. We also partner with local kindergartens and institutions to streamline preschool enrollment, daycare, and physical checkups for employees\' children.","talentDevelopmentOpportunities":"Thriving careers","talentDevelopmentOpportunitiesTitle":"Thriving careers","talentDevelopmentOpportunitiesDescription":"We want every employee at Alibaba to maximize their individual value and unleash their full potential, with access to ample room for career development and challenging opportunities for growth.","careerDevelopmentTitle":"Career development","careerDevelopmentDescription":"We care about the development of every employee, whether they are a new recruit, an experienced staffer, or a manager. We support their development through various approaches.","careerDevelopmentSubtitle":"We have built a learning and development platform where all employees have access to a wide range of internal and external initiatives that help them develop well both personally and professionally.","mentorCultureTitle":"New hire integration","mentorCultureDescription":"We provide new employees with onboarding roadmaps, peer mentorship, and the 100 Years of Alibaba corporate culture training to accelerate their integration. We also tailor programs for campus recruits, new technical hires, and interns to smooth the campus-to-career transition.","workAnniversaryTitle":"Promotion system","workAnniversaryDescription":"Our fair and transparent promotion system assesses employees holistically, weighing performance, values, manager reviews, and peer feedback.","jobTransferTitle":"Internal mobility","jobTransferDescription":"We provide open and transparent opportunities for internal mobility. This mechanism helps align capabilities with job requirements, encourages managers to focus on employee development, and facilitates the free flow of talent.","talentTrainingTitle":"Training","talentTrainingSubtitle":"We have built a learning and development platform where all employees have access to a wide range of internal and external initiatives that help them develop well both personally and professionally.","newEmployeeTrainingTab":"New employee training","leadershipTrainingTab":"Leadership development","professionalTrainingTab":"Professional development","aiCapabilityTrainingTab":"AI learning and practice","managementTraineeTitle":"Management trainee program","managementTraineeDescription":"To help new employees quickly acclimate to the workplace, we provide extensive support, including onboarding guidance, a mentorship program\uff0cdigital learning roadmaps, and online or offline training.\\n For campus recruits, our main businesses have launched management trainee programs and training initiatives to help bridge the campus-to-career gap.","leadershipProgramTitle":"Leadership training","leadershipProgramDescription":"Our tiered leadership pipeline features: entry-level programs like Xiakexing for transitions into managerial roles; mid-level training on coordination and strategy cascading; and senior programs on business acumen and governance. The DARE Program addresses cross-cultural communication and strategic alignment for overseas managers.","professionalDevelopmentTitle":"Nurturing professional capabilities","professionalDevelopmentDescription":"Our learning platforms, including Ali Learning, ATA, and the Singularity Academy, offer training resources for technologies, operations, products, finance, and ESG. Our businesses run self-tailored training programs and reward employees for achieving certifications like CPA and CFA.","aiCapabilityTitle":"AI capability building","aiCapabilityDescription":"We equip employees with extensive AI learning resources and practical support. AI Wendao fuses theory with practice by integrating courses and AI products. ATA hosts online AI hubs delivering frontier insights and business use cases. The AI Productivity Plan offers models, compute power, and office tools to drive AI innovation across R&D and business activities.","employeeHealthVitality":"Safety and wellness","employeeHealthVitalityTitle":"Safety and wellness","employeeHealthVitalityDescription":"Employee well-being is a top priority. We provide multi-dimensional support by building a safe, comfortable, and smart office environment, offering comprehensive healthcare coverage, and organizing a wide array of engaging activities. These efforts make the workplace vibrant and dynamic.","occupationalHealthTitle":"Occupational health and safety","occupationalHealthDescription":"Drawing upon the ISO 45001 standard, we have issued internal site-specific management policies and operating procedures. Detailed requirements are enforced across three dimensions: risk prevention, emergency management, and safety training.","riskManagementTitle":"Risk prevention","riskManagementDescription":"We have established a health and safety management system spanning diverse operational sites, such as office campuses, logistics facilities, and data centers, to identify risks, track them, and drive continuous improvement.","safetyTrainingTitle":"Emergency management","safetyTrainingDescription":"We have formulated policies and procedures such as the Safety and Emergency Response Guidelines to enhance our emergency response capabilities through clear and actionable instructions.","certificationTitle":"Certification","certificationDescription":"We are working on occupational health and safety certifications. As of March 31, 2026, multiple campuses, data centers, and logistics facilities were ISO 45001-certified.","employeeWellbeingTitle":"Employee wellness","employeeWellbeingDescription":"As part of our commitment to employee well-being, we have established the iHealth Employee Health Management Program.","seasonalWellnessTitle":"TCM","seasonalWellnessDescription":"We offer a 12-session introductory course on traditional Chinese medicine (TCM) and organize expert talks on seasonal wellness aligned with the 24 solar terms. These initiatives empower employees with essential health knowledge.","familyCareActivitiesTitle":"Physical well-being","familyCareActivitiesDescription":"We provide employees with annual physical checkups, complete with report interpretations. For critical and complex conditions, we offer specialized health consultations and care navigation.","mentalHealthServicesTitle":"Mental health","mentalHealthServicesDescription":"We provide employees with multi-tiered mental health support, ranging from a 24/7 counseling hotline to professional EAP services. Additionally, we host targeted mental health activities for employees at different life stages.","vibrantWorkplaceTitle":"Dynamic working environments","vibrantWorkplaceDescription":"Guided by the principles of green development, people-centric care, professionalism, and efficiency, we provide bright, spacious, and convenient working environments featuring daily amenities, comprehensive safety measures, and thoughtful services. We continuously optimize our physical and digital workspaces to create a better experience for our employees.","campusCertificationTitle":"Certification","campusCertificationDescription":"We are working on occupational health and safety certifications. As of March 31, 2026, multiple campuses, data centers, and logistics facilities were ISO 45001-certified.","fitnessFacilitiesTitle":"Fitness facilities","fitnessFacilitiesDescription":"Our campuses are equipped with gyms and facilities for tennis, billiards, basketball, and badminton. These amenities enable employees to stay fit and relieve stress so that they can live more healthily and work more efficiently.","healthManagementTitle":"Health management","healthManagementDescription":"Our campuses feature professional therapy rooms offering services such as tuina and other forms of massage as well as physical rehabilitation. These services alleviate strain in the neck, shoulder, and back, benefiting long-term health and enhancing workplace comfort.","campusCafeteriaTitle":"Cafeterias","campusCafeteriaDescription":"Our campus cafeterias serve a wide array of regional Chinese cuisines across multiple service lines and specialty stations. By providing balanced nutrition and diverse choices, they cater to the varying tastes and dietary habits of our employees, turning every meal into a delightful daily experience.","officeEnvironmentTitle":"Office environment","officeEnvironmentDescription":"We create office environments that harmonize cultural identity with functional utility, blending artistic decor with open layouts. This design fosters a comfortable atmosphere that encourages interaction and innovation, supporting both team collaboration and individual growth.","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"Women accounted for 35.4% of our workforce.","forbesBestEmployerPrefix":"","forbesBestEmployerTitle":"A top-rated employer","forbesBestEmployerDesc":"We claimed a top 5 spot among all Chinese companies on the Forbes list of the World\'s Best Employers 2024.","iso45001CertificationTitle":"ISO 45001","iso45001CertificationUnit":"","iso45001CertificationDesc":"Multiple office campuses, data centers, and logistics facilities of Alibaba obtained this certification.","familyCareLeavePrefix":"Over ","familyCareLeaveTitle":"60,000","familyCareLeaveUnit":"","familyCareLeaveDesc":"Over 60,000 employees took family care leave to spend quality time with their families.","firstAidTrainingPrefix":"Over ","firstAidTrainingTitle":"14,000","firstAidTrainingUnit":"","firstAidTrainingDesc":"The cumulative total number of First-aid Responders trained by Alibaba exceeded 14,000.","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"The satisfaction rate for Alibaba\'s office environment is 93.1%."}')},1738:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u62a5\u544a","bannerTitle":"\u652f\u6301\u5458\u5de5\u53d1\u5c55","bannerDescription":"\u963f\u91cc\u5df4\u5df4\u6700\u5b9d\u8d35\u7684\u8d22\u5bcc\u662f\u4e0d\u65ad\u6210\u957f\u7684\u4eba\u624d\u68af\u961f\uff0c\u6211\u4eec\u5e0c\u671b\\"\u8ba9\u5458\u5de5\u6210\u4e3a\u66f4\u597d\u7684\u81ea\u5df1\\"\uff0c\u52aa\u529b\u8ba9\u6bcf\u4f4d\u5458\u5de5\u90fd\u6709\u673a\u4f1a\u5728\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d\u7684\u6587\u5316\u4e0e\u73af\u5883\u4e2d\u5b66\u4e60\u6210\u957f\uff0c\u4fdd\u6301\u6fc0\u60c5\u3001\u5b9e\u73b0\u4ef7\u503c\u3002","actionResults":"\u884c\u52a8\u7ed3\u679c","actionResultsTitle":"\u884c\u52a8\u7ed3\u679c","strategyPath":"\u7b56\u7565","strategyPathTitle":"\u7b56\u7565","strategyPathContent":"\u4ef7\u503c\u89c2\u662f\u963f\u91cc\u5df4\u5df4\u6587\u5316\u7684\u6838\u5fc3\u7ec4\u6210\u90e8\u5206\uff0c\u5728\u6211\u4eec\u5982\u4f55\u7ecf\u8425\u4e1a\u52a1\u3001\u62db\u8058\u4eba\u624d\u3001\u7ba1\u7406\u548c\u8003\u6838\u5458\u5de5\u4ee5\u53ca\u51b3\u5b9a\u5458\u5de5\u62a5\u916c\u4e2d\u626e\u6f14\u7740\u91cd\u8981\u89d2\u8272\u3002\\n\u5728\u5185\u90e8\u7ba1\u7406\u65b9\u9762\uff0c\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5546\u4e1a\u884c\u4e3a\u51c6\u5219\u300b\u4f5c\u4e3a\u5168\u96c6\u56e2\u7edf\u4e00\u9075\u5faa\u7684\u884c\u4e3a\u89c4\u8303\uff0c\u660e\u786e\u8981\u6c42\u7ef4\u62a4\u6709\u5e8f\u7684\u5de5\u4f5c\u73af\u5883\u4e0e\u5458\u5de5\u7684\u57fa\u672c\u6743\u76ca\u3002\u5728\u6b64\u57fa\u7840\u4e0a\uff0c\u6211\u4eec\u8fdb\u4e00\u6b65\u5236\u5b9a\u300a\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u5458\u5de5\u6743\u76ca\u5b88\u5219\u300b\uff0c\u786e\u7acb\u5728\u4eba\u6743\u4fdd\u969c\u3001\u804c\u4e1a\u5065\u5eb7\u4e0e\u5b89\u5168\u3001\u591a\u5143\u5e73\u7b49\u4e0e\u5171\u878d\uff08DEI\uff09\u4ee5\u53ca\u5458\u5de5\u57f9\u8bad\u4e0e\u53d1\u5c55\u7b49\u65b9\u9762\u7684\u7ba1\u7406\u6807\u51c6\uff0c\u81f4\u529b\u4e8e\u4e3a\u6240\u6709\u5458\u5de5\u521b\u9020\u5b89\u5168\u3001\u516c\u5e73\u3001\u6709\u6210\u957f\u7a7a\u95f4\u7684\u5de5\u4f5c\u73af\u5883\u3002","consumerExperienceTitle":"\u521b\u9020\u826f\u597d\u7684\u6d88\u8d39\u4f53\u9a8c","digitalLifeTitle":"\u8425\u9020\u5305\u5bb9\u5065\u5eb7\u7684\u6570\u5b57\u751f\u6d3b","diversityEquityInclusion":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d","diversityEquityInclusionTitle":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d","diversityEquityInclusionDescription":"\u591a\u5143\u3001\u5e73\u7b49\u548c\u5171\u878d\u662f\u963f\u91cc\u5df4\u5df4\u7ec4\u7ec7\u6587\u5316\u63d0\u5021\u7684\u4ef7\u503c\u7406\u5ff5\u3002\u5728\u8463\u4e8b\u4f1a\u53ef\u6301\u7eed\u53d1\u5c55\u59d4\u5458\u4f1a\u7684\u6307\u5bfc\u4e0b\u5efa\u7acb\\"\u591a\u5143\u5e73\u7b49\u5171\u878d\u4e13\u9879\u7ec4\\"\uff0c\u8d1f\u8d23\u5236\u5b9a\u76f8\u5173\u7684\u653f\u7b56\u5e76\u843d\u5b9e\u5177\u4f53\u7684\u7ba1\u7406\u4e3e\u63aa\uff0c\u5c06\u8fd9\u4e00\u7406\u5ff5\u878d\u5165\u5230\\"\u9009\u3001\u8058\u3001\u80b2\u3001\u7559\\"\u56db\u9879\u4eba\u529b\u8d44\u6e90\u5de5\u4f5c\u4e2d\u3002","philosophyAndCultureTitle":"\u7ba1\u7406\u7406\u5ff5","practiceCasesTitle":"\u7ba1\u7406\u4e3e\u63aa","philosophyAndCultureDescription":"\u6211\u4eec\u5728\u8463\u4e8b\u4f1a\u53ef\u6301\u7eed\u53d1\u5c55\u59d4\u5458\u4f1a\u7684\u6307\u5bfc\u4e0b\u5efa\u7acb\\"\u591a\u5143\u5e73\u7b49\u5171\u878d\u4e13\u9879\u7ec4\\"\uff0c\u8d1f\u8d23\u5236\u5b9a\u76f8\u5173\u7684\u653f\u7b56\u5e76\u843d\u5b9e\u5177\u4f53\u7684\u7ba1\u7406\u4e3e\u63aa\u3002\u6211\u4eec\u5c06\u8fd9\u4e00\u7406\u5ff5\u4e0e\u81ea\u8eab\u7406\u5ff5\u76f8\u7ed3\u5408\uff0c\u878d\u5165\u5230\\"\u9009\u3001\u8058\u3001\u80b2\u3001\u7559\\"\u56db\u9879\u4eba\u529b\u8d44\u6e90\u5de5\u4f5c\u4e2d\uff0c\u5e76\u5f00\u5c55\u591a\u6837\u5316\u7684\u57f9\u8bad\u6d3b\u52a8\u3002","complianceTitle":"\u5408\u6cd5\u5408\u89c4","complianceDescription":"\u5efa\u7acb\u5305\u542b\u5b9a\u671f\u5458\u5de5\u57f9\u8bad\u3001\u5408\u89c4\u5ba1\u8ba1\u53ca\u5b89\u5168\u4e3e\u62a5\u6e20\u9053\u7684\u5b8c\u6574\u5408\u89c4\u4f53\u7cfb\uff0c\u5168\u9762\u4fdd\u969c\u5458\u5de5\u6743\u76ca\u3002","meritBasedTitle":"\u4efb\u4eba\u552f\u8d24","meritBasedDescription":"\u5b9e\u65bd\u4ee5\u7ee9\u6548\u548c\u80fd\u529b\u4e3a\u5bfc\u5411\u7684\u4eba\u529b\u8d44\u6e90\u653f\u7b56\uff0c\u4f46\u4e25\u683c\u7981\u6b62\u57fa\u4e8e\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u7684\u4e2a\u4eba\u7279\u5f81\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u6027\u522b\u3001\u5e74\u9f84\u3001\u79cd\u65cf\u3001\u7c4d\u8d2f\u3001\u5b97\u6559\u4fe1\u4ef0\u7b49\uff09\u7684\u504f\u89c1\uff0c\u4fdd\u969c\u7528\u4eba\u51b3\u7b56\u7684\u5ba2\u89c2\u516c\u6b63\u3002","respectInclusionTitle":"\u5c0a\u91cd\u5305\u5bb9","respectInclusionDescription":"\u652f\u6301\u5458\u5de5\u6ca1\u6709\u987e\u8651\u5730\u8868\u8fbe\u610f\u89c1\uff0c\u5f7c\u6b64\u70b9\u4eae\uff0c\u8ba9\u4eba\u624d\u5145\u5206\u53d1\u6325\u6f5c\u80fd\uff0c\u901a\u8fc7\u878d\u5408\u4e0d\u540c\u80cc\u666f\u3001\u601d\u7ef4\u65b9\u5f0f\u548c\u80fd\u529b\u7279\u8d28\u7684\u5458\u5de5\uff0c\u6253\u9020\u4e00\u652f\u6709\u521b\u9020\u529b\u7684\u56e2\u961f\u3002","diverseTalentPoolTitle":"\u591a\u5143\u5316\u7684\u4eba\u624d\u68af\u961f","diverseTalentPoolDescription":"\u963f\u91cc\u5df4\u5df4\u5145\u5206\u8ba4\u540c\u3001\u63a5\u7eb3\u548c\u5c0a\u91cd\u4e2a\u4f53\u4e4b\u95f4\u7684\u5dee\u5f02\uff0c\u5305\u62ec\u6027\u522b\u3001\u79cd\u65cf\u7b49\u591a\u5143\u5316\u7279\u5f81\u30022026\u8d22\u5e74\uff0c\u5973\u6027\u5458\u5de5\u5360\u963f\u91cc\u5df4\u5df4\u5458\u5de5\u603b\u6570\u768434.8%\u3002","equalWorkplaceTitle":"\u5e73\u7b49\u7684\u5de5\u4f5c\u73af\u5883","equalWorkplaceDescription":"\u6211\u4eec\u5bf9\u66b4\u529b\u3001\u9a9a\u6270\u3001\u6b67\u89c6\u6216\u9738\u51cc\u96f6\u5bb9\u5fcd\uff0c\u5efa\u7acb\u516c\u5f00\u6295\u8bc9\u548c\u4e3e\u62a5\u901a\u9053\uff0c\u914d\u5907\u4e13\u95e8\u4eba\u5458\u63a5\u53d7\u54a8\u8be2\u548c\u6295\u8bc9\uff0c\u5e76\u8fd0\u7528\u6570\u5b57\u5316\u53cd\u9988\u5de5\u5177\uff0c\u521b\u9020\u5b89\u5168\u7684\u6c9f\u901a\u73af\u5883\u3002","openCommunicationTitle":"\u5f00\u653e\u6c9f\u901a\uff0c\u5408\u4f5c\u5171\u878d","openCommunicationDescription":"\u6211\u4eec\u901a\u8fc7\u642d\u5efa\u5f00\u653e\u7684\u6c9f\u901a\u5e73\u53f0\u3001\u5f00\u5c55\u591a\u5143\u5316\u5458\u5de5\u6d3b\u52a8\uff0c\u6301\u7eed\u63a8\u52a8\u5171\u878d\u6587\u5316\u6c1b\u56f4\u7684\u5efa\u8bbe\u3002","aliShipaiTitle":"\u963f\u91cc\u5341\u6d3e","aliShipaiDescription":"\u963f\u91cc\u5341\u6d3e\u662f\u963f\u91cc\u5df4\u5df4\u5458\u5de5\u81ea\u53d1\u521b\u7acb\u3001\u81ea\u4e3b\u7ba1\u7406\u7684\u5174\u8da3\u56e2\u4f53\u3002\u622a\u81f32026\u5e743\u670831\u65e5\uff0c\u963f\u91cc\u5341\u6d3e\u5171\u670935\u4e2a\u6b63\u5f0f\u56e2\u4f53\uff0c\u6db5\u76d6\u4f53\u80b2\u7c7b\u7684\u7bee\u7403\u6d3e\u3001\u58c1\u7403\u6d3e\u3001\u5251\u9053\u6d3e\uff0c\u624d\u827a\u7c7b\u7684\u6444\u5f71\u6d3e\u3001\u4e66\u6cd5\u6d3e\u3001\u7ed8\u753b\u6d3e\uff0c\u6210\u957f\u7c7b\u7684\u8bfb\u4e66\u6d3e\u3001\u82f1\u8bed\u6d3e\u3001\u6b63\u5ff5\u51a5\u60f3\u6d3e\u7b49\u3002","womenNetworkingTitle":"\u5973\u6027\u4ea4\u6d41\u6d3b\u52a8","womenNetworkingDescription":"\u6211\u4eec\u4e3e\u529e\u5973\u6027\u4ea4\u6d41\u6d3b\u52a8\uff0c\u9080\u8bf7\u6765\u81ea\u591a\u5143\u80cc\u666f\u7684\u4f18\u79c0\u5973\u6027\u4ee3\u8868\u5206\u4eab\u804c\u4e1a\u53d1\u5c55\u7ecf\u9a8c\u4e0e\u4eba\u751f\u667a\u6167\uff0c\u4e3a\u5973\u6027\u5458\u5de5\u6253\u9020\u5f00\u653e\u4e92\u52a9\u7684\u5e73\u53f0\u3002","culturalEventsTitle":"\u6587\u5316\u4e3b\u9898\u65e5","culturalEventsDescription":"\u6211\u4eec\u5b9a\u671f\u4e3e\u529e Homecoming\u3001\u5168\u7403\u98ce\u60c5\u79c0\u7b49\u6587\u5316\u4e3b\u9898\u65e5\uff0c\u9080\u8bf7\u6765\u81ea\u5168\u7403\u5404\u5730\u62e5\u6709\u4e0d\u540c\u6587\u5316\u80cc\u666f\u7684\u5458\u5de5\u76f8\u4e92\u4ea4\u6d41\u3001\u589e\u8fdb\u4e86\u89e3\u3002","employeeDevelopmentTitle":"\u5e74\u9648\u6587\u5316\u5173\u6000","employeeDevelopmentDescription":"\u5728\u963f\u91cc\u5df4\u5df4\uff0c\u6bcf\u4f4d\u5458\u5de5\u5165\u804c\u7684\u65e5\u5b50\u90fd\u88ab\u89c6\u4e3a\u4e00\u4e2a\u7279\u522b\u7684\u7eaa\u5ff5\u65e5\u3002\u6211\u4eec\u8bbe\u7f6e\u201c\u4e00\u5e74\u9999\u201d\u201c\u4e09\u5e74\u9187\u201d\u201c\u4e94\u5e74\u9648\u201d\u201c\u5341\u5e74\u99a8\u201d\u7b49\u4e0d\u540c\u9636\u6bb5\uff0c\u901a\u8fc7\u201c\u5e74\u9648\u6587\u5316\u201d\u8bb0\u5f55\u5458\u5de5\u5728\u516c\u53f8\u7684\u6210\u957f\u5386\u7a0b\uff0c\u8868\u8fbe\u5bf9\u5458\u5de5\u957f\u671f\u8d21\u732e\u7684\u8ba4\u53ef\u4e0e\u611f\u8c22\u3002","talentAttractionRetention":"\u4eba\u624d\u7684\u5438\u5f15\u548c\u4fdd\u7559","talentAttractionRetentionTitle":"\u4eba\u624d\u7684\u5438\u5f15\u548c\u4fdd\u7559","talentAttractionRetentionDescription":"\u6211\u4eec\u5efa\u7acb\u5f00\u653e\u3001\u591a\u6837\u7684\u6e20\u9053\u6c47\u805a\u4eba\u624d\u3002\u540c\u65f6\uff0c\u6211\u4eec\u59cb\u7ec8\u4e0e\u5458\u5de5\u5171\u4eab\u53d1\u5c55\u6210\u679c\uff0c\u5efa\u7acb\u517c\u5177\u5185\u90e8\u516c\u5e73\u6027\u548c\u5916\u90e8\u7ade\u4e89\u529b\u7684\u85aa\u916c\u4f53\u7cfb\uff0c\u5e76\u6301\u7eed\u5b8c\u5584\u798f\u5229\u4fdd\u969c\uff0c\u63a8\u52a8\u5efa\u8bbe\\"\u5feb\u4e50\u5de5\u4f5c\u3001\u8ba4\u771f\u751f\u6d3b\\"\u7684\u6c1b\u56f4\u3002","recruitingTalentsTitle":"\u62db\u8058\u4eba\u624d","recruitingTalentsDescription":"\u4e3a\u4e86\u80fd\u591f\\"\u9009\u5bf9\u5408\u9002\u7684\u4eba\uff0c\u62db\u5230\u5408\u9002\u7684\u4eba\\"\uff0c\u6211\u4eec\u5728\u5efa\u7acb\u591a\u6837\u5316\u4eba\u624d\u62db\u8058\u6e20\u9053\u7684\u540c\u65f6\uff0c\u4e5f\u975e\u5e38\u91cd\u89c6\u5019\u9009\u4eba\u7684\u4f53\u9a8c\u548c\u9762\u8bd5\u8fc7\u7a0b\u4e2d\u7684\u5408\u89c4\u7ba1\u7406\u3002","socialRecruitmentTitle":"\u591a\u6837\u5316\u7684\u62db\u8058\u6e20\u9053","socialRecruitmentDescription":"\u5efa\u8bbe\u5f00\u653e\u3001\u591a\u6837\u7684\u4eba\u624d\u62db\u8058\u6e20\u9053\u6765\u6ee1\u8db3\u4eba\u624d\u9700\u6c42\uff0c\u5305\u62ec\u793e\u4f1a\u62db\u8058\u3001\u6821\u56ed\u62db\u8058\u3001\u5458\u5de5\u5185\u63a8\u7b49\u3002\u201c\u963f\u91cc\u661f\u201d\u4eba\u624d\u8ba1\u5212\u62db\u52df\u5e76\u57f9\u517b\u5168\u7403\u9876\u5c16\u9752\u5e74\u79d1\u7814\u4eba\u624d\u3002","socialRecruitmentLink":"\u7acb\u5373\u52a0\u5165","campusRecruitmentTitle":"\u91cd\u89c6\u62db\u8058\u4f53\u9a8c","campusRecruitmentDescription":"\u901a\u8fc7\u5236\u5b9a\u6807\u51c6\u62db\u8058\u6d41\u7a0b\u3001\u63d0\u4f9b\u9762\u8bd5\u5b98\u57f9\u8bad\u548c\u5efa\u7acb\u5019\u9009\u4eba\u4f53\u9a8c\u53cd\u9988\u673a\u5236\u7b49\u65b9\u5f0f\u6765\u63d0\u5347\u62db\u8058\u4f53\u9a8c\uff0c\u4fdd\u969c\u5019\u9009\u4eba\u80fd\u591f\u83b7\u5f97\u5e73\u7b49\u3001\u900f\u660e\u3001\u53cb\u5584\u7684\u62db\u8058\u4f53\u9a8c\u3002","compensationSystemTitle":"\u516c\u5e73\u3001\u6709\u7ade\u4e89\u529b\u7684\u85aa\u916c\u548c\u7ee9\u6548\u8bc4\u4f30\u4f53\u7cfb","compensationSystemDescription":"\u6211\u4eec\u81f4\u529b\u4e8e\u4e0e\u5458\u5de5\u5171\u4eab\u53d1\u5c55\u6210\u679c\uff0c\u5efa\u7acb\u5458\u5de5\u5408\u6cd5\u6743\u76ca\u4f53\u7cfb\uff0c\u4f7f\u5f97\u85aa\u916c\u6fc0\u52b1\u517c\u5177\u5185\u90e8\u516c\u5e73\u6027\u548c\u5916\u90e8\u7ade\u4e89\u529b\u3002","compensationSystemContent":"\u963f\u91cc\u5df4\u5df4\u5168\u4f53\u5458\u5de5\u6bcf\u5e74\u63a5\u53d7\u7ee9\u6548\u8bc4\u4f30\uff0c\u7ee9\u6548\u7ed3\u679c\u5e94\u7528\u4e8e\u5168\u4f53\u5458\u5de5\u7684\u77ed\u671f\u548c\u957f\u671f\u6fc0\u52b1\u3002\u6211\u4eec\u4ece\u591a\u4e2a\u7ef4\u5ea6\u8bc4\u4f30\u5458\u5de5\u7ee9\u6548\u8868\u73b0\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u76ee\u6807\u7ba1\u7406\u673a\u5236\u3001\u4e1a\u7ee9\u548c\u4ef7\u503c\u89c2\u7684\u7ee9\u6548\u8003\u6838\u5236\u5ea6\u3001\u56e2\u961f\u7ee9\u6548\u8003\u6838\u673a\u5236\u3001\u9636\u6bb5\u6027\u7075\u6d3b\u7ee9\u6548\u53ca\u53d1\u5c55\u5bf9\u8bdd\uff1b\u6211\u4eec\u5efa\u7acb\u4e0e\u7ee9\u6548\u6302\u94a9\u7684\u6fc0\u52b1\u673a\u5236\uff0c\u4e3a\u6240\u6709\u5458\u5de5\u63d0\u4f9b\u5177\u6709\u5e02\u573a\u7ade\u4e89\u529b\u7684\u85aa\u916c\u798f\u5229\u3002","heartWarmingBenefitsTitle":"\u6709\u6e29\u5ea6\u7684\u798f\u5229\u6743\u76ca","heartWarmingBenefitsDescription":"\u963f\u91cc\u5df4\u5df4\u81f4\u529b\u4e8e\u4e3a\u6240\u6709\u5458\u5de5\u63d0\u4f9b\u6709\u6e29\u5ea6\u7684\u798f\u5229\u3002\u4e0d\u540c\u56fd\u5bb6\u3001\u5730\u533a\u53ca\u884c\u4e1a\u5bf9\u5458\u5de5\u798f\u5229\u7684\u6cd5\u5f8b\u89c4\u5b9a\u4e0d\u5c3d\u76f8\u540c\u3002\u6211\u4eec\u5145\u5206\u5c0a\u91cd\u548c\u9075\u5faa\u76f8\u5173\u7684\u89c4\u5b9a\uff0c\u5236\u5b9a\u4e86\u4e0e\u6240\u5728\u5730\u533a\u76f8\u9002\u5e94\u7684\u798f\u5229\u4f53\u7cfb\uff0c\u4e3a\u5458\u5de5\u751a\u81f3\u5176\u5bb6\u5c5e\u63d0\u4f9b\u751f\u6d3b\u4fdd\u969c\uff0c\u4ee5\u51cf\u8f7b\u540e\u987e\u4e4b\u5fe7\u3002","socialSecurityTitle":"\u4e94\u9669\u4e00\u91d1","socialSecurityDescription":"\u5de5\u4f24\u4fdd\u9669\u3001\u5931\u4e1a\u4fdd\u9669\u3001\u57fa\u672c\u533b\u7597\u4fdd\u9669\u3001\u57fa\u672c\u517b\u8001\u4fdd\u9669\u3001\u751f\u80b2\u4fdd\u9669\u3001\u4f4f\u623f\u516c\u79ef\u91d1","statutoryLeaveTitle":"\u6cd5\u5b9a\u5047\u671f","statutoryLeaveDescription":"\u5e74\u5047\u3001\u5a5a\u5047\u3001\u5b55\u68c0\u5047\u3001\u4ea7\u5047\u3001\u80b2\u513f\u5047\u3001\u54fa\u4e73\u65f6\u95f4\u3001\u966a\u4ea7\u5047","workLifeBalanceTitle":"\u751f\u6d3b\u5e73\u8861","workLifeBalanceDescription":"\u7279\u8272\u5047\u671f\uff1a\u966a\u4f34\u5047\u3001\u957f\u671f\u670d\u52a1\u5047\u3001\u8def\u9014\u5047\u3001outing\u5047\u3001\u7075\u6d3b\u529e\u516c","featuredGiftsTitle":"\u7279\u8272\u793c","featuredGiftsDescription":"\u5165\u804c\u5468\u5e74\u793c\u3001\u963f\u91cc\u5bb6\u4e66\u3001\u5987\u5973\u8282\u793c\u7269\u3001\u4e2d\u79cb\u793c\u5305\u3001\u5348\u9910\u665a\u9910\u591c\u5bb5\u8865\u8d34","employeeSupportTitle":"\u5458\u5de5\u652f\u6301\u548c\u4fdd\u969c","employeeSupportDescription":"iHelp\u84b2\u516c\u82f1\u4e92\u52a9\u8ba1\u5212\u3001iHope\u5f69\u8679\u8ba1\u5212\u3001iHome\u7f6e\u4e1a\u8ba1\u5212\u3001\u8865\u5145\u578b\u5546\u4e1a\u4fdd\u9669\uff08\u542b\u4eba\u8eab\u9669\u3001\u5546\u4e1a\u8865\u5145\u533b\u7597\u4fdd\u9669\u548c\u767e\u4e07\u533b\u7597\u9669\uff09","familyCareTitle":"\u5173\u7231\u5bb6\u4eba","familyCareDescription":"\u5b50\u5973\u7efc\u5408\u5546\u4e1a\u4fdd\u9669\u3001\u5eb7\u4e43\u99a8\u7236\u6bcd\u4f53\u68c0\u3001\u5bb6\u5ead\u5173\u7231\u6d3b\u52a8\uff08\u80b2\u513f\u8bfe\u5802\u3001\u5065\u5eb7\u54a8\u8be2\u7b49\uff09\uff0c\u53ca\u5176\u4ed6\u7279\u8272\u4fdd\u969c\u7b49\uff08iHelp\u84b2\u516c\u82f1\u4e92\u52a9\u8ba1\u5212\u3001iHope\u5f69\u8679\u8ba1\u5212\uff09","healthcareTitle":"\u5065\u5eb7\u533b\u7597","healthcareDescription":"\u5e74\u5ea6\u5065\u5eb7\u4f53\u68c0\u548c\u89e3\u8bfb\u3001iHealth\u5458\u5de5\u5065\u5eb7\u5173\u7231\uff08\u542b\u8eab\u5fc3\u5065\u5eb7\u54a8\u8be2\u3001\u5065\u5eb7\u666e\u53ca\u3001\u5065\u5eb7\u6d3b\u52a8\u3001\u5065\u5eb7\u4e2d\u5fc3\u7b49\uff09\u3001\u7406\u7597\u670d\u52a1\u3001\u8fd0\u52a8\u5065\u8eab\u573a\u6240","aliLetterHomeTitle":"\u963f\u91cc\u5bb6\u4e66","aliLetterHomeDescription":"\u963f\u91cc\u5df4\u5df4\u6bcf\u5e74\u90fd\u4f1a\u5411\u5458\u5de5\u5bb6\u4eba\u5bc4\u9001\u7cbe\u5fc3\u51c6\u5907\u7684\u5bb6\u4e66\uff0c\u8fd9\u4efd\u5bb6\u4e66\u4e0d\u4ec5\u662f\u4e00\u4efd\u793c\u7269\uff0c\u66f4\u8574\u542b\u7740\u963f\u91cc\u5df4\u5df4\u5bf9\u6bcf\u4f4d\u5458\u5de5\u5bb6\u5ead\u7684\u5173\u6000\u4e0e\u611f\u8c22\u3002","aliDayTitle":"\\"510\\"\u963f\u91cc\u65e5","aliDayDescription":"\u4e3a\u4e86\u7eaa\u5ff5\u963f\u91cc\u4eba\u7684\u6fc0\u60c5\u548c\u4fe1\u5ff5\uff0c\u6211\u4eec\u5c06\u6bcf\u5e74\u7684 5 \u6708 10 \u65e5\u5b9a\u4e3a\\"\u963f\u91cc\u65e5\\"\uff0c\u4ee5\u7eaa\u5ff5\\"\u975e\u5178\\"\u4e2d\u51dd\u7ed3\u7684\u679c\u65ad\u3001\u56e2\u7ed3\u3001\u656c\u4e1a\u3001\u4e92\u52a9\u4e92\u7231\u7684\u7cbe\u795e\uff0c\u4e5f\u7528\u8fd9\u4e00\u5929\u6765\u8868\u8fbe\u5bf9\u4eb2\u53cb\u7684\u611f\u6069\u3002\u8fd9\u4e00\u5929\uff0c\u5458\u5de5\u4f1a\u5e26\u7740\u81ea\u5df1\u7684\u4eb2\u53cb\u8d70\u8fdb\u529e\u516c\u56ed\u533a\uff0c\u4f53\u9a8c\u3001\u611f\u53d7\u963f\u91cc\u7684\u5de5\u4f5c\u73af\u5883\u4e0e\u6587\u5316\u6c1b\u56f4\u3002","supportingMothersTitle":"\u63d0\u4f9b\u80b2\u513f\u652f\u6301","supportingMothersDescription":"\u6211\u4eec\u901a\u8fc7\u5b55\u5987\u5b66\u6821\u548c\u80b2\u513f\u8bfe\u5802\uff0c\u5e2e\u52a9\u51c6\u7236\u6bcd\u548c\u65b0\u664b\u7236\u6bcd\u4ece\u5bb9\u9002\u5e94\u201c\u65b0\u624b\u7238\u5988\u201d\u7684\u89d2\u8272\uff1b\u4e0e\u6240\u5728\u5730\u5e7c\u513f\u56ed\u53ca\u673a\u6784\u5408\u4f5c\uff0c\u4e3a\u5458\u5de5\u5b50\u5973\u5728\u5165\u56ed\u3001\u6258\u7ba1\u53ca\u5065\u5eb7\u68c0\u67e5\u7b49\u65b9\u9762\u63d0\u4f9b\u4fbf\u5229\u3002","talentDevelopmentOpportunities":"\u4e30\u5bcc\u7684\u4eba\u624d\u53d1\u5c55\u673a\u4f1a","talentDevelopmentOpportunitiesTitle":"\u4e30\u5bcc\u7684\u4eba\u624d\u53d1\u5c55\u673a\u4f1a","talentDevelopmentOpportunitiesDescription":"\u6211\u4eec\u5e0c\u671b\u6bcf\u4f4d\u5458\u5de5\u5728\u963f\u91cc\u5df4\u5df4\u90fd\u80fd\u66f4\u597d\u5b9e\u73b0\u4e2a\u4eba\u4ef7\u503c\uff0c\u5145\u5206\u53d1\u6325\u81ea\u8eab\u6f5c\u529b\uff0c\u5e76\u4e14\u83b7\u5f97\u4e30\u5bcc\u7684\u804c\u4e1a\u53d1\u5c55\u7a7a\u95f4\u548c\u5145\u6ee1\u6311\u6218\u7684\u6210\u957f\u673a\u4f1a\u3002","careerDevelopmentTitle":"\u804c\u4e1a\u53d1\u5c55\u673a\u4f1a","careerDevelopmentDescription":"\u6211\u4eec\u5173\u6ce8\u6bcf\u4f4d\u5458\u5de5\u7684\u6210\u957f\u4e0e\u53d1\u5c55\uff0c\u65e0\u8bba\u662f\u65b0\u4eba\u3001\u5165\u804c\u4e00\u5b9a\u5e74\u9650\u7684\u5458\u5de5\u8fd8\u662f\u7ba1\u7406\u8005\uff0c\u901a\u8fc7\u4e0d\u540c\u7684\u65b9\u5f0f\u7275\u5f15\u4ed6\u4eec\u6210\u957f\u3002","careerDevelopmentSubtitle":"\u6211\u4eec\u5efa\u7acb\u4e86\u8986\u76d6\u5168\u5458\u7684\u3001\u591a\u6837\u5316\u7684\u5185\u5916\u90e8\u5b66\u4e60\u53d1\u5c55\u9879\u76ee\uff0c\u4e3a\u5458\u5de5\u63d0\u4f9b\u5b66\u4e60\u4e0e\u53d1\u5c55\u5e73\u53f0\uff0c\u5e2e\u52a9\u5458\u5de5\u5b9e\u73b0\u4e2a\u4eba\u548c\u804c\u4e1a\u53cc\u91cd\u6210\u957f\u3002","mentorCultureTitle":"\u65b0\u5458\u5de5\u878d\u5165","mentorCultureDescription":"\u6211\u4eec\u4e3a\u65b0\u5458\u5de5\u63d0\u4f9b\u65b0\u4eba\u5730\u56fe\u5bfc\u822a\u3001\u5e08\u5144\u5e08\u59d0\u6307\u5bfc\u3001\\"\u767e\u5e74\u963f\u91cc\\"\u6587\u5316\u57f9\u8bad\u7b49\u7cfb\u5217\u652f\u6301\uff0c\u5e2e\u52a9\u4ed6\u4eec\u5feb\u901f\u878d\u5165\u5de5\u4f5c\u73af\u5883\u3002\u6211\u4eec\u8fd8\u4e3a\u6821\u62db\u751f\u3001\u6280\u672f\u65b0\u4eba\u53ca\u5b9e\u4e60\u751f\u7fa4\u4f53\u8bbe\u8ba1\u4e86\u4e13\u9879\u57f9\u517b\u9879\u76ee\uff0c\u4ee5\u5e2e\u52a9\u4ed6\u4eec\u66f4\u597d\u9002\u5e94\u4ece\u5b66\u6821\u5411\u804c\u573a\u7684\u8f6c\u53d8\u3002 ","workAnniversaryTitle":"\u664b\u5347\u673a\u5236","workAnniversaryDescription":"\u6211\u4eec\u5efa\u7acb\u4e86\u516c\u5e73\u900f\u660e\u7684\u664b\u5347\u8bc4\u4f30\u673a\u5236\uff0c\u7efc\u5408\u7ee9\u6548\u3001\u4ef7\u503c\u89c2\u3001\u7ba1\u7406\u8005\u8bc4\u4ef7\u53ca\u540c\u4e8b\u53cd\u9988\u7b49\u591a\u65b9\u89c6\u89d2\u8fdb\u884c\u8003\u91cf\u3002","jobTransferTitle":"\u8f6c\u5c97\u673a\u5236","jobTransferDescription":"\u4e3a\u5458\u5de5\u63d0\u4f9b\u5f00\u653e\u3001\u900f\u660e\u7684\u8f6c\u5c97\u673a\u4f1a\u3002\u8fd9\u4e00\u673a\u5236\u65e2\u80fd\u66f4\u597d\u5339\u914d\u5458\u5de5\u80fd\u529b\u548c\u5c97\u4f4d\u9700\u6c42\uff0c\u4e5f\u80fd\u9a71\u52a8\u7ba1\u7406\u8005\u5173\u6ce8\u5458\u5de5\u6210\u957f\uff0c\u8ba9\u4eba\u624d\u81ea\u7531\u6d41\u52a8\u3002","talentTrainingTitle":"\u57f9\u8bad\u4e0e\u53d1\u5c55","talentTrainingSubtitle":"\u6211\u4eec\u5efa\u7acb\u4e86\u8986\u76d6\u5168\u5458\u7684\u3001\u591a\u6837\u5316\u7684\u5185\u5916\u90e8\u5b66\u4e60\u53d1\u5c55\u9879\u76ee\uff0c\u4e3a\u5458\u5de5\u63d0\u4f9b\u5b66\u4e60\u4e0e\u53d1\u5c55\u5e73\u53f0\uff0c\u5e2e\u52a9\u5458\u5de5\u5b9e\u73b0\u4e2a\u4eba\u548c\u804c\u4e1a\u53cc\u91cd\u6210\u957f\u3002","newEmployeeTrainingTab":"\u65b0\u4eba\u57f9\u8bad","leadershipTrainingTab":"\u9886\u5bfc\u529b\u53d1\u5c55","professionalTrainingTab":"\u4e13\u4e1a\u80fd\u529b\u57f9\u517b","aiCapabilityTrainingTab":"AI\u5b66\u4e60\u4e0e\u5b9e\u8df5","managementTraineeTitle":"\u7ba1\u57f9\u751f\u8ba1\u5212","managementTraineeDescription":"\u6211\u4eec\u4e3a\u65b0\u5458\u5de5\u63d0\u4f9b\u65b0\u4eba\u5165\u804c\u77e5\u8bc6\u5bfc\u5f15\u3001\u5e08\u5144\u5e08\u59d0\u5339\u914d\u3001\u7ebf\u4e0a\u5b66\u4e60\u5730\u56fe\u3001\u7ebf\u4e0a\u7ebf\u4e0b\u57f9\u8bad\u9879\u76ee\u7b49\u7cfb\u5217\u652f\u6301\uff0c\u5e2e\u52a9\u4ed6\u4eec\u5feb\u901f\u878d\u5165\u5de5\u4f5c\u73af\u5883\u3002\u9664\u6b64\u4ee5\u5916\uff0c\u6211\u4eec\u7684\u4e3b\u8981\u4e1a\u52a1\u8fd8\u4e3a\u6821\u62db\u751f\u5f00\u53d1\u4e86\u7ba1\u57f9\u751f\u57f9\u8bad\u53ca\u5b9a\u5236\u57f9\u8bad\u9879\u76ee\uff0c\u4ee5\u5e2e\u52a9\u4ed6\u4eec\u66f4\u597d\u9002\u5e94\u4ece\u5b66\u6821\u5411\u804c\u573a\u7684\u8f6c\u53d8\u3002","leadershipProgramTitle":"\u9886\u5bfc\u529b\u57f9\u8bad","leadershipProgramDescription":"\u6211\u4eec\u6784\u5efa\u8986\u76d6\u57fa\u5c42\u3001\u4e2d\u9636\u53ca\u9ad8\u9636\u7ba1\u7406\u8005\u7684\u5206\u5c42\u57f9\u517b\u4f53\u7cfb\uff0c\u9762\u5411\u57fa\u5c42\u7ba1\u7406\u8005\u63a8\u51fa\\"\u4fa0\u5ba2\u884c\\"\u7b49\u9879\u76ee\u5e2e\u52a9\u5176\u5b8c\u6210\u89d2\u8272\u8f6c\u53d8\uff0c\u4e3a\u4e2d\u9636\u7ba1\u7406\u8005\u63d0\u4f9b\u7ec4\u7ec7\u534f\u540c\u4e0e\u6218\u7565\u4f20\u5bfc\u57f9\u8bad\uff0c\u5bf9\u9ad8\u9636\u7ba1\u7406\u8005\uff0c\u91cd\u70b9\u805a\u7126\u5546\u4e1a\u6d1e\u5bdf\u4e0e\u6cbb\u7406\u80fd\u529b\u57f9\u517b\u3002\u6b64\u5916\uff0c\u6211\u4eec\u4e5f\u4e3a\u6d77\u5916\u7ba1\u7406\u8005\u8bbe\u8ba1DARE\u9886\u5bfc\u529b\u57f9\u8bad\uff0c\u63d0\u5347\u8de8\u6587\u5316\u7ba1\u7406\u4e0e\u6218\u7565\u534f\u540c\u80fd\u529b\u3002","professionalDevelopmentTitle":"\u4e13\u4e1a\u80fd\u529b\u57f9\u517b","professionalDevelopmentDescription":"\u6211\u4eec\u63d0\u4f9b\u8986\u76d6\u6280\u672f\u3001\u8fd0\u8425\u3001\u4ea7\u54c1\u3001\u8d22\u52a1\u53caESG\u7b49\u9886\u57df\u7684\u4e13\u4e1a\u57f9\u8bad\u8d44\u6e90\uff0c\u4e3a\u5458\u5de5\u6253\u9020\u963f\u91cc\u5b66\u4e60\u3001ATA\u3001\u5947\u70b9\u5b66\u5802\u7b49\u5e73\u53f0\u548c\u5b66\u4e60\u793e\u533a\u3002\u5404\u4e1a\u52a1\u5355\u5143\u8fd8\u7ed3\u5408\u81ea\u8eab\u9700\u6c42\u63a8\u51fa\u5b9a\u5411\u57f9\u517b\u9879\u76ee\uff0c\u6b64\u5916\uff0c\u6211\u4eec\u4e5f\u652f\u6301\u5458\u5de5\u8003\u53d6CPA\u3001CFA\u7b49\u4e13\u4e1a\u8ba4\u8bc1\u3002","aiCapabilityTitle":"AI\u65f6\u4ee3\u80fd\u529b\u5efa\u8bbe","aiCapabilityDescription":"\u6211\u4eec\u4e3a\u5458\u5de5\u63d0\u4f9b\u4e30\u5bcc\u7684AI\u5b66\u4e60\u8d44\u6e90\u4e0e\u5b9e\u8df5\u652f\u6301\uff0c\u901a\u8fc7\\"AI\u95ee\u9053\\"\u6574\u5408\u8bfe\u7a0b\u4e0eAI\u4ea7\u54c1\uff0c\u5c06\u77e5\u8bc6\u5b66\u4e60\u4e0e\u5b9e\u8df5\u5e94\u7528\u76f8\u7ed3\u5408\u3002ATA\u4e0a\u7ebfAI\u4e13\u9898\u4e0eAI\u5b9e\u8df5\u4e13\u533a\uff0c\u4e3a\u5458\u5de5\u63d0\u4f9b\u524d\u6cbf\u8d44\u8baf\u548c\u4e1a\u52a1\u53c2\u8003\u3002\u6211\u4eec\u8fd8\u7ec4\u7ec7\u4e3b\u9898\u57f9\u8bad\u4e0e\u76f4\u64ad\uff0c\u5e76\u901a\u8fc7\\"AI\u751f\u4ea7\u529b\u8ba1\u5212\\"\u5f00\u653e\u6a21\u578b\u5de5\u5177\u3001\u8ba1\u7b97\u8d44\u6e90\u548c\u529e\u516c\u5de5\u5177\uff0c\u652f\u6301\u5458\u5de5\u5728\u6280\u672f\u7814\u53d1\u4e0e\u4e1a\u52a1\u521b\u65b0\u4e2d\u63a2\u7d22\u548c\u5e94\u7528AI\u3002","employeeHealthVitality":"\u5458\u5de5\u5065\u5eb7\u4e0e\u6d3b\u529b","employeeHealthVitalityTitle":"\u5458\u5de5\u5065\u5eb7\u4e0e\u6d3b\u529b","employeeHealthVitalityDescription":"\u5458\u5de5\u8eab\u5fc3\u5065\u5eb7\u662f\u6211\u4eec\u7684\u9996\u8981\u5173\u6ce8\u4e4b\u4e00\u3002\u901a\u8fc7\u5b89\u5168\u8212\u9002\u4e14\u667a\u80fd\u4fbf\u6377\u7684\u529e\u516c\u73af\u5883\uff0c\u4e13\u4e1a\u5168\u9762\u7684\u533b\u7597\u5065\u5eb7\u4fdd\u969c\u3001\u4e30\u5bcc\u591a\u5f69\u7684\u516c\u53f8\u6d3b\u52a8\uff0c\u6211\u4eec\u4e3a\u5458\u5de5\u63d0\u4f9b\u591a\u7ef4\u5ea6\u652f\u6301\uff0c\u8ba9\u804c\u573a\u73af\u5883\u5145\u6ee1\u751f\u673a\u4e0e\u6d3b\u529b\u3002","occupationalHealthTitle":"\u804c\u4e1a\u5065\u5eb7\u4e0e\u5b89\u5168\u4fdd\u969c","occupationalHealthDescription":"\u6211\u4eec\u53c2\u8003 ISO 45001 \u6807\u51c6\uff0c\u53d1\u5e03\u4e86\u9002\u7528\u4e8e\u4e0d\u540c\u573a\u6240\u7ba1\u7406\u7684\u5185\u90e8\u5236\u5ea6\u4e0e\u5de5\u4f5c\u89c4\u8303\uff0c\u5e76\u4ece\u98ce\u9669\u9632\u8303\u3001\u5e94\u6025\u7ba1\u7406\u548c\u5b89\u5168\u57f9\u8bad\u4e09\u4e2a\u65b9\u9762\u6765\u843d\u5b9e\u5177\u4f53\u7684\u7ba1\u7406\u8981\u6c42\u3002","riskManagementTitle":"\u98ce\u9669\u9632\u8303","riskManagementDescription":"\u5728\u529e\u516c\u56ed\u533a\u3001\u7269\u6d41\u573a\u6240\u53ca\u6570\u636e\u4e2d\u5fc3\u7b49\u5de5\u4f5c\u573a\u6240\uff0c\u6211\u4eec\u5df2\u5efa\u7acb\u8986\u76d6\u98ce\u9669\u8bc6\u522b\u3001\u8ddf\u8e2a\u4e0e\u6301\u7eed\u6539\u8fdb\u7684\u5458\u5de5\