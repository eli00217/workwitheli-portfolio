43\u5229\u58f0\u660e</span></strong></p><p data-lake-id=\\"u0d00d3ba\\" id=\\"u0d00d3ba\\"><span data-lake-id=\\"u6dcf1e41\\" id=\\"u6dcf1e41\\" class=\\"lake-fontsize-14\\">1\u3001\u672c\u7f51\u7ad9\u4e0a\u7684 \u201c\u963f\u91cc\u5df4\u5df4\u201d\u3001\u201cALIBABA\u201d\u3001\u201c</span><img type=\\"inline\\" name=\\"image\\" src=\\"https://static.alibabagroup.com/static/e6d1ba46-99ad-4726-8e35-8189d503d28b.png\\"></img><span data-lake-id=\\"u1021122f\\" id=\\"u1021122f\\" class=\\"lake-fontsize-14\\">\u201d\u7b49\u6587\u5b57\u53ca/\u6216\u6807\u8bc6\uff0c\u4ee5\u53ca\u672c\u7f51\u7ad9\u4e0a\u7684\u5176\u4ed6\u6807\u8bc6\u3001\u5fbd\u8bb0\u3001\u4ea7\u54c1\u548c\u670d\u52a1\u540d\u79f0\u5747\u4e3a\u6211\u4eec\u53ca\u6211\u4eec\u7684\u5173\u8054\u516c\u53f8\uff08\u4ee5\u4e0b\u5408\u79f0\u201c\u963f\u91cc\u5df4\u5df4\u201d\uff09\u5728\u4e2d\u56fd\u548c\u5176\u4ed6\u56fd\u5bb6\u7684\u6ce8\u518c\u5546\u6807\u3002\u672a\u7ecf\u6743\u5229\u4eba\u4e66\u9762\u6388\u6743\uff0c\u4efb\u4f55\u4eba\u4e0d\u5f97\u4ee5\u4efb\u4f55\u65b9\u5f0f\u5c55\u793a\u3001\u4f7f\u7528\u6216\u505a\u5176\u4ed6\u5904\u7406\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u590d\u5236\u3001\u4f20\u64ad\u3001\u5c55\u793a\u3001\u955c\u50cf\u3001\u4e0a\u4f20\u3001\u4e0b\u8f7d\uff09\uff0c\u4e5f\u4e0d\u5f97\u5411\u4ed6\u4eba\u8868\u660e\u60a8\u6709\u6743\u5c55\u793a\u3001\u4f7f\u7528\u6216\u505a\u5176\u4ed6\u5904\u7406\u3002</span></p><p data-lake-id=\\"u6770d1d1\\" id=\\"u6770d1d1\\"><span data-lake-id=\\"u239f105c\\" id=\\"u239f105c\\" class=\\"lake-fontsize-14\\">2</span><span data-lake-id=\\"u4ea32d4b\\" id=\\"u4ea32d4b\\" class=\\"lake-fontsize-14\\">\u3001\u672c\u7f51\u7ad9\u6240\u6709\u7684\u4ea7\u54c1\u3001\u670d\u52a1\u3001\u6280\u672f\u4e0e\u6240\u6709\u7a0b\u5e8f\u7684\u77e5\u8bc6\u4ea7\u6743\u5747\u5f52\u5c5e\u4e8e\u6211\u4eec\u6216\u5f52\u5176\u6743\u5229\u4eba\u6240\u6709\u3002</span></p><p data-lake-id=\\"uca153084\\" id=\\"uca153084\\"><span data-lake-id=\\"u5b97be13\\" id=\\"u5b97be13\\" class=\\"lake-fontsize-14\\">3</span><span data-lake-id=\\"u3fc11e93\\" id=\\"u3fc11e93\\" class=\\"lake-fontsize-14\\">\u3001\u9664\u975e\u6211\u4eec\u53e6\u884c\u58f0\u660e\uff0c\u6211\u4eec\u62e5\u6709\u6211\u4eec\u5728\u7f51\u7ad9\u5185\u53d1\u5e03\u6587\u6863\u7b49\u4fe1\u606f\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u6587\u5b57\u3001\u56fe\u5f62\u3001\u56fe\u7247\u3001\u7167\u7247\u3001\u97f3\u9891\u3001\u89c6\u9891\u3001\u56fe\u6807\u3001\u8272\u5f69\u3001\u7248\u9762\u8bbe\u8ba1\u3001\u7535\u5b50\u6587\u6863\uff09\u7684\u6240\u6709\u6743\u5229\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u7248\u6743\u3001\u5546\u6807\u6743\u3001\u4e13\u5229\u6743\u3001\u5546\u4e1a\u79d8\u5bc6\u548c\u5176\u4ed6\u6240\u6709\u76f8\u5173\u6743\u5229\uff09\u3002\u672a\u7ecf\u6743\u5229\u4eba\u8bb8\u53ef\uff0c\u4efb\u4f55\u4eba\u4e0d\u5f97\u64c5\u81ea\u4f7f\u7528\u5982\u4e0a\u5185\u5bb9\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u901a\u8fc7\u7a0b\u5e8f\u6216\u8bbe\u5907\u76d1\u89c6\u3001\u590d\u5236\u3001\u8f6c\u64ad\u3001\u5c55\u793a\u3001\u955c\u50cf\u3001\u4e0a\u4f20\u3001\u4e0b\u8f7d\u672c\u7f51\u7ad9\u5185\u7684\u4efb\u4f55\u5185\u5bb9\uff09\u3002\u88ab\u6388\u6743\u6d4f\u89c8\u3001\u590d\u5236\u3001\u6253\u5370\u548c\u4f20\u64ad\u5c5e\u4e8e\u672c\u7f51\u7ad9\u5185\u4fe1\u606f\u5185\u5bb9\u7684\uff0c\u8be5\u7b49\u5185\u5bb9\u90fd\u4e0d\u5f97\u7528\u4e8e\u5546\u4e1a\u76ee\u7684\u4e14\u6240\u6709\u4fe1\u606f\u5185\u5bb9\u53ca\u5176\u4efb\u4f55\u90e8\u5206\u7684\u4f7f\u7528\u90fd\u5fc5\u987b\u5305\u62ec\u6b64\u6743\u5229\u58f0\u660e\u3002</span></p><p data-lake-id=\\"u5cd7ac78\\" id=\\"u5cd7ac78\\"><span data-lake-id=\\"u7ae2d61d\\" id=\\"u7ae2d61d\\" class=\\"lake-fontsize-14\\">\u200b</span><br></p><p data-lake-id=\\"u5380c4e6\\" id=\\"u5380c4e6\\"><strong><span data-lake-id=\\"ubcf3318f\\" id=\\"ubcf3318f\\" class=\\"lake-fontsize-14\\">\u514d\u8d23\u6761\u6b3e\uff08\u9664\u975e\u6cd5\u5f8b\u6709\u5f3a\u5236\u6027\u7684\u89c4\u5b9a\u4e0d\u5f97\u514d\u8d23\uff09</span></strong></p><p data-lake-id=\\"u2183c213\\" id=\\"u2183c213\\"><span data-lake-id=\\"u2d4c5cf8\\" id=\\"u2d4c5cf8\\" class=\\"lake-fontsize-14\\">1</span><span data-lake-id=\\"uffeb07d8\\" id=\\"uffeb07d8\\" class=\\"lake-fontsize-14\\">\u3001\u672c\u7f51\u7ad9\u4e0a\u7684\u6240\u6709\u8d44\u6599\u4ec5\u4f9b\u7528\u6237\u53c2\u8003\uff0c\u4e0d\u5e94\u89c6\u4f5c\u6295\u8d44\u5efa\u8bae\u6216\u4efb\u4f55\u5f62\u5f0f\u7684\u6295\u8d44\u62db\u63fd\u3002\u5bf9\u672c\u7f51\u7ad9\u7684\u5185\u5bb9\uff0c\u6211\u4eec\u5df2\u5c3d\u6700\u5927\u52aa\u529b\u7684\u5ba1\u6838\uff0c\u4f46\u4e0d\u63d0\u4f9b\u4efb\u4f55\u5f62\u5f0f\u7684\u660e\u793a\u7684\u6216\u9ed8\u793a\u7684\u5173\u4e8e\u5185\u5bb9\u7684\u6b63\u786e\u6027\u3001\u53ca\u65f6\u6027\u3001\u6709\u6548\u6027\u3001\u7a33\u5b9a\u6027\u3001\u53ef\u7528\u6027\u3001\u4e0d\u4fb5\u72af\u4ed6\u4eba\u6743\u5229\u7b49\u65b9\u9762\u7684\u4fdd\u8bc1\uff1b\u4e0d\u4fdd\u8bc1\u670d\u52a1\u5668\u7684\u7a33\u5b9a\u6027\uff0c\u4e0d\u4fdd\u8bc1\u60a8\u4efb\u4f55\u65f6\u5019\u5747\u53ef\u6d4f\u89c8\u3001\u9605\u8bfb\u3001\u590d\u5236\u3001\u4f7f\u7528\u672c\u7f51\u7ad9\uff1b\u4e0d\u4fdd\u8bc1\u7f51\u7ad9\u5185\u5bb9\u6240\u5305\u542b\u7684\u6587\u5b57\u3001\u56fe\u5f62\u3001\u6750\u6599\u3001\u94fe\u63a5\u3001\u8bf4\u660e\u3001\u9648\u8ff0\u6216\u5176\u5b83\u4e8b\u9879\u7684\u51c6\u786e\u6027\u6216\u5b8c\u6574\u6027</span><span data-lake-id=\\"ua0beefcf\\" id=\\"ua0beefcf\\" class=\\"lake-fontsize-14\\">,</span><span data-lake-id=\\"u73c6d9c2\\" id=\\"u73c6d9c2\\" class=\\"lake-fontsize-14\\">\u4e5f\u4e0d\u4fdd\u8bc1\u672c\u7f51\u7ad9\u7684\u5185\u5bb9\u4e0d\u5b58\u5728\u6253\u5370\u3001\u590d\u5236\u53ca\u5176\u4ed6\u8f93\u5165\u65b9\u9762\u7684\u9519\u8bef\u3002</span></p><p data-lake-id=\\"u65754edf\\" id=\\"u65754edf\\"><span data-lake-id=\\"u8501f4b6\\" id=\\"u8501f4b6\\" class=\\"lake-fontsize-14\\">2</span><span data-lake-id=\\"u531354e5\\" id=\\"u531354e5\\" class=\\"lake-fontsize-14\\">\u3001\u5728\u4efb\u4f55\u60c5\u51b5\u4e0b\uff0c\u5bf9\u4e8e\u56e0\u4f7f\u7528\u672c\u7f51\u7ad9\u5185\u5bb9\u6216\u65e0\u6cd5\u8fdb\u5165\u672c\u7f51\u7ad9\u800c\u5bfc\u81f4\u7684\u4efb\u4f55\u76f4\u63a5\u7684\u3001\u95f4\u63a5\u7684\u3001\u9644\u5e26\u7684\u3001\u7ed9\u7b2c\u4e09\u4eba\u9020\u6210\u7684\u635f\u5931</span><span data-lake-id=\\"ue8b7b3d9\\" id=\\"ue8b7b3d9\\" class=\\"lake-fontsize-14\\">(</span><span data-lake-id=\\"u66b2d65b\\" id=\\"u66b2d65b\\" class=\\"lake-fontsize-14\\">\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u5229\u6da6\u635f\u5931\u3001\u4fe1\u606f\u6570\u636e\u4e22\u5931\u3001\u8d22\u4ea7\u6bc1\u574f\u7b49\u635f\u5931</span><span data-lake-id=\\"u2e70ad40\\" id=\\"u2e70ad40\\" class=\\"lake-fontsize-14\\">)</span><span data-lake-id=\\"u3a801e70\\" id=\\"u3a801e70\\" class=\\"lake-fontsize-14\\">\uff0c\u672c\u7f51\u7ad9\u5747\u65e0\u987b\u627f\u62c5\u6cd5\u5f8b\u8d23\u4efb\uff0c\u4e0d\u8bba\u662f\u91c7\u7528\u5408\u540c\u4e4b\u8bc9\u3001\u4fb5\u6743\u4e4b\u8bc9\u6216\u5176\u4ed6\u8bc9\u8bbc\u7406\u7531\u3002</span></p><p data-lake-id=\\"u91134f60\\" id=\\"u91134f60\\"><span data-lake-id=\\"u26d8e937\\" id=\\"u26d8e937\\" class=\\"lake-fontsize-14\\">3</span><span data-lake-id=\\"u2e04542d\\" id=\\"u2e04542d\\" class=\\"lake-fontsize-14\\">\u3001\u4e3a\u65b9\u4fbf\u60a8\u4f7f\u7528\uff0c\u672c\u7f51\u7ad9\u8bbe\u7acb\u4e86\u540c\u7b2c\u4e09\u65b9\u6240\u6709\u548c\u8fd0\u8425\u800c\u975e\u6211\u4eec\u7ef4\u62a4\u7684\u5176\u4ed6\u7f51\u7ad9\u4e4b\u95f4\u7684\u94fe\u63a5\u3002\u5c3d\u7ba1\u5982\u6b64\uff0c\u5373\u4f7f\u4e0a\u8ff0\u7b2c\u4e09\u65b9\u662f\u6211\u4eec\u7684\u5173\u8054\u65b9\uff0c\u6211\u4eec\u5bf9\u94fe\u63a5\u7f51\u7ad9\u4e5f\u4e0d\u884c\u4f7f\u4efb\u4f55\u63a7\u5236\u6743\uff0c\u6211\u4eec\u4e0d\u5bf9\u4efb\u4f55\u94fe\u63a5\u7f51\u7ad9\u7684\u5185\u5bb9\u8d1f\u6709\u8d23\u4efb\uff0c\u4e5f\u4e0d\u5bf9\u6b64\u7c7b\u7f51\u7ad9\u63d0\u4f9b\u6750\u6599\u7684\u5185\u5bb9\u6216\u771f\u5b9e\u6027\u505a\u51fa\u4efb\u4f55\u58f0\u660e\u3002\u672c\u7f51\u7ad9\u7528\u6237\u5bf9\u4e8e\u5982\u4f55\u4f7f\u7528\u8be5\u7b49\u7f51\u7ad9\uff0c\u9700\u505a\u51fa\u4e2a\u4eba\u7684\u72ec\u7acb\u5224\u65ad\u3002</span></p><p data-lake-id=\\"u20dfa670\\" id=\\"u20dfa670\\"><span data-lake-id=\\"u1f308920\\" id=\\"u1f308920\\" class=\\"lake-fontsize-14\\">4</span><span data-lake-id=\\"u6dbb818d\\" id=\\"u6dbb818d\\" class=\\"lake-fontsize-14\\">\u3001\u672c\u7f51\u7ad9\u4e2d\u6709\u5173\u963f\u91cc\u5df4\u5df4\u672a\u6765\u4e1a\u52a1\u7684\u4efb\u4f55\u524d\u77bb\u6027\u58f0\u660e\u672c\u8d28\u4e0a\u90fd\u5c5e\u4e8e\u6839\u636e\u73b0\u6709\u4fe1\u606f\u3001\u7ecf\u8425\u8ba1\u5212\u548c\u5bf9\u672a\u6765\u5f62\u52bf\u548c\u8d8b\u52bf\u7684\u9884\u6d4b\u800c\u505a\u51fa\u7684\u63a8\u65ad\uff0c\u53d7\u8bb8\u591a\u98ce\u9669\u548c\u4e0d\u786e\u5b9a\u56e0\u7d20\u7684\u5f71\u54cd\uff0c\u6211\u4eec\u53ef\u80fd\u4f1a\u6839\u636e\u5e02\u573a\u6216\u5176\u4ed6\u56e0\u7d20\u968f\u65f6\u81ea\u884c\u51b3\u5b9a\u66f4\u6539\uff0c\u5e76\u4e14\u65e0\u610f\u4ee5\u4efb\u4f55\u65b9\u5f0f\u5bf9\u672a\u6765\u63d0\u4f9b\u7684\u670d\u52a1\u3001\u8ba1\u5212\u505a\u51fa\u627f\u8bfa\u3002</span></p><p data-lake-id=\\"ud30ef1da\\" id=\\"ud30ef1da\\"><span data-lake-id=\\"u8805a054\\" id=\\"u8805a054\\" class=\\"lake-fontsize-14\\">\u200b</span><br></p><p data-lake-id=\\"uba45d9b7\\" id=\\"uba45d9b7\\"><strong><span data-lake-id=\\"u7e0288d7\\" id=\\"u7e0288d7\\" class=\\"lake-fontsize-14\\">\u9002\u7528\u6cd5\u5f8b\u53ca\u4e89\u8bae\u89e3\u51b3</span></strong></p><p data-lake-id=\\"u93ecd94a\\" id=\\"u93ecd94a\\"><span data-lake-id=\\"u912b82f0\\" id=\\"u912b82f0\\" class=\\"lake-fontsize-14\\">1</span><span data-lake-id=\\"u74a65efc\\" id=\\"u74a65efc\\" class=\\"lake-fontsize-14\\">\u3001\u672c\u7f51\u7ad9\u53ca\u672c\u6cd5\u5f8b\u58f0\u660e\u7684\u6210\u7acb\u3001\u751f\u6548\u3001\u89e3\u91ca\u53ca\u7ea0\u7eb7\u89e3\u51b3\uff0c\u9002\u7528\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6cd5\u5f8b\u3002\u82e5\u60a8\u548c\u6211\u4eec\u53d1\u751f\u4efb\u4f55\u7ea0\u7eb7\u6216\u4e89\u8bae\uff0c\u9996\u5148\u5e94\u53cb\u597d\u534f\u5546\u89e3\u51b3\uff1b\u534f\u5546\u4e0d\u6210\u7684\uff0c\u53cc\u65b9\u5747\u540c\u610f\u5c06\u7ea0\u7eb7\u6216\u4e89\u8bae\u63d0\u4ea4\u676d\u5dde\u5e02\u4f59\u676d\u533a\u4eba\u6c11\u6cd5\u9662\u89e3\u51b3\u3002</span></p><p data-lake-id=\\"u465de6ef\\" id=\\"u465de6ef\\"><span data-lake-id=\\"ub5e0b962\\" id=\\"ub5e0b962\\" class=\\"lake-fontsize-14\\">2</span><span data-lake-id=\\"u7edb7c0d\\" id=\\"u7edb7c0d\\" class=\\"lake-fontsize-14\\">\u3001\u672c\u6cd5\u5f8b\u58f0\u660e\u4efb\u4e00\u6761\u6b3e\u88ab\u89c6\u4e3a\u5e9f\u6b62\u3001\u65e0\u6548\u6216\u4e0d\u53ef\u6267\u884c\uff0c\u8be5\u6761\u5e94\u89c6\u4e3a\u53ef\u5206\u7684\u4e14\u4e0d\u5f71\u54cd\u672c\u6cd5\u5f8b\u58f0\u660e\u5176\u4f59\u6761\u6b3e\u7684\u6709\u6548\u6027\u53ca\u53ef\u6267\u884c\u6027\u3002</span></p><p data-lake-id=\\"u367f9328\\" id=\\"u367f9328\\"><span data-lake-id=\\"u25ed24b4\\" id=\\"u25ed24b4\\" class=\\"lake-fontsize-14\\">\u200b</span><br></p>"}')},23243:function(e){"use strict";e.exports=JSON.parse('{"title":"\u6cd5\u5f8b\u8072\u660e","content":"<p data-lake-id=\\"u453933e8\\" id=\\"u453933e8\\"><span data-lake-id=\\"u549fbb8b\\" id=\\"u549fbb8b\\">\u6b61\u8fce\u60a8\u8a2a\u554f\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u5b98\u65b9\u7db2\u7ad9\uff08\u4ee5\u4e0b\u7a31\u300c\u672c\u7db2\u7ad9\u300d\uff09\uff0c\u672c\u7db2\u7ad9\u7684\u670d\u52d9\uff08\u4ee5\u4e0b\u6216\u7a31\u300c\u672c\u670d\u52d9\u300d\uff09\u7531\u963f\u91cc\u5df4\u5df4\uff08\u4e2d\u570b\uff09\u6709\u9650\u516c\u53f8\uff08\u4ee5\u4e0b\u7a31\u300c\u6211\u5011\u300d\uff09\u63d0\u4f9b\u3002\u8acb\u60a8\u4ed4\u7d30\u95b1\u8b80\u3001\u5145\u5206\u7406\u89e3\u4ee5\u4e0b\u689d\u6b3e\uff0c\u7279\u5225\u662f\u300c\u6b0a\u5229\u8072\u660e\u300d\u689d\u6b3e\u3001\u300c\u514d\u8cac\u689d\u6b3e\u300d\u689d\u6b3e\u4ee5\u53ca\u300c\u9069\u7528\u6cd5\u5f8b\u53ca\u722d\u8b70\u89e3\u6c7a\u300d\u689d\u6b3e\u3002\u60a8\u8a2a\u554f\u3001\u700f\u89bd\u548c</span><span data-lake-id=\\"u1d8cbd86\\" id=\\"u1d8cbd86\\">/</span><span data-lake-id=\\"ubbdd9346\\" id=\\"ubbdd9346\\">\u6216\u4f7f\u7528\u672c\u7db2\u7ad9\uff0c\u4ee3\u8868\u60a8\u540c\u610f\u63a5\u53d7\u4ee5\u4e0b\u689d\u6b3e\uff1b\u5982\u679c\u60a8\u4e0d\u540c\u610f\u63a5\u53d7\u4ee5\u4e0b\u689d\u6b3e\uff0c\u8acb\u7acb\u5373\u505c\u6b62\u8a2a\u554f\u3001\u700f\u89bd\u548c\u4f7f\u7528\u672c\u7db2\u7ad9\u3002\u6211\u5011\u4fdd\u7559\u96a8\u6642\u4fee\u6539\u9019\u4e9b\u689d\u6b3e\u7684\u6b0a\u5229\u3002</span></p><p data-lake-id=\\"uc7231621\\" id=\\"uc7231621\\"><strong><span data-lake-id=\\"ub5839712\\" id=\\"ub5839712\\">\u6b0a\u5229\u8072\u660e</span></strong></p><p data-lake-id=\\"u68a57cfd\\" id=\\"u68a57cfd\\"><span data-lake-id=\\"u771d6608\\" id=\\"u771d6608\\">1</span><span data-lake-id=\\"u38963404\\" id=\\"u38963404\\">\u3001\u672c\u7db2\u7ad9\u4e0a\u7684\u300c\u963f\u91cc\u5df4\u5df4\u300d\u3001\u300c</span><span data-lake-id=\\"u30afe6ae\\" id=\\"u30afe6ae\\">ALIBABA</span><span data-lake-id=\\"uab8a1565\\" id=\\"uab8a1565\\">\u300d\u3001\u300c</span><img type=\\"inline\\" name=\\"image\\" src=\\"https://static.alibabagroup.com/static/e6d1ba46-99ad-4726-8e35-8189d503d28b.png\\"></img><span data-lake-id=\\"ufb8edb58\\" id=\\"ufb8edb58\\">\u300d\u7b49\u6587\u5b57\u53ca</span><span data-lake-id=\\"u7d41d0ed\\" id=\\"u7d41d0ed\\">/</span><span data-lake-id=\\"u4bd27a9c\\" id=\\"u4bd27a9c\\">\u6216\u6a19\u8b58\uff0c\u4ee5\u53ca\u672c\u7db2\u7ad9\u4e0a\u7684\u5176\u4ed6\u6a19\u8b58\u3001\u5fbd\u8a18\u3001\u7522\u54c1\u548c\u670d\u52d9\u540d\u7a31\u5747\u70ba\u6211\u5011\u53ca\u6211\u5011\u7684\u95dc\u806f\u516c\u53f8\uff08\u4ee5\u4e0b\u5408\u7a31\u300c\u963f\u91cc\u5df4\u5df4\u300d\uff09\u5728\u4e2d\u570b\u548c\u5176\u4ed6\u570b\u5bb6\u7684\u8a3b\u518a\u5546\u6a19\u3002\u672a\u7d93\u6b0a\u5229\u4eba\u66f8\u9762\u6388\u6b0a\uff0c\u4efb\u4f55\u4eba\u4e0d\u5f97\u4ee5\u4efb\u4f55\u65b9\u5f0f\u5c55\u793a\u3001\u4f7f\u7528\u6216\u505a\u5176\u4ed6\u8655\u7406\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u8907\u88fd\u3001\u50b3\u64ad\u3001\u5c55\u793a\u3001\u93e1\u50cf\u3001\u4e0a\u50b3\u3001\u4e0b\u8f09\uff09\uff0c\u4e5f\u4e0d\u5f97\u5411\u4ed6\u4eba\u8868\u660e\u60a8\u6709\u6b0a\u5c55\u793a\u3001\u4f7f\u7528\u6216\u4f5c\u51fa\u5176\u4ed6\u8655\u7406\u3002</span></p><p data-lake-id=\\"u1e9a95db\\" id=\\"u1e9a95db\\"><span data-lake-id=\\"u3f24d2e4\\" id=\\"u3f24d2e4\\">2</span><span data-lake-id=\\"ud9947eb1\\" id=\\"ud9947eb1\\">\u3001\u672c\u7db2\u7ad9\u6240\u6709\u7684\u7522\u54c1\u3001\u670d\u52d9\u3001\u6280\u8853\u8207\u6240\u6709\u7a0b\u5e8f\u7684\u77e5\u8b58\u7522\u6b0a\u5747\u6b78\u5c6c\u65bc\u6211\u5011\u6216\u6b78\u5176\u6b0a\u5229\u4eba\u6240\u6709\u3002</span></p><p data-lake-id=\\"uac6e8ddf\\" id=\\"uac6e8ddf\\"><span data-lake-id=\\"ub9ef521e\\" id=\\"ub9ef521e\\">3</span><span data-lake-id=\\"u1f9aba00\\" id=\\"u1f9aba00\\">\u3001\u9664\u975e\u6211\u5011\u53e6\u884c\u8072\u660e\uff0c\u6211\u5011\u64c1\u6709\u6211\u5011\u5728\u7db2\u7ad9\u5167\u767c\u4f48\u6587\u6a94\u7b49\u8cc7\u8a0a\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u6587\u5b57\u3001\u5716\u5f62\u3001\u5716\u7247\u3001\u7167\u7247\u3001\u8072\u97f3\u3001\u5f71\u7247\u3001\u5716\u6a19\u3001\u8272\u5f69\u3001\u7248\u9762\u8a2d\u8a08\u3001\u96fb\u5b50\u6587\u6a94\uff09\u7684\u6240\u6709\u6b0a\u5229\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u7248\u6b0a\u3001\u5546\u6a19\u6b0a\u3001\u5c08\u5229\u6b0a\u3001\u5546\u696d\u79d8\u5bc6\u548c\u5176\u4ed6\u6240\u6709\u76f8\u95dc\u6b0a\u5229\uff09\u3002\u672a\u7d93\u6b0a\u5229\u4eba\u8a31\u53ef\uff0c\u4efb\u4f55\u4eba\u4e0d\u5f97\u64c5\u81ea\u4f7f\u7528\u5982\u4e0a\u5167\u5bb9\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u900f\u904e\u7a0b\u5e8f\u6216\u8a2d\u5099\u76e3\u8996\u3001\u8907\u88fd\u3001\u8f49\u64ad\u3001\u5c55\u793a\u3001\u93e1\u50cf\u3001\u4e0a\u50b3\u3001\u4e0b\u8f09\u672c\u7db2\u7ad9\u5167\u7684\u4efb\u4f55\u5167\u5bb9\uff09\u3002\u88ab\u6388\u6b0a\u700f\u89bd\u3001\u8907\u88fd\u3001\u5217\u5370\u548c\u50b3\u64ad\u5c6c\u65bc\u672c\u7db2\u7ad9\u5167\u8cc7\u8a0a\u5167\u5bb9\u7684\uff0c\u8a72\u7b49\u5167\u5bb9\u90fd\u4e0d\u5f97\u7528\u65bc\u5546\u696d\u76ee\u7684\u4e14\u6240\u6709\u8cc7\u8a0a\u5167\u5bb9\u53ca\u5176\u4efb\u4f55\u90e8\u5206\u7684\u4f7f\u7528\u90fd\u5fc5\u9808\u5305\u62ec\u6b64\u6b0a\u5229\u8072\u660e\u3002</span></p><p data-lake-id=\\"ud01ae3fb\\" id=\\"ud01ae3fb\\"><span data-lake-id=\\"uf61ef0cd\\" id=\\"uf61ef0cd\\" class=\\"lake-fontsize-14\\">\u200b</span><br></p><p data-lake-id=\\"u4fc594b4\\" id=\\"u4fc594b4\\"><strong><span data-lake-id=\\"u9e8d1505\\" id=\\"u9e8d1505\\">\u514d\u8cac\u689d\u6b3e\uff08\u9664\u975e\u6cd5\u5f8b\u6709\u5f37\u5236\u6027\u7684\u898f\u5b9a\u4e0d\u5f97\u514d\u8cac\uff09</span></strong></p><p data-lake-id=\\"u8d82a539\\" id=\\"u8d82a539\\"><span data-lake-id=\\"u1981797b\\" id=\\"u1981797b\\">1</span><span data-lake-id=\\"u0dc5af06\\" id=\\"u0dc5af06\\">\u3001\u672c\u7db2\u7ad9\u4e0a\u7684\u6240\u6709\u8cc7\u6599\u50c5\u4f9b\u7528\u6236\u53c3\u8003\uff0c\u4e0d\u61c9\u8996\u4f5c\u6295\u8cc7\u5efa\u8b70\u6216\u4efb\u4f55\u5f62\u5f0f\u7684\u6295\u8cc7\u62db\u652c\u3002\u5c0d\u672c\u7db2\u7ad9\u7684\u5167\u5bb9\uff0c\u6211\u5011\u5df2\u76e1\u6700\u5927\u52aa\u529b\u7684\u5be9\u6838\uff0c\u4f46\u4e0d\u63d0\u4f9b\u4efb\u4f55\u5f62\u5f0f\u7684\u660e\u793a\u7684\u6216\u9ed8\u793a\u7684\u95dc\u65bc\u5167\u5bb9\u7684\u6b63\u78ba\u6027\u3001\u53ca\u6642\u6027\u3001\u6709\u6548\u6027\u3001\u7a69\u5b9a\u6027\u3001\u53ef\u7528\u6027\u3001\u4e0d\u4fb5\u72af\u4ed6\u4eba\u6b0a\u5229\u7b49\u65b9\u9762\u7684\u4fdd\u8b49\uff1b\u4e0d\u4fdd\u8b49\u4f3a\u670d\u5668\u7684\u7a69\u5b9a\u6027\uff0c\u4e0d\u4fdd\u8b49\u60a8\u4efb\u4f55\u6642\u5019\u5747\u53ef\u700f\u89bd\u3001\u95b1\u8b80\u3001\u8907\u88fd\u3001\u4f7f\u7528\u672c\u7db2\u7ad9\uff1b\u4e0d\u4fdd\u8b49\u7db2\u7ad9\u5167\u5bb9\u6240\u5305\u542b\u7684\u6587\u5b57\u3001\u5716\u5f62\u3001\u6750\u6599\u3001\u9023\u7d50\u3001\u8aaa\u660e\u3001\u9673\u8ff0\u6216\u5176\u5b83\u4e8b\u9805\u7684\u6e96\u78ba\u6027\u6216\u5b8c\u6574\u6027\uff0c\u4e5f\u4e0d\u4fdd\u8b49\u672c\u7db2\u7ad9\u7684\u5167\u5bb9\u4e0d\u5b58\u5728\u5217\u5370\u3001\u8907\u88fd\u53ca\u5176\u4ed6\u8f38\u5165\u65b9\u9762\u7684\u932f\u8aa4\u3002</span></p><p data-lake-id=\\"uf4b1c78e\\" id=\\"uf4b1c78e\\"><span data-lake-id=\\"u0544f7d7\\" id=\\"u0544f7d7\\">2</span><span data-lake-id=\\"u3cd3d611\\" id=\\"u3cd3d611\\">\u3001\u5728\u4efb\u4f55\u60c5\u6cc1\u4e0b\uff0c\u5c0d\u65bc\u56e0\u4f7f\u7528\u672c\u7db2\u7ad9\u5167\u5bb9\u6216\u7121\u6cd5\u9032\u5165\u672c\u7db2\u7ad9\u800c\u5c0e\u81f4\u7684\u4efb\u4f55\u76f4\u63a5\u7684\u3001\u9593\u63a5\u7684\u3001\u9644\u5e36\u7684\u3001\u7d66\u7b2c\u4e09\u4eba\u9020\u6210\u7684\u640d\u5931\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u5229\u6f64\u640d\u5931\u3001\u8cc7\u8a0a\u8cc7\u6599\u4e1f\u5931\u3001\u8ca1\u7522\u6bc0\u58de\u7b49\u640d\u5931\uff09\uff0c\u672c\u7db2\u7ad9\u5747\u7121\u9808\u627f\u64d4\u6cd5\u5f8b\u8cac\u4efb\uff0c\u4e0d\u8ad6\u662f\u63a1\u7528\u5408\u540c\u4e4b\u8a34\u3001\u4fb5\u6b0a\u4e4b\u8a34\u6216\u5176\u4ed6\u8a34\u8a1f\u7406\u7531\u3002</span></p><p data-lake-id=\\"u92e21fec\\" id=\\"u92e21fec\\"><span data-lake-id=\\"u0d94c8c5\\" id=\\"u0d94c8c5\\">3</span><span data-lake-id=\\"u57a3030f\\" id=\\"u57a3030f\\">\u3001\u70ba\u65b9\u4fbf\u60a8\u4f7f\u7528\uff0c\u672c\u7db2\u7ad9\u8a2d\u7acb\u4e86\u540c\u7b2c\u4e09\u65b9\u6240\u6709\u548c\u71df\u904b\u800c\u975e\u6211\u5011\u7dad\u8b77\u7684\u5176\u4ed6\u7db2\u7ad9\u4e4b\u9593\u7684\u9023\u7d50\u3002\u5118\u7ba1\u5982\u6b64\uff0c\u5373\u4f7f\u4e0a\u8ff0\u7b2c\u4e09\u65b9\u662f\u6211\u5011\u7684\u95dc\u806f\u65b9\uff0c\u6211\u5011\u5c0d\u9023\u7d50\u7db2\u7ad9\u4e5f\u4e0d\u884c\u4f7f\u4efb\u4f55\u63a7\u5236\u6b0a\uff0c\u6211\u5011\u4e0d\u5c0d\u4efb\u4f55\u9023\u7d50\u7db2\u7ad9\u7684\u5167\u5bb9\u8ca0\u6709\u8cac\u4efb\uff0c\u4e5f\u4e0d\u5c0d\u6b64\u985e\u7db2\u7ad9\u63d0\u4f9b\u6750\u6599\u7684\u5167\u5bb9\u6216\u771f\u5be6\u6027\u4f5c\u51fa\u4efb\u4f55\u8072\u660e\u3002\u672c\u7db2\u7ad9\u7528\u6236\u5c0d\u65bc\u5982\u4f55\u4f7f\u7528\u8a72\u7b49\u7db2\u7ad9\uff0c\u9700\u4f5c\u51fa\u500b\u4eba\u7684\u7368\u7acb\u5224\u65b7\u3002</span></p><p data-lake-id=\\"u835c895a\\" id=\\"u835c895a\\"><span data-lake-id=\\"ud116483c\\" id=\\"ud116483c\\">4</span><span data-lake-id=\\"u283f69b7\\" id=\\"u283f69b7\\">\u3001\u672c\u7db2\u7ad9\u4e2d\u6709\u95dc\u963f\u91cc\u5df4\u5df4\u672a\u4f86\u696d\u52d9\u7684\u4efb\u4f55\u524d\u77bb\u6027\u8072\u660e\u672c\u8cea\u4e0a\u90fd\u5c6c\u65bc\u6839\u64da\u73fe\u6709\u8cc7\u8a0a\u3001\u7d93\u71df\u8a08\u5283\u548c\u5c0d\u672a\u4f86\u5f62\u52e2\u548c\u8da8\u52e2\u7684\u9810\u6e2c\u800c\u4f5c\u51fa\u7684\u63a8\u65b7\uff0c\u53d7\u8a31\u591a\u98a8\u96aa\u548c\u4e0d\u78ba\u5b9a\u56e0\u7d20\u7684\u5f71\u97ff\uff0c\u6211\u5011\u53ef\u80fd\u6703\u6839\u64da\u5e02\u5834\u6216\u5176\u4ed6\u56e0\u7d20\u96a8\u6642\u81ea\u884c\u6c7a\u5b9a\u66f4\u6539\uff0c\u4e26\u4e14\u7121\u610f\u4ee5\u4efb\u4f55\u65b9\u5f0f\u5c0d\u672a\u4f86\u63d0\u4f9b\u7684\u670d\u52d9\u3001\u8a08\u5283\u4f5c\u51fa\u627f\u8afe\u3002</span></p><p data-lake-id=\\"u45c5313b\\" id=\\"u45c5313b\\"><span data-lake-id=\\"u39ccea9e\\" id=\\"u39ccea9e\\" class=\\"lake-fontsize-14\\">\u200b</span><br></p><p data-lake-id=\\"ue756bc8f\\" id=\\"ue756bc8f\\"><strong><span data-lake-id=\\"uc97150c6\\" id=\\"uc97150c6\\">\u9069\u7528\u6cd5\u5f8b\u53ca\u722d\u8b70\u89e3\u6c7a</span></strong></p><p data-lake-id=\\"u99a42e8a\\" id=\\"u99a42e8a\\"><span data-lake-id=\\"u30d13408\\" id=\\"u30d13408\\">1</span><span data-lake-id=\\"ua7fb8755\\" id=\\"ua7fb8755\\">\u3001\u672c\u7db2\u7ad9\u53ca\u672c\u6cd5\u5f8b\u8072\u660e\u7684\u6210\u7acb\u3001\u751f\u6548\u3001\u89e3\u91cb\u53ca\u7cfe\u7d1b\u89e3\u6c7a\uff0c\u9069\u7528\u4e2d\u83ef\u4eba\u6c11\u5171\u548c\u570b\u6cd5\u5f8b\u3002\u82e5\u60a8\u548c\u6211\u5011\u767c\u751f\u4efb\u4f55\u7cfe\u7d1b\u6216\u722d\u8b70\uff0c\u9996\u5148\u61c9\u53cb\u597d\u5354\u5546\u89e3\u6c7a\uff1b\u5354\u5546\u4e0d\u6210\u7684\uff0c\u96d9\u65b9\u5747\u540c\u610f\u5c07\u7cfe\u7d1b\u6216\u722d\u8b70\u63d0\u4ea4\u676d\u5dde\u5e02\u9918\u676d\u5340\u4eba\u6c11\u6cd5\u9662\u89e3\u6c7a\u3002</span></p><p data-lake-id=\\"ua46f214a\\" id=\\"ua46f214a\\"><span data-lake-id=\\"u5492f6b0\\" id=\\"u5492f6b0\\" class=\\"lake-fontsize-12\\">2\u3001\u672c\u6cd5\u5f8b\u8072\u660e\u4efb\u4e00\u689d\u6b3e\u88ab\u8996\u70ba\u5ee2\u6b62\u3001\u7121\u6548\u6216\u4e0d\u53ef\u57f7\u884c\uff0c\u8a72\u689d\u61c9\u8996\u70ba\u53ef\u5206\u7684\u4e14\u4e0d\u5f71\u97ff\u672c\u6cd5\u5f8b\u8072\u660e\u5176\u9918\u689d\u6b3e\u7684\u6709\u6548\u6027\u53ca\u53ef\u57f7\u884c\u6027\u3002</span></p>"}')},61173:function(e){"use strict";e.exports=JSON.parse('{"title":"Email Alerts","subTitle":"If you want to get the most updated information from Alibaba Group, please provide your information below and choose which category(s) of email alerts you would like to receive.","firstName":"First Name","lastName":"Last Name","userType":"I am a/an","userState":"Country / Region","email":"Email","organization":"Organization","phone":"Phone","subject":"Subject","message":"Message","verificationCode":"Verification Code","submit":"Submit","privacyStatement":"Privacy Statement","statementTop":"To opt-in for investor email alerts, please input your email address in the field below and select at least one alert option. After submitting your request, you will receive an activation email to the requested email address. You must click the activation link in order to complete your subscription.\xa0\\n \\n You can unsubscribe to any of the investor alerts you are subscribed to by visiting the \u2018unsubscribe\u2019 section below. If you experience any issues with this process, please contact us for further assistance. \\n \\n By providing your email address below, you are providing consent to Alibaba\uff0c to send you the requested Investor Email Alert updates.","statementBottom":"To unsubscribe from our investor relations email alerts, please go to the relevant subscription email and click on \\"unsubscribe\\".","back":"Back","firstNameTip":"Please input your first name","lastNameTip":"Please input your last name","userTypeTip":"Please select user type","userStateTip":"Please select country / region","emailTip":"Please input your email address","phoneTip":"Please input your phone","subjectTip":"Please input subject","messageTip":"Please input message","verificationCodeTip":"Please enter verification code","organizationTip":"Please fill in the organization","category":"Category(s)","categoryTip":"please select category(s)","pressReleases":"Press Releases","events":"Events","SECFilings":"SEC Filings/HKEX Filings","endDayStockQuote":"End of Day Stock Quote","financialReports":"Earnings and Financials","pleaseSelect":"Please select","submitSuccess":"Submitted successfully","company":"Company","companyTip":"Please input your company","position":"Job information","positionTip":"Please input your job information","individualInvestor":"Individual Investor","institutionalInvestor":"Institutional Investor","broker":"Broker","others":"Others"}')},69119:function(e){"use strict";e.exports=JSON.parse('{"title":"\u7535\u90ae\u8ba2\u9605","subTitle":"\u5982\u3000\u9601\u4e0b\u6b32\u83b7\u5f97\u963f\u91cc\u5df4\u5df4\u96c6\u56e2\u7684\u6700\u65b0\u8d44\u8baf\uff0c\u8bf7\u4e8e\u4e0b\u8868\u586b\u59a5\u4e2a\u4eba\u8d44\u6599\u5e76\u9009\u62e9\u5e0c\u671b\u6536\u53d6\u7684\u7535\u90ae\u63d0\u793a\u79cd\u7c7b\u3002","firstName":"\u540d\u5b57","lastName":"\u59d3\u6c0f","userType":"\u7528\u6237\u7c7b\u578b","userState":"\u56fd\u5bb6/\u5730\u533a","organization":"\u673a\u6784","email":"\u7535\u5b50\u90ae\u7bb1","phone":"\u7535\u8bdd","subject":"\u4e3b\u9898","message":"\u5185\u5bb9","verificationCode":"\u9a8c\u8bc1\u7801","submit":"\u63d0\u4ea4","privacyStatement":"\u9690\u79c1\u58f0\u660e","statementContent":"\u60a8\u53ef\u4ee5\u5728\u4e0d\u5411\u6211\u4eec\u63d0\u4f9b\u4efb\u4f55\u4e2a\u4eba\u8d44\u6599\u7684\u60c5\u51b5\u4e0b\u6d4f\u89c8\u672c\u7f51\u7ad9\uff0c\u7136\u800c\uff0c\u5982