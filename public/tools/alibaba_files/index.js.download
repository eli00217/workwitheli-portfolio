7e5","techEthicsReviewDesc":"\u6211\u5011\u5efa\u7acb\u79d1\u6280\u502b\u7406\u5be9\u67e5\u6a5f\u5236\uff0c\u8986\u84cb\u53ef\u80fd\u5e36\u4f86\u502b\u7406\u98a8\u96aa\u7684AI\u79d1\u6280\u6d3b\u52d5\u3002\u5be9\u67e5\u6d41\u7a0b\u5305\u62ec\u98a8\u96aa\u8b58\u5225\u3001\u8a55\u4f30\u8207\u5be9\u67e5\u7b49\u74b0\u7bc0\uff0c\u6839\u64da\u6280\u8853\u985e\u578b\u8207\u98a8\u96aa\u7a0b\u5ea6\u5339\u914d\u5dee\u7570\u5316\u5be9\u67e5\u7a0b\u5e8f\uff0c\u4e26\u5728\u5168\u904e\u7a0b\u4e2d\u6301\u7e8c\u8ddf\u8e64\u98a8\u96aa\u8b8a\u5316\u3002","processTabCardsTitle":"\u7ba1\u7406\u6d41\u7a0b\u8207\u9ad4\u7cfb","modelResearchTab":"\u6a21\u578b\u7814\u767c\u8207\u8a13\u7df4\u968e\u6bb5","sourceScreeningTitle":"\u6e90\u982d\u7be9\u9078","sourceScreeningDesc":"\u5efa\u7acb\u51c6\u5165\u6a5f\u5236\uff0c\u512a\u5148\u63a1\u7528\u5408\u898f\u6b0a\u5a01\u8a9e\u6599\uff0c\u5f15\u5165\u81ea\u5efa\u79d1\u6280\u502b\u7406\u6578\u64da\u96c6\uff0c\u4fdd\u969c\u5408\u898f\u8207\u591a\u6a23\u6027\u3002","multiLayerFilterTitle":"\u6578\u64da\u8655\u7406","multiLayerFilterDesc":"\u69cb\u5efa\u591a\u5c64\u904e\u6ffe\u6a5f\u5236\uff0c\u8b58\u5225\u4e26\u4fee\u6b63\u6b67\u8996\u6027\u8868\u8ff0\u8207\u4e0d\u826f\u50f9\u503c\u89c0\u50be\u5411\uff0c\u964d\u4f4e\u98a8\u96aa\u6578\u64da\u6df7\u5165\u3002","standardAnnotationTitle":"\u898f\u7bc4\u6a19\u8a3b","standardAnnotationDesc":"\u5340\u5206\u529f\u80fd\u6027\u8207\u5b89\u5168\u6027\u6a19\u8a3b\uff0c\u52a0\u5f37\u6a19\u8a3b\u4eba\u54e1\u57f9\u8a13\uff0c\u5efa\u7acb\u4ea4\u53c9\u9a57\u8b49\u6a5f\u5236\uff0c\u4fdd\u969c\u6a19\u8a3b\u7d50\u679c\u6e96\u78ba\u4e00\u81f4\u3002","safetyAlignmentTitle":"\u5b89\u5168\u5c0d\u9f4a","safetyAlignmentDesc":"\u900f\u904e\u504f\u597d\u512a\u5316\u5f15\u5c0e\u6a21\u578b\u5c0d\u9f4a\u4eba\u985e\u50f9\u503c\u89c0\u8207\u5408\u898f\u908a\u754c\uff0c\u4f7f\u6a21\u578b\u5b78\u7fd2\u8b58\u5225\u98a8\u96aa\u6307\u4ee4\u4e26\u4f5c\u51fa\u5b89\u5168\u56de\u8986\u3002","safetyEvaluationTitle":"\u5b89\u5168\u8a55\u6e2c","safetyEvaluationDesc":"\u5f9e\u98a8\u96aa\u985e\u578b\u3001\u653b\u64ca\u624b\u6bb5\u7b49\u591a\u7dad\u5ea6\u958b\u5c55\u5b89\u5168\u8a55\u6e2c\uff0c\u6301\u7e8c\u66f4\u65b0\u984c\u5eab\u61c9\u5c0d\u65b0\u578b\u5a01\u8105\uff0c\u5f62\u6210\u554f\u984c\u767c\u73fe\u5230\u80fd\u529b\u589e\u5f37\u7684\u9589\u74b0\u3002","deploymentInteractionTab":"\u90e8\u7f72\u8207\u904b\u884c\u4ea4\u4e92\u968e\u6bb5","contentAccuracySafetyTitle":"\u5167\u5bb9\u6e96\u78ba\u8207\u5b89\u5168","contentAccuracySafetyDesc":"\u5efa\u7acb\u5e72\u9810\u6a5f\u5236\u8207\u5168\u6a21\u614b\u5b89\u5168\u5f15\u64ce\uff0c\u5c0d\u7528\u6236\u8f38\u5165\u53ca\u6a21\u578b\u8f38\u51fa\u57f7\u884c\u5167\u5bb9\u5b89\u5168\u9632\u8b77\uff0c\u4e26\u5b9a\u671f\u958b\u5c55\u98a8\u96aa\u8a55\u6e2c\u63a8\u52d5\u7b56\u7565\u512a\u5316\u3002","aigcMarkingTitle":"AI\u751f\u6210\u5167\u5bb9\u6a19\u8b58","aigcMarkingDesc":"\u5728\u5167\u5bb9\u53ca\u754c\u9762\u6dfb\u52a0\u986f\u5f0f\u6a19\u8b58\uff0c\u900f\u904e\u6587\u4ef6\u5143\u6578\u64da\u96b1\u5f0f\u6a19\u8b58\uff0c\u78ba\u4fdd\u516c\u773e\u77e5\u60c5\u6b0a\u548c\u4f86\u6e90\u53ef\u8ffd\u6eaf\u3002","userDisclosureFeedbackTitle":"\u7528\u6236\u544a\u77e5\u8207\u53cd\u994b","userDisclosureFeedbackDesc":"\u516c\u958b\u62ab\u9732AI\u670d\u52d9\u4fb7\u9650\u6027\u8207\u4f7f\u7528\u898f\u7bc4\uff0c\u4e26\u5efa\u7acb\u4fbf\u6377\u7684\u53cd\u994b\u8207\u6295\u8a34\u6e20\u9053\uff0c\u53ca\u6642\u53d7\u7406\u8655\u7406\u7528\u6236\u53cd\u994b\u3002","ethicsIncidentResponseTitle":"\u6301\u7e8c\u76e3\u6e2c\u8207\u512a\u5316","ethicsIncidentResponseDesc":"\u5efa\u7acb\u6a21\u578b\u53ca\u61c9\u7528\u904b\u884c\u76e3\u6e2c\u6a5f\u5236\uff0c\u5c0d\u7570\u5e38\u60c5\u6cc1\u53ca\u6642\u9810\u8b66\u4e26\u63a8\u52d5\u6574\u6539\uff0c\u5c0d\u8fed\u4ee3\u66f4\u65b0\u7d00\u9304\u5b58\u6a94\u4e26\u5236\u5b9a\u76f8\u61c9\u5b89\u5168\u7b56\u7565\u3002","supplierManagementSystemTitle":"\u4f9b\u61c9\u5546\u7ba1\u7406\u9ad4\u7cfb","supplierProcessStep1Title":"\u51c6\u5165","supplierProcessStep1Desc":"\u5efa\u7acb\u4f9b\u61c9\u5546\u51c6\u5165\u6a5f\u5236\uff0c\u8a55\u4f30\u8cc7\u8cea\u3001\u8cea\u91cf\u8207\u5408\u898f\u60c5\u6cc1\uff0c\u63a8\u52d5\u7c3d\u7f72\u300a\u8aa0\u4fe1\u7d04\u5b9a\u51fd\u300b\u4e26\u660e\u78ba\u5ec9\u6f54\u8981\u6c42\u3002\u622a\u81f32026\u5e743\u670831\u65e5\uff0c\u5df2\u67094.3\u842c\u4f9b\u61c9\u5546\u7c3d\u8a02\u300a\u8aa0\u4fe1\u7d04\u5b9a\u51fd\u300b\uff0c\u5176\u4e2d\uff0c\u4e2d\u570b\u5167\u5730\u4f7f\u7528\u6a19\u6e96\u5408\u540c\u7684\u4f9b\u61c9\u5546\u7c3d\u7f72\u7387\u9054100%\u3002","supplierProcessStep2Title":"\u9078\u64c7","supplierProcessStep2Desc":"\u5236\u5b9a\u5dee\u7570\u5316\u6a19\u6e96\uff0c\u7d9c\u5408\u8003\u91cf\u8cea\u91cf\u3001\u670d\u52d9\u3001\u6280\u8853\u8207\u6210\u672c\uff0c\u5805\u6301\u516c\u6b63\u9074\u9078\uff0c\u5efa\u7acb\u7e3e\u6548\u5c0e\u5411\u6a5f\u5236\uff0c\u512a\u5148\u652f\u6301\u512a\u79c0\u5408\u4f5c\u5925\u4f34\u3002","supplierProcessStep3Title":"\u8a55\u4f30","supplierProcessStep3Desc":"\u5f9e\u7522\u54c1\u8cea\u91cf\u3001\u670d\u52d9\u6c34\u5e73\u548c\u4ea4\u4ed8\u80fd\u529b\u7b49\u7dad\u5ea6\u5c0d\u4f9b\u61c9\u5546\u958b\u5c55\u7e3e\u6548\u8a55\u4f30\uff0c\u4e26\u900f\u904e\u6301\u7e8c\u53cd\u994b\u8207\u5408\u4f5c\u512a\u5316\u6a5f\u5236\uff0c\u63a8\u52d5\u5176\u63d0\u5347\u7522\u54c1\u548c\u670d\u52d9\u8cea\u91cf\u3002","supplierProcessStep4Title":"\u9055\u898f\u7ba1\u7406","supplierProcessStep4Desc":"\u91dd\u5c0d\u9055\u898f\u884c\u70ba\u5efa\u7acb\u8655\u7f6e\u6a5f\u5236\uff0c\u63a1\u53d6\u6574\u6539\u3001\u66ab\u505c\u5408\u4f5c\u6216\u7d42\u6b62\u5408\u4f5c\u7b49\u63aa\u65bd\u30022026\u8ca1\u5e74\uff0c\u5171\u670948\u5bb6\u4f9b\u61c9\u5546\u56e0\u8cc4\u8cc2\u963f\u91cc\u5df4\u5df4\u54e1\u5de5\u800c\u88ab\u963f\u91cc\u5df4\u5df4\u96c6\u5718\u6c38\u4e45\u62c9\u9ed1\u3002","supplierRiskManagementTitle":"\u4f9b\u61c9\u5546\u98a8\u96aa\u7ba1\u7406","supplierRiskManagementDesc":"\u900f\u904e\u6578\u5b57\u5316\u5de5\u5177\u6301\u7e8c\u8b58\u5225\u548c\u76e3\u6e2c\u4f9b\u61c9\u93c8\u98a8\u96aa\uff0c\u4e26\u7d50\u5408\u76e3\u7ba1\u5408\u898f\u3001\u6cd5\u5f8b\u8a34\u8a1f\u53ca\u5b89\u5168\u7b49\u7dad\u5ea6\u958b\u5c55\u98a8\u96aa\u8a55\u4f30\u3002\u91dd\u5c0d\u91cd\u9ede\u4f9b\u61c9\u5546\u6216\u9ad8\u98a8\u96aa\u54c1\u985e\uff0c\u958b\u5c55\u5c08\u9805\u8a55\u4f30\u6216\u73fe\u5834\u6aa2\u67e5\uff0c\u63a8\u52d5\u554f\u984c\u6574\u6539\u3002","supplierEsgManagementSystemTitle":"\u4f9b\u61c9\u5546ESG\u7ba1\u7406\u9ad4\u7cfb","supplierEsgProcessTitle":"\u4f9b\u61c9\u5546ESG\u7ba1\u7406\u6d41\u7a0b","supplierEsgProcessStep1Title":"ESG\u51c6\u5165","supplierEsgProcessStep1Desc":"\u5236\u5b9a\u300a\u963f\u91cc\u5df4\u5df4\u4f9b\u61c9\u5546ESG\u884c\u70ba\u6e96\u5247\u898f\u7bc4\u300b\uff0c\u63a8\u52d5\u5408\u4f5c\u5925\u4f34\u7c3d\u7f72\uff0c\u660e\u78ba\u5176\u5728\u52de\u5de5\u6b0a\u76ca\u3001\u8077\u696d\u5065\u5eb7\u8207\u5b89\u5168\u3001\u74b0\u5883\u4fdd\u8b77\u3001\u6578\u64da\u5b89\u5168\u8207\u79c1\u96b1\u4fdd\u8b77\u53ca\u5546\u696d\u9053\u5fb7\u7b49\u65b9\u9762\u7684\u57fa\u672c\u8981\u6c42\u3002","supplierEsgProcessStep2Title":"ESG\u8a55\u4f30","supplierEsgProcessStep2Desc":"\u900f\u904e\u5c08\u984c\u8abf\u7814\u53ca\u4f9b\u61c9\u5546\u8a55\u4f30\u6a5f\u5236\uff0c\u6301\u7e8c\u77ad\u89e3\u5176\u5728\u52de\u5de5\u6b0a\u76ca\u3001\u74b0\u5883\u7ba1\u7406\u53ca\u5546\u696d\u9053\u5fb7\u7b49\u65b9\u9762\u7684\u8868\u73fe\uff0c\u4e26\u5c07ESG\u8981\u6c42\u5d4c\u5165\u90e8\u5206\u63a1\u8cfc\u985e\u76ee\u7ba1\u7406\u6d41\u7a0b\u3002","supplierEsgProcessStep3Title":"ESG\u5408\u898f\u57f9\u8a13","supplierEsgProcessStep3Desc":"\u6301\u7e8c\u958b\u5c55\u4f9b\u61c9\u5546ESG\u5c08\u9805\u80fd\u529b\u5efa\u8a2d\uff0c\u9762\u5411\u5404\u696d\u52d9\u4f9b\u61c9\u5546\u958b\u5c55\u591a\u7dad ESG\u5408\u898f\u57f9\u8a13\uff0c\u52a9\u529b\u4f9b\u61c9\u5546\u63d0\u5347ESG\u5c65\u7d04\u80fd\u529b\u8207\u53ef\u6301\u7e8c\u767c\u5c55\u6c34\u5e73\u3002","supplierEsgRiskManagementTitle":"\u4f9b\u61c9\u5546ESG\u98a8\u96aa\u7ba1\u7406","supplierEsgRiskManagementDesc":"\u5c07ESG\u98a8\u96aa\u8b58\u5225\u7d0d\u5165\u4f9b\u61c9\u5546\u98a8\u96aa\u76e3\u6e2c\u9ad4\u7cfb\uff0c\u900f\u904e\u76e3\u6e2c\u8207\u9810\u8b66\u6a5f\u5236\u63d0\u5347\u63a1\u8cfc\u7d44\u7e54\u5c0dESG\u98a8\u96aa\u7684\u8b58\u5225\u8207\u61c9\u5c0d\u80fd\u529b\uff0c\u4fc3\u9032\u4f9b\u61c9\u93c8\u9577\u671f\u7a69\u5b9a\u767c\u5c55\u3002"}')},32989:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG Report","bannerTitle":"Providing Responsible Products for Consumers","bannerDescription":"Our ability to fully leverage digital technologies to continuously improve consumer experience with quality products and efficient services has a direct impact on consumer engagement and long-term business growth.","actionResults":"Progress","actionResultsTitle":"Progress","strategyPath":"Approaches","strategyPathTitle":"Approaches","strategyPathContent":"We have established \\"user-first\\" as Alibaba\'s core strategy. Under this strategy, we leverage digital innovation and market mechanisms to build an ecosystem that fosters positive interaction among all stakeholders, including merchants and consumers. We also prioritize accessibility, age-friendly features, and minor protection. As we build a brighter future for digital consumption, we are committed to ensuring that every consumer can benefit from technologies.","consumerExperienceTitle":"Consumer experience","consumerExperienceDescription":"We optimize the quality of products and services to create a trustworthy shopping environment and a good consumer experience.","optimizeProductQualityTitle":"Product quality","optimizeProductQualityDescription":"In accordance with applicable laws and regulations, such as the E-commerce Law of the People\'s Republic of China and the Product Quality Law of the People\'s Republic of China, our e-commerce platforms work closely with merchants to ensure the quality and safety of products by taking measures such as merchant vetting, product qualification, and product quality monitoring.","merchantVettingTitle":"Vetting and qualification","merchantVettingDescription":"Our e-commerce platforms have established clear guidelines for merchant management. Only merchants and products that have passed our vetting processes are allowed on the platforms. We communicate the latest product compliance requirements through compliance training and policy interpretations.","qualityMonitoringTitle":"Product quality monitoring","qualityMonitoringDescription":" Our e-commerce platforms monitor product quality using an algorithm-driven approach, supplemented by manual reviews. This process integrates consumer feedback with product attributes. For high-risk items, we conduct spot checks to ensure compliance with quality standards.","nonCompliantHandlingTitle":"Non-compliance handling","nonCompliantHandlingDescription":"Upon identifying a product quality issue through monitoring or a spot check, we take a punitive action, such as delisting or removing the product. Meanwhile, we impose a penalty on the merchant based on the severity of the violation. In the event of a product recall, we facilitate the process and immediately prevent further sales of the defective product.","improveServiceQualityTitle":"Service quality","improveServiceQualityDescription":"We make growing efforts to improve the core aspects of consumer experience. To that end, we strive to build a trustworthy, convenient shopping environment across the consumer journey, from pre-sales communication and in-sales support to after-sales service and other stages.","preSalesTitle":"Pre-sales","preSalesSubtitle":"Responsible marketing","preSalesDescription":"We have established clear rules to ensure compliance and transparency in marketing activities, covering qualification vetting, real-time monitoring, and complaint handling.","inSalesTitle":"In-sales","inSalesSubtitle":"Transparent reviews","inSalesDescription":"We provide consumers with intuitive review tools and analyze their feedback to build an evaluation system for merchants and products so that consumers can make informed purchase decisions.","afterSalesTitle":"After-sales","afterSalesSubtitle":"Worry-free shopping","afterSalesDescription":"Our rigorous after-sales service standards ensure prompt responses to complaints, full process transparency, and smart quality control.","digitalLifeTitle":"Inclusive digital life","digitalLifeDescription":"At Alibaba, we constantly enhance our products and service capabilities for the digital era. We are committed to fostering an inclusive, healthy environment for a digital life.","accessibleServicesTitle":"Accessible services","accessibleServicesIntro1":"For over a decade, we have remained committed to addressing the digital needs of vulnerable groups, such as the visually impaired. 10 apps and product features under the banner of Alibaba, such as Taobao, Cainiao, and Youku, have obtained the national Level 1 accessibility certification in China.","shoppingAccessibilityTitle":"Accessible consumption","shoppingAccessibilityDesc":"We continuously refine readability and interaction on the Taobao app, maintaining a regular communication channel to ensure that the needs of visually impaired users are heard and met.","travelAccessibilityTitle":"Accessible mobility","travelAccessibilityDesc":"Amap has introduced accessible navigation features to prioritize barrier-free routes for wheelchair users and provide the visually impaired with support for screen readers as well as guidance along tactile paths.","entertainmentAccessibilityTitle":"Accessible entertainment","entertainmentAccessibilityDesc":"Youku offers premium accessible media content for the visually or hearing-impaired and has hosted multiple in-person entertainment activities catering to their specific needs.","healthAccessibilityTitle":"Accessible healthcare","healthAccessibilityDesc":"Alibaba Philanthropy and Alibaba Health have partnered with charities to launch the Lemon Baby Care Initiative. This initiative provides health management services for children with rare diseases and mobilizes socially responsible companies to secure a steady supply of formulas for special medical purposes.","elderlyServicesTitle":"Age-friendly services","taobaoElderlyAdaptationTitle":"Senior mode","taobaoElderlyAdaptationDesc":"The Taobao app has launched a senior mode that simplifies the interface, enlarges fonts, and enhances voice assistance. These optimizations streamline browsing and searching for elderly users.","elderlyMealProgramTitle":"Elderly Meal Assistance Program","elderlyMealProgramDesc":"In collaboration with local authorities, Taobao Instant Commerce provides professional delivery services for community cafeterias serving the elderly. This initiative addresses mealtime challenges caused by limited mobility and inefficient delivery, improving the experience of aging in place.","minorProtectionTitle":"Minor protection","minorProtectionDescription":"The Taobao platform launched a minor mode in 2023. It has constantly improved its minor protection mechanism to safeguard and guide minors toward healthy development.","minorModeTitle":"Minor mode","minorModeDesc":"In this mode, Taobao curates age-appropriate content for minors, filtering out products unsuitable for them to browse or purchase. Additionally, it disables services such as livestream tipping and account top-ups, providing guardians with tools for managing screen time and permissions.","minorMarketingTitle":"Marketing to minors","minorMarketingDesc":"A closed loop for protection: We enforce strict screening protocols to filter out harmful information, leverage intelligent algorithms alongside manual reviews for 24/7 monitoring, and maintain fast-track reporting channels to remove non-compliant content swiftly.","minorInfoManagementTitle":"Privacy protection for minors","minorInfoManagementDesc":"The personal information of minors under 14 is treated as sensitive data. We follow strict requirements when collecting, storing, and processing such information. If we need to collect a minor\'s personal information, we explicitly inform their guardians of the purpose and obtain their consent. Additionally, we prohibit using automated decision-making to target minors for marketing.","greenNetMinorProtectionTitle":"GreenNet Program","greenNetMinorProtectionDesc":"In minor mode, the GreenNet Program expands its scope of restricted search keywords to cover tobacco, gambling, suicide, and depression. Inappropriate searches suspected of originating from minors are redirected to educational pages that encourage them to do public good.","greenNetProgramTitle":"GreenNet Program","greenNetProgramDesc":" The Internet is beset with inappropriate searches involving pornography, gambling, drug abuse, and wildlife trafficking as well as products related to suicide or depression and trade in addictive games. It is our duty to ensure that transactions on our e-commerce platforms are not abused and that inappropriate searches are diverted to positive content. In 2020, Taobao launched the GreenNet Program to systematically address inappropriate searches on the platform. By combining technological capabilities with public awareness efforts, the program advocates for informed, responsible, and sustainable consumption. It focuses on five key areas: human health, wildlife conservation, minor protection, public safety, and individual privacy.","complaintRateTitle":"0.023","complaintRateDesc":"The consumer complaint rate on the Taobao and Tmall platforms was 0.023%.","visuallyImpairedPrefix":"Over ","visuallyImpairedTitle":"220,000","visuallyImpairedUnit":"","visuallyImpairedDesc":"The Taobao app served over 220,000 visually impaired users.","accessibleVideosPrefix":"Over ","accessibleVideosTitle":"2.4 million","accessibleVideosUnit":"","accessibleVideosDesc":"Youku\'s accessible media content was streamed over 2.4 million times.","accessibleRoutesPrefix":"Over ","accessibleRoutesTitle":"100 million","accessibleRoutesUnit":"","accessibleRoutesDesc":"Amap\'s accessible navigation features facilitated over 100 million trips for wheelchair users and the visually impaired.","greenNetPrefix":"Over ","greenNetTitle":"51 million","greenNetUnit":"","greenNetDesc":"The GreenNet Program redirected over 51 million inappropriate searches to public awareness and educational pages.","diversityEquityInclusion":"Diversity, Equity & Inclusion","talentAttractionRetention":"Talent Attraction & Retention","talentDevelopmentOpportunities":"Rich Talent Development Opportunities","employeeHealthVitality":"Employee Health & Vitality","femaleEmployeesTitle":"35.4","femaleEmployeesDesc":"of employees are female","forbesBestEmployerTitle":"2024","forbesBestEmployerDesc":"Forbes Global Best Employer","familyCareLeaveTitle":"Over 60,000","familyCareLeaveDesc":"Caring for families, employees enjoy precious time with their loved ones through family care leave","iso45001CertificationTitle":"ISO 45001","iso45001CertificationDesc":"Multiple Alibaba campuses, data centers and logistics facilities have obtained certification","firstAidTrainingTitle":"Over 14,000","firstAidTrainingDesc":"Alibaba has cumulatively trained first aid heroes","officeSatisfactionTitle":"93.1","officeSatisfactionDesc":"Alibaba office environment satisfaction rate 93.1%"}')},66229:function(e){"use strict";e.exports=JSON.parse('{"esgReports":"ESG\u62a5\u544a","bannerTitle":"\u606a\u5b88\u4ea7\u54c1\u8d23\u4efb\u670d\u52a1\u6d88\u8d39\u8005","bannerDescription":"\u80fd\u5426\u5145\u5206\u53d1\u6325\u6570\u5b57\u5316\u3001\u667a\u80fd\u5316\u7684\u6280\u672f\u80fd\u529b\u4e3a\u6d88\u8d39\u8005\u63d0\u4f9b\u66f4\u4f18\u8d28\u548c\u9ad8\u6548\u7684\u4ea7\u54c1\u4e0e\u670d\u52a1\uff0c\u6301\u7eed\u4f18\u5316\u7528\u6237\u4f53\u9a8c\uff0c\u5c06\u76f4\u63a5\u5f71\u54cd\u963f\u91cc\u5df4\u5df4\u7528\u6237\u53c2\u4e0e\u5ea6\u548c\u4e1a\u52a1\u7684\u957f\u8fdc\u53d1\u5c55\u3002","actionResults":"\u884c\u52a8\u7ed3\u679c","actionResultsTitle":"\u884c\u52a8\u7ed3\u679c","strategyPath":"\u7b56\u7565\u4e0e\u8def\u5f84","strategyPathTitle":"\u7b56\u7565\u4e0e\u8def\u5f84","strategyPathContent":"\u963f\u91cc\u5df4\u5df4\u5c06\\"\u7528\u6237\u4e3a\u5148\\"\u786e\u7acb\u4e3a\u6838\u5fc3\u6218\u7565\u3002\u5728\u8fd9\u4e00\u6218\u7565\u6307\u5f15\u4e0b\uff0c\u6211\u4eec\u4f9d\u6258\u6570\u5b57\u79d1\u6280\u521b\u65b0\u548c\u5e02\u573a\u673a\u5236\u5efa\u8bbe\uff0c\u7740\u529b\u6784\u5efa\u5546\u5bb6\u3001\u6d88\u8d39\u8005\u7b49\u5404\u65b9\u53c2\u4e0e\u8005\u826f\u6027\u4e92\u52a8\u7684\u751f\u6001\u7cfb\u7edf\u3002\u6211\u4eec\u8fd8\u5173\u6ce8\u65e0\u969c\u788d\u3001\u9002\u8001\u5316\u5efa\u8bbe\u548c\u672a\u6210\u5e74\u4eba\u4fdd\u62a4\uff0c\u81f4\u529b\u4e8e\u8ba9\u79d1\u6280\u7ea2\u5229\u60e0\u53ca\u6bcf\u4e00\u4f4d\u6d88\u8d39\u8005\uff0c\u5171\u540c\u521b\u9020\u66f4\u7f8e\u597d\u7684\u6570\u5b57\u5316\u6d88\u8d39\u672a\u6765\u3002","consumerExperienceTitle":"\u826f\u597d\u7684\u6d88\u8d39\u4f53\u9a8c","consumerExperienceDescription":"\u6211\u4eec\u901a\u8fc7\u4f18\u5316\u5546\u54c1\u8d28\u91cf\u4e0e\u63d0\u5347\u670d\u52a1\u54c1\u8d28\uff0c\u6784\u5efa\u53ef\u4fe1\u8d56\u7684\u6d88\u8d39\u73af\u5883\uff0c\u4e3a\u6d88\u8d39\u8005\u63d0\u4f9b\u4f18\u8d28\u4f53\u9a8c\u3002","optimizeProductQualityTitle":"\u4f18\u5316\u5546\u54c1\u8d28\u91cf","optimizeProductQualityDescription":"\u4e3a\u6d88\u8d39\u8005\u63d0\u4f9b\u4fbf\u6377\u7684\u8bc4\u4ef7\u5de5\u5177\uff0c\u5e76\u901a\u8fc7\u7efc\u5408\u5206\u6790\u6d88\u8d39\u8005\u53cd\u9988\uff0c\u6784\u5efa\u5546\u5bb6\u548c\u5546\u54c1\u7684\u8bc4\u4ef7\u4f53\u7cfb\uff0c\u4e3a\u6d88\u8d39\u8005\u51b3\u7b56\u63d0\u4f9b\u6709\u529b\u652f\u6301\u3002","merchantVettingTitle":"\u5546\u5bb6\u4e0e\u5546\u54c1\u51c6\u5165\u7ba1\u7406","merchantVettingDescription":"\u6211\u4eec\u7684\u7535\u5546\u4ea4\u6613\u5e73\u53f0\u5236\u5b9a\u4e86\u6e05\u6670\u7684\u5546\u5bb6\u7ba1\u7406\u89c4\u5219\uff0c\u660e\u786e\u5bf9\u5546\u5bb6\u63d0\u51fa\u8981\u6c42\uff0c\u5ba1\u6838\u901a\u8fc7\u7684\u5546\u5bb6\u548c\u5546\u54c1\u624d\u80fd\u5728\u5e73\u53f0\u4e0a\u7ecf\u8425\u3002\u5e73\u53f0\u4f1a\u901a\u8fc7\u89c4\u5219\u8bfe\u7a0b\uff0c\u89c4\u5219\u89e3\u8bfb\u7b49\u65b9\u5f0f\u5411\u5546\u5bb6\u4f20\u9012\u6700\u65b0\u7684\u5546\u54c1\u5408\u89c4\u7ba1\u7406\u8981\u6c42\uff0c\u786e\u4fdd\u5546\u5bb6\u4e86\u89e3\u89c4\u5219\u3002","qualityMonitoringTitle":"\u5546\u54c1\u54c1\u8d28\u76d1\u6d4b","qualityMonitoringDescription":"\u6211\u4eec\u7684\u7535\u5546\u4ea4\u6613\u5e73\u53f0\u901a\u8fc7\u7b97\u6cd5\u6a21\u578b\u4e3a\u4e3b\u3001\u4eba\u5de5\u6cbb\u7406\u4e3a\u8f85\u7684\u65b9\u5f0f\uff0c\u7ed3\u5408\u6d88\u8d39\u8005\u53cd\u9988\u53ca\u5546\u54c1\u7279\u5f81\u4fe1\u606f\uff0c\u5bf9\u9500\u552e\u5546\u54c1\u8fdb\u884c\u54c1\u8d28\u76d1\u6d4b\u3002 \u5bf9\u4e8e\u6709\u8f83\u9ad8\u98ce\u9669\u7684\u5546\u54c1\uff0c\u5e73\u53f0\u4f1a\u8fdb\u884c\u62bd\u68c0\uff0c\u786e\u4fdd\u5546\u54c1\u8d28\u91cf\u7b26\u5408\u6807\u51c6\u3002","nonCompliantHandlingTitle":"\u5f02\u5e38\u5546\u54c1\u5904\u7f6e","nonCompliantHandlingDescription":"\u5e73\u53f0\u901a\u8fc7\u5546\u54c1\u76d1\u6d4b\u4e0e\u62bd\u68c0\u8bc6\u522b\u51fa\u5546\u54c1\u8d28\u91cf\u95ee\u9898\u540e\uff0c\u5c06\u91c7\u53d6\u4e25\u683c\u5904\u7f6e\u6307\u65bd\uff0c\u5305\u62ec\u5546\u54c1\u4e0b\u67b6\u3001\u5220\u9664\u7b49\uff0c\u5e76\u6839\u636e\u8fdd\u89c4\u60c5\u8282\u4e25\u91cd\u7a0b\u5ea6\u5bf9\u76f8\u5173\u5546\u5bb6\u65bd\u4ee5\u76f8\u5e94\u5904\u7f5a\u3002 \u5f53\u5546\u5bb6\u5df2\u552e\u5546\u54c1\u88ab\u53ec\u56de\u65f6\uff0c\u5e73\u53f0\u5c06\u534f\u52a9\u53ec\u56de\uff0c\u963b\u6b62\u7f3a\u9677\u5546\u54c1\u7ee7\u7eed\u5728\u5e73\u53f0\u9500\u552e\u3002","improveServiceQualityTitle":"\u63d0\u5347\u670d\u52a1\u54c1\u8d28","improveServiceQualityDescription":"\u6211\u4eec\u5728\u7528\u6237\u6838\u5fc3\u4f53\u9a8c\u4e0a\u52a0\u5927\u6295\u5165\uff0c\u5728\u552e\u524d\u3001\u552e\u4e2d\u548c\u552e\u540e\u7b49\u73af\u8282\u4fdd\u969c\u6d88\u8d39\u8005\u7684\u8d2d\u7269\u4f5