34\u3001\u84c4\u6c34\u3001\u6e17\u6c34\u3001\u51c0\u6c34\u201d\u80fd\u529b\uff0c\u4ece\u800c\u6709\u6548\u5e94\u5bf9\u6c34\u8d44\u6e90\u77ed\u7f3a\u3001\u6d2a\u6d9d\u707e\u5bb3\u548c\u6c34\u6c61\u67d3\u7b49\u95ee\u9898\u3002\\n\u963f\u91cc\u5df4\u5df4\u676d\u5dde\u56ed\u533a\u897f\u6eaa C \u533a\u3001\u5317\u4eac\u56ed\u533a\u5747\u9075\u5faa\u8fd9\u4e00\u7406\u5ff5\uff0c\u91c7\u53d6\u4e86\u4e00\u7cfb\u5217\u4e3e\u63aa\u3002\u8b6c\u5982\uff0c\u9009\u7528\u900f\u6c34\u6027\u94fa\u88c5\u6750\u6599\uff0c\u4f7f\u96e8\u6c34\u80fd\u591f\u76f4\u63a5\u6e17\u900f\u5230\u5730\u4e0b\uff1b\u5efa\u8bbe\u96e8\u6c34\u6536\u96c6\u7cfb\u7edf\uff0c\u5c06\u5c4b\u9876\u548c\u5730\u9762\u7684\u96e8\u6c34\u6536\u96c6\u8d77\u6765\u91cd\u590d\u518d\u5229\u7528\u3002","campusWaterConservationTitle":"\u56ed\u533a\u7684\u6c34\u8d44\u6e90\u7ba1\u7406","campusWaterSavingTitle":"\u8861\u91cf","campusWaterSavingDesc":"\u6211\u4eec\u6784\u5efa\u4e86\u6c34\u8d44\u6e90\u7ba1\u7406\u5e73\u53f0\uff0c\u901a\u8fc7\u6570\u5b57\u5316\u76d1\u6d4b\uff0c\u5b9e\u73b0\u5bf9\u7528\u6c34\u7684\u7cbe\u7ec6\u5316\u7ba1\u63a7\uff0c\u63d0\u5347\u8d44\u6e90\u5229\u7528\u6548\u7387\uff0c\u652f\u6301\u53ef\u6301\u7eed\u8fd0\u8425\u3002","campusWaterRecyclingTitle":"\u7ba1\u7406\u4f53\u7cfb","campusWaterRecyclingDesc":"\u6211\u4eec\u6784\u5efa\u201c\u76d1\u6d4b - \u8282\u6c34 - \u56de\u7528\u201d\u7684\u667a\u6167\u5316\u6c34\u8d44\u6e90\u7ba1\u7406\u4f53\u7cfb\u3002\u901a\u8fc7\u90e8\u7f72\u667a\u80fd\u6c34\u8868\u7cfb\u7edf\u3001\u5347\u7ea7\u4e00\u7ea7\u6c34\u6548\u8bbe\u5907\uff0c\u4ee5\u53ca\u5efa\u7acb\u76f4\u996e\u6c34\u5e9f\u6c34\u4e0e\u7a7a\u8c03\u51b7\u51dd\u6c34\u5faa\u73af\u5229\u7528\u7f51\u7edc\uff0c\u7cfb\u7edf\u5316\u63d0\u5347\u6c34\u8d44\u6e90\u5229\u7528\u6548\u7387\u30022026\u8d22\u5e74\uff0c\u963f\u91cc\u5df4\u5df4\u81ea\u7528\u529e\u516c\u56ed\u533a\u6301\u7eed\u62d3\u5c55\u5faa\u73af\u6c34\u7cfb\u7edf\u7684\u6539\u9020\u548c\u6295\u5165\u8fd0\u8425\uff0c\u5168\u5e74\u5faa\u73af\u7528\u6c34\u91cf\u